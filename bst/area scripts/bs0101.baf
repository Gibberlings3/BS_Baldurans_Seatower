/* group came from arena bs0104 - reset defense system */
IF
    InMyArea(Player1)
    GlobalGT("bs_i_PortalRoomActivated","GLOBAL",0)
    GlobalLT("bs_i_PortalRoomActivated","GLOBAL",4)
THEN
	RESPONSE #100
        SetGlobal("bs_i_PortalRoomActivated","GLOBAL",0)
END

/* spawn more sahuagin as guard of baron Frohklto - Acifer */
IF
    Global("bs0101_spawn_sahuagin01","MYAREA",0)
THEN
	RESPONSE #100
        CreateCreature("bsisagg4",[1743.1826],9)
        CreateCreature("bsisagg4",[1871.1704],9)
        CreateCreature("bsisagg4",[1251.1606],11)
        CreateCreature("bsisagg4",[1664.1344],3)  
        CreateCreature("bsisagg4",[1479.1694],11)
        CreateCreature("bsisagg4",[1736.1572],4)              
        SetGlobal("bs0101_spawn_sahuagin01","MYAREA",1)
END

/* spawn more sahuagin when fighting the baron Frohklto - Acifer */
IF
    Global("bs0101_spawn_sahuagin02","MYAREA",1)
    DifficultyGT(EASIEST)
THEN
	RESPONSE #100
        CreateCreature("bsisagg3",[937.1430],10)
        CreateCreature("bsisagg3",[936.1485],10)
        CreateCreature("bsisagg3",[968.1533],10)
        SetGlobal("bs0101_spawn_sahuagin02","MYAREA",2)
END

/* spawn even more sahuagin when fighting the baron Frohklto - Acifer */
IF
    Global("bs0101_spawn_sahuagin02","MYAREA",2)
    //DifficultyGT(EASY)
    LevelPartyGT(6)
THEN
	RESPONSE #100
        CreateCreature("bsisagg3",[1400.1009],0)
        CreateCreature("bsisagg3",[1371.1049],0)
        SetGlobal("bs0101_spawn_sahuagin02","MYAREA",3)
END

/* journal entries, in case player attacked the waiting rebel baron outside of dialogue */
IF
    !Dead("bsisagb1")
    !Dead("bsisagp1")
    Dead("bsisagr1")
    GlobalGT("bs_RebelDeal","GLOBAL",0)
    !GlobalGT("bs_BaronDeal","GLOBAL",0)
THEN
    RESPONSE #100
        EraseJournalEntry(@965)
        EraseJournalEntry(@969)
        AddJournalEntry(@964,QUEST)
        SetGlobal("bs_RebelDeal","GLOBAL",-1)
END
IF
    !Dead("bsisagb1")
    !Dead("bsisagp1")
    Dead("bsisagr1")
    GlobalGT("bs_RebelDeal","GLOBAL",0)
    GlobalGT("bs_BaronDeal","GLOBAL",0)
THEN
    RESPONSE #100
        EraseJournalEntry(@964)
        EraseJournalEntry(@965)
        EraseJournalEntry(@969)
        AddJournalEntry(@966,QUEST)
        SetGlobal("bs_RebelDeal","GLOBAL",-1)
END
/* journal entries for both dead */
IF
    Dead("bsisagb1")
    Dead("bsisagr1")
    Global("bs_JournalBaronsDead","MYAREA",0)
THEN
    RESPONSE #100
        EraseJournalEntry(@963)
        EraseJournalEntry(@964)
        EraseJournalEntry(@965)
        EraseJournalEntry(@966)
        EraseJournalEntry(@967)
        EraseJournalEntry(@968)
        EraseJournalEntry(@969)
        EraseJournalEntry(@100007)
        SetGlobal("bs_JournalBaronsDead","MYAREA",1)
END

/* secret passage: altar bulged after one stone */
IF
    Global("bs_SecretPassageMechanism","MYAREA",0)
    HasItem("bsistone","Altar01")
THEN
  RESPONSE #100
        DisplayStringHead("bs0101t1",@11113)
        AddJournalEntry(@100002,QUEST) //Hidden Mechanism in the Chapel's Altar?
        SetGlobal("bs_SecretPassageMechanism","MYAREA",1)
END

/* secret passage opened */
/* did not hear about passage from Old Hermit */
IF
    Global("bs_SecretPassageOpen","GLOBAL",0)
    NumItemsGT("bsistone","Altar01",1)
THEN
  RESPONSE #100
        PlaySound("AMB_D04A")
        EraseJournalEntry(@100002)
        AddJournalEntry(@100004,QUEST_DONE)
        AddexperienceParty(100)
        DisplayStringHead("bs0101t1",@11108)
		TriggerActivation("bs0101t1",FALSE)
		TriggerActivation("travbs0104",TRUE)
        SetGlobal("bs_SecretPassageOpen","GLOBAL",2)
END
/* did hear about passage from Old Hermit */
IF
    Global("bs_SecretPassageOpen","GLOBAL",1)
    NumItemsGT("bsistone","Altar01",1)
THEN
  RESPONSE #100
        PlaySound("AMB_D04A")
        EraseJournalEntry(@100002)
        AddJournalEntry(@100004,QUEST_DONE)
        AddexperienceParty(100)
        EraseJournalEntry(@100001)
        AddJournalEntry(@100003,QUEST)
        DisplayStringHead("bs0101t1",@11108)
		TriggerActivation("bs0101t1",FALSE)
		TriggerActivation("travbs0104",TRUE)
        SetGlobal("bs_SecretPassageOpen","GLOBAL",3)
END

/* open secret door */
IF
    Global("bs_SolvedDoorRiddle","MYAREA",5)
THEN
  RESPONSE #100
        SetInterrupt(FALSE)
        Unlock("Door01" )
        OpenDoor("Door01")
        EraseJournalEntry(@100068)
        EraseJournalEntry(@100069)
        EraseJournalEntry(@100082)
        AddJournalEntry(@100070,QUEST_DONE)
        SetGlobal("bs_SolvedDoorRiddle","MYAREA",6)
        SetInterrupt(TRUE)
END

