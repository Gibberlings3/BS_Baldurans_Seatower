	Global("bs_Barrel01ItemSpawn","MYAREA",0)
THEN
	RESPONSE #100
		ActionOverride("Crate01",CreateItem("potn08",1,0,0)
		ActionOverride("Crate01",CreateItem("potn17",1,0,0)
		ActionOverride("Barrel01",CreateItem("misc07",735,0,0)
		ActionOverride("Barrel01",CreateItem("potn10",3,0,0)
		ActionOverride("Barrel01",CreateItem("potn34",1,0,0)
		ActionOverride("Barrel01",CreateItem("amul11",1,0,0)
		ActionOverride("Barrel02",CreateItem("misc07",5,0,0)
		ActionOverride("Barrel03",CreateItem("misc07",1,0,0)
		ActionOverride("Barrel03",CreateItem("potn08",1,0,0)
		SetGlobal("bs_Barrel01ItemSpawn","MYAREA",1)
END

