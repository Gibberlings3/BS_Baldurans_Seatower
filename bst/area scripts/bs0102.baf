/* group came from arena bs0104 - reset defense system */
IF
    InMyArea(Player1)
    GlobalGT("bs_i_PortalRoomActivated","GLOBAL",0)
    GlobalLT("bs_i_PortalRoomActivated","GLOBAL",4)
THEN
	RESPONSE #100
        SetGlobal("bs_i_PortalRoomActivated","GLOBAL",0)
END

/* spawn more sahuagin when fighting baron Frohxlto - Acifer */
IF
    Global("bs0102_spawn_sahuagin03","MYAREA",1)
    DifficultyGT(EASIEST)
THEN
    RESPONSE #100
        CreateCreature("bsisagg3",[1320.1935],10)
        CreateCreature("bsisagg3",[1364.1952],10)
        CreateCreature("bsisagg3",[1243.2003],10)
        SetGlobal("bs0102_spawn_sahuagin03","MYAREA",2)
END

IF
    Global("bs0102_spawn_sahuagin03","MYAREA",2)
    LevelPartyGT(6)
THEN
    RESPONSE #100
        CreateCreature("bsisagg3",[495.2233],10)
        CreateCreature("bsisagg3",[528.2303],10)
        SetGlobal("bs0102_spawn_sahuagin03","MYAREA",3)
END

