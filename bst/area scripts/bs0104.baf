/* player used shell horn - deactivate defence system. */
IF
    InMyArea(Player1)
    Global("bs_ihorn","GLOBAL",1)
    GlobalLT("bs_i_MonsterSpawnbs0104","GLOBAL",11)
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
THEN
	RESPONSE #100
        EraseJournalEntry(@100033)
        EraseJournalEntry(@100072)
        AddJournalEntry(@100030,QUEST)
        SetGlobal("bs_i_PortalRoomActivated","GLOBAL",2)
END
/* after last spawn */
IF
    InMyArea(Player1)
    Global("bs_ihorn","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",11)
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
THEN
	RESPONSE #100
        SetGlobal("bs_i_MonsterSpawnbs0104","GLOBAL",12)
END

/* deactivate hidden passage, if it was not cleared from the other side (in bs0101) */
IF
    GlobalLT("bs_SecretPassageOpen","GLOBAL",2)
    Global("bs_CloseHiddenPassage","MYAREA",0)
THEN
	RESPONSE #100
		TriggerActivation("travbs0101",FALSE) //hidden passage to bs0101
		SetGlobal("bs_CloseHiddenPassage","MYAREA",1)
END

/* Open hidden passage if it was opened in bs0101 */
IF
    GlobalGT("bs_SecretPassageOpen","GLOBAL",1)
    GlobalLT("bs_CloseHiddenPassage","MYAREA",2)
THEN
	RESPONSE #100
		TriggerActivation("travbs0101",TRUE) //hidden passage to bs0101
		SetGlobal("bs_CloseHiddenPassage","MYAREA",2)
END

/* portal is destroyed - set via dialogue */
IF
    Global("bs_POP","GLOBAL",2)
THEN
	RESPONSE #100
        SoundActivate("PortalHumm",FALSE)
        SetGlobal("bs_POP","GLOBAL",4)
END

/* defense system: monster waves */
/* monster spawn: 1: skeletons */
/* activation */
IF
    Dead("bsisagw1")
    Dead("bsisagw2")
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",0)
THEN
	RESPONSE #100
		RealSetGlobalTimer("bs_i_MonsterSpawnbs0104_Timer","GLOBAL",15)
		DisplayStringHead(Player1,@11131)
		SetGlobal("bs_i_MonsterSpawnbs0104","GLOBAL",1)
END
/* monster spawn, depending on game difficulty */
/* easiest */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        StartCutSceneMode()
        CreateCreature("bsislkt1",[718.830],10)
        CreateVisualEffect("spsdimpa",[718.830])
        CreateCreature("bsislkt1",[845.872],10)
        CreateVisualEffect("spsdimpa",[845.872])
        CreateCreature("bsislkt2",[649.1023],10)
        CreateVisualEffect("spsdimpa",[649.1023])
        PlaySound("EFF_M31C")
        IncrementGlobal("bs_MonsterSpawn1","MYAREA",1)
        SetInterrupt(TRUE)
        Continue()
END
/* easy */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
    DifficultyGT(EASIEST)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        CreateCreature("bsislkt2",[515.734],13)
        CreateVisualEffect("spsdimpa",[515.734])
        IncrementGlobal("bs_MonsterSpawn1","MYAREA",1)
        SetInterrupt(TRUE)
        Continue()
END
/* normal */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
    DifficultyGT(EASY)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        CreateCreature("bsislkt1",[866.793],10)
        CreateVisualEffect("spsdimpa",[866.793])
        CreateCreature("bsislkt2",[1042.931],5)
        CreateVisualEffect("spsdimpa",[1042.931])
        IncrementGlobal("bs_MonsterSpawn1","MYAREA",1)
        SetInterrupt(TRUE)
        Continue()
END
/* hard */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
    DifficultyGT(NORMAL)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        CreateCreature("bsislkt2",[1079.647],0)
        CreateVisualEffect("spsdimpa",[1079.647])
        CreateCreature("bsislkt3",[744.1141],10)
        CreateVisualEffect("spsdimpa",[744.1141])
        IncrementGlobal("bs_MonsterSpawn1","MYAREA",1)
        SetInterrupt(TRUE)
        Continue()
END
/* hardest */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
    DifficultyGT(HARD)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        CreateCreature("bsislkt3",[669.583],2)
        CreateVisualEffect("spsdimpa",[669.583])
        CreateCreature("bsislkt3",[606.1117],10)
        CreateVisualEffect("spsdimpa",[606.1117])
        IncrementGlobal("bs_MonsterSpawn1","MYAREA",1)
        SetInterrupt(TRUE)
        Continue()
END
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",1)
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",1)
    RealGlobalTimerExpired("bs_i_MonsterSpawnbs0104_Timer","GLOBAL")
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
		SetGlobal("bs_i_MonsterSpawnbs0104","GLOBAL",2)
        Wait(1)
        EndCutSceneMode()
        SetInterrupt(TRUE)
END

