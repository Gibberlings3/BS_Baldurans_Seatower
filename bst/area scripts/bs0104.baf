/* portal is destroyed by PC's doing - set via item bsiblood */
IF
    InMyArea(Player1)
    Global("bs_POP","GLOBAL",1)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
        SoundActivate("PortalHumm",FALSE)
        PlaySound("EFF_P92")
        ScreenShake([20.20],4)
        SetGlobal("bs_SahuaginPortalRoom","GLOBAL",2)
        SetGlobal("bs_POP","GLOBAL",3)
        DisplayStringHead(Player1,@11110)
        SetInterrupt(TRUE)
END
