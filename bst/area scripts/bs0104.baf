/* defense system deactivated - doors will be opened again */
/* open hidden door - if it was already opened from bs0101 */
IF
    GlobalGT("bs_SecretPassageOpen","GLOBAL",1)
    Global("bs_i_PortalRoomActivated","GLOBAL",2)
THEN
	RESPONSE #100
		TriggerActivation("travbs0101",TRUE) //hidden passage to bs0101
		Continue()
END
/* main door */
IF
    Global("bs_i_PortalRoomActivated","GLOBAL",2)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
		TriggerActivation("Translc0102c",TRUE)
        SetGlobal("bs_i_PortalRoomActivated","GLOBAL",3)
        DisplayStringHead(Player1,@11098)
        SetInterrupt(TRUE)
END
/* all monster spawns defeated: deactivate for good + journal entry */
IF
    Global("bs_i_MonsterSpawnbs0104","GLOBAL",12)
    Global("bs_i_PortalRoomActivated","GLOBAL",3)
THEN
	RESPONSE #100
        EraseJournalEntry(@100030)
        EraseJournalEntry(@100033)
        EraseJournalEntry(@100072)
        AddJournalEntry(@100031,QUEST_DONE)
        AddexperienceParty(100)
        SetGlobal("bs_ihorn","GLOBAL",0)
		SetGlobal("bs_i_PortalRoomActivated","GLOBAL",4)
END

/*journal entry about finding the portals */
