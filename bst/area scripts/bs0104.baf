    !Dead("bsihermi")
    InMyArea(Player1)
    GlobalLT("bs_HermitQuests","GLOBAL",7)
    GlobalLT("bs_SawPortalRoom","GLOBAL",2)
THEN
	RESPONSE #100
        EraseJournalEntry(@100006)
        AddJournalEntry(@983,QUEST)
        SetGlobal("bs_SawPortalRoom","GLOBAL",2)
END
