END



/* "Lord Dlusker's Tomb Visit" quest broken */
IF
	Global("bs_LadyDluskersPlea","GLOBAL",99)
THEN
	RESPONSE #100
		EraseJournalEntry(@931)
		EraseJournalEntry(@932)
		EraseJournalEntry(@933)
		EraseJournalEntry(@934)
		EraseJournalEntry(@935)
		AddJournalEntry(@938,QUEST_DONE)
		SetGlobal("bs_LadyDluskersPlea","GLOBAL",100)
END


// Tannery door
IF
    TimeOfDay(NIGHT)
    !Global("bsLockTannerDoor","MYAREA",1)
    OpenState("DOOR 15",TRUE)
THEN
    RESPONSE #100
        CloseDoor("DOOR 15")
END

IF
    TimeOfDay(NIGHT)
    !Global("bsLockTannerDoor","MYAREA",1)
    OpenState("DOOR 15",FALSE)
THEN
    RESPONSE #100
        Lock("DOOR 15")
        SetGlobal("bsLockTannerDoor","MYAREA",1)
END

IF
    TimeOfDay(DAY)
    !Global("bsLockTannerDoor","MYAREA",0)
THEN
    RESPONSE #100
        SetGlobal("bsLockTannerDoor","MYAREA",0)
        Unlock("DOOR 15")
END
