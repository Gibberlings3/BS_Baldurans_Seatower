/* this is to open up Seatower */


// Unlock and prepare the area
IF
  GlobalLT("bsOpenSeatower","GLOBAL",2)
THEN
  RESPONSE #100
	SetInterrupt(FALSE)
	Unlock("DOOR 02")
	Unlock("DOOR 05")
	Unlock("DOOR 07")
//	Unlock("DOOR 08")
	Unlock("DOOR 13")
//	Unlock("DOOR 14")
	Unlock("DOOR 15") //Tannery door
	Unlock("DOOR 16")
	OpenDoor("DOOR 09") //main gates
	OpenDoor("DOOR 13")
	OpenDoor("DOOR 14")
	TriggerActivation("Travbs1010",TRUE)
	CreateCreature("ysstcgrd",[3804.1941],1)
	CreateCreature("ysstcgrd",[2781.1652],1) //Tower Guard in front of barracks
	CreateCreature("ysstcgrd",[1992.1258],15)  // Tower Guard in front of treasury
	CreateCreature("ysstcgrd",[1901.1212],1)  // Tower Guard in front of treasury
	CreateCreature("bsgrdbcn",[3732.554],6)
	CreateCreature("bsboybcn",[3599.522],0) 
	CreateCreature("bsmanbcn",[3504.518],0)
	CreateCreature("bswellgl",[3827.2108],3) 
	CreateCreature("bswellbo",[3804.2086],0) 
	CreateCreature("bswellma",[3845.2058],2) 
	AmbientActivate("GreenSmoke",FALSE)
	SetGlobal("bsOpenSeatower","GLOBAL",2)
	SetInterrupt(TRUE)
END

//make sure doors are open */
IF
  GlobalLT("bsOpenSeatower","GLOBAL",3)
THEN
  RESPONSE #100
	SetInterrupt(FALSE)
	Unlock("DOOR 02")
	Unlock("DOOR 05")
	Unlock("DOOR 07")
//	Unlock("DOOR 08")
	Unlock("DOOR 13")
//	Unlock("DOOR 14")
	Unlock("DOOR 15") //Tannery door
	Unlock("DOOR 16")
	OpenDoor("DOOR 09") //main gates
	OpenDoor("DOOR 13")
	OpenDoor("DOOR 14")
	TriggerActivation("Travbs1010",TRUE)
	SetGlobal("bsOpenSeatower","GLOBAL",3)
	SetInterrupt(TRUE)
END

/* 5th smuggler quest - spawn smuggler contact */
IF
	InMyArea(Player1)
	Global("bsSmugglerQuest","GLOBAL",22)
	!Dead("bssmgl02")
	Global("bs_SpawnSmugglerContact5","MYAREA",0)
THEN
	RESPONSE #100
		CreateCreature("bssmgl18",[3509.3130],8) //Smuggler Contact
		SetGlobal("bs_SpawnSmugglerContact5","MYAREA",1)
END

/* 5th smuggler quest, reporting smugglers to FF: timer expired, no barrel delivery. Spawn Tower Guard - in both bs1000 and bs1011 */
IF
	InMyArea(Player1)
	Global("bs_ReportSmugglersToSeatower","GLOBAL",6)
	GlobalGT("bsSmugglerQuest","GLOBAL",24)
	GlobalTimerExpired("bsSmugglerQuestTimer5","GLOBAL")
	!PartyHasItem("bssmq008")
	!Exists("bssmgl17")
	!Exists("bssmgl18")
	CombatCounter(0)
THEN
	RESPONSE #100
        SetInterrupt(FALSE)
		SetGlobal("bs_ReportSmugglersToSeatower","GLOBAL",7)
		CreateCreatureObjectOffset("bssmgl19",Player1,[10.5])
        SetInterrupt(TRUE)
END


