/* Chapter 7, before palace scene : PC is fugitive */
// spawn special guards
IF
    Global("Chapter","GLOBAL",%tutu_chapter_7%)
    Global("bs_Capture1000","MYAREA",0)
    Global("DukeThanks","GLOBAL",0)
    Global("ENDOFBG1","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("bs_Capture1000","MYAREA",1)
		CreateCreature("bsch7grd",[2779.1677],6) //guard in front of barracks
		CreateCreature("bsch7grd",[1981.1259],0) //guard left of treasury
		CreateCreature("bsch7grd",[1630.1227],0) //guard on pallisade west
		CreateCreature("bsch7grd",[4429.855],0) //guard on pallisade northeast
		CreateCreature("bsch7grd",[4615.1498],0) //guard on pallisade east
		CreateCreature("bsch7grd",[917.2309],0) //guard on pallisade southwest
END

// spawn FF Enforcers either for: PC did not reveal doppelgangers in the seatower, or: encounter with commander is done
IF
    Global("Chapter","GLOBAL",%tutu_chapter_7%)
    Global("bs_Capture1000","MYAREA",1)
    Global("DukeThanks","GLOBAL",0)
    Global("ENDOFBG1","GLOBAL",0)
	OR(2)
		Global("bs_CityKnowsBSTDoppel","GLOBAL",0) //PC didn't finish reveal doppelgangers in tower
		GlobalGT("bs_TowerArrestCh7","GLOBAL",1) //PC did help and already met commander once
THEN
    RESPONSE #100
        SetGlobal("Capture100","GLOBAL",2)
        CreateCreature("FFHUNT",[1964.1272],6)  // Flaming Fist Enforcer
        CreateCreature("FFHUNT",[1913.1327],6)  // Flaming Fist Enforcer
END


/* spawn Lenard: Missing Monk quest */
