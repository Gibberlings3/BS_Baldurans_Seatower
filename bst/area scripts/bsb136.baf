IF
	Global("bsSpawnSpiders","MYAREA",0)
THEN
	RESPONSE #100
		SetGlobal("bsSpawnSpiders","MYAREA",1)
		CreateCreature("bsspdr1a",[672.217],0) 
		CreateCreature("bsspdr2a",[749.312],0) 
		CreateCreature("bsspdr3a",[677.316],12)
END

IF
  Global("bsSpawnLens","MYAREA",0)
THEN
  RESPONSE #100
		ActionOverride("Shelf01",CreateItem("bslense1",0,0,0))
		SetGlobal("bsSpawnLens","MYAREA",1)
END