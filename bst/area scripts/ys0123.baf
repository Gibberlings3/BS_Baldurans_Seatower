/* place some trinkets */
IF
	Global("bs_PlaceLoot","MYAREA",0)
THEN
	RESPONSE #100
		ActionOverride("Barrel01",CreateItem("POTN29",1,0,0)) //Potion of Genius
		ActionOverride("Barrel01",CreateItem("MISC07",16,0,0)) //gold piece
		ActionOverride("Shelf01",CreateItem("Book41",0,0,0)) //Last March of the Giants
		ActionOverride("Shelf01",CreateItem("Book45",0,0,0)) //History of the North - Recent History of the North
		ActionOverride("Shelf01",CreateItem("SCRL3H",1,0,0)) //Protection From Evil
		SetGlobal("bs_PlaceLoot","MYAREA",1)
END
