
/* safety check: Fuller is alive after banning the King of the Dead */

IF
	Global("bsTalkedToRestlessDead","GLOBAL",10)
	GlobalGT("bsClearedCatacombs","GLOBAL",9)
	GlobalLT("bsClearedCatacombs","GLOBAL",13)
	!Dead("bsrsd07")
THEN
	RESPONSE #100
		SetGlobal("bsClearedCatacombs","GLOBAL",21)
END

/* spawn Fuller for "Dark Power in the Seatower Catacombs" quest */

IF
	Global("bs_SpawnFuller","MYAREA",0)
	OR(4)
		Global("bsClearedCatacombs","GLOBAL",18)
		Global("bsClearedCatacombs","GLOBAL",19)
		Global("bsClearedCatacombs","GLOBAL",20)
		Global("bsClearedCatacombs","GLOBAL",21)
	!Dead("bsrsd07")
THEN
	RESPONSE #100
		CreateCreature("bsrsd07",[1070.368],11)
		SetGlobal("bs_SpawnFuller","MYAREA",1)
END


/* spawn Gerrit for "Dark Power in the Seatower Catacombs" quest */

IF
	Global("bs_SpawnGerrit","MYAREA",0)
THEN
	RESPONSE #100
		CreateCreature("bsrsd01",[1047.355],11)
		SetGlobal("bs_SpawnGerrit","MYAREA",1)
END

/* spawn Nathoriel (Shuck's Brother) after he is free */

IF
	Global("bsShucksBrother","GLOBAL",5)
THEN
	RESPONSE #100
		CreateCreature("bsshckbr",[657.509],14)
		OpenDoor("DOOR0004")
		SetGlobal("bsShucksBrother","GLOBAL",6)
END

/* spawn Klaus after he was taken in by the monks */
IF
	Global("bsRabbitQuest","GLOBAL",9)
THEN
	RESPONSE #100
		SetGlobal("bsRabbitQuest","GLOBAL",10)
		CreateCreature("bstq004",[355.672],14)
		ActionOverride("bstq004",SetNumTimesTalkedTo(1))
END

/* spawn Ulf after he is free */

IF
	Global("bsFreedUlf","GLOBAL",1)
THEN
	RESPONSE #100
		CreateCreature("bsghast2",[370.711],14)
		SetGlobal("bsFreedUlf","GLOBAL",2)
END


/* Abbot heals */

IF
    Global("bsAbbotHeals","GLOBAL",3)
    Global("bsAbbotRDPlayer1","MYAREA",0)
    StateCheck(Player1,STATE_DEAD)
THEN
    RESPONSE #100
//        ActionOverride("bssatos",ReallyForceSpell(Player1,CLERIC_RAISE_DEAD))
        ActionOverride("bssatos",ReallyForceSpell(Player1,CLERIC_RESURRECTION))
        Wait(2)
        SetGlobal("bsAbbotRDPlayer1","MYAREA",1)
END

IF
    Global("bsAbbotHeals","GLOBAL",3)
    InPartyAllowDead(Player2)
    StateCheck(Player2,STATE_DEAD)
    Global("bsAbbotRDPlayer2","MYAREA",0)
THEN
    RESPONSE #100
        ActionOverride("bssatos",ReallyForceSpell(Player2,CLERIC_RESURRECTION))
        Wait(2)
        SetGlobal("bsAbbotRDPlayer2","MYAREA",1)
END

