/* reset checking of injured party members */
IF
 Global("bsAbbotHeals","GLOBAL",2)
 Global("bsAbbotOffersHealing","MYAREA",6)
THEN
	RESPONSE #100
		SetGlobal("bsAHP1","MYAREA",0)
		SetGlobal("bsAHP2","MYAREA",0)
		SetGlobal("bsAHP3","MYAREA",0)
		SetGlobal("bsAHP4","MYAREA",0)
		SetGlobal("bsAHP5","MYAREA",0)
		SetGlobal("bsAHP6","MYAREA",0)
		SetGlobal("bsAbbotOffersHealing","MYAREA",0)
		SetGlobal("bsAbbotHealingInjuryDetected","MYAREA",0)
		SetGlobal("bsAbbotHeals","GLOBAL",1)
END

/* check whether one party member is injured */
IF
 Global("bsAbbotHeals","GLOBAL",1)
OR(7)
 HPPercentLT(Player1,100)
 StateCheck(Player1,STATE_DEAD)
 StateCheck(Player1,CD_STATE_NOTVALID)
 !CheckStat(Player1, 0, LEVELDRAIN)
 StateCheck(Player1,STATE_BLIND)
 StateCheck(Player1,STATE_DISEASED)
 StateCheck(Player1,STATE_FEEBLEMINDED)
THEN
	RESPONSE #100
		SetGlobal("bsAbbotHeals","GLOBAL",2)
END

IF
 Global("bsAbbotHeals","GLOBAL",1)
