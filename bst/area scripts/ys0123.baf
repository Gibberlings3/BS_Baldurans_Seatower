        ActionOverride("bssatos",StartDialogueNoSet([PC]))
END


/* abbot offered to fully heal party once */

/* group is healthy: Global("bsAbbotOffersHealing","MYAREA",6)
*/
IF
 Global("bsAbbotHeals","GLOBAL",2)
 !HPPercentLT(Player1,100)
 !StateCheck(Player1,STATE_DEAD)
 !StateCheck(Player1,CD_STATE_NOTVALID)
 CheckStat(Player1, 0, LEVELDRAIN)
 !StateCheck(Player1,STATE_BLIND)
 !StateCheck(Player1,STATE_DISEASED)
 !StateCheck(Player1,STATE_FEEBLEMINDED)
 Global("bsAHP1","MYAREA",0)
THEN
	RESPONSE #100
		IncrementGlobal("bsAbbotOffersHealing","MYAREA",1)
		SetGlobal("bsAHP1","MYAREA",1)
END

