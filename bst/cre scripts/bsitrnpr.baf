/* add journal entry */
IF
    Global("bs_AskedHammer","LOCALS",9)
THEN
    RESPONSE #100
        EraseJournalEntry(@1002)
        AddJournalEntry(@1003,QUEST)
        SetGlobal("bs_AskedHammer","LOCALS",10)
END

/* after fight: heal */
IF
    !See([PC])
    !See([ENEMY])
    CombatCounter(0)
    HPLT(Myself,35)
THEN
    RESPONSE #100
        ApplySpellRES("SPIN711",Myself)
END


/* return to chapel */
IF
    !See([PC])
    !See([ENEMY])
    CombatCounter(0)
    StateCheck(Myself,STATE_NORMAL)
    !Range("Altar01",15)
THEN
    RESPONSE #100
        MoveToObject("Altar01")
END
