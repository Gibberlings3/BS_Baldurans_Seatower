/* override script of priest in bd0101, Old Temple Island */

/* use antidote if poisoned */
IF
    StateCheck(Myself,STATE_POISONED)
    !GlobalTimerNotExpired("bs_AntidoteTimer","LOCALS")
    HasItem("POTN20",Myself)  // Antidote
THEN
    RESPONSE #100
        UseItem("POTN20",Myself)  // Antidote
        SetGlobalTimer("bs_AntidoteTimer","LOCALS",ONE_ROUND)
END
