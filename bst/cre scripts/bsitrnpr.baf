/* initiate dialogue after cutscene */
IF
    See([PC])
    !Allegiance(Myself,ENEMY)
	Global("bs_LacedonQuest","MYAREA",2) //after 1st cutscene
THEN
    RESPONSE #100
        Dialogue([PC])
END

/* exchange weapons */
/* hammer */
IF
    Global("bs_AskedHammer","LOCALS",3)
    OR(6)
        See(Player1)
        See(Player2)
        See(Player3)
        See(Player4)
        See(Player5)
        See(Player6)
THEN
    RESPONSE #100
        SetInterrupt(FALSE)
        GiveItem("bsihammr",LastSeenBy(Myself))
        SetGlobal("bs_AskedHammer","LOCALS",9)
        TakePartyItemNum("HAMM01",1)
        FillSlot(SLOT_WEAPON)
        EquipItem("HAMM01")
        SetInterrupt(TRUE)
END
