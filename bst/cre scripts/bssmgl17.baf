/* override script of Crimmor Ambassador */

/* initiate dialogue */
IF
    See([PC])
    NumberOfTimesTalkedTo(0)
	!StateCheck(Myself,CD_STATE_NOTVALID)
    Allegiance(Myself,NEUTRAL)
THEN
    RESPONSE #100
        Dialogue([PC])
END

IF
    GlobalGT("bsSmugglerQuest","GLOBAL",24)
THEN
    RESPONSE #100
        EscapeAreaDestroy(5)
END

