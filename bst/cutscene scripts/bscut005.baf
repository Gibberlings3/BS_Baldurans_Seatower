IF
	True()
THEN
	RESPONSE #100
		CutSceneId(Player1)
		StorePartyLocations()
		ActionOverride("bstanner",MoveToPoint([413.330])) 
		ActionOverride("bstanner",ReallyForceSpellPointRES("bsdoppdr",[356.308]))
		SmallWait(7)
		FadeToColor([30.0],0)
		Wait(4)
		LeaveAreaLUAPanic("bs1000","",[3250.525],0)
		LeaveAreaLUA("bs1000","",[3250.525],0)
		ActionOverride(Player2,LeaveAreaLUA("bs1000","",[3250.525],0))
		ActionOverride(Player3,LeaveAreaLUA("bs1000","",[3250.525],0))
		ActionOverride(Player4,LeaveAreaLUA("bs1000","",[3250.525],0))
		ActionOverride(Player5,LeaveAreaLUA("bs1000","",[3250.525],0))
		ActionOverride(Player6,LeaveAreaLUA("bs1000","",[3250.525],0))
		MultiPlayerSync()
		CreateCreatureImpassable("cutspy",[4445.2167],12)
		Wait(1)
		MoveViewPoint([4678.1837],INSTANT)
		FadeFromColor([30.0],0)
		Wait(1)
		AmbientActivate("GreenSmoke",TRUE)
		Wait(1)
		ActionOverride("cutspy",DestroySelf())
		FadeToColor([30.0],0)
		CreateCreatureImpassable("cutspy",[3338.1767],0)
		SmallWait(7)
		ActionOverride("cutspy",ReallyForceSpellPointRES("bsdoppdr",[3535.1962]))
		Wait(1)
		MoveViewPoint([3535.1962],INSTANT)
		Wait(3)
		FadeFromColor([30.0],0)
		Wait(4)
		FadeToColor([30.0],0)
		Wait(1)
		ActionOverride("cutspy",DestroySelf())
		AmbientActivate("GreenSmoke",FALSE)
		RestorePartyLocations()
		MultiPlayerSync()
		FadeFromColor([30.0],0)
		SetInterrupt(TRUE)
		EndCutSceneMode()
		ActionOverride("bstanner",StartDialogNoSet([PC]))
END

