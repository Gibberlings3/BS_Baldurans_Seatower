// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Oh, äh, Ihr habt das versteckte Easter-Egg ausgelöst, also springe ich für alle Monster ein, denen Ihr hier begegnet. Tut einfach so, als wäre ich ein, ein, äh …~
@1 = ~Entschuldigung, was?~
@2 = ~Biff der Ersatzmann! Lange nicht mehr gesehen.~
@3 = ~Wollt Ihr mich auf den Arm nehmen?~
@4 = ~Nuuuuuun … nein?~
@5 = ~Ja, wie in den guten alten Zeiten, was?~
@6 = ~Ich bin irgendwie geblieben, nachdem ich eine provisorische Besetzung war … Ihr wisst schon, damit die Mission weitergehen kann, ohne jedes Detail umsetzen zu müssen. Keine Sorge, ich habe das schon mehrfach gemacht. Wie wäre es, wenn wir so tun, als wäre ich ein … ein Tana’ri! Ja, genau so. Ich bin ein Taaana’riii…~
@7 = ~Tana’ri sind schlecht. Es gibt einen jungen Nabassu direkt in diesem Verlies.~
@8 = ~Ach ja, richtig. Wie wäre es mit … einem Glabrezuuuu …~
@9 = ~Tut mir leid, Biff, aber es gibt auch eine davon unten bei der Meereshöhle.~
@10 = ~Richtig, richtig. Hmm, wie wäre es mit … wie wäre es mit einem Drachen?~
@11 = ~Ein Dra… EIN DRACHE?~
@12 = ~Das funktioniert so nicht, Biff.~
@13 = ~Wartet, Ihr habt recht. Mir wurde gesagt, das sei keine Option.~
@14 = ~Wie wäre es, wenn ich Euch einfach die Linsen gebe, die Ihr noch braucht? Wie viele wollt Ihr?~
@15 = ~… Alle?~
@16 = ~Biff, das dauert zu lange. Gebt uns einfach, was Ihr habt.~
@17 = ~Ich bedaure, dieses Easter-Egg gefunden zu haben. Besteht die Möglichkeit, dass Ihr die Monster, die hier sein sollten, wiederherstellt?~
@18 = ~Wartet! Bevor Ihr geht – was genau hat Euer Erscheinen ausgelöst?~
@19 = ~Gute Antwort!~
@20 = ~Es tut mir furchtbar leid, aber das ist nicht möglich, das übersteigt meine Gehaltsklasse! Ich gebe Euch einfach die Linsen und wir versuchen, die Sache zu vergessen.~
@21 = ~Wollt Ihr damit sagen, dass Ihr es wirklich nicht genau wisst? Also gut, es geht darum, die schwarze Linse einzusetzen, sie wieder herauszunehmen und nur die schwarze, aber keine klare Linse im Rucksack zu haben, wenn man durch eines der drei Bildportale geht. Die Entwickler dachten, das sei ungewöhnlich genug, um nicht versehentlich ausgelöst zu werden. Sie wollten nicht, dass jemand die vierte Wand durchbricht, ohne zu wissen, dass es sich um ein Easter-Egg handelt.~
@22 = ~Nun, es war schön, Euch zu treffen. Und was jetzt?~
@23 = ~Bitte sehr. Es ist übrigens möglich, dass Ihr jetzt zu viele habt. Man sollte meinen, sie würden sich die Zeit nehmen, die Skripte zuverlässiger zu schreiben … Ich werde jetzt gehen. Wahrscheinlich warte ich darauf, irgendwo ein Vorbild zu sein.~
@24 = ~Jetzt werde ich wieder niemand von Bedeutung mehr sein … Oh, Ihr meintet für EUCH. Nun, ich schätze, ich werde Euch einfach alle Linsen geben, die ich habe.~
