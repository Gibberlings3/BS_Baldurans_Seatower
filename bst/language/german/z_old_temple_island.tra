// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Sahuagin haben diese Stadt angegriffen. Sie haben ein heiliges Artefakt aus dem Tempel unserer Königin gestohlen! Ihr habt die Nachhut der entweihenden Kreaturen besiegt. Ihr seid auserwählt, sie zu verfolgen und die gestohlene Reliquie zurückzuholen!~
@1 = ~Wie bitte?~
@2 = ~Ich bin ganz Ohr.~
@3 = ~Ich glaube nicht, dass Ihr das Recht habt, mich für irgendetwas „auszuwählen“.~
@4 = ~Schön, dass Ihr Euch entschieden habt, JETZT mitzumachen!~
@5 = ~Schweigt! Ihr werdet zuhören!~
@6 = ~Die Sahuagin kamen durch ein Portal im unterirdischen Teich. Es handelte sich nicht um eine Wilde Jagd, sondern um einen gezielten Angriff. Sie hatten es auf den Tempel unserer Königin abgesehen, den Tempel dieser Stadt. Es war ein Angriff auf Baldurs Tor!~
@7 = ~Ich bin mir immer noch nicht sicher, was ich damit zu tun habe.~
@8 = ~Fahrt fort.~
@9 = ~Ein Angriff der Sahuagin auf die Stadt wäre schlimm. Aber warum erzählt Ihr mir das alles? Ihr solltet mit den Behörden sprechen.~
@10 = ~Werte Dame, vielleicht solltet Ihr Eure Rekrutierungsstandards überdenken. Ich hatte eine feindliche Konfrontation in Eurem Tempel, und jetzt wollt Ihr mich als Söldner?~ ~Werte Dame, vielleicht solltet Ihr Eure Rekrutierungsstandards überdenken. Ich hatte eine feindliche Konfrontation in Eurem Tempel, und jetzt wollt Ihr mich als Söldnerin?~
@11 = ~Warum fragt Ihr ausgerechnet mich?~
@12 = ~Sehe ich aus, als würde mich das interessieren?~
@13 = ~Pah, „Behörden“ … Der Tempel unserer Königin ist die einzige Autorität, der ich gehorche!~
@14 = ~Hier wart Ihr zur richtigen Zeit am richtigen Ort. Ihr habt die eindringenden Kreaturen besiegt. Ihr seid so gut geeignet wie jeder andere.~
@15 = ~Die Sahuagin haben unsere heilige Reliquie, den Zahn von Iakhovas, geschändet. Dies ist ein äußerst heiliges Artefakt, das schon länger bei uns ist, als die Stadt ihren jetzigen Namen trägt. Es fand seinen Weg zu uns durch den Gründer der Stadt, Balduran, der es uns als Zeichen der Gunst der Königin für seine Seereisen gab. Wenn der Zahn weg ist, wie wird dann wohl Umberlees Gunst für die Stadt aussehen?~
@16 = ~Nicht gut, wette ich. Gut, Ihr habt mein Interesse geweckt. Aber was jetzt?~
@17 = ~Ihr schiebt mir ernsthaft die Schuld für das Schicksal der ganzen Stadt zu, nicht wahr?~
@18 = ~Ein Zahn? Das soll doch wohl ein Scherz sein?~
@19 = ~Vielleicht wird es so aussehen wie das Schicksal, das Euch jetzt trifft, weil Ihr mich mit solchen Details belästigt habt. Ich habe kein Interesse daran, Eurem „Heiligen Zahn“ nachzugehen. Wie wäre es, wenn wir mal schauen, ob Eure Zähne alle fest sitzen, hm?~
@20 = ~Macht nicht lächerlich, was heilig ist! Der Zahn steht für Umberlees Macht und den Zorn derer, die unsere Königin enttäuschen und verletzen. Er ist ein Zeichen dafür, was mit denen geschehen wird, die den Namen unserer Herrin beschmutzen!~
@21 = ~Schön, Ihr habt mein Interesse geweckt. Und was jetzt?~
@22 = ~Und der wurde gestohlen. Hahaha, jetzt ist es noch mehr ein Zeichen für Eure „Macht“ – Ihr seid buchstäblich ZAHNLOS und wollt Euch darauf verlassen, dass die erste bewaffnete Person, die vorbeikommt, ihn zurückerobert.~
@23 = ~Stellt Eure Nützlichkeit für Umberlees Vorhaben nicht infrage! Aber ich werde Euch das Maul stopfen, wenn Ihr Euch weiterhin so respektlos verhaltet.~
@24 = ~Meine Dame, Ihr wollt meine Hilfe, also achtet auf Euren Tonfall!~
@25 = ~Ihr werdet dem Portal folgen und den Heiligen Zahn zurückholen!~
@26 = ~Gut, ich werde es tun.~
@27 = ~Vielleicht, aber nicht jetzt!~
@28 = ~Was wird meine Belohnung sein?~
@29 = ~Nein, das werde ich nicht tun. Versucht, mich davon abzuhalten, es nicht zu tun!~
@30 = ~Ich werde das ursprüngliche Portal schließen und eines öffnen, das in die Nähe des Ortes führt, an den die Kreaturen unsere heilige Reliquie gebracht haben.~
@31 = ~Eure Belohnung werden alle Schätze sein, die Ihr bei den Sahuagin findet! Behaltet alles, was Ihr wollt, aber bringt den Zahn zu uns!~
@32 = ~Mit anderen Worten: Ihr habt keine Belohnung für mich. (seufz) Gut, ich werde es tun.~
@33 = ~Es ist fertig. Ihr dürft eintreten. Holt Euch den Zahn, und das Portal wird Euch hierher zurückführen. Zögert Eure Abreise nicht zu lange hinaus, unsere Königin ist ungeduldig, und das wird Eure Aufgabe nur noch schwieriger machen. Und … sucht nicht nach Unterstützung für diese Aufgabe im Tempel, noch sprecht mit irgendjemandem darüber, oder der Zorn meiner Göttin wird Euch zerschmettern!~ [bsblank]
@34 = ~Worauf wartet Ihr noch? Folgt dem Portal und tut, was unsere Königin von Euch erwartet!~
@35 = ~Sagt mir zuerst, wohin das Portal mich bringen wird!~
@36 = ~Warum geht Ihr nicht selbst? Der Tempel verfügt doch sicher über die nötigen Mittel, um ein paar Sahuagin zu bekämpfen.~
@37 = ~Eure Königin, nicht meine.~
@38 = ~Ihr WISST, dass ich in Eurem Tempel Priesterinnen getötet habe, ja? Aber Ihr rekrutiert mich trotzdem für eine solch sinnvolle Mission?~
@39 = ~Äh, Portal … Wo genau?~
@40 = ~Ich habe meine Meinung geändert. Euer Zahn ist mir völlig egal. Ich werde ihn nicht zurückholen.~
@41 = ~Lebt wohl.~
@42 = ~Was habt Ihr nicht verstanden, als ich „Portal im unterirdischen Teich“ sagte? Es ist hier, direkt vor Euren Augen. Ihr werdet tauchen müssen, um es zu erreichen.~
@43 = ~Ihr werdet ihr ausgeliefert sein, also zeigt lieber Respekt!~
@44 = ~Ich muss Euch meine Beweggründe nicht verraten.~
@45 = ~Ihr wollt, dass ich durch ein unbekanntes Portal gehe und für Euch gegen Seeungeheuer kämpfe. Warum könnt Ihr nicht selbst gehen? Gibt es eine Art Interessenkonflikt in Bezug auf Umberlees Kinder?~
@46 = ~Habt Ihr Angst, selbst zu gehen?~
@47 = ~Wie auch immer. Lebt wohl.~
@48 = ~Die Sahuagin haben die Konfrontation gestartet, indem sie unseren Heiligen Zahn an sich genommen haben.~
@49 = ~Also GIBT es irgendeine Art von Einschränkung für Euch, sie zu verfolgen. Warum sollte es dann für mich sicher sein? Ich will Umberlees Zorn nicht mehr auf mich ziehen als Ihr!~
@50 = ~Glaubt Ihr, meine Königin sei so kleinlich, dass sie nicht sieht, wer Euch schickt?~
@51 = ~Ich habe keine Angst! Ihr seid Söldner, angeheuert, um die Wünsche der Königin zu erfüllen. Ärgert mich nicht weiter!~
@52 = ~Bringt den Zahn zurück, und Umberlee wird mit Euren Diensten nicht unzufrieden sein.~
@53 = ~Was nützt es Euch, wenn Ihr wisst, um welche abgelegene Insel es sich handelt? Na gut, wenn Ihr es unbedingt wissen wollt, es ist eine kleine Insel in den Mondseen.~
@54 = ~Ihr WISST, dass ich die Hohepriesterin in Eurem Tempel getötet habe, ja? Aber Ihr rekrutiert mich trotzdem für eine solch sinnvolle Mission?~
@55 = ~Die Königin gibt Euch die Chance, Euch zu rehabilitieren. Die Wiederbeschaffung des Zahns ist von äußerster Wichtigkeit.~
@56 = ~Ihr Schwachköpfe! Spürt den Zorn der Furienkönigin!~
@57 = ~Wir waren zu geduldig mit Euch! Spürt den Zorn der Furienkönigin!~
@58 = ~Hier sind sie!~
@59 = ~Ihr habt unsere Schwester getötet, also habt Ihr Euer Recht zu leben verwirkt. Ich werde den Heiligen Zahn an mich nehmen, nachdem ich Euch getötet habe.~
@60 = ~Ihr kehrt siegreich zurück! Übergebt das Relikt und erfüllt den Auftrag der Königin!~
@61 = ~Nun, um den Zahn zu finden, bin ich dort hingegangen, also hier habt Ihr ihn.~
@62 = ~Ihr habt mich angelogen! Der Zahn wurde den Sahuagin GEGEBEN als Zeichen verbündeter Kräfte und einer gegenseitigen Vereinbarung, dass die Sahuagin Baldurs Tor angreifen!~
@63 = ~Ihr habt schon andere Abenteurer auf die Suche nach dem Zahn geschickt! Die Sahuagin in der Meereshöhle gehörten nicht zu der Gruppe, die den Zahn tatsächlich genommen hat!~
@64 = ~An welchen Ort habt Ihr mich geschickt? Umberlees Zorn hat die Menschen getroffen, die sich in diesen Tempel gewagt hatten!~
@65 = ~Ups, ich habe es wohl verlegt.~
@66 = ~Mehr Worte sind nicht nötig. Ich habe beschlossen, Euch den Zahn nicht zu geben, also bedeutet das wohl, dass wir kämpfen.~
@67 = ~Ihr habt eine weise Wahl getroffen.~
@68 = ~Ich will keinen Ärger mit der Wasserkönigin, also lebt wohl.~
@69 = ~Ich habe außer meiner Aussage keine Beweise für Euren Verrat, also kommt Ihr mit mir und gesteht vor den Behörden der Stadt.~
@70 = ~Nicht so schnell. Ihr habt schon andere Abenteurer auf die Suche nach dem Zahn geschickt! Die Sahuagin in der Meereshöhle gehörten nicht zu der Gruppe, die den Zahn tatsächlich genommen hat!~
@71 = ~Wie könnt Ihr so töricht sein, Euch uns ohne die heilige Reliquie zu nähern?~
@72 = ~Ich werde sie mir holen.~
@73 = ~Tss. Und könnt Ihr diese kühne Behauptung beweisen?~
@74 = ~Ich habe noch keine Beweise für Euren Verrat, aber während ich den Zahn aufbewahre, könnt Ihr losmarschieren und bei den städtischen Behörden beichten.~
@75 = ~Ich habe den Zahn nicht dabei.~
@76 = ~Natürlich haben wir nicht nur eine Gruppe von Abenteurern geschickt. Glaubt Ihr, wir seien Dummköpfe?~
@77 = ~Hattet Ihr Angst? Und doch seid Ihr hier, zurück in einem Stück, also bis jetzt scheint Ihr alles richtig gemacht zu haben.~
@78 = ~Meine Geduld geht langsam zu Ende. Ihr habt den Zahn von Iakhovas zurückgebracht – wir werden ihn bekommen!~
@79 = ~Wir werden nichts dergleichen tun!~
@80 = ~A-hahaha! Ihr habt wirklich gedacht, das hätte funktioniert?~
@81 = ~Schwestern, unsere Arbeit hier ist getan. Dieses Ungeziefer ist unsere Mühe nicht wert.~
@82 = ~Der Heilige Zahn ist wieder unser! Ihr wart ein gehorsamer Diener, also werde ich Euer Leben verschonen.~ ~Der Heilige Zahn ist wieder unser! Ihr wart eine gehorsame Dienerin, also werde ich Euer Leben verschonen.~
@83 = ~Ihr habt die Rache der Wasserkönigin auf Euch gezogen!~
@84 = ~(Die Kreatur sagt etwas Aufgeregtes in Sahuagin-Sprache aus Pfeifen, Klicken und Knurren. Es ist offensichtlich, dass sie feindselig ist.)~
@85 = ~Ihr habt die Portalräume entweiht!~
@86 = ~Ihr habt die Portale zerstört. Denkt Ihr, das hat Euch weiche Landbewohner vor unseren Plänen bewahrt? Ihr Narr, alles was Ihr gewonnen habt, ist mehr Zeit. Wir werden mit Vielen kommen … Und Eure Stadt wird die erste sein, die fällt!~ ~Ihr habt die Portale zerstört. Denkt Ihr, das hat Euch weiche Landbewohner vor unseren Plänen bewahrt? Ihr Närrin, alles was Ihr gewonnen habt, ist mehr Zeit. Wir werden mit Vielen kommen … Und Eure Stadt wird die erste sein, die fällt!~
@87 = ~Ihr habt etwas gesehen, das Ihr nicht sehen solltet. Ihr habt Euren Landbewohnern mehr Zeit verschafft, indem Ihr unseren Architekten getötet habt. Wir respektieren Eure Stärke, also werdet Ihr lebendig hier rauskommen. Rührt nichts anderes an oder wir werden Euch wie das Ungeziefer vernichten, das Ihr seid!~
@88 = ~Ihr habt, weswegen Ihr gekommen seid. Es gibt keinen Grund für Euch, auf dieser Insel zu verweilen.~
@89 = ~Entscheidet Euch für eine Fraktion, die Ihr unterstützen wollt, und zwar schnell! Meine Geduld geht langsam zu Ende.~
@90 = ~(Die Kreatur streitet sich offensichtlich mit einem anderen Sahuagin. Sie sagt etwas in der Sahuagin-Sprache, nicht an Euch gerichtet.)~
@91 = ~Ihr seid hier fertig. Geht!~
@92 = ~Gibt es eine Chance, dass wir noch die Dienste des Tempels in Anspruch nehmen können?~
@93 = ~Ich werde bald weg sein.~
@94 = ~(Die Kreatur sagt etwas Aufgeregtes in Sahuagin-Sprache aus Pfeifen, Klicken und Knurren zur Sahuagin-Priesterin).~
@95 = ~(Die Kreatur spricht kurz mit dem ersten Sahuagin und wendet sich dann Euch zu.)~
@96 = ~Ich habe Sekolah angerufen, um diesen Wesen die Fähigkeit zu verleihen, unsere Sprache zu verstehen. Es sind intelligente Landkreaturen, wie wir sie bereits kennen, aber sie sehen anders aus als die, die sich in den Gängen verstecken. Sie scheinen gut bewaffnet zu sein und sind ein ernstzunehmender Gegner.~
@97 = ~Dann werden sie es verstehen, wenn ich ihnen sage, dass ich Ehre gewinne, wenn ich sie im Namen von Sekolah töte!~
@98 = ~Macht Euch nicht lächerlich, Frohxlto. Unser Disput muss Euch klar gemacht haben, dass Ihr für das, was Ihr vorhabt, Verbündete brauchen werdet. Einen Baron anzugreifen, der die heiligen Befehle von König Ixilthetocal ausführt, wird Euch nichts als Euren eigenen Tod bringen, also wägt die Möglichkeiten, die sich Euch durch das Auftauchen dieser Wesen bieten, weise ab.~
@99 = ~Ihr – kommt und redet mit mir, wenn Baron Frohxlto mit Euch fertig ist! Wenn keiner von Euch so primitiv ist, bei diesem ersten Treffen einen Kampf anzufangen, versteht sich.~
@100 = ~Ihr, Landbewohner! Priesterin Ilxigantl sagte, Ihr könntet mir von Nutzen sein. Warum seid Ihr hier?~ ~Ihr, Landbewohnerin! Priesterin Ilxigantl sagte, Ihr könntet mir von Nutzen sein. Warum seid Ihr hier?~
@101 = ~Ich bin hier, um eine Reliquie – eine Art Zahn – zurückzuholen. Euer Volk hat ihn aus einem Tempel in Umberlee entwendet.~
@102 = ~Kein Grund, viel zu reden. Ich schätze, ich töte Euch lieber einfach.~
@103 = ~Ihr seid auf der Suche nach dem Zahn? Ghrumshrtl hat ihn. Seine Anhänger nennen ihn den „Zahn des Einen, der mit Sekolah schwimmt“, und glauben, dass er Macht und die Gunst von Umberlee besitzt. Seit er mit ihm zurückgekommen ist, benehmen er und seine Anhänger sich, als wären sie Sekolahs Auserwählte.~
@104 = ~Es scheint, als hätten wir dasselbe Ziel, Landbewohner. Baron Ghrumshrtl hat den richtigen Weg aus den Augen verloren. Ich will ihn tot sehen, damit ich seinen Platz einnehmen kann. Priesterin Ilxigantl hat recht, ich kann ihn nicht selbst töten, ohne den König zu verärgern. Tötet Ghrumshrtl für mich und Ihr könnt mit dem Zahn von hier verschwinden.~ ~Es scheint, als hätten wir dasselbe Ziel, Landbewohnerin. Baron Ghrumshrtl hat den richtigen Weg aus den Augen verloren. Ich will ihn tot sehen, damit ich seinen Platz einnehmen kann. Priesterin Ilxigantl hat recht, ich kann ihn nicht selbst töten, ohne den König zu verärgern. Tötet Ghrumshrtl für mich und Ihr könnt mit dem Zahn von hier verschwinden.~
@105 = ~Wir haben eine Abmachung. Ich werde den anderen Baron für Euch töten.~
@106 = ~Wartet, also muss ich den anderen Baron wegen des Zahns gegenübertreten, weil er ihn mir wahrscheinlich nicht freiwillig geben wird, und Ihr werdet nicht angreifen und mich mit dem Zahn gehen lassen, wenn ich den Baron töte? Wir haben eine Abmachung!~
@107 = ~Was ist, wenn ich ablehne?~
@108 = ~Dann wird Euer eigener Wert der einer Jagdtrophäe sein, mit der ich Ghrumshrtls Gefolgsleute beeindrucken und zeigen kann, dass ich der bessere Anführer bin.~
@109 = ~Sollen wir kämpfen?~
@110 = ~Ich nehme das Angebot an. Ich werde den anderen Baron für Euch töten.~
@111 = ~Ihr habt die Schiffbrüchigen gejagt und sogar ein Kind entführt! Ich werde Euch auf der Stelle töten!~
@112 = ~Hört auf zu reden und zieht Eure Waffen!~
@113 = ~Ich werde auf Eure Schritte achten, Landbewohner. Versucht nicht, mich zum Narren zu halten!~ ~Ich werde auf Eure Schritte achten, Landbewohnerin. Versucht nicht, mich zum Narren zu halten!~
@114 = ~Ihr habt es geschafft. Unsere Abmachung steht.~
@115 = ~Verlasst diesen Ort dahin, von wo Ihr gekommen seid. Ich werde nicht länger bei Euch verweilen.~
@116 = ~Ich weiß, dass Ihr Euch mit Ghrumshrtl getroffen habt. Warum ist er noch am Leben?~
@117 = ~Ich warte darauf, dass Ihr Euren Vertrag einhaltet! Zögert nicht zu lange, ich muss die Herrschaft übernehmen, bevor der König die Geduld mit unserem Zögern verliert.~
@118 = ~Nicht so ungeduldig. Ich arbeite daran.~
@119 = ~Die Abmachung ist nichtig. Der andere Baron hatte ein besseres Angebot. Zieht Eure Waffen!~
@120 = ~Ich habe beschlossen, Euch trotzdem zu töten.~
@121 = ~(knurr)~
@122 = ~Ich brauche keine Waffen, um Euch zu töten, Weichling.~
@123 = ~Da seid Ihr ja. Lasst uns reden.~
@124 = ~Ihr habt noch eine Rechnung mit Baron Frohxlto offen. Glaubt Ihr, dass Ihr ihm zuvorkommen und Ghrumshrtl zur Rede stellen könnt?~
@125 = ~Das werden wir sehen. Warum wolltet Ihr mit mir reden?~
@126 = ~Ich denke auf jeden Fall, dass ich mit ihm fertigwerde, und auch Euch ausschalten kann. Kämpft!~
@127 = ~Ihr habt Baron Frohxlto getötet.~
@128 = ~Baron Frohxlto war weise genug Euch anzuheuern, damit Ihr Euch an seiner Stelle Baron Ghrumshrtl entgegenstellt.~
@129 = ~Es mag Euch widersprüchlich erscheinen, aber mein Hauptziel ist der Frieden unter den Arbeitern hier. Wir haben ein größeres Ziel zu erreichen. Es ist mir egal, unter wessen Aufsicht es beendet wird, aber dieser lächerliche Streit zwischen den beiden Baronen muss aufhören, so oder so.~
@130 = ~Sollte Baron Frohxlto Baron Ghrumshrtl mit seinen eigenen Klauen angreifen und töten, wird er selbst bestraft, und ich muss die Verantwortung dafür übernehmen, dass beide aus der Reihe getanzt sind. Das Gleiche gilt natürlich auch für Baron Ghrumshrtl, und so befinden sich die beiden Barone derzeit in einem Patt und versuchen, die Anhänger des anderen zu beeindrucken und zu sich zu locken, um die Oberhand zu gewinnen.~
@131 = ~Baron Ghrumshrtl hingegen hat sich von dem ablenken lassen, warum wir hier sind. Er hat eine alberne Wilde Jagd auf die Behausung von Euch Landwesen gestartet, um seine Anhänger zu erfreuen. Ich nehme an, das ist der Grund, warum Ihr hier seid. Ich SAGTE ihm, dass dies zu Komplikationen führen würde, aber er wollte nicht aufhören und argumentierte, dass er sich mit den Landlebewesen selbst verschworen habe, um die gewonnenen Schätze und Nahrung zu vermehren, was zu unserem Vorteil sein wird. Die Anwesenheit von Euch Landbewohnern bestärkt mich in meinen Zweifeln, dass eine solche organisierte Wilde Jagd nicht ihre eigenen Auswirkungen haben würde.~
@132 = ~Natürlich würde ich mir wünschen, dass sie alle ihr törichtes Verhalten beenden und mit voller Kapazität an unserer Aufgabe arbeiten, aber ich habe die Hoffnung verloren, dass sie zur Vernunft kommen werden. Wenn die Befriedung dieses Ortes bedeutet, dass eine Partei eliminiert werden muss, dann soll es so sein. Ihr wärt das Werkzeug, um dies zu ermöglichen, ohne den Zorn des Königs auf uns alle zu ziehen.~
@133 = ~Oder ist es Euer Ziel, uns alle zu vernichten?~
@134 = ~Ich habe mich auf einen Deal mit dem rebellischen Baron eingelassen, da ich den anderen Baron anscheinend sowieso töten muss, um das zu bekommen, wofür ich gekommen bin.~
@135 = ~Baron Ghrumshrtl begann, die Portale für Raubzüge an der Küste zu nutzen. Eine gewisse Anzahl von Schatzjagden ist zwar akzeptabel, aber er hat es mit dem Umfang und der Größenordnung inzwischen so übertrieben, dass unsere eigentliche Arbeit darunter leidet.~
@136 = ~Was die von ihm erwähnte Verschwörung angeht, so stellt Ihr diese Frage am besten Baron Ghrumshrtl selbst.~
@137 = ~Was meint Ihr damit, dass es Landbewohner anlockt? Waren es noch mehr, die wegen des Zahns gekommen sind?~
@138 = ~Was macht Ihr Sahuagins hier?~
@139 = ~Ich habe keine weiteren Fragen an Euch. Was nun?~
@140 = ~Ich habe beschlossen, Euch zu töten. Kämpft!~
@141 = ~Ihr seid nicht die Ersten, aber Ihr scheint die Mächtigsten zu sein.~
@142 = ~Nichts, womit wir nicht umgehen könnten, aber es wird langsam langweilig. Wenn das so weitergeht, wird der König auf uns aufmerksam werden.~
@143 = ~Wilde Jagd, aber in Zusammenarbeit mit Leuten aus Baldurs Tor? Was meint Ihr damit?~
@144 = ~Wir machen diesen verlassenen Ort zu einem heiligen Tempel, einer heiligen Enklave. Sekolah wird uns wohlwollend zulächeln. Das geht Euch nichts an, Ihr Landbewohner.~
@145 = ~Ihr seid also einer derjenigen, die gekommen sind, um den Zahn von Iakhovas zu holen. Aha, ich verstehe. Baron Ghrumshrtl und seine Gefolgsleute sehen darin eine Bestätigung für unser Ziel an diesem Ort, während Baron Frohxlto die Idee verachtet, nur weil Ghrumshrtl sie schätzt. Ich selbst bin bereit, mich von ihm zu trennen. Es lockt zu viele Landbewohner an, und wenn es den Frieden zwischen uns wiederherstellt, umso besser.~ ~Ihr seid also eine diejenigen, die gekommen sind, um den Zahn von Iakhovas zu holen. Aha, ich verstehe. Baron Ghrumshrtl und seine Gefolgsleute sehen darin eine Bestätigung für unser Ziel an diesem Ort, während Baron Frohxlto die Idee verachtet, nur weil Ghrumshrtl sie schätzt. Ich selbst bin bereit, mich von ihm zu trennen. Es lockt zu viele Landbewohner an, und wenn es den Frieden zwischen uns wiederherstellt, umso besser.~
@146 = ~Weshalb seid Ihr hierher gekommen?~
@147 = ~Ihr habt also zugestimmt, Baron Ghrumshrtl zu töten, und Baron Frohxlto wird Euch den Zahn dafür überlassen. Aha, ich verstehe. Ja, das ist sicherlich eine Möglichkeit, wie das ablaufen könnte. Ich habe aber einen anderen Vorschlag.~
@148 = ~Ich habe einen Vorschlag.~
@149 = ~Ich werde zu Baron Ghrumshrtl gehen und ihn davon überzeugen, dass er seine Wilden Jagden einstellen muss, bevor er den Zorn unseres Königs provoziert. Ich werde ihm klarmachen, dass andernfalls das Auftauchen von Landbewohnern nur zunehmen wird, was unsere Mission gefährden WIRD. Ich werde ihn dazu bringen, Euch den Zahn zu geben, als Zeichen dafür, dass er wirklich zur Vernunft gekommen ist.~
@150 = ~Ich erwarte nicht, dass Baron Ghrumshrtl ohne eine Gegenleistung nachgibt. Er wird höchstwahrscheinlich erwarten, dass Ihr im Gegenzug Baron Frohxlto für ihn tötet.~
@151 = ~Ihr habt bereits die Rebellen für ihn getötet – das wird Euer Druckmittel für diese Verhandlungen sein. Es muss nicht noch mehr Blutsauger geben.~
@152 = ~Warum solltet Ihr das tun?~
@153 = ~Gut, ich werde mit Eurem Baron sprechen.~
@154 = ~Wie ich sehe, habt Ihr beschlossen, Baron Ghrumshrtl zu töten. Nun gut, so sei es. Es mag Euch widersprüchlich erscheinen, aber mein Hauptziel ist der Frieden unter den Arbeitern hier. Wir haben ein größeres Ziel zu erreichen. Baron Frohxlto ist jetzt unser Baron. Ich werde in die Quartiere hinuntergehen. Holt Euch die versprochene Belohnung ab und verlasst diesen Ort!~
@155 = ~So soll es sein. Baron Ghrumshrtl befindet sich auf der unteren Ebene. Ich werde in einem der Quartiere im Erdgeschoss sein, falls Ihr die Dienste des Haigotts benötigen solltet. Solange Ihr für einen der Barone arbeitet, wäre ich bereit, dafür zu sorgen, dass Eure körperliche Verfassung es zulässt.~
@156 = ~Trefft eine Wahl.~
@157 = ~Wie ich schon sagte, möchte ich, dass die Arbeiter so schnell wie möglich zu ihren Pflichten zurückkehren.~
@158 = ~Die Beibehaltung des derzeitigen Anführers wird so wenig Aufsehen wie möglich erregen, daher ist sie vorzuziehen.~
@159 = ~Aber Baron Ghrumshrtl muss von seinen albernen Nebenbeschäftigungen loslassen. Ihr werdet das Werkzeug sein, dessen bloße Anwesenheit mir helfen wird, ihn wieder unter Kontrolle zu bringen.~
@160 = ~Eure Wahl ist unklug, Landkreatur, aber so soll es sein.~
@161 = ~Braucht Ihr die Dienste von Vater Hai?~
@162 = ~Ja, zeigt mir, was Ihr anzubieten habt.~
@163 = ~Nicht jetzt.~
@164 = ~Ihr müsst die Landbewohner sein, von denen Priesterin Ilxigantl sprach. Die Priesterin hat Euch Sekolahs Segen gegeben, unsere Sprache zu verstehen, also werde ich zuhören. Sagt mir, warum Ihr hier seid.~
@165 = ~Ich bin wegen des Zahns aus dem Tempel von Umberlee hergekommen.~
@166 = ~Zunächst eine Frage. Stimmt es, dass Ihr das Zahnrelikt erhalten habt? Ich wurde hierher geschickt, um es zu holen, in der Annahme, dass es gestohlen wurde.~
@167 = ~Wie wäre es, wenn wir einfach kämpfen?~
@168 = ~Ich werde keine Geschäfte mit Kreaturen machen, die uns als Nahrung sehen!~
@169 = ~Ich habe zugestimmt, Euch für den anderen Baron zu töten. Es gibt keinen Grund mehr zu reden.~
@170 = ~Ich würde es begrüßen, Euch zu bekämpfen, Eindringlinge in unser Reich. Aber unsere Priesterin hat große Schmerzen auf sich genommen, um sicherzustellen, dass wir reden. Also redet!~
@171 = ~Ich bin wegen des Zahns hier, den Ihr aus dem Tempel von Umberlee genommen habt.~
@172 = ~Nein, wir kämpfen.~
@173 = ~Schreckliche Landkreaturen! Priesterin Ilxigantl hat also die Wahrheit gesagt, dass Ihr hier seid, um ihn zurückzuholen. Wer hat Euch geschickt?~
@174 = ~Warum nennt Ihr mich heimtückisch? Mir wurde gesagt, Ihr hättet den Zahn aus dem Tempel gestohlen.~
@175 = ~Der Tempel von Umberlee.~
@176 = ~Eine Priesterin von Umberlee.~
@177 = ~Was macht das schon? Ihr habt ihn gestohlen, ich werde ihn zurückholen.~
@178 = ~Was spielt das für eine Rolle?~
@179 = ~Ich bin kein Dieb! Ihr meint, weil ich Euch Landbewohnern meine Schätze und Trophäen abnehme? Der Zahn gehört nicht dazu.~
@180 = ~Der Tempel, sagt Ihr? Also, erst reden sie über Vereinbarungen, dann schicken sie Söldner?~
@181 = ~Eine Priesterin, sagt Ihr? Spricht sie nicht für ihren Tempel? Erst reden sie über Vereinbarungen, dann schicken sie Söldner!~
@182 = ~Der Zahn des Einen, der mit Sekolah schwimmt, ist ein Pfand für unsere Vereinbarung. Wir jagen in der Stadt der unterirdischen Flüsse, und der Tempel mischt sich nicht ein! Ihr seid derjenige, der ihn zurückhaben will – das ist Hausfriedensbruch!~ ~Der Zahn des Einen, der mit Sekolah schwimmt, ist ein Pfand für unsere Vereinbarung. Wir jagen in der Stadt der unterirdischen Flüsse, und der Tempel mischt sich nicht ein! Ihr seid diejenige, die ihn zurückhaben will – das ist Hausfriedensbruch!~
@183 = ~Wartet, wollt Ihr damit sagen, dass der Tempel von Umberlee eine Vereinbarung mit Euch getroffen hat, um in Baldurs Tor auf Raubzüge gehen zu können?~
@184 = ~Ich glaube Euch nicht. Ihr versucht, mich zu manipulieren, damit ich meine Mission aufgebe!~
@185 = ~Es ist nicht mehr von Bedeutung. Priesterin Ilxigantl bewies Weisheit mit ihren Warnungen, dass Landkreaturen kommen und unsere Mission gefährden werden. Ich wollte meinem Volk die Möglichkeit geben, sich zu vergnügen und mehr Wertgegenstände und Nahrung zu gewinnen, um unsere Arbeit hier voranzutreiben. Aber Eure Einmischung hat mir die Augen geöffnet. Ich brauche weder den Zahn des Einen, der mit Sekolah schwimmt, noch eine Vereinbarung mit den Priesterinnen von Umberlee, um das zu erreichen.~
@186 = ~Ich könnte Euch töten und mit der Sache durch sein, aber Priesterin Ilxigantl hat mich davon überzeugt, dass Ihr zu meinem Vorteil sein könnt, und ich stimme zu, dass der Nutzen den Verlust des Heiligen Zahns überwiegt. Tötet den Rebellenbaron für mich, und ich lasse Euch mit dem Zahn von der Insel ziehen.~
@187 = ~Gut, ich werde das für Euch tun.~
@188 = ~Nun, er ist bereits tot.~
@189 = ~Nein. Ich habe zugestimmt, Euch für den anderen Baron zu töten, und ich habe mich entschieden, diese Vereinbarung einzuhalten.~
@190 = ~Lasst mich darüber nachdenken.~
@191 = ~Wisst Ihr was? Wir haben geredet, jetzt lasst uns kämpfen.~
@192 = ~Nein, kein „darüber nachdenken“. Entweder wir kämpfen jetzt oder Ihr nehmt mein Angebot an!~
@193 = ~Eine gute Wahl.~
@194 = ~Bringt mir den Kopf des Barons!~
@195 = ~So soll es also sein. Wir werden kämpfen!~
@196 = ~Ich hörte, Ihr habt die Rebellen getötet. Ich werde unsere Abmachung einhalten.~
@197 = ~Hier ist der Zahn.~
@198 = ~Gebt ihn den Priesterinnen der Launischen Königin und sagt ihnen, dass unsere Abmachung vorbei ist – und dass wir den Verrat nicht vergessen werden. Wenn wir das nächste Mal in Eure Stadt der Steine kommen, werden wir mit vielen kommen und niemanden verschonen.~
@199 = ~Geht!~
@200 = ~Aber der Zahn ist weg – Ihr habt ihn gestohlen! Aber es spielt keine Rolle, Ihr habt getan, was wir vereinbart haben und habt Eure Belohnung.~
@201 = ~Halt! Ihr habt keine Erlaubnis hier einzutreten. Geht nicht weiter oder wir werden Euch mit Gewalt aufhalten.~
@202 = ~Geht weg von den Türen!~
@203 = ~Sprecht mit Baron Ghrumshrtl, nicht mit uns.~
@204 = ~Sprecht mit der Priesterin, nicht mit mir.~
@205 = ~Eindringling!~
@206 = ~Ich beobachte Euch.~
@207 = ~Sprecht mit Baron Frohxlto, nicht mit mir.~
@208 = ~Benehmt Euch!~
@209 = ~Redet mit Baron Ghrumshrtl, nicht mit mir.~
@210 = ~Ich habe hier ein Relikt des Tempels von Umberlee und möchte Euch bitten es zurückzugeben. Ich habe es für sie geholt, aber es gab ein … Missverständnis, als ich es abgeben wollte.~
@211 = ~Ich verstehe. Ich danke Euch, mein Kind. Auch wenn die Kirchen nicht immer einer Meinung sind, gehört es zur Höflichkeit, heilige Reliquien zu respektieren. Wir werden für ihre sichere Rückgabe sorgen.~
@212 = ~[female Talos priestess]Ich hörte, Ihr habt Euch gegen den Verkauf des Zahns von Iakhovas an uns entschieden. Ihr habt eine gute Gelegenheit verpasst, dem Gott der Stürme zu gefallen. Es hat keinen Sinn, Euch jetzt zu töten. Mein Gott wird einen besseren Plan für Euch haben.~
@213 = ~[female Talos priestess]Grüße, <CHARNAME>. Ja, ich weiß, wer Ihr seid. Lasst uns nicht auf Dinge eingehen, die in der jüngsten Vergangenheit passiert sein könnten. Ich bin Priesterin von Talos, und komme auf Euch zu, weil wir wissen, dass Ihr eine Reliquie bei Euch habt, die dem verfluchten Tempel der Launischen Königin heilig ist. Wir haben ein ureigenes Interesse daran, diesen Gegenstand zu erwerben, und bieten Euch eine große Summe Gold. Wärt Ihr bereit, Euch davon für uns zu trennen?~
@214 = ~Ihr wollt den Zahn von Iakhovas?~
@215 = ~[female Talos priestess]Das ist in der Tat korrekt.~
@216 = ~Ich bin ganz Ohr.~
@217 = ~Und warum sollte ich ihn Euch geben?~
@218 = ~Das Ding an die Kirche des Gottes übergeben, mit dem Umberlee im Streit liegt? Denkt Ihr, ich sei verrückt?~
@219 = ~Wie wäre es, wenn ich Euch stattdessen einfach töte?~
@220 = ~[female Talos priestess]Wir werden Euch mit 4.000 Gold dafür belohnen, zusätzlich zu dieser Schriftrolle „Eissturm“ … und dem Dank Talos.~
@221 = ~Und wenn ich nein sage?~
@222 = ~Darf ich darüber nachdenken?~
@223 = ~Nein, danke. Ich möchte Umberlee nicht noch mehr verärgern, als ich es ohnehin schon getan habe.~
@224 = ~Ich würde Euch gerne das Zahnrelikt verkaufen, aber ich habe es gerade nicht bei mir.~
@225 = ~Ja, ich möchte den Gott der Stürme zufriedenstellen. Hier ist er.~
@226 = ~4.000 Gold sind in der Tat unglaublich. Lasst es mindestens 5.000 sein und das Relikt gehört Euch.~
@227 = ~[female Talos priestess]Ihr könntet Umberlee verärgern, aber was würde das schon ausmachen, wenn es die Gunst des Gottes der Stürme sichert?~
@228 = ~[female Talos priestess]Dann würde ich versuchen, Euch ein weiteres Mal zu überzeugen. Seid Euch bewusst, dass ich diese Gelegenheit nicht so einfach verstreichen lassen werde.~
@229 = ~[female Talos priestess]Wie lautet Eure Entscheidung?~
@230 = ~Ich sagte nein.~
@231 = ~[female Talos priestess]Ich ahnte schon, dass es ein Fehler sein würde, Euch nett zu bitten. Sieht so aus, als müsste ich Euch das Relikt aus Euren toten Händen nehmen.~
@232 = ~[female Talos priestess]5.000 sinds.~
@233 = ~[female Talos priestess]Ich glaube, dass Ihr wisst, wann Ihr Eure Karten ausspielen müsst, um Euch die Gunst des wichtigsten und mächtigsten Gottes in diesen Reichen zu sichern.~
@234 = ~[female Talos priestess]Kommt zu mir in die Taverne Elfgesang, wenn Ihr bereit seid, mir das Zahnrelikt zu verkaufen.~
@235 = ~[female Talos priestess]Auf keinen Fall. Ich glaube, dass Ihr wisst, wann Ihr Eure Karten ausspielen müsst, um Euch die Gunst des wichtigsten und mächtigsten Gottes in diesen Reichen zu sichern.~
@236 = ~[female Talos priestess]Seid gegrüßt, <CHARNAME>. Seid Ihr bezüglich des Zahns zu einer Entscheidung gelangt?~
@237 = ~Ich habe mich noch nicht entschieden.~
@238 = ~[female Talos priestess]Wartet nicht zu lange.~
@239 = ~[female Talos priestess]Ihr habt eine ausgezeichnete Gelegenheit ergriffen, den Gott der Stürme zu ehren. Lebt wohl.~
@240 = ~Ich habe gehört, dass Sahuagin eine Reliquie aus deinem Tempel gestohlen haben. Die Priesterin von Umberlee, die mich gebeten hat sie zurückzubekommen, wollte Euch das nicht sagen. Wisst Ihr überhaupt davon?~
@241 = ~Ich habe hier den Zahn des Iakhovas – eine heilige Reliquie Eures Tempels.~
@242 = ~Ich habe Beweise, dass einige Eurer Priesterinnen an einer Intrige gegen die Stadt beteiligt waren.~
@243 = ~Ihr habt unseren heiligen Zahn in Besitz – und Ihr habt unsere Schwestern dafür getötet!~
@244 = ~Hmpf. Gebt ihn sofort her oder spürt den Zorn der Wasserkönigin!~
@245 = ~Ja, das ist der Grund, warum ich hier bin. Nehmt ihn. Ich mag hier und da kleine Intrigen. Kein Grund, unfreundlich zu werden.~
@246 = ~Nicht so schnell. Ich glaube, es sollte Euch etwas wert sein, wenn ich ihn Euch gebe, meint Ihr nicht? Ich bin sicher, die Stadtverwaltung wäre auch sehr daran interessiert.~
@247 = ~Was? Dachtet Ihr, ich würde ihn Euch einfach überlassen? Ich will Euch nur wissen lassen, dass ich etwas gegen Euch in der Hand habe, sodass Ihr es Euch besser merken könnt.~
@248 = ~Der Zahn von Iakhovas?! Wenn Ihr diesen Beweis erhalten habt, müsst Ihr auch unsere heilige Reliquie erworben haben. Gebt sie sofort her!~
@249 = ~Es ist nur logisch, dass ich Euch auch Euer Relikt gebe. Hier ist es.~
@250 = ~Ich habe ihn nicht.~
@251 = ~Wie wäre es mit einer Belohnung? Das Relikt sollte Euch etwas wert sein, meint Ihr nicht?~
@252 = ~Der heilige Zahn – der Zahn von Iakhovas – sollte bei meinen Schwestern sein. Wenn sie Euch gesagt haben, dass Ihr ihn zurückholen sollt, worauf wartet Ihr dann noch? Holt ihn sofort zurück!~
@253 = ~Mit anderen Worten: Ihr hattet keine Ahnung.~
@254 = ~Ja, das werde ich.~
@255 = ~Achtet auf Eure Worte! Die Königin der Tiefe duldet keine Unverschämtheiten.~
@256 = ~Ihr WAGT es, solche Worte in diesen Hallen zu sprechen?~
@257 = ~Ihr WAGT es, mit leeren Händen hierherzukommen?~
@258 = ~Ihr habt heute eine weise Entscheidung getroffen. Die Furienkönigin wird Euch Eure Sünden vergeben – dieses Mal. Geht jetzt und belästigt mich nicht noch einmal!~
@259 = ~Unsere Schwestern wurden getötet, und Ihr seid es, der den Zahn hat!~ ~Unsere Schwestern wurden getötet, und Ihr seid es, die den Zahn hat!~
@260 = ~Nun, Eure Schwestern waren Teil einer Intrige … gegen Euch selbst, wie es scheint.~
@261 = ~Ja, und wenn Ihr ihn wollt, solltet Ihr ihn schnell nehmen, damit ich mich nicht anders entscheide.~
@262 = ~Sie waren nicht gerade kooperativ. Seid froh, dass ich es nicht an Euch auslasse.~
@263 = ~Kühne Behauptung. Zeigt mir die Beweise für Eure Behauptung!~
@264 = ~Hier wird der Zahn von Iakhovas erwähnt. Wenn es zusammengehört, müsst Ihr auch unsere heilige Reliquie erworben haben. Gebt sie mir sofort!~
@265 = ~Was immer Ihr gehört oder gesehen habt, Umberlee wird es auch sehen und hören! Ihr Zorn wird grenzenlos sein gegen jeden, der ihr Unrecht getan hat. Wenn meine Schwestern Euch gebeten haben, unsere heilige Reliquie zurückzubringen, worauf wartet Ihr dann noch?~ ~Was immer Ihr gehört oder gesehen habt, Umberlee wird es auch sehen und hören! Ihr Zorn wird grenzenlos sein gegen jede, die ihr Unrecht getan hat. Wenn meine Schwestern Euch gebeten haben, unsere heilige Reliquie zurückzubringen, worauf wartet Ihr dann noch?~
@266 = ~Ich bin dabei.~
@267 = ~Ihr habt unsere heilige Reliquie VERLOREN und seid trotzdem hierhergekommen in der Hoffnung, Ihr würdet lebendig wieder herauskommen?~
@268 = ~Es ist weise, der Wasserkönigin gegenüber gehorsam zu sein. Geht jetzt!~
@269 = ~Geht, jetzt!~
@270 = ~Warum ist das wichtig für Euch? Eure Priesterin sagte, Ihr würdet mich gebrauchen können. Was wollt Ihr?~
@271 = ~Es ist wichtig, um zu entscheiden, ob ich Euch vernichten oder mir zunutze machen soll. Ihr seid aus einem bestimmten Grund hierhergekommen. Nennt ihn und er könnte Eure Belohnung sein, wenn Ihr für mich arbeitet.~
