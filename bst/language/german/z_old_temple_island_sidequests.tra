// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Habt Ihr sie gesehen? Sie zeigt sich nur für kurze Zeiträume. Aber sie war hier! Das war sie! Wo ist mein Notizbuch? Habt Ihr mein Notizbuch gesehen?~
@1 = ~Ist dies das Notizbuch, das Ihr gesucht habt? Es lag auf Eurem Schreibtisch.~
@2 = ~Wer seid Ihr?~
@3 = ~Was ist das für ein Ort?~
@4 = ~Was treibt Euch in den Wahnsinn?~
@5 = ~Ich meinte die alten Tempelruinen.~
@6 = ~Ich werde nach Eurem Notizbuch suchen gehen.~
@7 = ~Ich überlasse Euch jetzt Eurer Arbeit.~
@8 = ~Ja, ja … nicht dass ich viel machen würde, da sie sich immer versteckt und mein Notizbuch fehlt!~
@9 = ~Ja, danke.~
@10 = ~Ich bin froh, das zu hören.~
@11 = ~Wer ich bin? Ich? Ihr seid seltsam, in mein Haus zu kommen und mich zu fragen, wer ich bin. Nun, mein Name ist Theome, aber ich schätze, ich bin jetzt eine alte Einsiedlerin, die vor sich hin murmelt, oder? Wartet nur, bis Ihr mein Alter erreicht habt und auf einer einsamen Insel gestrandet seid! Wartet, Ihr SEID auf einer abgelegenen Insel gestrandet.~
@12 = ~Hmm, aber als der <PRO_RACE>, der Ihr seid, bin ich mir nicht sicher, ob Ihr tatsächlich mein Alter erreichen werdet. Nun, ist das nicht traurig?~
@13 = ~Ihr könnt Euch hier gerne ausruhen. Ich bin es gewohnt, obwohl schon länger niemand mehr hier war. Und … ich bewohne vielleicht diese Bibliothek, aber es ist nicht so, dass sie MIR gehören würde.~
@14 = ~Wisst Ihr, wo wir sind?~
@15 = ~Nun, das ist eine Bibliothek, oder war es zumindest. Ist das nicht offensichtlich?~
@16 = ~Findet Ihr das lustig?~
@17 = ~Was meint Ihr mit „lustig“? Sehe ich aus, als würde ich Spaß haben? Das Ding macht mich wahnsinnig und ich verliere ständig mein Notizbuch!~
@18 = ~Nun, die Ratte! Habt Ihr sie nicht gesehen? Bösartige kleine Kreatur! Sie knabbert an meinen Notizen und reißt manchmal sogar ganze Seiten weg, um ihr Nest zu stopfen. Nicht Nest, es ist kein Vogel. Ihr wisst schon, ihr Rattennest!~
@19 = ~Ah, die Tempelruinen. Ich habe ein paar alte Inschriften gefunden, ein paar Hinweise und Anhaltspunkte. Der Name dieser Insel ist „Alte Tempelinsel“, aber man hat vergessen, wer hier verehrt wurde, und vielleicht ist es auch nicht mehr wichtig. So ein Ort der Leere, der Verlassenheit und der Verzweiflung! Nun, sie ist nicht mehr verlassen, denn die Sahuagin haben sie für ihre bösartigen Absichten entdeckt. Und es ist auch nicht gerade leer, mit all den Leuten, die draußen und unten herumlaufen … und drinnen! Ihr seid allerdings die ersten Leute, die seit einiger Zeit die Bibliothek betreten haben. Ich schätze, ich habe sie verscheucht, heh.~
@20 = ~Nun, wir sind auf einer Insel … Seht mich nicht so an, ich war noch nicht fertig … Wir sind auf einer Insel im Korinn-Archipel nördlich der Mondscheinsee, die „Alte Tempelinsel“ heißt. Ich könnte sie Euch auf einer Karte zeigen, aber ich habe keine bei mir.~
@21 = ~Das würde ich zu schätzen wissen. Sehr zu schätzen wissen! Da steht eigentlich nichts drin. Aber ich brauche die leeren Seiten, um Dinge aufzuschreiben! Ich habe keine Ahnung, wo ich es gelassen habe. Es könnte hier in der Bibliothek sein, vielleicht irgendwo zwischen den Büchern? Oder ich habe es verloren, als ich in die Tempelruinen hinuntergegangen bin. Oder draußen? Ah, ich werde alt. Nein, ich BIN alt. Nun, Ihr geht und sucht danach.~
@22 = ~Ah … ja, das ist mein Notizbuch. Auf meinem Schreibtisch? Na so was. Kein Wunder, dass ich es nicht gefunden habe! Wer hätte gedacht, dass es auf meinem Schreibtisch liegt? Ich danke Euch vielmals. Ich schulde Euch einen Gefallen, junger Mann.~ ~Ah … ja, das ist mein Notizbuch. Auf meinem Schreibtisch? Na so was. Kein Wunder, dass ich es nicht gefunden habe! Wer hätte gedacht, dass es auf meinem Schreibtisch liegt? Ich danke Euch vielmals. Ich schulde Euch einen Gefallen, junge Frau.~
@23 = ~Da! Die Ratte! Habt Ihr sie gesehen? Sie versteckt sich immer, verfluchte Kreatur.~ [bsblank]
@24 = ~Es gibt Piraten da draußen, die behaupten, Ihr hättet einen der Ihren in ein Eichhörnchen verwandelt.~
@25 = ~Kann ich Euch irgendwie mit dieser Ratte helfen?~
@26 = ~Ich habe hier etwas Käse …~
@27 = ~Wie seid Ihr hier gelandet?~
@28 = ~Könnt Ihr mir mehr über diese Ruinen erzählen?~
@29 = ~Ihr habt die Sahuagin unten bemerkt, richtig? Wisst Ihr, was sie vorhaben?~
@30 = ~Könnt Ihr mir mehr über die Sahuagin erzählen?~
@31 = ~Ich bin dabei.~
@32 = ~Habt Ihr etwas zu verkaufen?~
@33 = ~Käse! Diese Kreaturen mögen bestimmt Käse, nicht wahr? Legt Ihn irgendwo in die Nähe der Regale. Ich bin sicher, sie wird herauskommen, um ihn zu holen. Nicht AUF die Regale, wohlgemerkt. Wir wollen ja nicht, dass die Bücher obendrein nach Käse riechen!~
@34 = ~Wenn Ihr es schafft, sie zu töten … und mir ist egal, wie! Aber sie ist sehr scheu. Wenn ich etwas hätte, um sie anzulocken … Ihr wisst schon, etwas, das sie gerne isst, vielleicht. Was fressen Ratten? Käse, Früchte, Nüsse? Manchmal habe ich den Eindruck, dass DIESE Ratte von Papier lebt, ha! Oh, und zögert nicht, hier drinnen Feuer zu machen. Es ist überall so feucht, feucht und kalt, kalt, kalt. Solange Ihr mich nicht mit irgendwelchen Zaubern bombardiert, macht mir das nichts aus. Tötet die Ratte und ich gebe Euch meinen wertvollsten magischen Gegenstand. So viel ist mir das wert.~
@35 = ~Ihr wollt es wirklich wissen? Es ist ein winziges bisschen peinlich. Für mich, meine ich. Ich habe versucht, mich nach Calimshan zu teleportieren, als ich bemerkte, dass meine Versuche an einen bestimmten Ort gezogen wurden, und nur an einen Ort. Ich habe verzweifelt versucht, dem Ort zu entkommen, zu dem ich gezogen wurde, und bin stattdessen hier gelandet. Das ist nicht der peinliche Teil. Dass ich es geschafft habe, dem Ziehen zu entkommen, ist etwas, worauf ich ziemlich stolz bin. Der Versuch, per Teleportation über eine so große Entfernung zu reisen, war töricht. Offenbar gibt es für Magier, die das tun, eine Falle, von der ich nichts wusste – was Sinn ergibt, denn sonst wäre es ja keine Falle mehr, oder? Ich habe keine Lust zu versuchen, wo ich landen würde, wie Ihr Euch vorstellen könnt, denn … es ist offensichtlich eine Falle. Und ich will nicht gefangen werden, versteht Ihr? Also sitze ich hier vorerst fest. Für über ein Jahrzehnt nun schon … (seufz) Nun, wie auch immer, das ist kaum Euer Problem. Ich meine, dass ICH hier festsitze. Dass IHR es tut, ist aber definitiv Euer Problem.~
@36 = ~Es war eine beeindruckende Tempelanlage, jetzt ist sie verlassen und vergessen. Es ist immer das Gleiche. Es gibt nicht viel, was ich sagen kann. Außer dass die Sahuagin offensichtlich eine Verwendung dafür gefunden haben – und dass die Insel eine Zuflucht für viele ist, die in den Meeren der Monscheinsee gestrandet sind. Das ist das Besondere an dieser Insel – sie ist aufgrund der Strömungen und der Windrichtung leicht zu erreichen, aber sie ist anfällig für gestrandete Schiffe WEGEN der Strömungen und des Windes und der vielen Felsformationen unter Wasser. So kann fast jeder Schiffbrüchige die Insel erreichen, aber es gibt so gut wie keinen Ausweg. Es wäre viel belebter, wenn nicht die verdammten Sahuagin hier wären, die sich von den Schiffbrüchigen ernähren. Wie auch immer, ich habe meine Erkenntnisse über die Tempelanlage aufgeschrieben, sie sollten in einem der Regale stehen. Wenn die Ratte sie nicht gefressen hat.~
@37 = ~Sie haben vor einigen Monaten den Weg hierher gefunden und den Arenaraum abgeschirmt. Das heißt aber nicht, dass ich mich nicht hineinschleichen konnte, um einen Blick auf das zu werfen, was sie da drin machen. Sie bereiten ihn für etwas Großes vor, etwas wirklich Großes. Wahrscheinlich sollte ich mich einmischen, aber … ich bin nicht stark genug gegen all ihre Macht, und ich hänge an meinem Leben. Selbst wenn es in einer feuchten Bibliothek ist.~
@38 = ~Außerdem, wie soll ich mich KONZENTRIEREN, wenn jedermann und eine RATTE meine Arbeit sabotiert!? Ich habe nicht Euch gemeint. Ich genieße unsere kleine Unterhaltung. Zumindest habt Ihr bisher nicht versucht, mich zu verletzen, das ist also ein großes Plus.~
@39 = ~Die Sahuagin – ja, sie sind eine Bedrohung und sie arbeiten an etwas … Verdammt, ich kann KEINEN klaren Gedanken fassen, wenn diese dumme Ratte hier herumläuft!~
@40 = ~Wa… Er ist immer noch ein Eichhörnchen? Ich wollte sie nur ein bisschen erschrecken, damit sie mich in Ruhe lassen. Ich habe sogar das raue Piratenleben und -verhalten in den Fluch miteinbezogen. Piraten geraten gerne aneinander, nicht wahr? Immer grob und rau. Ein beherzter Schlag und er wird wieder zu dem Flegel, der er war. Ich bin wirklich überrascht, dass das nicht schon passiert ist. Ich dachte, das wäre bei Piraten narrensicher.~
@41 = ~Sie ist tot! Sie ist wirklich tot. Ich danke Euch! Ich danke Euch so sehr. Hier ist Eure Belohnung.~ [bsblank]
@42 = ~Es tut mir im Herzen weh, mich davon zu trennen. Aber ich habe es Euch versprochen, also hier ist er – ein Gegenstand von Balduran. Ja, der berühmte Gründer von Baldurs Tor, nicht weniger! Ihr werdet kein schöneres Stück finden, und Ihr könnt es Euch auch in die Haare stecken!~
@43 = ~Es tut mir im Herzen weh, mich davon zu trennen, aber für diese großartige Tat verdient Ihr meinen wertvollsten Besitz. Also hier ist er – ein Gegenstand von Balduran. Ja, der berühmte Gründer von Baldurs Tor, nicht weniger! Ihr werdet kein schöneres Stück finden, und Ihr könnt es auch an Eurem Haar befestigen!~
@44 = ~Habt Ihr das gespürt? Ich hatte schon befürchtet, dass es eines Tages so weit sein würde. Diese verfluchte Kreatur!~
@45 = ~Eine weitere?~
@46 = ~Dies war keine Ratte … hoffe ich.~
@47 = ~Was war das?~
@48 = ~Ihr werdet es mir sagen, auch wenn ich mich jetzt verabschiede, oder?~
@49 = ~Ahaha, nein, keine Ratte. DIESE Kreatur bedroht mehr als nur meine Notizen.~
@50 = ~Ich glaube, es ist dieser Erdkoloss unten in den Höhlen. Er gräbt seine Tunnel mit solcher Begeisterung, dass er mich nicht einmal bemerkt hat, als ich ihn vor einiger Zeit gesehen habe. Er ist immer noch dabei, nicht wahr? Es scheint, was ich befürchtet habe, ist eingetreten – er ist jetzt direkt unter der Bibliothek.~
@51 = ~Mir ist aufgefallen, dass Ihr den Erdkoloss unten in den Höhlen getötet zu haben scheint? Ich weiß das zu schätzen.~
@52 = ~Diese Kreatur hat wochenlang ununterbrochen gegraben. Ich habe befürchtet, dass sie irgendwann die Stabilität des Bibliotheksbodens bedrohen würde. Aber es bedeutet auch, dass es ein starkes Tier war. Ich bin sicher, sein Fell ist bemerkenswert, Ihr habt gut daran getan es einzusammeln. Begabte Waffenschmiede können daraus wunderbare Plattenpanzer herstellen, viel besser als Ankhegs es könnten, hehe!~
@53 = ~Ihr werdet trotzdem nicht Balurans Stiefel dafür bekommen.~
@54 = ~Ah, keine Sorge. Der Boden wird nicht einfach so einstürzen. Aber wenn ich diesem Erdkoloss erlaube weiterzumachen, WIRD er den Boden destabilisieren. (seufz) Ich kümmere mich darum, sobald ich wieder bei Kräften bin. Dieser Erdkoloss gräbt nun schon seit Wochen ununterbrochen, er muss sehr stark sein. Ich bin sicher, dass seine Haut bemerkenswert sein wird. Begabte Waffenschmiede können daraus wunderbare Plattenpanzer machen, viel besser als Ankhegs es könnten, hehe! Alsoooo, wenn Ihr Lust habt, es mit ihm aufzunehmen … Ihr wisst schon, nur zu!~
@55 = ~Ihr werdet aber dennoch nicht Baldurans Stiefel dafür bekommen.~
@56 = ~Wollt Ihr noch etwas, junger Mann?~ ~Wollt Ihr noch etwas, junge Frau?~
@57 = ~Ihr habt in einer Eurer Notizen erwähnt, dass das Türrätsel, mit dem man die versteckte Tür zum Versteck der Schiffbrüchigen öffnen kann, sehr einfach ist. Ich kann allerdings nicht herausfinden, wie es funktioniert. Bitte klärt mich auf.~
@58 = ~Das große Portal ist zerstört.~
@59 = ~In Ordnung, ich werde das Portal zerstören.~
@60 = ~Die Silbergabel war Euer wertvollster Besitz?~
@61 = ~Die Silbergabel – das ist ein Scherz, oder?~
@62 = ~Wie kommt Ihr in den Besitz von Gegenständen von Balduran?~
@63 = ~Gibt es wirklich keine Möglichkeit für Euch, mir die Stiefel von Balduran zu geben?~
@64 = ~Wegen der Sahuagin …~
@65 = ~Nun, in diesem Fall seid Ihr nicht würdig, diese Tür zu öffnen, tut mir leid. Jung<PRO_MANWOMAN>, glaubt Ihr, dass ich mich an die genaue Kombination erinnern kann? Ich weiß, dass sie wirklich einfach war, so einfach, dass ich nicht dachte, ich müsste sie aufschreiben. Hmm… Zählt einfach die Anzahl der Fische in den Becken. Oder war es die Reihenfolge des Auftretens? Jedenfalls hatte es etwas mit den Meerestieren zu tun, die in den Becken waren. Ihr werdet es merken, wenn Ihr vergleicht, welche TATSÄCHLICH dort sind und welche beim Türrätsel zur Auswahl stehen. Und dann müsst Ihr sie einfach in der richtigen Reihenfolge drücken. Es WAR logisch, das weiß ich noch.~
@66 = ~Nun, meine Theorie ist einfach, und, äh, ein wenig schlicht: Die Gegenstände kamen hierher, entweder mit oder ohne Balduran. Woher soll ich Genaueres wissen? Es ist ja nicht so, dass ich seine Leiche oder – HA – sein Tagebuch gefunden hätte, wisst Ihr? Aber es sind zwei seiner Sachen, eigentlich drei, wenn man pedantisch sein will. Seht Ihr diese Stiefel? Ja, die waren auch von Balduran, beide, und sie waren nach all der Zeit noch zusammen. Nein, denkt nicht einmal daran zu fragen. Ich werde sie Euch nicht schenken, denn ich finde sie ganz schick, und deshalb möchte ich sie behalten.~
@67 = ~Das macht einen nachdenklich. Welches Schicksal ist ihm widerfahren, dass er sich von diesen Gegenständen trennen musste … sich von ihnen trennen konnte. Er brauchte sie nicht mehr …~
@68 = ~Nun, ich denke, es ist nicht so ungewöhnlich, neue Stiefel zu bekommen. Ich würde mir nicht zu viele Gedanken darüber machen.~
@69 = ~Ja, es ist seltsam, dass er seine Stiefel verloren hat … Das ist kein gutes Zeichen, wette ich.~
@70 = ~Ja, es ist DEFINITIV eine Tragödie, seine Gabel zu verlieren.~
@71 = ~Seine Stiefel?~
@72 = ~Ich spreche nicht über seine Stiefel.~
@73 = ~War das Sarkasmus? Junge<PRO_MANWOMAN>, lasst mich Euch etwas sagen.~
@74 = ~Ihr denkt, die Stiefel sind der wichtigere Besitz? Ich bitte Euch, es ist nichts Besonderes, neue Stiefel zu bekommen. Ihr könnt an jeder Ecke neue Stiefel kaufen. Aber eine GABEL? Und eine silberne, mit Gravuren, die bedeuten, dass jemand Besonderes sie Euch geschenkt hat? Das erzählt eine Geschichte, sage ich Euch, und zwar eine traurige und tragische, da bin ich sicher! Ich kann nicht einmal daran denken, ohne Tränen in den Augen zu haben.~
@75 = ~Äh, wenn Ihr es sagt.~
@76 = ~Da ist etwas dran.~
@77 = ~Es tut mir leid. Ich stimme definitiv zu, dass für einen Seefahrer eine Gabel viel wichtiger ist als Stiefel.~
@78 = ~Sarkasmus. Immer Sarkasmus!~
@79 = ~Man fragt sich allerdings, was mit ihm passiert ist. Ich bin sicher, er hatte nicht vor, eines Tages einfach zu verschwinden.~
@80 = ~Nun, ich habe gesehen, was angeblich sein letztes Schiff war, gestrandet auf einer Insel, mit seinem elfischen Begleiter noch am Leben. Er konnte lebhaft erzählen, wie sie hierherkamen, aber nicht, was danach mit Balduran geschah.~
@81 = ~Nun, ich habe Baldurans Logbuch gefunden … zumindest das, das er benutzt hat, bis sein letztes bekanntes Schiff auf einer abgelegenen Insel gestrandet ist.~
@82 = ~Ich schätze, wir werden es nie erfahren.~
@83 = ~Vielleicht findet es eines Tages jemand heraus.~
@84 = ~Vielleicht tut das jemand und bereut es, weil … nun ja, er IST spurlos verschwunden, nicht wahr? Dafür gibt es einen Grund. Es gibt immer einen Grund.~
@85 = ~Habt Ihr? Sein Schiff, sagtet Ihr? War es in der Nähe von hier? Ah, das spielt keine Rolle. Ihr MUSSTET einfach den Teil über den elfischen Gefährten erwähnen, der immer noch auf der Insel umherwandert, oder nicht?~
@86 = ~Stellt Euch das vor – auf einer abgelegenen Insel gestrandet zu sein …~
@87 = ~(seufz) Nun, ich bin mir sicher, dass niemand MEINEM Besitz Aufmerksamkeit schenken wird, wenn er irgendwo auftaucht.~
@88 = ~Lange Zeit dachte ich, dass dies auch mein Schicksal sein würde. (seufz) Nun, ich bin mir sicher, dass niemand MEINEM Besitz Beachtung geschenkt hätte, wenn er irgendwo aufgetaucht wäre.~
@89 = ~Habt Ihr? Sein Logbuch? Ich dachte, ich mache Scherze, als ich sein Tagebuch erwähnte. Und es sagt nicht, was mit ihm passiert ist?~
@90 = ~Arrgh, ich hätte meine Klappe halten sollen! Sicher, wenn Ihr, hmm… wenn Ihr, sagen wir mal … wenn Ihr mir einen Weg von dieser Insel findet, der KEIN Schiff beinhaltet. Einverstanden? Kapiert? Falls Euch mein Sarkasmus entgangen ist, lasst es mich buchstabieren: N-E-I-N! Ihr werdet diese Stiefel nicht bekommen!~
@91 = ~Hmm, ich schätze, ich könnte Euch etwas von meinem Zeug verkaufen. Es ist nicht so, dass ich hier viel Verwendung dafür hätte.~
@92 = ~Ich weiß nicht, was Ihr meint.~
@93 = ~Euer wertvollster Besitz und magischer Gegenstand? Diese Gabel?~
@94 = ~Ich hatte etwas anderes erwartet. Ihr wisst schon, etwas wirklich Nützliches.~
@95 = ~Ah, macht Euch keine Sorgen. Ich weiß den Gedanken zu schätzen.~
@96 = ~Ja! Ist sie nicht wundervoll?~
@97 = ~Wenn Ihr sie so sehr schätzt, könnten wir sie vielleicht gegen etwas eintauschen, das für mich nützlicher ist?~
@98 = ~Das ist sie sicherlich. Ich habe nur etwas anderes erwartet. Ihr wisst schon, etwas Nützlicheres.~
@99 = ~Nun ja …~
@100 = ~Nein, ist sie nicht.~
@101 = ~Oh! Ihr könnt mit ihr nichts anfangen?~
@102 = ~Das habe ich nicht gesagt. Aber ich habe etwas anderes erwartet. Ihr wisst schon, etwas wirklich Nützliches.~
@103 = ~Nein, das kann ich nicht.~
@104 = ~Aber sie ist nützlich! Damit kann man im Dunkeln besser sehen. Ihr könnt damit gediegen essen. Ihr könnt Euch sogar damit am Kopf kratzen!~
@105 = ~Na gut. Ich sehe schon, Ihr mögt sie nicht. Aber es IST jetzt Eure. Sie zurückzunehmen würde sich falsch anfühlen, so sehr ich sie auch jetzt schon vermisse.~
@106 = ~Ihr seid offensichtlich nicht zufrieden mit meiner Belohnung. Aber … aber …~
@107 = ~Ich HABE nichts anderes. Es tut mir so leid.~
@108 = ~Ich habe nichts Besonderes zu verschenken, nur diesen alten Schrott. Nun, vielleicht habt Ihr ja eine Verwendung dafür.~
@109 = ~Habt Ihr konkretere Fragen?~
@110 = ~Wisst Ihr, was genau sie vorhaben?~
@111 = ~Wofür benutzen sie den bewachten Raum?~
@112 = ~Angenommen, ich möchte in den bewachten Raum gehen, gibt es Tipps und Tricks, wie ich das machen kann, ohne jeden Sahuagin auf der Insel zu verärgern?~
@113 = ~Ihr sagtet, Ihr denkt, dass sie mit dem, woran sie arbeiten, aufgehalten werden sollten. Haben Ihr eine Idee, wie?~
@114 = ~Ich habe dieses scheinbar trockene Sporenpulver auf den Mykoniden in den unteren Höhlen gefunden. Könnte das trocken genug für unseren Zweck sein?~
@115 = ~Das ist leicht zu beantworten: jagen und plündern! Und dieses Mal mit der Hilfe von etwas Großem. Ich verstehe ihre Sprache nicht so gut, aber ich habe genug verstanden, um zu wissen, dass sie sich darauf vorbereiten, einen ihrer Götter anzurufen. Ich meine sogar, dass ich die Beschwörung des Avatars irgendeines Gottes mitbekommen habe, aber das scheint mir sehr weit hergeholt. Was auch immer sie planen, ich bin mir sicher, dass es Auswirkungen auf die Siedlungen der Menschen an der Küste haben wird, denn wir reden hier von Sahuagin. Diese Insel ist ein sehr gut gewählter Ort, um eine böse Überraschung vorzubereiten, wenn man bedenkt, dass es fast unmöglich ist, sie mit dem Schiff zu erreichen, ohne intensive Kenntnisse über die umliegenden Felsformationen unter Wasser zu haben. Ich meine … sie ist leicht zu erreichen. Aber nicht, wenn Ihr vorhabt wieder abzureisen, wenn Ihr wisst, was ich meine. Das ist auch der Grund, warum ich befürchte, dass die Sahuagin nicht aufgehalten werden können und mit Sicherheit Erfolg haben werden, es sei denn, ich lasse mir etwas wirklich Schlaues einfallen.~
@116 = ~Ich nenne den bewachten Raum die „Arena“, weil er sicherlich wie eine solche aussieht. Er hat riesige Türen, die wahrscheinlich in der Vergangenheit zu weiteren Tempelhallen führten, aber was auch immer sich dahinter befand, ist längst eingestürzt. Die Sahuagin verwandeln die Türen in Portale. Sie sind nicht dumm, diese Kreaturen. Als ich das letzte Mal hier war, war eines noch im Bau, aber ein anderes Portal hatte eine ständige Verbindung zu einem Ort unter Wasser, und sie gingen hindurch und kamen mit Trophäen zurück, also kann ich nur annehmen, dass es unter einer menschlichen Stadt mündet. Allerdings scheint es jetzt geschlossen zu sein. Und die Sahuagin scheinen darüber nicht erfreut zu sein, kann ich Euch sagen.~
@117 = ~Wenn Ihr unsichtbar seid, solltet Ihr ohne Probleme an den Wachen an der Tür vorbeischleichen können. Außerdem habe ich alte Pläne gefunden, die darauf hinweisen, dass es anscheinend einen direkten Durchgang gibt, der in der alten Kapelle im Erdgeschoss beginnt, den ich bisher aber noch nicht entdeckt habe.~
@118 = ~Aber egal welchen Weg Ihr wählt, das eigentliche Problem ist die Magie im Inneren. Ich habe sie den Göttern sei Dank nie ausgelöst, aber es gibt definitiv eine Art Sicherheitsmaßnahme, also solltet Ihr sicherstellen, dass Ihr unsichtbar bleibt. Oder Euch auf einen guten Kampf vorbereiten. Denn DANN habe ich das Gefühl, dass nicht nur die Wachen vor dem Eingang zu einem Problem werden, wenn es darum geht, diesen Ort schnell zu verlassen, oh nein.~
@119 = ~Aber da die Sahuagin keine Magie benutzen, scheint dies ein Mechanismus aus längst vergangenen Zeiten zu sein. Die Sahuagin mögen einen Weg gefunden haben, ihn zu umgehen, sonst könnten sie in diesem Raum nicht arbeiten, ohne gegen Monster kämpfen zu müssen. Schaut, ob Ihr drinnen etwas findet.~
@120 = ~Abgesehen davon, dass man jeden Sahuagin tötet, der hier auftaucht – nein. Absolut keine Ahnung. Denn das mächtige Portal, an dem sie noch arbeiten, wurde mit dem Blut einer mächtigen Meereskreatur erschaffen. Wir bräuchten das Blut einer Landkreatur, um es zu schließen. Mächtiges Blut. Mächtig genug, um das Portal unbrauchbar zu machen. Es ist immer noch nicht fertig, also sollte es dadurch eigentlich zerstört werden, nicht nur inaktiv werden.~
@121 = ~Eine solche Kreatur gibt es hier nicht, und das ist einer der Gründe, warum ich mit keiner der von mir erwogenen Maßnahmen weitergekommen bin. Ich habe zum Beispiel darüber nachgedacht, dass solch mächtiges Blut durch ein wenig Blut eines Landwesens plus sehr, sehr trockenes Etwas eines Landwesens entstehen KÖNNTE. Sehr, extrem trocken. Versteht Ihr, worauf ich hinauswill? Hier, an diesem feuchten Ort, an diesem verdammten Ort. Ha!~
@122 = ~Trockenes Sporenpulver … Warum … Das könnte tatsächlich funktionieren! Das ist so trocken wie Babypuder … Bäh, es riecht aber nicht so gut. Wartet hier, wartet nur einen kurzen Moment. Ich weiß, es war sinnvoll, das verdammte Rattenblut aufzubewahren. Das könnte wirklich funktionieren …~
@123 = ~Seht Euch das an. Blut einer nachgeahmten mächtigen Landkreatur. Keine Sorge, es ist nicht nur das Rattenblut und die Sporen, sondern es enthält auch eine Menge Magie. So! Jetzt muss nur noch jemand hineingehen und das verdammte Ding zerstören …~ [bsblank]
@124 = ~Ich weiß, dass Ihr Euch bereits um die Sahuagin gekümmert habt, die gerade hier waren, aber was auch immer die Arena bewacht, ist immer noch aktiv, und ich erwarte nicht, dass es leicht zu besiegen ist.~
@125 = ~Ich weiß, dass Ihr Euch bereits um das Verteidigungssystem der Arena gekümmert habt, aber es gibt immer noch Sahuagin hier, und die reagieren nicht gerade freundlich darauf, wenn man ihre Arbeit zerstört. Und ehrlich gesagt wäre es mir lieber, sie wären tot, wenn wir ihr Spielzeug kaputt machen.~
@126 = ~Und das wird nicht einfach sein. Was auch immer die Arena bewacht, ist immer noch aktiv, und ich erwarte nicht, dass es leicht zu besiegen ist. Außerdem gibt es hier immer noch Sahuagin, und die reagieren nicht gerade freundlich darauf, wenn man ihre Arbeit zerstört. Ehrlich gesagt wäre es mir lieber, sie wären tot, wenn wir ihr Spielzeug kaputt machen.~
@127 = ~Mein großartiger Plan hatte einen großen Nachteil: Ich bin ziemlich ausgelaugt von dem, was ich gerade getan habe. Ich fürchte also, dass ich noch etwa eine Woche lang keine Hilfe im Kampf sein werde. Also …~
@128 = ~Ich mache das schon, keine Sorge.~
@129 = ~Ja, in der Tat. „Jemand“ muss das tun.~
@130 = ~Ihr habt Euch bereits um die Sahuagin gekümmert, die gerade hier waren, UND um das Verteidigungssystem der Arena. Im Grunde genommen muss man nur dort hineingehen und die Bluttinktur auftragen. Ich sollte dazu in der Lage sein.~
@131 = ~Ja, ich denke, meine Arbeit hier ist getan. Ich bin mir sicher, dass Ihr den Rest selbst in die Hand nehmen könnt.~
@132 = ~Danke Euch. Ich meine es ernst! Ich wünsche Euch alles Glück dieser Welt, jung<PRO_MANWOMAN>. Und keine Sahuagin auf Euren Fersen.~
@133 = ~Vielen Dank.~
@134 = ~Nehmt es. Vergewissert Euch, dass Ihr es an der richtigen Türöffnung anbringt, denn ich fürchte, es gibt derzeit weder Ratten noch trockene Sporen mehr. Und tragt es richtig auf, damit es seine volle Wirkung entfalten kann, nicht nur ein paar Spritzer, klar? Und vergewissert Euch vorher, dass keine Monster mehr in der Nähe sind, sonst könnten sie Euch in die Quere kommen, und … Ich bin jetzt still, stellt nur sicher, dass es FUNKTIONIERT, in Ordnung?~
@135 = ~Nehmt auch diese hier. Die könnten sich als nützlich erweisen, und wie ich schon sagte, kann es nicht genug Feuer an diesem Ort geben!~
@136 = ~Ahaha. Emotionaler Druck funktioniert bei Euch nicht, wie schade. Ich meine, für Euch ist das natürlich toll. Es ist nicht so, dass ich es nicht versuchen würde. Es wäre tatsächlich ein triftiger Grund, die Sahuagin herauszufordern und zu sehen, wer sich durchsetzen wird. Aber es wäre klüger zu warten, bis ich wieder gesund bin. Lasst es mich wissen, Ihr wisst schon, falls Ihr Eure Meinung ändert et cetera pp.~
@137 = ~Wartet, ich habe das Gefühl, ich sollte Euch noch etwas anderes geben.~
@138 = ~Und ja, es ist urkomisch, dass ich Euch das jetzt gebe, NACH dem Kampf gegen die Mykoniden.~
@139 = ~Ich werde es auf jeden Fall schaffen. Selbst wenn in der Zwischenzeit neue Sahuagin auftauchen, werde ich einen Weg finden, an ihnen vorbeizukommen, bevor sie die Produktion wieder aufnehmen.~
@140 = ~Ich danke Euch. Ihr habt hier eine gute Tat vollbracht für viele Menschen, die es nicht einmal wissen werden. Wir haben wahrscheinlich nicht verhindert, was auch immer die Sahuagin vorhatten, aber wir haben es sicherlich verzögert und ihr Leben ein wenig unbequemer gemacht. Nun ja, und Ihr habt auch ein paar von ihren Leben verkürzt.~
@141 = ~Moment, das bedeutet, dass mir jetzt ein weiteres mögliches Portal zur Verfügung steht, nicht wahr? Ich müsste in der Lage sein, es an einem sicheren Ort münden zu lassen, sicher und irgendwo in den Hauptlanden. Oh ja, das ist brillant! Es wird auch für alle Schiffbrüchigen offen sein. Und alle Sahuagins, die hierherkommen könnten … Na gut, dafür werde ich mir eine Lösung einfallen lassen. Aber das Wichtigste ist, dass ich in der Lage sein werde, ein Portal zu öffnen, das die Leute von hier wegbringt! Ich muss mich nur erst einmal erholen, und dann ein paar Zutaten sammeln … Nochmals vielen Dank Euch. Es gibt so wenig, was ich Euch als Belohnung geben kann – Wertlosigkeiten, nichts als Wertlosigkeiten.~
@142 = ~Moment mal, das … das bedeutet auch, dass Ihr einen Weg von dieser Insel gefunden habt, ohne ein Schiff zu benutzen. Oh, ihr Götter … (seufz) Nun gut. Ich stehe zu meinem Wort, auch wenn es vermeintlich im Scherz gegeben wurde. Wagt es nicht, Euch über Löcher in meinen Socken lustig zu machen, hört Ihr? Ohne Stiefel herumzulaufen, bis ich mir ein neues Paar besorgt habe, ist schon peinlich genug.~
@143 = ~Ihr seid wirklich fest entschlossen, mir Haus und Hof wegzuschnappen, ja? Nun, irgendwie habt Ihr es ja auch möglich gemacht, dass ich diesen Ort verlasse, also … (seufz). Nun gut. Ich kann verstehen, warum sie für einen Abenteurer wie Euch attraktiv sind. Ich wollte sowieso mal ausprobieren, wie es ist, barfuß zu laufen. Ich habe gehört, dass das ziemlich gesund sein soll.~ ~Ihr seid wirklich fest entschlossen, mir Haus und Hof wegzuschnappen, ja? Nun, irgendwie habt Ihr es ja auch möglich gemacht, dass ich diesen Ort verlasse, also … (seufz). Nun gut. Ich kann verstehen, warum sie für eine Abenteurerin wie Euch attraktiv sind. Ich wollte sowieso mal ausprobieren, wie es ist, barfuß zu laufen. Ich habe gehört, dass das ziemlich gesund sein soll.~
@144 = ~Seid vorsichtig mit dem Eichhörnchen. Ich röste Euch, wenn Ihr ihm wehtut, hört Ihr?~
@145 = ~Was ist mit einem Eichhörnchen? Euer Kapitän sagte, ich solle Euch fragen.~
@146 = ~Was ist mit einem Eichhörnchen?~
@147 = ~Die letzte Person, die in diesem Tonfall mit mir gesprochen hat, hat einen Stiefelabsatz zu schmecken bekommen. Möchtet Ihr Euch ihnen anschließen?~
@148 = ~Und da dachte ich, Ihr könntet vielleicht Hilfe gebrauchen bei dem, womit Ihr gerade beschäftigt seid. Aber gut, ich brauche das nicht.~
@149 = ~Schönen Tag auch an Euch.~
@150 = ~Oooh, ich habe solche Angst. Könnt Ihr nicht sehen, wie meine Knie zittern? Sie werden den ganzen Weg von hier bis zu diesem Boot klappern.~
@151 = ~Ihr könnt froh sein, dass ich nicht hier bin, um Euch Piraten zu bekämpfen, sonst würde ich Euch das Maul stopfen.~
@152 = ~Ich glaube, wir sollten noch mal neu anfangen. Was ist mit einem Eichhörnchen? Euer Kapitän sagte, ich solle Euch fragen.~
@153 = ~Ich glaube, wir haben mit dem falschen Fuß angefangen. Was ist mit einem Eichhörnchen?~
@154 = ~Ja, klar.~
@155 = ~Oh, ein bisschen empfindlich, was? Nun, wenn Ihr die Geschichte hören wollt …~
@156 = ~Hat sich herausgestellt, dass es eine alte Magierin in der alten Bibliothek gibt. Hat sich herausgestellt, dass sie eine ziemlich gute Magierin ist. Hat sich herausgestellt, dass sie Menschen in Eichhörnchen verwandeln kann. Habt Ihr das Eichhörnchen gesehen, das hier irgendwo herumhüpft? Das ist Purug, mein Kumpel und Maat. Und ich mag ihn viel lieber in Menschengestalt, wie Ihr Euch vorstellen könnt. Bisher ist es mir nicht gelungen ihn zurückzuverwandeln. Nichts hat funktioniert, weder die Zauber „Fluch brechen“ noch „Verwandlung“, die ich versucht habe.~
@157 = ~Lasst einfach die Finger von ihm, in Ordnung?~
@158 = ~Das Lustige ist, dass die alte Magierin gesagt hat, dass ihn ein Schlag tatsächlich zurückverwandeln würde.~
@159 = ~Ich habe Euch gesagt, wie Ihr ihn befreien könnt. Es ist Eure Entscheidung, was Ihr daraus macht.~
@160 = ~Haben Ihr etwas, das Ihr verkaufen möchtet?~
@161 = ~Schönen Tag noch.~
@162 = ~Hmm, ich habe vielleicht einen Trank oder zwei.~
@163 = ~Habt Ihr den Verstand verloren? Ich werde meinen Kumpel nicht schlagen, solange er ein Eichhörnchen ist! Ein guter Schlag und er wird tot sein! Nein, ich bin sicher, sie hat Euch zum Narren gehalten. Diese schlaue, alte Füchsin!~
@164 = ~Seid Ihr wirklich sicher, dass das nicht nur eine späte Rache der alten Hexe ist? (seufz) Gut.~
@165 = ~Hier ist mein Schatz. Verschmäht ihn nicht, es ist der köstlichste Käse, den Ihr je probieren werdet, und ich habe ihn ursprünglich für Purug aufbewahrt. Aber ich dachte mir, wenn er ihn wieder essen kann, wird er ihn gerne teilen.~
@166 = ~Sprecht mit dem Kapitän, wenn Ihr weitere Fragen habt.~
@167 = ~Sieht so aus, als hätten die Prügel bei Purug gewirkt, was? Und ich habe versucht, ihn vor Schaden zu beschützen.~
@168 = ~Hallo noch mal.~
@169 = ~Dieses Eichhörnchen scheint ein wenig zu vertrauensselig für ein Eichhörnchen zu sein, aber trotzdem lässt es sich nicht fangen.~
@170 = ~Oha, ich habe wieder Hände! Und eine Stimme! Hört zu, ich werde es Euch nicht übelnehmen, dass Ihr mich angegriffen habt. Können wir uns einfach in Frieden trennen? Ich möchte meine wahre Gestalt noch ein wenig länger genießen.~
@171 = ~Ich verstehe jetzt, dass Ihr mich gerettet habt. Befreit durch eine gute Ohrfeige … Ich muss sagen, ich mag den Humor dieser alten Frau.~
@172 = ~Hallihallo! Kann ich Euch für einige meiner Sachen interessieren?~
@173 = ~Klar, zeigt mir, was Ihr anzubieten habt~
@174 = ~Nicht heute.~
@175 = ~Was für eine gottverlassene Insel.~
@176 = ~Ich weiß, was ICH tun werde, wenn wir von dieser Insel wegkommen, soviel ist sicher!~
@177 = ~Sprecht mit dem Kapitän.~
@178 = ~Ich kann es kaum erwarten, bis wir wieder auf See sind.~
@179 = ~Macht ihn nicht so weit auf! Macht ihn wieder zu und geht weg! Sonst wacht Binky auf. Ich habe Euch gewarnt. Das ist MEIN Versteck!~
@180 = ~Ach, jetzt habt Ihr Binky kaputt gemacht. Na ja. Ich schätze, ich werde mir ein anderes Versteck suchen.~
@181 = ~Sssstürme sollen das Verderben über Euuuch bringen …~
@182 = ~Der Erdkoloss scheint damit beschäftigt zu sein zu graben. Er schenkt Euch keine Aufmerksamkeit – noch nicht. Ihr könnt jedoch nicht sicher sein, dass Ihr Euch ihm noch einmal unversehrt nähern könnt.~
@183 = ~Der Erdkoloss hat Euch bemerkt!~
@184 = ~Es ist fertig. Die Lacedonen sind nicht mehr, das verfluchte Volk ist endlich frei. Ich habe den Felsbrocken gesegnet, Sand abgeklopft und ihn auf die armen Seelen gestreut. Wir haben heute eine gute Tat vollbracht, mein Freund. Wir haben allen Widrigkeiten getrotzt. Valkur wird zufrieden sein!~ [bsblank] ~Es ist fertig. Die Lacedonen sind nicht mehr, das verfluchte Volk ist endlich frei. Ich habe den Felsbrocken gesegnet, Sand abgeklopft und ihn auf die armen Seelen gestreut. Wir haben heute eine gute Tat vollbracht, meine Freundin. Wir haben allen Widrigkeiten getrotzt. Valkur wird zufrieden sein!~ [bsblank]
@185 = ~Willkommen. Ich bin Mollager, Priester von Valkur. Ich bin hier gestrandet, genau wie Ihr, und habe diese alte und vergessene Kapelle zu meiner Bleibe und diesen gewöhnlichen Hammer zu meiner Waffe gemacht. Sagt mir Bescheid, wenn Ihr Tempeldienste benötigt. Ich bin mehr als bereit, Euch zu dienen.~
@186 = ~Eine Warnung, mein Freund: Weiter unten im Gang sind Lacedons, arme verfluchte Seelen. Nicht alle von ihnen haben ihre Sinne verloren, aber die meisten schon, sodass sie Freund und Feind nicht mehr unterscheiden können. Ich bin sicher, ich könnte ihnen helfen, aber mir fehlt die körperliche Kraft, um sie zu befreien.~ ~Eine Warnung, meine Freundin: Weiter unten im Gang sind Lacedons, arme verfluchte Seelen. Nicht alle von ihnen haben ihre Sinne verloren, aber die meisten schon, sodass sie Freund und Feind nicht mehr unterscheiden können. Ich bin sicher, ich könnte ihnen helfen, aber mir fehlt die körperliche Kraft, um sie zu befreien.~
@187 = ~Es ist wirklich schade, dass Ihr die Lacedonen getötet habt, mein Freund. Sie waren ein verfluchtes Volk. Wir hätten sie befreien können, ohne ihre Seelen ins Jenseits zu schicken. Nun, was geschehen ist, ist geschehen. Ich hoffe, sie finden Frieden mit der Gottheit, die sie gewählt haben.~ ~Es ist wirklich schade, dass Ihr die Lacedonen getötet habt, meine Freundin. Sie waren ein verfluchtes Volk. Wir hätten sie befreien können, ohne ihre Seelen ins Jenseits zu schicken. Nun, was geschehen ist, ist geschehen. Ich hoffe, sie finden Frieden mit der Gottheit, die sie gewählt haben.~
@188 = ~Kann ich Euch bei irgendetwas behilflich sein?~ [bsblank]
@189 = ~Die alte Magierin in der Bibliothek sagte, dass sie in naher Zukunft ein Portal zur Küste öffnen wird. Ich dachte mir, dass das auch für Euch interessant ist.~
@190 = ~Die Sahuagin sind von dieser Ebene verschwunden. Sie sollten nicht wieder auftauchen.~
@191 = ~Körperliche Stärke, um die Lacedonen zu befreien? Wollt Ihr, dass ich sie töte?~
@192 = ~Was denkt Ihr, wie können die Lacedonen gerettet werden?~
@193 = ~Ich bin hier in einer Mission für Umberlee … sozusagen. Ich fürchte, den Lacedonen zu helfen, könnte sie verärgern und meinen Weg von dieser Insel gefährden.~
@194 = ~Ich habe einen schweren Stein auf den Altar gelegt. Glaubt Ihr, dass das funktioniert?~
@195 = ~Als ich einen Felsbrocken auf den Altar gelegt habe, hat er sich gewölbt. Habt Ihr eine Ahnung, was hier los ist?~
@196 = ~Hinter der Statue hat sich ein Geheimgang geöffnet. Habt Ihr eine Idee, wohin er führen könnte?~
@197 = ~Draußen gibt es Piraten, die Euren Handwerkerhammer gut gebrauchen könnten.~
@198 = ~Könnte ich Euren Hammer gegen diese herkömmliche Keule eintauschen?~
@199 = ~Könnte ich Euren Hammer gegen diesen herkömmlichen Kriegshammer eintauschen?~
@200 = ~Könnte ich Euren Hammer gegen diesen herkömmlichen Flegel eintauschen?~
@201 = ~Könnte ich Euren Hammer gegen diesen herkömmlichen Streitkolben eintauschen?~
@202 = ~Könnte ich Euren Hammer gegen diesen herkömmlichen Morgenstern eintauschen?~
@203 = ~Ich benötige die Dienste Eurer Gottheit.~
@204 = ~Erzählt mir mehr über Valkur.~
@205 = ~Habt Ihr keine Angst vor den Sahuagin?~
@206 = ~Wisst Ihr, warum die Sahuagin hier sind?~
@207 = ~Lebt wohl.~
@208 = ~Das würde ich nicht sagen, aber ich bin vorsichtig, was die Bedrohung angeht, die sie darstellen. Es ist noch nicht lange her, dass sie sich auf dieser Ebene befunden haben. Aber ich weiß, wie man sich wehrt, und zu meinem Glück scheinen sie nicht an einer weiteren Konfrontation mit den Lacedonen interessiert zu sein, sodass sie sich nach einiger Erkundung nicht mehr so tief in diese Gänge gewagt haben.~
@209 = ~Das sind großartige Neuigkeiten. Das wird das Leben der Schiffbrüchigen sehr viel einfacher machen. Und, na ja, meins auch.~
@210 = ~Es scheint sich um eine Art alten Mechanismus zu handeln. Ich bin mir sicher, dass dieser Ort mehr Geheimnisse birgt, als man auf den ersten Blick sieht, aber ich weiß nicht, wofür er gedacht war.~
@211 = ~Das stimmt! Leider weiß ich nicht, wohin er führt. Ich kann Euch nur raten, vorsichtig zu sein.~
@212 = ~Ah? Das sind großartige Neuigkeiten für alle gestrandeten Seelen auf dieser Insel. Ich werde dafür sorgen, dass jeder davon erfährt. Danke, dass Ihr mich informiert habt.~
@213 = ~Valkurs Segen sei mit Euch.~
@214 = ~Ich verstehe Eure Sorge. Doch Ihr bewegt Euch frei in diesem Tempel, und ich spüre ihre Anwesenheit bei Euch nicht. Umberlees Kirche scheint sich auf Euch zu verlassen, was auch immer es ist, weswegen Ihr hierhergekommen seid. Und ich würde glauben, dass Ihr eine Art Druckmittel habt – zumindest bis Eure Arbeit erledigt ist.~
@215 = ~Sie sind im Auftrag ihres Königs hier. Früher lebten sie nur in den unteren Ebenen, aber vor nicht allzu langer Zeit haben sie sich hierher ausgebreitet. Sie bedrohen die Schiffbrüchigen, die früher in diesen Hallen lebten. Ich habe diese armen Leute schon ein Weile nicht mehr gesehen. Sie scheinen sich zu verstecken. Ich hoffe, sie haben es geschafft, nicht erwischt zu werden. Diese Seeteufel zögern nicht, Menschen zu ihrer Mahlzeit zu machen, wenn sie die Gelegenheit dazu haben!~
@216 = ~Schiffbrüchige?~
@217 = ~Ich verstehe.~
@218 = ~Ja, es gibt hier arme Leute, die wie wir auf dieser Insel gestrandet sind. Die meisten von ihnen sind keine Kämpfer, also verstecken sie sich, seit die Sahuagin auf diese Ebene der Tempelruinen gekommen sind.~
@219 = ~Ich bin bereit, diesen Hammer gegen einen anderen einzutauschen – oder jede andere stumpfe Waffe. Aber ich fürchte, ich kann ihn nicht einfach weggeben, da er meine einzige Waffe ist. Ich will damit keinen Profit machen, aber es sollte eine echte Waffe sein, denn das ist der Zweck, für den ich dieses Handwerkszeug benutze.~
@220 = ~Aber ja, das werde ich gerne tun. Ich werde helfen, indem ich den Hammer weggebe, und ich habe mir selbst geholfen, indem ich eine bessere Waffe bekomme. Valkur wird sich freuen!~
@221 = ~Ich fürchte nein, mein Freund. Ich hätte jederzeit selbst eine solche Holzwaffe herstellen können, wenn ich es für sinnvoll gehalten hätte. Ich werde meinen Hammer nur gegen eine Waffe austauschen, die von einem Schmied gefertigt wurde.~ ~Ich fürchte nein, meine Freundin. Ich hätte jederzeit selbst eine solche Holzwaffe herstellen können, wenn ich es für sinnvoll gehalten hätte. Ich werde meinen Hammer nur gegen eine Waffe austauschen, die von einem Schmied gefertigt wurde.~
@222 = ~Valkur ist der Gott der Seefahrer und ihrer Schiffe, der Gott des Trotzes und der Kühnheit des Unmöglichen. Mein Herr segnet diejenigen, die für sich selbst und für andere kämpfen. Er ist gütig und unterstützt die Selbstständigkeit seiner Anhänger, seine Dogmen zu erfüllen. Deshalb kann ich diese Kapelle, diesen Altar nutzen, um ihm zu huldigen, auch wenn sie für eine längst vergessene Gottheit errichtet wurde.~
@223 = ~Es ist auch der Grund, warum ich, obwohl ich nur den Hammer eines Handwerkers schwinge, zuversichtlich bin, dass mein Herr meine Bemühungen, mir selbst zu helfen, wohlwollend betrachtet.~
@224 = ~Oh nein, ganz und gar nicht. Was für ein unglückliches Missverständnis. Ich bin froh, dass Ihr gefragt habt!~
@225 = ~Soweit ich weiß, waren sie Anhänger von Umberlee, die bei ihrer Göttin in Ungnade gefallen sind. Die Launische Königin verfluchte sie zu ihrem jetzigen, erbärmlichen Zustand. Ich bin mir sicher, dass Valkur mir die Macht geben würde, den Fluch aufzuheben, aber ich brauche etwas, auf das ich ihn anwenden kann. Etwas, das das Gegenteil von Umberlees Domäne ist. Etwas, das sich deutlich von den fließenden Wassern der Meere abhebt – fest, trocken und schwer.~
@226 = ~Ich habe versucht, den Sand zu segnen, den ich draußen gesammelt habe, ich habe es mit Steinen versucht, mit VIELEN Steinen und mit großen Steinen, so groß wie ich sie tragen konnte. Aber es hat nicht gereicht, sie waren alle zu klein gegen Umberlees Zorn. Ich bin immer noch davon überzeugt, dass ein Felsbrocken, der so schwer ist, dass er von einer einzelnen Person kaum gehoben werden kann, das Symbol wäre, das man braucht, um die armen Seelen zu erlösen.~
@227 = ~Wenn Ihr helfen wollt, seht Euch um. Sucht nach einem schweren Felsbrocken und bringt ihn hierher. Legt ihn auf den Altar, und ich werde ihn mit Valkurs Gnade segnen, um die Lacedonen zu befreien.~
@228 = ~Genial! Stein ist ein Synonym für Berge, für Land, für alles, was außerhalb der Domäne von Umberlee liegt. Dieser Felsbrocken sollte schwer genug sein. Ich werde ihn mit Valkurs Segen versehen und einen Weg finden, ihn gegen die Lacedonen einzusetzen. Lasst uns diese armen Seelen endlich befreien.~
@229 = ~Ich kann mir einen einfachen Weg vorstellen, wie man einen solchen Felsbrocken auf einen Lacedon anwenden kann, um ihn von dem Fluch zu befreien. Und das auch noch mit viel weniger Aufwand. (Warum vergeuden wir hier unsere Zeit?)~
@230 = ~Habeee sie hier reingetrieeeeben … Warten … Wartend darauf, dass der Fluuuch gebrrrochen wird … Verflucht von Umberleeeee … Warnung, mein Freunnnnd … Verstannnd von vielen getrübt … nicht betretennnn …~ ~Habeee sie hier reingetrieeeeben … Warten … Wartend darauf, dass der Fluuuch gebrrrochen wird … Verflucht von Umberleeeee … Warnung, meine Freunnnndin … Verstannnd von vielen getrübt … nicht betretennnn …~
@231 = ~Ihr habt den Fluch aufgehoben und Umberlees Zorn von uns genommen. Wir sind Euch gegenüber verpflichtet.~
@232 = ~Ihr seid Seeräuber!~
@233 = ~Was ist mit Euch passiert?~
@234 = ~Wie auch immer. Irgendeine Belohnung?~
@235 = ~Ich werde mich verabschieden.~
@236 = ~Das waren wir, ja.~
@237 = ~Wir haben Umberlee verärgert, als wir diesen Tempel betraten und uns zu sehr für die alten Götter interessierten, für die er gebaut wurde. Ihr Fluch ist aufgehoben, aber ich denke, wir können uns glücklich schätzen, wenn wir eine weitere Bootsfahrt überleben.~
@238 = ~Draußen sind Piraten, sind das Eure Leute?~
@239 = ~Die Piraten da draußen erwähnten, dass sie sich nicht in diese Tempel wagen.~
@240 = ~Ja, möglicherweise sind wir der Grund dafür, haha.~
@241 = ~Ich glaube, Ihr habt keine Ahnung, wie lange wir in diesem verfluchten Zustand gefangen waren.~
@242 = ~Wir waren hier für sehr lange Zeit gefangen. Wenn es draußen Piraten gibt, gehören sie nicht zu uns – und sie sind schlau nicht hierherzukommen.~
@243 = ~Nehmt alles, was Ihr hier findet, als Belohnung mit. Es ist nicht viel, aber es ist alles, was wir haben, und wir geben es gerne für unsere Rettung her. Wirklich, alles, was wir brauchen, sind ein paar Kerzen, um diesen dunklen und feuchten Ort zu erhellen. Ich weiß aber, dass es unten in der Krypta viele davon gibt. Wir werden uns ein wenig ausruhen und dann wieder auf Wanderschaft gehen.~
@244 = ~Vielen Dank, dass Ihr uns befreit habt.~
@245 = ~Seid gegrüßt, Retter.~ ~Seid gegrüßt, Retterin.~
@246 = ~Ich habe eine Kerze für Euch, wenn Ihr wollt.~
@247 = ~Auf Wiedersehen.~
@248 = ~Wenn ich will? Ich will auf jeden Fall! Vielen Dank Euch! Ich kann Euch nichts anderes geben als ein Lächeln und ein herzliches Danke dafür.~
@249 = ~Das sind wunderbare Neuigkeiten, danke Euch! Wir werden die Augen danach offenhalten. Wer hätte gedacht, dass wir diese Insel verlassen können, ohne auf ein Schiff gehen zu müssen und Umberlees Zorn erneut zu riskieren!~
@250 = ~Heeeeelft unssss…~
@251 = ~(Ihr bemerkt, dass mehrere Umrisse von Meereskreaturen in die Wand geritzt wurden. Es scheint, dass der Fackelgriff zu jedem dieser Bilder bewegt werden kann.)~
@252 = ~(Versuchen, den Griff zu bewegen.)~
@253 = ~(Das Rätsel in Ruhe lassen.)~
@254 = ~(Wählen, auf welches Bild einer Meereskreatur Ihr den Fackelgriff bewegen möchtet.)~
@255 = ~Schildkröte.~
@256 = ~Schwertfisch.~
@257 = ~Qualle.~
@258 = ~Kraken.~
@259 = ~Oktopus.~
@260 = ~Sahuagin.~
@261 = ~Rochen.~
@262 = ~Wal.~
@263 = ~Seepferdchen.~
@264 = ~(Der Griff rastet in die Position ein.)~
@265 = ~(Wählen, auf welches Bild einer Meereskreatur Ihr den Fackelgriff nun bewegen möchtet.)~
@266 = ~(Der Griff kehrt in seine ursprüngliche Position zurück.)~
@267 = ~(Ihr hört eine Reihe von Klicks.)~
@268 = ~(Die Klicks klingen so, als würde etwas in seinen ursprünglichen Zustand zurückkehren, bis alles wieder still ist.)~
@269 = ~(Es wurde ein Mechanismus in Gang gesetzt.)~
@270 = ~Wasser tropft von der Decke und hat im Laufe der Jahre Stalaktiten gebildet. Das Wasser schmeckt ein wenig abgestanden, ist aber frisch genug, um getrunken werden zu können. Mit etwas Geduld könnt Ihr eine kleine Flasche davon sammeln.~
@271 = ~(Eine kleine Flasche unter das tropfende Wasser halten und warten, bis sie voll ist.)~
@272 = ~(Das tropfende Wasser in Ruhe lassen.)~
@273 = ~(Ihr verstaut die Flasche mit Wasser.)~
@274 = ~(Mit etwas mehr Geduld könntet Ihr eine weitere kleine Flasche Wasser sammeln.)~
@275 = ~Ah, Ihr seid ein ganz Schlauer, ja? Den Schlüssel zu stehlen … Nun, Ihr benehmt Euch besser, denn ich beobachte Euch!~ ~Ah, Ihr seid eine ganz Schlaue, ja? Den Schlüssel zu stehlen … Nun, Ihr benehmt Euch besser, denn ich beobachte Euch!~
@276 = ~Neue Gesichter? Nun, Hegomee hat recht, Ihr seht aus, als könntet Ihr Euch verteidigen. Die Tür ist für normale Leute geschlossen, aber wenn Ihr mir 10 Pfeile bringt, öffne ich sie für Euch, wenn Ihr wollt.~
@277 = ~Und seid vorsichtig in der Nähe des Gefangenen. Er ist ein schlauer Fuchs und aus gutem Grund gefesselt, sage ich Euch.~
@278 = ~Ihr habt da eine gute Tat vollbracht. Ich habe die Mutter nie so glücklich gesehen. Sie ist zwar immer noch in ihrem eigenen Kopf gefangen, aber wenigstens ist sie glücklich. Ich danke Euch.~
@279 = ~Ich beobachte Euch, also seid vorsichtig.~ [bsblank]
@280 = ~Hier sind Eure zehn Pfeile.~
@281 = ~Was hat es mit dem Gefangenen auf sich?~
@282 = ~Was ist mit der Frau da drüben los?~
@283 = ~Ich bin nicht hier, um Ärger zu machen.~
@284 = ~Wisst Ihr was? Eigentlich mag ich Fomthards Ideen. Pech für Euch, wie es scheint.~
@285 = ~Klasse. Einen Moment noch …~
@286 = ~Zum einen hat er versucht, Hegomee zu töten. Außerdem ist er ein kranker Bastard, der Frieden mit den Sahuagin schließen will, indem er einige von uns an sie verfüttert! Haltet Abstand, es lohnt sich nicht, seinem Geschwätz zuzuhören.~
@287 = ~Das ist eine traurige Geschichte. Sie und andere wurden von Sahuagin gejagt und konnten nur knapp entkommen, und zu denen, die nicht so viel Glück hatten, gehörte ihr kleiner Sohn, von dem wir wissen, dass er inzwischen tot ist. Sie hat durch den Schock ihren Verstand verloren. Wir können nichts weiter für sie tun, als sie zu trösten und ihr zuzuhören.~
@288 = ~Das sollte besser wahr sein.~
@289 = ~Verdammt, das kann doch nicht Euer Ernst sein!~
@290 = ~Ihr habt die Sahuagin dazu gebracht zu gehen, habe ich gehört. Gut gemacht! Dann brauche ich wohl keinen Ehrgeiz mehr, um der Anführer dieser traurigen Gruppe zu werden. Die Wache beäugt mich immer noch misstrauisch, aber dank Euch bin ich wieder ein freier Mann.~
@291 = ~Frisches Blut! Nicht wörtlich, keine Sorge. IHR wärt der Letzte, den ich zu den Sahuagin schicken würde. Seid gegrüßt, Fomthard ist mein Name. Ja, ich bin ein Gefangener unseres hochnäsigen „Anführers“ Hegomee, der uns dazu zwingt, uns zu verstecken und zu hungern, und uns sagt, dass wir so „sicher“ sind. Wann hat jemand von uns das letzte Mal eine gute Mahlzeit bekommen oder gar seinen Durst mit einem guten Schluck Wasser löschen können? Nicht jeder ist mit Hegomee einverstanden, seht Euch um und hört den Leuten zu! Aber ich werde nicht freikommen, solange dies Wache nicht weg ist. Wenn Ihr ihn für mich tötet, übernehme ich diesen Unterschlupf und belohne Euch dafür.~ ~Frisches Blut! Nicht wörtlich, keine Sorge. IHR wärt die Letzte, die ich zu den Sahuagin schicken würde. Seid gegrüßt, Fomthard ist mein Name. Ja, ich bin ein Gefangener unseres hochnäsigen „Anführers“ Hegomee, der uns dazu zwingt, uns zu verstecken und zu hungern, und uns sagt, dass wir so „sicher“ sind. Wann hat jemand von uns das letzte Mal eine gute Mahlzeit bekommen oder gar seinen Durst mit einem guten Schluck Wasser löschen können? Nicht jeder ist mit Hegomee einverstanden, seht Euch um und hört den Leuten zu! Aber ich werde nicht freikommen, solange dies Wache nicht weg ist. Wenn Ihr ihn für mich tötet, übernehme ich diesen Unterschlupf und belohne Euch dafür.~
@292 = ~Also, was denkt Ihr?~
@293 = ~Ihr wollt einen Handel mit den Sahuagin abschließen, indem Ihr ihnen Menschen anbietet?~
@294 = ~Ich glaube, Ihr seid ein kranker Bastard.~
@295 = ~Ich halte Euch immer noch für einen kranken Bastard.~
@296 = ~Ich ziehe in Erwägung, Euch zu helfen.~
@297 = ~Ich denke, Ihr seid genau da, wo Ihr hingehört, und solltet dort auch bleiben.~
@298 = ~Ich muss gehen.~
@299 = ~Ja, meine Methode mag brutal erscheinen, aber seht sie Euch an! Seht Euch die Mutter dort drüben an, gebrochen durch den Verlust ihres Kindes. Sie ist nichts weiter als ein brabbelndes Durcheinander. Was bringt es also, sie „in Sicherheit“ zu bringen? Sie könnte ihrem Kind folgen – sie wäre besser dran, glaubt mir, und wir würden davon profitieren, wenn die Sahuagin uns eine Zeit lang in Ruhe lassen würden. Versteht Ihr, was ich meine? Wie kann man das Warten, bis wir ALLE verhungert sind, als die weniger grausame Option ansehen?~
@300 = ~Ist das nicht Musik in meinen Ohren? Ich kann es selbst mit Hegomee aufnehmen, aber dafür muss die Wache verschwinden. Ihr wisst, was zu tun ist.~
@301 = ~Pffff, als ob ich irgendwo hingehen würde, wenn ich hier so festgehalten werde.~
@302 = ~Vergesst nicht die Wache! Ihr müsst sie töten, um mich zu befreien.~
@303 = ~Ha! Ihr habt Rückgrat, ich mag Euch. Ihr werdet sehen, dass meine Methode am Ende effizienter ist, wartet nur ab.~
@304 = ~Ihr habt die Wache getötet!~
@305 = ~Es wird Zeit für eine Veränderung hier, denke ich. Seht zu, wie ich diesen Idioten Hegomee zur Strecke bringe!~
@306 = ~Wozu, Ihr Idiot? Ich war schon so gut wie frei – Hegomee steht zu seinem Wort. Hach, ich habe damit nichts zu tun!~ ~Wozu, Ihr Idiotin? Ich war schon so gut wie frei – Hegomee steht zu seinem Wort. Hach, ich habe damit nichts zu tun!~
@307 = ~Da Hegomee tot ist, bin ich jetzt wohl der Chef, was?~
@308 = ~Ihr habt sie also beide getötet, und zwar umsonst, denn ich war schon so gut wie frei. Und wisst Ihr was? Scheißt drauf, ich werde mich rarmachen.~
@309 = ~Nun, es ist Zeit für Veränderungen in dieser Gegend. Ihr könnt die Sachen von Hegomee gerne behalten. Ich denke, sein Schwert war gar nicht so schlecht. Es sollte eine kleine Entschädigung für Eure Mühen sein. Ich werde mich auf die Suche machen und versuchen, eine Art Vertrag mit den Sahuagin zu schließen, die noch auf der Insel sind. Macht keine Dummheiten, während ich weg bin.~
@310 = ~Ich gehe dann mal auf Erkundungstour, denke ich. Man sieht sich – oder auch nicht!~
@311 = ~Oh, dieses Tuch – das gehörte meinem Baby! So muss es sein! Sicherlich hat er es von meiner Schwester bekommen, sie hat drei Mädchen, wisst Ihr? Ja, sicher hat sie ihm das Tuch gegeben … Es wird ihn warm halten!~
@312 = ~Bitte, gebt mir dieses Tuch!~
@313 = ~Diese rosa Hüfttuch? Ich fand es auf einem … Ach, egal. Hier, nehmt es, wenn es Euch an Euren Jungen erinnert.~
@314 = ~Klar, was gebt Ihr mir dafür, hmm?~
@315 = ~Finger weg! Ich habe es gefunden, es gehört mir.~
@316 = ~Das rosa Tuch? Ich bin es irgendwo losgeworden.~
@317 = ~Ich werde darüber nachdenken.~
@318 = ~Oh, mein armer Junge …~
@319 = ~I-I-Ich habe nicht viel. Nur diese fünf Goldmünzen …~
@320 = ~Gut, besser als nichts.~
@321 = ~Mach Euch keine Mühen. Nehmt es einfach.~
@322 = ~Nein, das ist nicht gut genug. Ich werde es behalten.~
@323 = ~Nein … nein, bitte! Ich brauche diese Weste.~
@324 = ~Und ich habe nein gesagt.~
@325 = ~(schluchz) Mein Junge …~
@326 = ~Ja! Danke, danke, danke!~
@327 = ~Siehst du, hier ist dein Tuch, mein Schatz. Ich kann dich jetzt einkuscheln … Ist es bequem? Mein lieber Junge, dir wird nie wieder kalt sein …~
@328 = ~Mein Baby … mein armes Baby … Ich habe es verloren … Ich habe mein Baby verloren. Habt Ihr ihn gesehen? Ein kleiner Junge mit braunen Haaren … so schöne braune Haare … Es ist so kalt hier.~
@329 = ~Ihm muss so kalt sein. Ich muss etwas Warmes für ihn finden …~
@330 = ~Ihr habt die Wache getötet! Wofür? Ich lasse es Euch durchgehen, aber passt auf, dass Ihr nicht noch mehr Ärger verursacht!~
@331 = ~Sieh mal an! Neue Gesichter, und so fähige noch dazu. Mein Name ist Hegomee. Ihr habt das Türrätsel gelöst, also seid Ihr hier willkommen – solange Ihr keine Unruhe stiftet. Haltet Euch von dem Gefangenen unten fern, lasst niemanden durch diese Türen, der nicht meine Zustimmung hat, und Ihr seid willkommen. Die Spannungen sind derzeit etwas hoch, da wir von allen Seiten zwischen Lacedonen und Sahuagin gefangen sind, aber wir sind zuversichtlich, dass beide Bedrohungen bald vorüber sein werden. Sprecht mit mir, wenn Ihr Euch nicht scheut, uns zu helfen. Andernfalls könnt Ihr Euch hier ausruhen, solange ihr wollt.~
@332 = ~Gibt es etwas, das Ihr wissen wollt?~
@333 = ~Eigentlich sind alle Sahuagin von dieser Insel verschwunden, zumindest im Moment.~
@334 = ~Die Lacedonen sind erlöst. Ich kann nicht für die Menschen sprechen, in die sie sich verwandelt haben, aber zumindest sind sie keine hirnlosen Monster mehr.~
@335 = ~Die Lacedonen sollten kein Problem mehr darstellen. Ihr solltet in der Lage sein, die Treppe wieder zu erreichen.~
@336 = ~Ihr erwähntet, dass Ihr Hilfe bräuchtet?~
@337 = ~Was ist mit dem Gefangenen los?~
@338 = ~Es wird gemunkelt, dass Ihr alle hier eingesperrt haltet und riskiert, dass Ihr alle verhungert.~
@339 = ~Eure Strategie ist es, die Gefahr draußen auszusitzen?~
@340 = ~Wisst Ihr was, eigentlich gefallen mir Fomthards Ideen besser als Eure.~
@341 = ~Ich werde gehen.~
@342 = ~Fomthard war ein sehr wertvolles Mitglied dieser Gemeinschaft, aber er leidet derzeit an leichten Wahnvorstellungen. Ich kann nicht zulassen, dass er noch jemandem Schaden zufügt, also wird er vorerst unter Kontrolle bleiben. Am besten haltet Ihr Abstand.~
@343 = ~Das sind Neuigkeiten, mit denen ich nie gerechnet hätte, und das so schnell. Danke, dass Ihr uns das mitgeteilt habt. Das wird uns alle retten.~
@344 = ~Von der ganzen Insel? Das ist eine interessante Neuigkeit, obwohl ich bezweifle, dass das lange Bestand haben wird. In den unteren Ebenen kommen und gehen sie. Wir werden sehen. Für den Moment ist es auf jeden Fall eine große Erleichterung.~
@345 = ~Wenn Ihr die armen Leute hier meint – wir sind alle Schiffbrüchige, die auf die eine oder andere Weise auf dieser Insel gestrandet sind. Wenn Ihr mich meint, ich bin Hegomee, ausgebildeter Kämpfer aus dem hohen Norden und derzeit Anführer dieser Menschen in Not.~
@346 = ~Das … ist nicht ganz unwahr, wenn auch eine eher bösartige Formulierung meines eigentlichen Anliegens.~
@347 = ~Diese Leute sind keine Kämpfer. Ich allein bin weder den Sahuagin noch den Lakedoniern gewachsen. Der Priester draußen hat mir gesagt, dass die Lacedonen verfluchte Menschen sind, die gerettet werden können, und dass er daran arbeitet. Daher bin ich zuversichtlich, dass wir bald wieder Zugang zur Bibliothek und zur alten Einsiedlerin haben werden. Die Sahuagin auf dieser Ebene der Ruinen kamen vor nicht allzu langer Zeit hierher, und es scheint, dass sie Differenzen haben, die sie klären müssen. Ihre eigentlichen Geschäfte finden weiter unten statt, sie müssen auch ab und zu ins Wasser abtauchen … Ich bin überzeugt, dass sie auch diese Ebene bald wieder verlassen werden. Für uns ist es am sichersten, die Sache abzuwarten. Wir sind nicht in der Lage, gegen eine der beiden Parteien zu kämpfen. Schon gar nicht, wenn Fomthard so verrückt spielt.~
@348 = ~Mögen die Götter mit Euch sein.~
@349 = ~Was … was soll ich aus Euren Worten schließen?~
@350 = ~Nichts, keine Sorge. Ich glaube nur, dass an seinem Plan etwas dran ist, aber ich werde mich nicht in Eure Angelegenheiten einmischen.~
@351 = ~Ihr habt mich verstanden. Zieht Eure Waffe!~
@352 = ~Ihr trefft die richtige Wahl. Haltet Euch von Fomthard fern, er ist ein begnadeter Redner und hat schon viele Menschen mit seinen honigsüßen Worten für sich gewonnen. Diese Narren verstehen nicht, dass sie die ersten sein werden, die geopfert werden!~
@353 = ~Ihr macht einen großen Fehler. Jeder, der hier zu Tode kommt, wird Euch auf dem Gewissen haben!~
@354 = ~Wunderbar. Danke, dass Ihr uns das erzählt habt.~
@355 = ~Tolle Neuigkeiten! Hmm, das bedeutet, dass wir Fomthard vielleicht nicht länger gefangen halten müssen. Keine Sahuagin-Bedrohung bedeutet, dass er seinen verrückten Plan nicht durchziehen kann. Ich werde in Betracht ziehen, ihn gehen zu lassen.~
@356 = ~Unsere größte Sorge ist, dass wir zwischen Sahuagin und Lacedonen eingeklemmt sind. Wenn Ihr irgendetwas tun könnt, um wenigstens einen Weg in dieser Ebene der Ruinen freizumachen, würdet Ihr uns aus unserer Gefangenschaft befreien. Aber ich erwarte nicht, dass Ihr das für uns löst, obwohl Ihr den Priester in der Kapelle fragen könntet, ob es etwas gibt, womit Ihr ihm helfen könnt, die Lacedonen zu erlösen. Dass Ihr in der Lage seid, außerhalb dieses Verstecks herumzulaufen, ist schon eine große Chance. Fragt herum, ob die Leute etwas brauchen, das Ihr uns zurückbringen könnt.~
@357 = ~Vor allem unseren Quartiermeister – bitte fragt ihn, ob er etwas vermisst, das draußen zu finden wäre.~
@358 = ~Ich weiß, dass Ihr bereits unseren Quartiermeister gefragt habt. Was auch immer er Euch gesagt hat, wird uns eine große Hilfe sein.~
@359 = ~Herzlich willkommen. Ich bin der Quartiermeister, obwohl dieser Titel viel zu hochtrabend ist für die Tragödie, die ich hier verwalte. Wie ich sehe, könnt Ihr durch diese Ruinen gehen, ohne von Sahuagin oder Schlimmerem erwischt zu werden. Wenn Ihr in die Höhlen kommt, gibt es eine Stelle, an der frisches Wasser von der Decke fällt. Wir bräuchten so viel Ihr tragen könnt, wenn ich so kühn sein darf, Euch darum zu bitten. Es ist zu gefährlich für uns, dorthin zu gehen. Ich spreche nicht davon, dass wir in diesem Stockwerk von Sahuagin und Lacedonen eingeschlossen sind – ich bin zuversichtlich, dass dies in naher Zukunft gelöst wird. Ich spreche von den verdammten Malenti in diesen Höhlen. Sie haben ein Wasserloch, aus dem sie auftauchen. Solange das nicht geschlossen wird, besteht immer die Gefahr, dass man auf Malenti trifft, wenn man dorthin geht. Nicht dass ich sicher bin, dass es tatsächlich geschlossen werden KANN, ich habe es mir nicht genau angesehen.~
@360 = ~Und damit habe ich meine benötigten zehn Flaschen. Vielen Dank an Euch. Ich nehme immer noch jedes Wasser, das Ihr mitbringt, aber für den Moment haben wir genug, damit niemand verdursten muss.~
@361 = ~Wunderbar. Ich würde noch mehr nehmen, aber das hier ist schon eine große Hilfe.~
@362 = ~Wie ich sehe, habt Ihr Wasser dabei. Ist das etwa für uns?~
@363 = ~Ja, bitte nehmt alles.~
@364 = ~Lasst mich darüber nachdenken.~
@365 = ~Klasse! Ich werde jede Flasche für fünf Goldmünzen kaufen, als kleine Entschädigung.~
@366 = ~Kann ich etwas für Euch tun?~
@367 = ~Was haltet Ihr von der Rivalität zwischen Eurem Anführer und dem Gefangenen?~
@368 = ~Das Wasserloch, aus dem die Malenti hervorgingen, ist geschlossen, zumindest im Moment.~
@369 = ~Wie viel Wasser braucht Ihr?~
@370 = ~Wunderbare Neuigkeiten. Sobald es die Situation zulässt, werden wir wieder Wasser sammeln können.~
@371 = ~Das habe ich tatsächlich. Alles außer Essen.~
@372 = ~Nun, wir sind alle durstig. Mindestens zehn Flaschen Wasser, würde ich sagen.~
@373 = ~Zehn Flaschen!? Ich werde mit Moos bedeckt sein, wenn ich versuche zu warten, bis sie alle voll sind.~
@374 = ~Ich werde sehen, was ich tun kann.~
@375 = ~Ich weiß, dass es lange dauert, sie aus den Tropfen zu sammeln.~
@376 = ~Ich weiß das zu schätzen.~
@377 = ~Ich würde es machen, die Wartezeit macht mir nichts aus. Allerdings stört mich die Bedrohung durch die Monster. Ihr könnt vielleicht Moos ansetzen, aber ich werde wahrscheinlich gefressen, während ich darauf warte, dass die Flaschen sich füllen.~
@378 = ~Ihr müsst Euch nicht bemühen, Ihr habt schon so viel für uns getan. Ich gehe und mache es, die Wartezeit macht mir nichts aus. Die Bedrohung durch Malenti hätte mich allerdings gestört. Ihr hättet vielleicht Moos angesetzt, aber ich wäre wahrscheinlich gefressen worden, während ich darauf warte, dass die Flaschen sich füllen.~
@379 = ~Macht das, macht das. Und kommt wieder zurück. Denn das bedeutet, dass Ihr noch am Leben seid.~
@380 = ~Ich stimme unserem Anführer Hegomee zu. Der Priester in der Kapelle arbeitet daran, die Lacedonen zu erlösen, und die Sahuagin werden sich schließlich dorthin zurückziehen, wo sie herkamen. Wir sind hier sicher. Es gibt keinen Grund, jemanden zu gefährden.~
@381 = ~Das Einzige, was wirklich knapp wird, ist Wasser, und selbst das ist noch nicht lebensgefährlich.~
@382 = ~Nur das Wasser ging langsam zur Neige, und selbst das wird jetzt dank Eurer Hilfe noch eine ganze Weile reichen.~
@383 = ~Hegomee ist nur ein Feigling, der sich hinter den großen Türen versteckt! Wir haben bald nichts mehr zu essen, oder nicht? Er sollte nach draußen gehen und nach Vorräten suchen. Das Warten, bis die Sahuagin weg sind – was, wenn das zu lange dauert?~
@384 = ~„Er“? Erwartet Ihr, dass er allein gegen die Sahuagin oder die Lacedonen antritt? Hegomee ist der einzige echte Kämpfer hier. Ihr wisst, dass wir Fomthard nicht ohne Wache zurücklassen können. Wollt Ihr mit ihm da rausgehen?~
@385 = ~Ich sags ja nur. Hier wie Enten zu sitzen, kann auch nicht das Richtige sein.~
@386 = ~Oh, ein neues Gesicht! Ihr seht aus, als könntet Ihr auf Euch selbst aufpassen. Wir könnten mehr Leute mit Kampferfahrung gebrauchen, das steht fest. Dann kommen wir hier vielleicht eher früher als später wieder raus. Ihr habt sicher schon davon gehört, dass Fomthard versucht hat, Hegomee zu töten … ZU TÖTEN, sag ich Euch. Dennoch, ich weiß, dass niemand derjenige sein will, der den Sahuagin geopfert wird – ich auch nicht –, aber ich sehe die Weisheit in Fomthards Ansatz. Wir können nicht sagen, wie lange es dauern wird, bis die Sahuagin diese Ebene wieder verlassen, und wir können nicht einfach warten, bis wir alle zu schwach zum Kämpfen sind!~
@387 = ~Hallo! Seid Ihr hier, um zu helfen? Ihr seht nicht aus wie jemand, der Hilfe braucht, deshalb frage ich. Ich würde mich sehr freuen. Ich bin auch sehr froh, dass Hegomee unser Anführer ist. Den Schwächeren zu opfern, wäre Wahnsinn! Ich kann nicht glauben, dass jemand so etwas vorschlagen würde. Ich kann nicht glauben, dass wir überhaupt darüber reden!~
@388 = ~Seid vorsichtig, wem Ihr vertraut. Es gibt hier einige Leute, die nicht mehr am Leben wären, wenn es nicht Fomthard gäbe. Ja, Fomthard! Er ist derjenige, der sich an den Lacedonen und den Malenti und so weiter vorbeischleichen konnte. Die anderen wissen es nicht, aber ich habe bemerkt, dass uns die Vorräte zur Neige gehen. Was macht Hegomee? Er betet zu seinem Gott und sperrt uns hier ein, damit wir verhungern! Es ist logisch, dass wir auf Fomthard hören sollten, es führt kein Weg an seiner Idee vorbei.~
@389 = ~Ihr wart doch draußen, oder? Habt Ihr meinen Dolch gefunden? Ich musste ihn im Schlafsaal lassen. Wir mussten uns so beeilen, dass ich ihn nicht mehr aus meinem Versteck holen konnte! Der Schlafsaal ist gleich draußen auf der linken Seite, Ihr könnt ihn nicht verfehlen. Dort stehen alle Etagenbetten, meins war das zweite von der Tür aus. Der Dolch ist zwischen zwei losen Brettern des oberen Bettes versteckt.~
@390 = ~Ihr wart doch vorhin draußen, oder? Habt Ihr zufällig meinen Dolch gefunden? Ich musste ihn im Schlafsaal liegen lassen. Wir hatten es so eilig zu gehen, dass ich ihn nicht aus meinem Versteck holen konnte! Der Schlafsaal ist gleich draußen auf der linken Seite, ihr könnt ihn nicht verfehlen. Dort stehen alle Etagenbetten, meins war das zweite von der Tür aus. Der Dolch ist zwischen zwei losen Brettern des oberen Bettes versteckt. Habt Ihr ihn zufällig mitgenommen? Ich kann ihn nicht mehr finden.~
@391 = ~Ihr habt nicht zufällig meinen Dolch gefunden?~
@392 = ~Wir haben tatsächlich nachgesehen. Aber da war kein Dolch.~
@393 = ~Hört zu, meine Dame. Ich habe dort gesucht, wo Ihr es mir gesagt habt, aber da war nichts!~
@394 = ~Seid Ihr sicher, dass der Dolch in dem Versteck ist? Es widerstrebt mir, dort hinzugehen, nur um nichts zu finden.~
@395 = ~Wenn ich Euch den Dolch bringe, was bekomme ich dann?~
@396 = ~Sehe ich für Euch aus wie ein Botenjunge?~ ~Sehe ich für Euch aus wie ein Botenmädchen?~
@397 = ~Ich bin dabei.~
@398 = ~Wir sehen uns später.~
@399 = ~N-Nein? Aber wie jemand, der auf sich selbst aufpassen kann, jemand, der stark ist und keine Angst hat, nach draußen zu gehen, wo die Monster warten, jemand, der so viele Waffen hat, dass er keinen einzigen lausigen Dolch braucht.~
@400 = ~Schmeicheleien? In Ordnung, das funktioniert. Ich werde nach Eurem Dolch Ausschau halten.~
@401 = ~Ihr habt also bemerkt, dass ich NICHT wie ein Botenjunge aussehe.~ ~Ihr habt also bemerkt, dass ich NICHT wie ein Botenmädchen aussehe.~
@402 = ~Es ist nur … für den Fall, dass Ihr sowieso unseren Schlafsaal durchsucht. Ich bin mir sicher, dass Ihr keinen Bedarf für einen kleinen Dolch habt. Aber für mich ist es die Welt.~
@403 = ~Ab-so-lut. Es sei denn, ich habe Demenz und niemand hat es mir gesagt.~
@404 = ~Ich meine es ernst. Ihr lasst mich besser nicht umsonst Eure gebrauchte Bettwäsche durchwühlen.~
@405 = ~Vielen Dank an Euch!~
@406 = ~Das heißt, Ihr werdet nach meinen Dolch suchen?~
@407 = ~Äh, ich habe einen Heiltrank …~
@408 = ~Ach, egal. Ich bringe Euch einfach Euren Dolch.~
@409 = ~Dann passt gut darauf auf. Er gehört mir.~
@410 = ~Ich kann mich damit nicht befassen.~
@411 = ~Das hoffe ich doch!~
@412 = ~Nein? Aber … Habt Ihr die Bretter durchsucht?~
@413 = ~Ich habe ihn definitiv dort gelassen. Ich habe meinen Dolch zwischen den losen Dielen meines Bettes liegen lassen. Ich schwöre bei den Göttern da oben und da unten!~
@414 = ~Geht es um Euren Dolch? Euer Dolch ist nicht mehr dort. Ich habe ihn.~
@415 = ~I-IHR habt meinen Dolch genommen? Warum habt Ihr das nicht gleich gesagt? Bitte gebt ihn …~
@416 = ~Er gehört jetzt mir. Die Regel lautet: Wenn jemand etwas verliert und jemand anderes es findet, gehört es dem Finder.~ ~Er gehört jetzt mir. Die Regel lautet: Wenn jemand etwas verliert und jemand anderes es findet, gehört es der Finderin.~
@417 = ~Aber ich habe meinen Dolch nicht verloren! Er war in meinem Versteck gelagert!~
@418 = ~Konntet Ihr ihn selbst besorgen? Nein. Ihr habt jemand anderen damit beauftragt. Also war er für Euch verloren.~
@419 = ~Aber … aber … Hach, ich kann das nicht glauben. Ihr gebt ihn nicht zurück, oder?~
@420 = ~Nö.~
@421 = ~Und wann wolltet Ihr es mir sagen?~
@422 = ~Ich sags Euch jetzt.~
@423 = ~Na, ist das nicht fantastisch?~
@424 = ~Aber … Wenn Ihr sagt, er ist nicht mehr dort …~
@425 = ~Es tut mir sehr leid. Es scheint, als hätte ich Euch umsonst gebeten, meinen Dolch zurückzuholen. (seufz)~
@426 = ~Nun, da Ihr mir meinen Dolch nicht gebracht habt, ist es nur fair, dass ich Euch keine Belohnung gebe … richtig?~
@427 = ~Behaltet das Wenige, das Ihr übrig habt, ich brauche Euren Plunder nicht.~
@428 = ~Nnatürlich. Ich habe es bereits gesagt.~
@429 = ~Wie bitte? Wir hatten bereits darüber gesprochen. Ihr könnt Euch jetzt nicht mehr rauswinden, nur weil es nicht so gelaufen ist, wie Ihr es wolltet.~
@430 = ~Ich habe mich für Euch auf den Weg gemacht und dort gesucht, wo Ihr mich hingeführt habt. Gebt ihn her!~
@431 = ~Haaach! Schon gut, schon gut! Hier ist er, ein Heiltrank. Das ist wirklich alles, was ich habe.~
@432 = ~Buahaha, Ihr habt gerade einen Trank verloren, der viel wertvoller als ein Dolch ist. Ihr hättet ihn bei unserem Quartiermeister gegen ein Kurzschwert eintauschen können!~
@433 = ~Ich war mir nicht BEWUSST, dass ich meinen Dolch nicht zurückbekomme, Ihr stümperhafter Idiot!~ ~Ich war mir nicht BEWUSST, dass ich meinen Dolch nicht zurückbekomme, Ihr stümperhafte Idiotin!~
@434 = ~Danke. Ich danke Euch vielmals.~
@435 = ~Nun, das bin dann wohl ich. Ärmer an Besitztümern, aber SO viel reicher an Erfahrungen! Hmpf …~
@436 = ~Wir sind hier noch nicht fertig. He, Kumpel, gebt ihr ihren Dolch zurück! Er gehört ihr, und das wisst Ihr nur zu gut!~
@437 = ~Nun, der liebe Herr „Ich-habe-Euren-Dolch-jetzt“ hat leider recht. Da kann ich nichts machen.~
@438 = ~Es tut mir leid, dass es für Euch so gelaufen ist, aber ich sehe es nicht als meine Aufgabe an, noch etwas zu tun.~
@439 = ~Kopf hoch! Vergesst diesen Idioten. Hier ist eine Goldmünze, das sollte für einen Dolch von Eurem Quartiermeister reichen.~
@440 = ~Kopf hoch! Hier ist eine Goldmünze, das sollte für einen Dolch von Eurem Quartiermeister reichen.~
@441 = ~Ja, Erfahrungen zu sammeln, ist besonders wichtig, wenn man eine Schiffbrüchige auf einer abgelegenen Insel ist. Ich freue mich, dass ich Euch helfen konnte.~
@442 = ~Aber … Ich … Nun … Ah, hier ist er. Seid Ihr jetzt zufrieden?~
@443 = ~D-Das ist Sarkasmus! Wie könnt Ihr Euch in so einer furchtbaren Situation über mich lustig machen?~
@444 = ~Lasst mich in Ruhe! Ihr alle, lasst mich in Ruhe!~
@445 = ~Ihr … Oh, Ihr seid unglaublich! Ich danke Euch. Ich danke Euch so sehr.~
@446 = ~(seufz) Ich hatte befürchtet, dass Ihr das sagen würdet.~
@447 = ~Ich werde diesen Dolch besser hüten, versprochen. Ich werde ihn nie wieder herumliegen lassen.~
@448 = ~Vielen Dank für Euren Versuch.~
@449 = ~Ich werde mir sofort einen neuen holen.~
@450 = ~Die geisterhafte Erscheinung scheint nach etwas zu suchen, scheint aber gleichzeitig nichts anderes zu bemerken als die helle Kohlenpfanne vor ihr.~
@451 = ~Ihr … habt mich beeefreit. Dankeee.~
@452 = ~Wie die andere Geistererscheinung am Eingang der Krypta scheint auch diese nichts anderes zu bemerken als die helle Kohlenpfanne vor ihr.~
@453 = ~In dieser nebligen Form scheint die Erscheinung überhaupt nicht zu reagieren.~
@454 = ~Hatte Balduran noch seine persönlichen Sachen, als Ihr getrennt wurdet? Ich war auf einer anderen abgelegenen Insel und habe dort einige von Baldurans Gegenständen gefunden.~
@455 = ~Hatte Balduran noch seine Stiefel – und seine Silbergabel? Die waren auf einer anderen abgelegenen Insel. Ich frage mich, ob er dorthin kam, bevor oder nachdem sein Schiff hier gestrandet war.~
@456 = ~Seine Besitztümer? Nun, ich denke, er hat so viel wie möglich mitgenommen und ist … irgendwohin …~
@457 = ~Hatte er noch seine Stiefel? Meint Ihr, dass jemand ohne seine Stiefel wegläuft? Nun, das kann natürlich passieren, wenn Ihr von einem solchen Angriff überrascht werdet. Ich kann Euch sagen, als ich ihn das letzte Mal sah, hatte er seine Stiefel noch an. Nicht dass ich mich erinnern könnte, wie sie aussahen. Was seine Silbergabel angeht, weiß ich es nicht. Ich habe sie hier nirgends gefunden, das steht fest. Sie hätte es mir ermöglicht, all die Jahre mit ein wenig mehr Würde zu speisen.~
@458 = ~Jung<PRO_MANWOMAN>, ich habe seit Jahrhunderten auf dieser Insel verbracht, aber keine Spur von Balduran oder seinen Besitztümern gesehen. Ich komme nicht einmal an meinen Besitz heran, so wie die Lage jetzt ist. Ich könnte die Hilfe wirklich gebrauchen.~
@459 = ~Ein Schiffswrack auf einer abgelegenen Insel? Ich fange an, mich zu fragen, ob ich zufällig dort gewesen bin, obwohl ich das nicht glaube. Aber könnte diese Insel, von der Ihr sprecht, irgendwo in der Mondscheinsee liegen? Einige von Baldurans persönlichen Gegenständen haben es dorthin geschafft.~
@460 = ~Mondschei… Ah, nein, diese Insel ist noch unberührt, auch das Schiffswrack ebenso. Viele vergessene Schätze, wenn Ihr helft.~
@461 = ~Es ist eine schlimme Situation, in der wir uns befinden.~
@462 = ~Ich hoffe, dass wir zumindest diese Ebene der Ruinen wieder begehen können, ohne von Monstern bedroht zu werden.~
@463 = ~Wir werden sehen, wie sich das Ganze entwickelt, denke ich.~
@464 = ~Wir können wieder rausgehen! Ich bin so froh.~
@465 = ~Vielen Dank, dass Ihr uns das Leben leichter macht.~
@466 = ~Der Plan von Hegomee ging also am Ende auf.~
@467 = ~Ich bin froh, dass die Spannungen zwischen Hegomee und Fomthard vorbei sind.~
@468 = ~Jetzt entscheidet also Fomthard über unser Schicksal.~
@469 = ~Ihr könnt Fomthard nicht vorwerfen, ein Feigling zu sein, wenn er so auf Erkundungstour geht. Das könnt Ihr wirklich nicht.~
@470 = ~Es ist traurig, dass Hegomee tot ist. Er war ein guter Kerl, und er hat es gut gemeint.~
@471 = ~Hegomee hat es verdient, sage ich Euch.~
@472 = ~Wir sind ohne Anführer! Oh Götter, was werden wir jetzt tun?~
@473 = ~Toll, dass Ihr uns so ungeschützt gelassen habt!~
@474 = ~Vielleicht könnte der Priester uns Unterschlupf gewähren?~
@475 = ~Wollt Ihr jetzt unser Anführer sein?~ ~Wollt Ihr jetzt unsere Anführerin sein?~
