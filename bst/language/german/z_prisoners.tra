// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Ah, ein neues Gesicht! Ihr seht freundlicher aus als diese kalten Wachen. Habt Ihr nicht zufällig etwas, um mich aufzuwärmen, <PRO_SIRMAAM>? Es ist so kalt und feucht an diesem Ort. Nur eine Kleinigkeit, damit ich hier auf den Steinen ein kleines Feuer machen kann …~
@1 = ~Hört nicht auf diesen Mann. Er ist ein Pyromane, der die halbe untere Stadt niedergebrannt hat. Er ist hier drin, weil er es wieder tun würde. Er wird nie wieder entflammbare Substanzen in die Hände bekommen.~
@2 = ~Nur etwas wirklich Kleines. Ein Zahnstocher würde reichen! Ich habe mir schon alle Haare verbrannt …~
@3 = ~Nur eine winzige Kleinigkeit, die ich verbrennen könnte? Keiner würde es merken!~
@4 = ~Seht die Flammen, die Flammen!~
@5 = ~Ich vermisse das Licht, die hellen Flammen, die Hitze … und die Schreie!~
@6 = ~Wie wäre es, wenn Ihr mir die Fesseln abnehmt? Das würde mir die Freiheit geben, mich so zu BEWEGEN, dass ich Euch meine Dankbarkeit zeigen kann, Hübscher.~ ~Wie wäre es, wenn Ihr mir die Fesseln abnehmt? Das würde mir die Freiheit geben, mich so zu BEWEGEN, dass ich Euch meine Dankbarkeit zeigen kann, Hübsche.~
@7 = ~Wer seid Ihr?~
@8 = ~Worauf wollt Ihr hinaus?~
@9 = ~Versucht Ihr, mich zu verführen?~
@10 = ~Netter Versuch. Ich falle nicht auf Eure Tricks herein.~
@11 = ~Werte Dame, Ihr seid aus einem bestimmten Grund hier drin, da bin ich mir ziemlich sicher.~
@12 = ~Da Ihr hier drin seid, seid Ihr nicht unschuldig!~
@13 = ~Hmm, das klingt nach der Behandlung, die ich verdienen würde.~
@14 = ~Ich möchte nicht mit Euch reden.~
@15 = ~Eine Kombination von ungünstigen Umständen, mehr nicht! Aber Ihr habt recht, es gibt für alles einen Grund. Der Grund dafür, dass ich Euch meine Dankbarkeit zeige, wäre zum Beispiel, dass Ihr mich aus diesem Gefängnis befreit, hm?~
@16 = ~Oh, Ihr habt definitiv recht, dass ich nicht … UNSCHULDIG bin. Befreit mich und ich werde Euch zeigen, was für ein ungezogenes Mädchen ich sein kann …~
@17 = ~Nun, ich denke, Ihr wisst es bereits.~
@18 = ~Könnt Ihr es mir verübeln, dass ich es versuche, wenn der Zufall mich damit segnet, jemanden wie Euch zu treffen?~
@19 = ~Oh, ich hatte gehofft, wir könnten mit dem Geplauder warten, bis Ihr mich von diesen schweren Ketten befreit! Dann gehöre ich ganz Euch, für jede … Untersuchung, auf die Ihr Lust habt, Hübscher.~ ~Oh, ich hatte gehofft, wir könnten mit dem Geplauder warten, bis Ihr mich von diesen schweren Ketten befreit! Dann gehöre ich ganz Euch, für jede … Untersuchung, auf die Ihr Lust habt, Hübsche.~
@20 = ~[no stats > 17]Es muss das Schicksal gewesen sein, das uns zusammengeführt hat!~
@21 = ~[PC's STR > 17]Es muss das Schicksal gewesen sein, das mich mit so jemandem zusammengebracht hat, stark<PRO_MANWOMAN>!~
@22 = ~[PC's INT > 17]Es muss das Schicksal gewesen sein, das mich mit so jemandem zusammengebracht hat, intelligent<PRO_MANWOMAN>!~
@23 = ~[PC's WIS > 17]Es muss das Schicksal gewesen sein, das mich mit einer so jemandem zusammengebracht hat, weis<PRO_MANWOMAN>!~
@24 = ~[PC's DEX > 17]Es muss das Schicksal gewesen sein, das mich mit so jemandem zusammengebracht hat, fingerfertig<PRO_MANWOMAN>!~
@25 = ~[PC's CON > 17]Es muss das Schicksal gewesen sein, das mich mit so jemandem zusammengebracht hat, stämmig<PRO_MANWOMAN>!~
@26 = ~[PC's CHR > 17]Es muss das Schicksal gewesen sein, das mich mit so jemandem zusammengebracht hat, charmant<PRO_MANWOMAN>!~
@27 = ~[Safana](spöttel)<CHARNAME>, bitte sagt mir, dass Ihr dieses Frauenzimmer als das seht, was es ist – eine Manipulatorin, die versucht, sich aus dem GEFÄNGNIS herauszuwinden, indem sie ihre Worte verführerisch aufbessert. Ich weiß GENAU, wo das enden wird. Sie wird Euch ins Gesicht lachen, sobald Ihr diese Fesseln öffnet.~
@28 = ~Oh, Ihr schließt also von Euch auf mich, hmm? Ich weiß nicht, was für eine Geschichte Ihr mit dieser Frau habt, lieber Fremder, aber gebt mir nicht die Schuld, dass ich mich sofort in jemanden verliebt habe, der so gut aussieht. Ich würde sagen, ich bin auch nicht so schlecht, hmm?~ ~Oh, Ihr schließt also von Euch auf mich, hmm? Ich weiß nicht, was für eine Geschichte Ihr mit dieser Frau habt, liebe Fremde, aber gebt mir nicht die Schuld, dass ich mich sofort in jemanden verliebt habe, die so gut aussieht. Ich würde sagen, ich bin auch nicht so schlecht, hmm?~
@29 = ~[Safana]Pfffffff…~
@30 = ~Hmm, ich glaube, Ihr seid in der Tat nicht schlecht.~
@31 = ~Es tut mir leid. Selbst wenn ich es wollte, kann ich Euch nicht einfach gehen lassen.~
@32 = ~Ihr seid so gar nicht mein Typ.~
@33 = ~Bemüht Euch nicht weiter. Ihr bleibt genau da, wo Ihr seid.~
@34 = ~Nehmt es mir nicht übel, dass ich mich sofort in jemanden verliebt habe, der so gut aussieht. Ich würde sagen, dass ich auch nicht so schlecht bin, oder?~ ~Nehmt es mir nicht übel, dass ich mich sofort in jemanden verliebt habe, die so gut aussieht. Ich würde sagen, dass ich auch nicht so schlecht bin, oder?~
@35 = ~Oh, ich verstehe! Aber würdet Ihr wenigstens diese Fesseln öffnen? Ich würde Euch gerne meine Dankbarkeit zeigen, aber mit diesen Ketten kann ich mich kaum bewegen.~
@36 = ~Also abgemacht?~
@37 = ~Oh, also ist <PRO_HESHE> nicht nur gutaussehend, sondern auch ehrlich und direkt! Ihr könnt mich nicht einfach so hierlassen. Nicht nachdem wir uns so kennengelernt haben!~
@38 = ~Ich bin sicher, dass eine so heldenhafte Person wie Ihr kein Problem damit haben wird, die Schlösser zu öffnen, die diese Ketten halten.~
@39 = ~Sagt mir zuerst, wer Ihr seid.~
@40 = ~Ich befreie keine Verbrecherinnen.~
@41 = ~Oh, sie sagen, ich sei ein amnische Spionin! Könnt Ihr das glauben? Sie haben mich in dieses Gefängnis gesteckt und an die Wand gekettet! Selbst wenn ich aus Amn wäre, könnt Ihr es der amnischen Bevölkerung verübeln, dass sie wissen wollen, was vor sich geht? Alle sprechen vom Krieg! Könnt Ihr Euch einen KRIEG zwischen der Schwertküste und Amn vorstellen?~
@42 = ~Ihr habt recht, das sollte kein Grund sein, Euch so anzuketten.~
@43 = ~Also … darf ich hoffen, dass ich nicht in Ketten liege, wenn ich Euch meine Dankbarkeit für meine Befreiung zeige?~
@44 = ~Hmm, das hört sich doch gut an. Hier … Eure Fesseln sind weg. Und jetzt kommt her …~
@45 = ~Ihr braucht nichts dergleichen zu tun. Ich habe Euch trotzdem die Ketten abgenommen. Ihr seid frei und könnt gehen.~
@46 = ~Ganz und gar nicht. Ihr bleibt genau da, wo Ihr seid. Ich glaube kein Wort von dem, was Ihr sagt.~
@47 = ~Wenn Ihr nur ein Spionin wärt, würden sie Euch sicher nicht so anketten. Nein, es gibt noch mehr, was Ihr mir nicht erzählt habt. Ihr werdet genau hier bleiben.~
@48 = ~Was … Habt Ihr wirklich gedacht, dass „Kommt her!“ zu dem gehören würde, was wir jetzt tun werden? Ahahaha!~
@49 = ~Endlich frei von den Ketten! Vielen Dank, mein RETTER! (lach) Danke, dass Ihr mich befreit habt. Ich dachte schon, ich müsste es selbst tun.~ ~Endlich frei von den Ketten! Vielen Dank, meine RETTERIN! (lach) Danke, dass Ihr mich befreit habt. Ich dachte schon, ich müsste es selbst tun.~
@50 = ~Ohhh. Ihr seht nicht nur gut aus, sondern habt auch Köpfchen. Na dann ist ja gut. Man kann es einem Mädchen nicht verübeln, dass sie es versucht.~
@51 = ~Oh, tut mir bitte nicht weh! Ich bin so eine unschuldige Frau. (lach)~
@52 = ~Hmm, wie schade. Kommt bald wieder, Hübscher!~ ~Hmm, wie schade. Kommt bald wieder, Hübsche!~
@53 = ~Ooh, seht mal, wer da ist.~
@54 = ~Mein Retter. (lach)~ ~Meine Retterin. (lach)~
@55 = ~Der Mann, der mir das Herz gebrochen hat! Seht Ihr, ich habe meinen eigenen Weg hierher eingeschlagen. (lach)~ ~Die Frau, die mir das Herz gebrochen hat! Seht Ihr, ich habe meinen eigenen Weg hierher eingeschlagen. (lach)~
@56 = ~Was macht Ihr hier?~
@57 = ~Ihr SEID also ein amnische Spionin, die gegen den Eisenthron ermittelt?~
@58 = ~Ich sollte Euch auf der Stelle dafür bestrafen, dass Ihr die geflohene Verbrecherin seid, die Ihr seid!~
@59 = ~Ich habe nicht vergessen, wie Ihr mich ausgetrickst habt, wisst Ihr?~
@60 = ~Tun wir einfach so, als hätten wir uns nicht gesehen.~
@61 = ~Hmm. Na gut, ich nehme das Angebot an. Aber nur, weil Ihr so nett gefragt habt. Machts gut, Hübscher.~ ~Hmm. Na gut, ich nehme das Angebot an. Aber nur, weil Ihr so nett gefragt habt. Machts gut, Hübsche.~
@62 = ~Oh, passt das nicht zusammen in deinem kleinen Kopf? „Aber wenn sie aus Amn kommt, sollte sie dann nicht auf MEINER Seite in diesem Konflikt stehen?“~
@63 = ~Ich arbeite nicht für den Eisenthron, und doch versuche ich, den Konflikt zwischen Amn und Baldurs Tor zu eskalieren. Kompliziert, nicht wahr?~
@64 = ~Dann sind wir also Feinde, fürchte ich.~ ~Dann sind wir also Feindinnen, fürchte ich.~
@65 = ~Ich will nicht gegen Euch kämpfen. Können wir einfach so tun, als hätten wir uns nicht gesehen?~
@66 = ~Ihr werdet jedes Mal süßer, wenn wir uns treffen.~
@67 = ~Meine Anwesenheit hier ist eigentlich ganz einfach. Die Mächte innerhalb des Eisenthrons arbeiten auf einen Krieg an der Schwertküste hin, und ich tue das auch, für meine eigenen Herren.~
@68 = ~Für wen? Für wen arbeitet Ihr denn?~
@69 = ~… Das macht uns zu Feinden?~ ~… Das macht uns zu Feindinnen?~
@70 = ~Das sind wir, Hübscher. Ihr gefährdet meine Mission, also werde ich Euch hier und jetzt töten.~ ~Das sind wir, Hübsche. Ihr gefährdet meine Mission, also werde ich Euch hier und jetzt töten.~
@71 = ~Seht mal an, wen wir hier haben: <CHARNAME>, den Banditenlager-Aufmischer. Nun, ich habe es lebendig da rausgeschafft, aber wie sich herausstellt, ist die Flammenden Faust auch nicht dumm.~ ~Seht mal an, wen wir hier haben: <CHARNAME>, die Banditenlager-Aufmischerin. Nun, ich habe es lebendig da rausgeschafft, aber wie sich herausstellt, ist die Flammenden Faust auch nicht dumm.~
@72 = ~Ihr seid ein Bandit? Scheint, als hätte ich einen Skalp übersehen.~
@73 = ~Ihr seid kein normaler Bandit, wenn man Euch hier hergebracht hat.~
@74 = ~Dann bin ich ja ein Glückspilz.~
@75 = ~Wie wärs, wenn ich mir Euren dann jetzt hole?~
@76 = ~Hmm, das könnte man so sagen, aber ich war auch kein Bandenführer. Ich war nur … ein bisschen besser informiert als diese Idioten. Das hat mir aber nicht viel geholfen, außer „am Leben zu bleiben“.~
@77 = ~Besser informiert? Was wisst Ihr denn?~
@78 = ~Wie wäre es, wenn ich Letzteres bei Euch ändere?~
@79 = ~Mit Euch zu reden, ist sinnlos.~
@80 = ~Was, hier und jetzt? Habt Ihr keine Angst, dass die Wachen Euch beobachten, während Ihr ihre Gefangenen tötet?~
@81 = ~Nein, hab ich nicht.~
@82 = ~Nun, welche Wahl hatte ich denn, als Ihr mich zuerst angegriffen habt, versteht Ihr?~
@83 = ~Ich habe nur mit der Faust gewackelt. Obwohl Eure Anwesenheit hier bedeutet, dass Ihr mehr als nur ein Lakai wart.~
@84 = ~Ich habe nur mit der Faust geschüttelt. Was wisst Ihr denn, wenn Ihr so gut informiert seid?~
@85 = ~Nun, jeder dachte, wir würden von den Zenths angeheuert werden. ICH wusste, dass sie es nicht waren.~
@86 = ~Wer war es denn?~
@87 = ~Was? Denkt Ihr, ich würde es Euch einfach so sagen?~
@88 = ~Ich schätze, das spielt keine Rolle. Es ist nicht so, dass ich glaube, dass Ihr mir viel erzählen könntet.~
@89 = ~Ihr braucht etwas „Motivation“, was?~
@90 = ~Schon gut, schon gut! Es ist der Eisenthron. SIE haben den ganzen Ärger angezettelt, wahrscheinlich um von dem Chaos zu profitieren. Da, ich habs Euch gesagt.~
@91 = ~Das soll wohl ein Scherz sein?! Mann, es ist eine Schande, dass wir auf verschiedenen Seiten stehen.~
@92 = ~Nun, ich fürchte, IHR müsst gehen. Ich sitze hier irgendwie fest.~
@93 = ~Hört mal, ich weiß, ich war auf Gegenseite. Aber um ehrlich zu sein, würdet Ihr nicht zustimmen, dass ich außerhalb dieses Gefängnisses von größerem Nutzen wäre? Ich war nie hinter Euch her und habe mich nicht um die persönlichen Pläne der Oberen gekümmert. Es gibt keine Banditenaktivitäten mehr, ich werde Euch keine Probleme machen.~
@94 = ~Jemand rekrutiert Söldner oben im Hochmoor, wir werden uns dorthin orientieren. Ich werde Euch aus dem Weg gehen und der Stadt wird auch kein Schaden zugefügt, versteht Ihr?~
@95 = ~Alles, was Ihr tun müsstet, wäre, diesen Zettel zu einem meiner Kontakte zu bringen. Werdet Ihr das tun?~
@96 = ~Pff, Ihr würdet mir mehr Banditen offenbaren? Wünscht Ihr Eurem „Kontakt“ den Tod?~
@97 = ~Was spränge für mich raus?~
@98 = ~Nein, das werde ich nicht.~
@99 = ~Neue Pläne am Schmieden, was? Ich schätze, ich muss Euch doch noch erledigen.~
@100 = ~Ich hatte befürchtet, dass Ihr das sagen würdet.~
@101 = ~Ich bin nicht so dumm, keine Sorge.~
@102 = ~Eine schöne Summe Gold.~
@103 = ~Ich sage Euch, wo Ihr den Zettel hinlegen müsst und wie Ihr das versteckte Gold findet. Ihr legt den Zettel einfach an eine bestimmte Stelle, das wars. Ich vertraue Euch, dass Ihr deswegen nicht zur Flammenden Faust rennen werdet. Und selbst wenn, es gibt nichts zu sagen, außer dass Ihr einen Zettel angenommen habt, den Ihr nicht lesen könnt, und dass sie einen Ort bewachen müssen, an dem niemand auftauchen wird.~
@104 = ~Gut, ich werde es tun. Ich hoffe, die Belohnung ist es wert.~
@105 = ~Wird sie. Hier ist die Notiz. Wenn Ihr die Stadt an der Brücke verlasst und nach Norden geht, werdet Ihr einen einzelnen Baum finden, der um diese Jahreszeit normalerweise rote Blätter hat. Ihr müsst die Rinde am untersten Astloch ein wenig lockern. Versteckt den Zettel einfach dort. Ihr werdet dort auch Gold finden. Der Sicherheitsvorrat ist bereits dort, und ich habe ihnen geschrieben, dass sie noch mehr hineinlegen sollen, wenn sie ihn herausnehmen. Danke, Mann.~
@106 = ~Ich zähle auf Euch.~
@107 = ~Habt Ihr es getan?~
@108 = ~Ihr seid immer noch hier?~
@109 = ~Talona, ich habe sie alle für Euch geopfert! Alles für Euch. Nehmt mich zu Euch, meine Göttin, Mutter aller Plagen! Ich habe es für Euch getan. Sie alle tranken das gesegnete Wasser, sie alle wurden krank, sie alle starben in Eurem Namen! Die Straßen sind voll von Leichen, um Euch die Ehre zu geben! Warum … warum habt Ihr mich verlassen …~
@110 = ~Nehmt mich zu Euch, meine Göttin, Mutter aller Plagen!~
@111 = ~Alles für Euch, nur für Euch!~
@112 = ~Warum habt Ihr mich im Stich gelassen?~
@113 = ~Endlich ist es soweit! Die Wachen sind bestochen worden, und Ihr seid hier, um Eure toten Verwandten zu rächen! Wachen! WACHEN! Ah, es ist sinnlos, sie zu rufen, wenn sie Euch durchgelassen haben! Mein Schicksal ist besiegelt!~
@114 = ~Beruhigt Euch, ich bin nicht wegen so etwas hier.~
@115 = ~Ich dachte, Euer Schicksal sei bereits besiegelt, da Ihr ja hier in diesem Gefängnis sitzt und so.~
@116 = ~Oh, Ihr seid also ein Mörder? Vielleicht SOLLTE ich dann tote Menschen rächen!~
@117 = ~(gähn) Ihr seid also ein Mörder. Warum bin ich nicht überrascht? Oh, wartet, vielleicht weil dies das Seeturm-Gefängnis ist.~
@118 = ~Ich sollte nicht mit Euch reden.~
@119 = ~Wer … wer seid Ihr denn?~
@120 = ~Ich bin <CHARNAME>. Und wer seid Ihr?~
@121 = ~Sagt mir, warum Ihr hier seid.~
@122 = ~Neeeeein…~
@123 = ~Ihr seid also gekommen, um mich zu verspotten. Ist es nicht schon Strafe genug, hier zu sein?~
@124 = ~Ich wollte nur mit Euch reden.~
@125 = ~Ich weiß nicht, was habt Ihr gemacht?~
@126 = ~Ich habe nichts getan!~
@127 = ~Oh, kommt schon! Dann wärt Ihr nicht hier.~
@128 = ~Ihr habt gerade tote Menschen erwähnt. Vielleicht solltet Ihr aufhören, Eure Verbrechen zu leugnen!~
@129 = ~„Nichts“, hm? Und was genau war dieses „Nichts“, das Euch hierher gebracht hat?~
@130 = ~Mein Name ist Dorsay, ich war einmal ein Seekapitän …~
@131 = ~Es … es ist wahr! Ich habe nichts getan … Als die ersten Matrosen krank wurden, habe ich nichts getan … Als die Hälfte der Mannschaft sich hinlegte und der erste starb, als die Symptome deutlich sichtbar waren … habe ich nichts getan, weil ich die Ware entladen lassen wollte. Ich habe abgestritten, dass eine Gefahr für die Stadt besteht, sollten wir an Land gehen. Es gibt Regeln für Quarantäne … Ich habe die Besatzung unter Quarantäne gestellt, aber nicht die Waren. Woher sollte ich wissen, dass es wirklich die Pest war, die wir aus Chult mitgebracht haben?! Ach, wenn Ihr nicht hier seid, um mir etwas anzutun, und auch keine Wachen seid, überlasst Ihr mich am besten meinem Schicksal.~
@132 = ~Das Meer … es ruft nach mir. So nah und doch so weit weg …~
@133 = ~Dann geht besser!~
@134 = ~Wer … wer seid Ihr? Ihr seid keine Wachen.~
@135 = ~Ich bin <CHARNAME>, und ich habe Zugang zu diesem Gefängnis und darf mit den Gefangenen sprechen.~
@136 = ~Ich stelle hier die Fragen. Sagt mir, wer Ihr seid.~
@137 = ~Ihr seht erstaunlich kultiviert aus für jemanden, der Verbrechen begangen hat, die zu lebenslanger Haft in diesem Kerker führten.~
@138 = ~Ah, noch ein Mörder, der auf seine Gerechtigkeit wartet!~
@139 = ~So … so ein freundliches Gesicht. Es ist Jahre her, dass mich jemand so freundlich angesprochen hat.~
@140 = ~Warum seid Ihr hier?~
@141 = ~Nun, das könnte bald vorbei sein, je nachdem, warum Ihr hier seid. Erzählt es mir!~
@142 = ~Ich fürchte, das war meine gute Tat für diesen Tag. Jetzt müsst Ihr Euch für den Mord verantworten, den Ihr begangen habt!~
@143 = ~Nein, bitte nicht! Nein! Ich habe niemanden getötet. Wisst Ihr nicht einmal, wessen ich beschuldigt werde?~
@144 = ~Bitte sagt es mir.~
@145 = ~Und was sollte das sein?~
@146 = ~Nein, und ich will es auch nicht hören.~
@147 = ~Oh, das sind das Verlies für die wirklich gefährlichen Kriminellen, nicht nur für Schläger und Mörder. Ich sage nicht, dass ICH so ein Verbrecher bin …~
@148 = ~(seufz) Natürlich nicht. Lasst mich raten, Ihr seid unschuldig?~
@149 = ~Wenn Ihr hier drin seid, seid Ihr mit Sicherheit mindestens ein Mörder!~
@150 = ~Ich bin Timothy Malastair. Ich bin der Vetter von Herzog Eltan. Ich wurde angeklagt … ich wurde verurteilt, ein Attentat auf Herzog Eltan inszeniert zu haben, was Hochverrat bedeutet. Hätte ich vorgehabt, meine Familienanteile an der Flammenden Faust zu vergrößern, hätte dies zumindest Sinn ergeben, aber ich war damals Anwärter auf eine Führungsrolle beim Eisenthron! Ja, ich weiß, es ist wenig überzeugend, dass ich darauf bestehe, unschuldig zu sein, aber es ist die Wahrheit! Ich danke Euch, dass Ihr mir zugehört habt. Ich erwarte nicht, dass Ihr mir glaubt, aber es tat gut, wenigstens darüber reden zu können.~
@151 = ~Und ich kann es Euch nicht verübeln.~
@152 = ~So sehr ich mich auch über das Gespräch mit Euch gefreut habe, weiß ich doch, dass Ihr dringendere Angelegenheiten zu erledigen habt.~
@153 = ~Ich habe hier Beweise für Eure Unschuld!~
@154 = ~Ich werde gehen.~
@155 = ~Ihr … Wie … Nach all diesen Jahren?! Das ist brillant! Bitte, übergebt es schnell an Eltan oder eine andere Autorität!~
@156 = ~(Wahrheit) Werde ich.~
@157 = ~Ihr seht kein Problem darin, dass Herzog Eltan das hier bekommt? Die Anschuldigung lautete ja, dass Ihr versucht habt, ihn zu töten. Er könnte einen Groll hegen oder sich schämen, dass er im Unrecht war.~
@158 = ~Ja, seht, ich habe nachgedacht … Das muss sehr wertvoll für Euch sein, meint ihr nicht?~
@159 = ~Was? Nein, ich hatte nicht vor, Euch zu helfen. Ich wollte Euch das zeigen und Euch ins Gesicht lachen!~
@160 = ~Oh, danke, danke! Ah, mein Herz … Ich muss mich ein wenig beruhigen, es fühlt sich an, als würde ich platzen. Von der Freiheit zu träumen, nach all den Jahren …~
@161 = ~Was? Oh, nein. Eltan ist nicht so. Er nimmt diese Angelegenheiten sehr ernst, was bedeutet, dass er mich hierher gebracht hat, als die Beweise auf meine Schuld hindeuteten. Aber er wird dafür sorgen, dass ich freigelassen werde, wenn das nicht mehr der Fall ist. Bitte gebt es ihm oder dem Seeturm-Kommandanten, der vielleicht eher verfügbar ist.~
@162 = ~Ist es … ist es Gold, was Ihr wollt? Ich kann einen Brief an meine Mutter senden und jemanden schicken, der sich mit Euch trifft. Sie werden dort sein! Wie klingen …. 3.000 Gold für Euch?~
@163 = ~Das klingt großartig! Wo werde ich sie treffen?~
@164 = ~Ah, dieser hoffnungsvolle Blick in Euren Augen – unbezahlbar. Und jetzt werden wir ihn sterben lassen. Seht Ihr diesen Zettel mit den Beweisen? Ups, wie ungeschickt von mir, jetzt ist er nur noch ein Fetzen. Ich glaube nicht, dass noch jemand lesen kann, was darauf geschrieben stand.~
@165 = ~Sagen wir … hinter dem Tempel des Helm, im Norden von Baldurs Tor. Bitte, geht dorthin und übergebt den Zettel. Ihr werdet mein Retter sein, unabhängig von dem Gold, das Ihr verlangt.~ ~Sagen wir … hinter dem Tempel des Helm, im Norden von Baldurs Tor. Bitte, geht dorthin und übergebt den Zettel. Ihr werdet meine Retterin sein, unabhängig von dem Gold, das Ihr verlangt.~
@166 = ~Nein! Nein … Wie könnt … wie könnt Ihr … Die Beweise! Nach all dieser Zeit … So nah … Ich …~
@167 = ~Ah, Ihr seid es! <CHARNAME>, der Retter der Stadt – und auch mein ganz persönlicher! Die Herzöge haben mich gebeten zu beaufsichtigen, was mit diesem Gebäude geschehen soll. Wer hätte gedacht, dass die Jahre im Kerker nun der Grund dafür sind, dass ich das volle Vertrauen der Herzöge genieße und sozusagen großen Einfluss auf den Wiederaufbau der örtlichen Niederlassung habe. Die Wege der Götter sind in der Tat unergründlich.~ ~Ah, Ihr seid es! <CHARNAME>, die Retterin der Stadt – und auch meine ganz persönliche! Die Herzöge haben mich gebeten zu beaufsichtigen, was mit diesem Gebäude geschehen soll. Wer hätte gedacht, dass die Jahre im Kerker nun der Grund dafür sind, dass ich das volle Vertrauen der Herzöge genieße und sozusagen großen Einfluss auf den Wiederaufbau der örtlichen Niederlassung habe. Die Wege der Götter sind in der Tat unergründlich.~
@168 = ~Übrigens, meine Mutter möchte, dass Ihr das hier bekommt, als kleine Entschädigung für Ihre Mühen. Sie entschuldigt sich ausdrücklich dafür, dass sie ihre Dankbarkeit nicht auf eine angemessenere Weise zum Ausdruck gebracht hat.~
@169 = ~Nun, ich muss jetzt gehen und darüber nachdenken, wie die Sache gerettet werden kann und wie sehr ich daran beteiligt sein möchte. Es war schön Euch wiederzusehen, <CHARNAME>. Lebt wohl.~
@170 = ~<CHARNAME>, seid gegrüßt. Seht mal, was aus diesem Ort geworden ist. Es ist nicht gerade so, wie ich mir das vorgestellt habe. Aber ein Händler muss Gelegenheiten ergreifen, wenn sie sich bieten.~
@171 = ~Die Herzöge haben mich gebeten zu beaufsichtigen, was mit diesem Gebäude geschehen wird. Wer hätte gedacht, dass die Jahre in den Kerkern nun der Grund dafür sind, dass ich das volle Vertrauen der Herzöge genieße und sozusagen großen Einfluss auf den Wiederaufbau der örtlichen Niederlassung habe. Die Wege der Götter sind in der Tat unergründlich.~
@172 = ~Ich bin froh, dass es Euch gutgeht. Ich danke Euch für das Gold.~
@173 = ~Ich bin froh, dass es Euch gutgeht.~
@174 = ~Ich stehe in Eurer Schuld, <CHARNAME>.~
@175 = ~Möglichkeiten? Ihr lasst doch nicht diese armen Leuten dafür bezahlen, dass sie sich hier aufhalten, oder?~
@176 = ~Ihr macht also Gold aus dem Gebäude, das in ein Kinderzimmer umgewandelt wurde. Ihr seid ein echter Geschäftsmann, muss ich sagen.~
@177 = ~Schön, dass Ihr so viel zu tun habt, aber ich muss los.~
@178 = ~Was? Nein, absolut nicht! Aber wir verkaufen die Bandagen an die Priester und bekommen dafür eine Entschädigung von den Herzögen.~
@179 = ~Nun, das alles kostet und das Gebäude LEIDET. Es muss wieder aufgebaut werden, wenn diese unruhigen Zeiten vorbei sind.~
@180 = ~Ich will Euch nicht länger aufhalten. Ich bin sicher, wir haben alle viel zu tun. Lebt wohl, mein Retter.~ ~Ich will Euch nicht länger aufhalten. Ich bin sicher, wir haben alle viel zu tun. Lebt wohl, meine Retterin.~
@181 = ~Guten Abend! Seid Ihr wegen <CHARNAME> hier?~
@182 = ~Ja, <PRO_HESHE> hat mich geschickt.~
@183 = ~Nein, <PRO_HESHE> wird in Kürze hier sein.~
@184 = ~Ich warte auf den Beweis für die Unschuld meines Sohnes. Bitte beeilt Euch und bringt ihn mir.~
@185 = ~Ihr seid also gekommen. Zeigt mir bitte die Beweise.~
@186 = ~Hier, nehmt ihn für umsonst. Ich habe beschlossen, aus dem Elend Eurer Familie kein Gold zu machen.~
@187 = ~Bitte sehr. Gebt mir die vereinbarte Summe.~
@188 = ~Das werde ich, aber der Preis ist gerade gestiegen. Er kostet jetzt 5.000 Gold.~
@189 = ~Was, keine Worte des Dankes, der Hoffnung, dass Euer Sohn wieder frei sein wird? Keine Tränen, keine Emotionen?~
@190 = ~Ah, ich habe meine Meinung geändert. Ich werde jetzt gehen.~
@191 = ~Bitte, wenn Ihr mehr Gold wollt, werden wir mehr bezahlen.~
@192 = ~Also gut, 5.000 Gold und er gehört Euch.~
@193 = ~Nee, ich habe gerade meine Meinung geändert. Ich werde ihn behalten, vielleicht zünde ich ein Feuer damit an oder benutze ihn, wenn ich hinter die Büsche gehe … Wer weiß?~
@194 = ~Oh nein … Wie kann jemand nur so grausam sein? Meine Wachen sind nicht stark genug, um es mit Euch aufzunehmen, und wir beide wissen das. Ändert Eure Meinung und kommt zurück, ich bitte Euch!~
@195 = ~Ich wäre … sehr dankbar, wenn Ihr mir die Beweise aushändigen würdet, die meinen Sohn aus seiner unverdienten Haftstrafe befreien werden … <PRO_LADYLORD>.~
@196 = ~Seht Ihr? Das war doch gar nicht so schwer. Hier, bitte schön.~
@197 = ~Ich danke Euch. Es scheint ein letzter Funke Ehre in Euch zu sein.~
@198 = ~Ich danke Euch. Es scheint noch eine Art von Ehre in Euch zu sein, wenn man das so nennen kann.~
@199 = ~Ich habe nichts anderes erwartet, aber trotzdem danke ich Euch.~
@200 = ~Ich werde jetzt gehen. Es wäre ratsam, keinen Ärger zu machen.~
@201 = ~Das ist nah genug.~
@202 = ~Tretet bitte einen Schritt zurück!~
@203 = ~Sprecht mit ihrer Gnaden, nicht mit mir.~
@204 = ~Ich habe hier Beweise, die belegen, dass Euer Cousin Malastair unschuldig an dem Anschlag auf Euer Leben ist, für den er verurteilt wurde. Es war die ganze Zeit Sarevok!~
@205 = ~Timothy? Er soll unschuldig sein? Ich will das sofort haben!~
@206 = ~Ah, wie weit reichen die Intrigen dieser Schlange?! Ich danke Euch, dass Ihr mich darauf aufmerksam gemacht habt. Ich schwöre, sobald die Situation geklärt ist und ich wieder das volle Kommando über die Flammende Faust habe, werde ich dafür sorgen, dass Timothy zu seinem Recht kommt. Ich bete zu den Göttern, dass es Euch gelingen wird, Sarevok aufzuhalten, <CHARNAME>.~
@207 = ~Ah, wie weit gingen die Intrigen dieser Schlange?! Ich danke Euch, dass Ihr mich darauf aufmerksam gemacht habt. Ich schwöre bei meiner Ehre als Kommandant der Flammenden Faust, dass ich dafür sorgen werde, dass Timothy zu seinem Recht kommt.~
@208 = ~Ich habe auch gehört, dass Ihr es wart, der den Beweis gefunden hat, dass mein Cousin Timothy Malastair, der wegen eines Attentats auf mich verurteilt wurde, tatsächlich unschuldig ist. Ich danke Euch dafür, dass Ihr die Beweise geliefert habt und unserer Familie eine Chance zur Heilung gegeben habt. Unsere Dankbarkeit gilt Euch.~
@209 = ~Timothy? Er soll unschuldig sein? Ich will das sofort haben! Ah, wie weit gehen die Intrigen dieser Schlange?! Ich danke Euch, dass Ihr mich darauf aufmerksam gemacht habt. Ich schwöre bei meiner Ehre als Kommandant der Flammenden Faust, dass ich dafür sorgen werde, dass Timothy zu seinem Recht kommt.~
