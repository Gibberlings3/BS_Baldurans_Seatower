// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Frei! Endlich bin ich frei! Ich danke Euch, meine Retter, dass Ihr mich aus der Kontrolle dieses jungen Nabassus befreit habt. Sein Todesblick hatte mich direkt in dem Augenblick getroffen, als mein Freund und ich diese Hallen betraten, und seitdem war ich verpflichtet, ihm zu dienen.~
@1 = ~Klaus hat es nach draußen geschafft, aber … ich denke nicht, dass es ihm gut geht, wenn man bedenkt, dass Ihr die Schriftrolle haben müsst, um die Kerker betreten zu haben …~
@2 = ~Er ist am Leben, falls Ihr Euch darüber Sorgen macht.~
@3 = ~Als ich ihn das letzte Mal sah, war er in Baldurans Seeturm und hat Kaninchen beschworen. VIELE Kaninchen.~
@4 = ~Oh, er hat sie mir aus freien Stücken gegeben. Zumindest würde ich es so nennen.~
@5 = ~Was ist damit?~
@6 = ~Ihr seid also derjenige, von dem der verrückte Magier gesprochen hat.~
@7 = ~Oh, Ihr meint, dieser verrückte Magier hat davon gesprochen, EUCH zu retten? Ich dachte, er sprach von unserem „Gastgeber“ Alguine.~
@8 = ~Oh, ich wollte nichts unterstellen!~
@9 = ~Hat er?~
@10 = ~Ähm, Kaninchen?~
@11 = ~Ich dachte nur, er würde … na ja, einen Weg suchen, um mir zu helfen, das ist alles.~
@12 = ~Oh, das hat er. Glaubt mir, das hat er.~
@13 = ~Nun, hier sind wir! Nicht?~
@14 = ~Er war nicht wirklich in der Lage dazu, aber ich glaube, er hat es versucht.~
@15 = ~Warum geht Ihr nicht und findet es selbst heraus?~
@16 = ~Ah! Oh! Ich verstehe.~
@17 = ~Ich muss ihn finden und sehen, wie es ihm geht. Der arme Mann, er muss wirklich verzweifelt sein … Vielen Dank, meine Retter. Ich habe nichts bei mir, was Euch von Nutzen sein könnte, aber wenn wir uns das nächste Mal treffen, habe ich etwas für Euch parat.~
@18 = ~Verrückter Magier? Meint Ihr zufällig Klaus?~
@19 = ~Ich glaube, das war sein Name, ja. Er war auf der Suche nach jemandem, der stark genug ist, „ihn“ zu retten. Ich nehme an, er hat sich auf Euch bezogen?~
@20 = ~Ratten! Hier sind überall Ratten! Ich schwöre, ich habe oben Ratten herumlaufen sehen. Das ist so widerlich!~
@21 = ~Macht die Tür nicht auf! Er tut es schon wieder. Dieser Mann ist VERRÜCKT!~
@22 = ~Ich muss die richtigen beschwören. Die richtigen werden ihn befreien. Die richtigen werden die Bestie töten. Die richtigen …~
@23 = ~Nicht der richtige! Niemals der richtige … Ich … ich werde ihn niemals retten … Niemals …~
@24 = ~Oh nein, Herr Klaus! Ihr wisst doch noch, was gesagt wurde, nicht wahr? Jetzt muss ich Euch aus dem Gasthaus schmeißen … Es tut mir sehr leid, das müsst Ihr mir glauben.~
@25 = ~Kommt, packt Eure Sachen – lasst die Kaninchen hier, ich werde sie gleich einsammeln – und folgt mir, bitte …~
@26 = ~Jetzt kann ich die richtigen herbeirufen! Wollt Ihr sie sehen?~
@27 = ~Ah, da seid Ihr ja. Was wollt Ihr mir zeigen?~
@28 = ~Was meint Ihr, könnt Ihr jetzt braune Kaninchen herbeizaubern?~
@29 = ~Lasst mich in Ruhe, ich habe gerade alle Eure dummen Kaninchen durch die Flure des Gasthauses gejagt, ich will wirklich nicht noch mehr sehen.~
@30 = ~Wagt es nicht, in meiner Gegenwart ein weiteres Kaninchen zu beschwören!~
@31 = ~Aber … es sind jetzt die richtigen! Sie müssen es sein. Ich muss es jemandem zeigen, sonst bin ich mir nicht sicher!~
@32 = ~Kann ich es Euch jetzt zeigen?~
@33 = ~Jetzt habe ich Zeit, ja.~
@34 = ~(seufz) Gut, dann zeigt es mir.~
@35 = ~Nein.~
@36 = ~Nein, die Farbe ist irrelevant.~
@37 = ~Es sind die Zähne! Seht Euch die Zähne an!~
@38 = ~Wir müssen sie testen … die richtigen!~
@39 = ~Nein! NEIN!! Tot! Es ist tot … Es ist nicht stark genug … Niemals stark genug …~
@40 = ~Was im Namen der Götter war das?~
@41 = ~Ein vampirisches Kaninchen? Echt jetzt?~
@42 = ~Warum finden wir nicht heraus, ob Ihr stark genug seid, Ihr Idiot?~
@43 = ~Aber IHR seid es! Ihr seid stark genug! Nehmt dies und geht hinein. Das Schicksal will es so! Das Schicksal! Ja! Und rettet ihn … Bitte rettet ihn … Er ist in den Ruinen, den alten Ruinen im Scharfzahnwald, er ist gefangen!~
@44 = ~Es wird mir eine Ehre sein, Eurem Freund zu helfen.~
@45 = ~Äh, was?~
@46 = ~Wir sprechen von einer Person, ja? Nicht von einem Kaninchen? Und vor allem nicht von der letzten Art, hm?~
@47 = ~Ein Verlies zum Erforschen? Klar, warum nicht?~
@48 = ~Hört auf, schmutzige Schriftrollen in mein Seil zu stecken!~
@49 = ~Bitte … jemand muss ihn retten …~
@50 = ~WAS in Selunes Namen war das denn? Wir haben schon genug Mühe und Arbeit, die Abscheulichkeiten zu bekämpfen, die die Reiche unserer Göttin entehren, da brauchen wir NICHT auch noch neue untote Kreationen!~
@51 = ~Ich wette, es war ein vampirisches Kaninchen.~
@52 = ~Oh, das ist ja toll. Wo wart Ihr denn, als ich gegen das untote Kaninchen gekämpft habe?~
@53 = ~Wir sind so schnell gekommen, wie wir konnten. Ihr habt ja genug Lärm gemacht.~
@54 = ~Was sollen wir mit diesem Dummkopf machen?!~
@55 = ~Dieser Mann ist sehr aufgewühlt, Priesterin der Selûne. Wir Mönche von Ilmater werden ihn aufnehmen und ihm Obdach gewähren, bis sich sein rasender Geist wieder beruhigt hat.~
@56 = ~Pfft, wie Ihr wollt. Aber ich garantiere Euch, dass wir NICHT in der Lage sein werden, Eure Schreie zu hören, wenn dieser Verrückte weiterhin vampirische Kaninchen im Inneren des Klosters beschwört. (schnaub)~
@57 = ~Vielen Dank, dass Ihr uns geholfen habt.~
@58 = ~Ihn retten … Wir müssen einen Weg finden, einen Weg …~
@59 = ~Klaus, es tut mir wirklich leid, aber ich habe Ulf nicht befreit.~
@60 = ~Ups, ich wusste doch, dass ich in diesem Verlies etwas zu tun hatte.~
@61 = ~Ihr … Ihr habt es geschafft!~
@62 = ~Nein … nein! Ulf …~
@63 = ~Jemand muss ihn retten …~
@64 = ~Oh! Oh, sieh mal, wer da ist, Klaus! Es sind die Abenteurer, die mich gerettet haben! Seid willkommen! Willkommen, meine Freunde.~
@65 = ~Ich … ich danke Euch, dass Ihr meinen Freund gerettet habt.~
@66 = ~Ich sagte, dass ich bei unserem nächsten Treffen eine Belohnung bereithalten würde. Lasst sie mich schnell holen.~
@67 = ~Macht Euch keine Gedanken über eine Belohnung.~
@68 = ~Schön, dass es Euch allen gut geht.~
@69 = ~Es ist an der Zeit!~
@70 = ~Was? Oh, nein, nein, nein.~
@71 = ~Ihr verdient eine Belohnung, und wir sind mehr als bereit, Euch eine zu geben für das, was Ihr getan habt.~
@72 = ~Was Ihr für uns getan habt, war, gelinde gesagt, großzügig. Ich hoffe, dies wird Euch von Nutzen sein.~
@73 = ~Alles, was ich sagen kann, ist, dass es ist eine schlechte Idee, Verliese säubern zu gehen, wenn die Gruppe nur aus zwei Magiern besteht. Eine sehr schlechte Idee.~
@74 = ~Ich meine … äh, das war für UNS. Heh.~
@75 = ~Ich will nicht undankbar klingen, aber Klaus ist in sehr schlechtem Zustand und muss sich bald wieder ausruhen.~
@76 = ~Habt Ihr noch weitere Fragen?~
@77 = ~Könnt Ihr mir etwas über dieses Verlies erzählen?~
@78 = ~Also gut, ich kann nicht mehr schweigen. WARUM KANINCHEN?~
@79 = ~Keine Fragen mehr. Ich hoffe, es geht Euch gut.~
@80 = ~Dann lasse ich Euch beide jetzt allein.~
@81 = ~Das Labyrinth der zukünftigen Erinnerungen, ja. Wir haben in einem sehr alten Folianten darüber gelesen und bald darauf Almirans Schriftrolle entdeckt. Wir wissen allerdings nicht allzu viel darüber, es gibt nur wenig zu finden – hauptsächlich Beschreibungen von Leuten, die den Eingang gefunden haben und darin waren. Zumindest von denen, die heil wieder herauskamen, denn es kann auch ganz anders laufen. Der thailändische Magier Almiran war der erste, der einen direkten Eingang fand und ihn mit seiner Schriftrolle zu stabilisierte. Wir wissen nicht, was aus ihm geworden ist.~
@82 = ~Anscheinend kann nur derjenige, der die Schriftrolle erhalten hat, „zukünftige Erinnerungen“ seines Lebens sehen. Wir wussten das nicht, als wir die Schriftrolle erwarben. Klaus war in unserem Fall der Auserwählte, ich habe einfach mitgemacht und zugesehen, wie er leidet …~
@83 = ~Das wollte … ich nicht. Wollte etwas Größeres … Aber hatte auch Angst, wirklich etwas ganz anderes …~
@84 = ~Der arme Klaus hat seit dem Kampf mit dem Nabassu die Aufmerksamkeitsspanne eines Kleinkindes, und ich schätze, das Verlies hat das noch verstärkt. Wie ich schon sagte, sind wir für Eure Hilfe dankbar – bei allem.~
@85 = ~Unser aufrichtiger Dank wird Euch begleiten, Freund. Es tut uns sehr leid, dass Ihr unseretwegen in so große Schwierigkeiten geraten seid.~ ~Unser aufrichtiger Dank wird Euch begleiten, Freundin. Es tut uns sehr leid, dass Ihr unseretwegen in so große Schwierigkeiten geraten seid.~
@86 = ~Tut mir wirklich leid … Ich wusste nicht, wie ich Ulf sonst helfen sollte …~
@87 = ~Klaus, überanstreng dich nicht. Komm, setz dich einen Moment hin.~
@88 = ~Das stimmt nicht. Du bist derjenige, der all die Monate in einen Düsterschrecken verwandelt war … Ich sollte mich um dich kümmern, nicht andersherum …~
@89 = ~Unsinn. Ich bin so gut wie neu. Du bist derjenige, der sich die ganze Zeit Sorgen und sich auf die Suche gemacht hat, geschwächt von diesem Verlies. Hier, nimm diese Decke … Willst du etwas trinken? Ich könnte die Köchin um eine ihrer feinen Brühen bitten …~
@90 = ~Ihr werdet hier immer willkommen sein, Freund.~ ~Ihr werdet hier immer willkommen sein, Freundin.~
