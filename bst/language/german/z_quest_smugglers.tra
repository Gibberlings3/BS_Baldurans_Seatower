// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-09-06, 13:51
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Ihr! Ihr seid diejenigen, mit denen ich reden muss.~
@1 = ~Und Ihr seid gekommen!~
@2 = ~Bitte, bitte hört mir zu!~
@3 = ~Ihr habt die tote Ordensschwester gefunden. Ich bin kein Ungeheuer!~
@4 = ~Ich schätze, man hat Euch gesagt, dass ich ein rücksichtsloser Dieb sei.~
@5 = ~Ich muss erklären, was passiert ist. Und … ich brauche Eure Hilfe.~
@6 = ~Gut, ich werde zuhören.~
@7 = ~Ich werde Euch nicht helfen, aus dem Gefängnis zu kommen!~
@8 = ~Warum habt Ihr nach mir gefragt?~
@9 = ~Warum sollte ich auf Euch hören?~
@10 = ~Was? Nein! Darum geht es hier ÜBERHAUPT nicht!~
@11 = ~Warum ich?~
@12 = ~Ich … ich werde Euch Gold geben. Ich habe etwas davon mitgenommen, bevor ich hierherkam, richtig? Ich habe noch etwas davon und werde Euch sagen, wo ich es hingelegt habe.~
@13 = ~Ihr seid diejenigen, die die Nashkell-Minen geräumt haben. Es gab eine Diskussion zwischen dem Kommandanten und der Flammenden Faust, ob Ihr eine Bedrohung oder eine Hilfe sein könntet, und sie haben sich vorerst für Hilfe entschieden in der Hoffnung, dass Ihr nicht Amn verpflichtet seid. Ich brauche einen Söldner, der kämpfen kann und bereit ist, sich einer Bedrohung zu stellen, vor der andere vielleicht weglaufen. Ihr habt bewiesen, dass Ihr ein solcher Mann seid.~ ~Ihr seid diejenigen, die die Nashkell-Minen geräumt haben. Es gab eine Diskussion zwischen dem Kommandanten und der Flammenden Faust, ob Ihr eine Bedrohung oder eine Hilfe sein könntet, und sie haben sich vorerst für Hilfe entschieden in der Hoffnung, dass Ihr nicht Amn verpflichtet seid. Ich brauche eine Söldnerin, die kämpfen kann und bereit ist, sich einer Bedrohung zu stellen, vor der andere vielleicht weglaufen. Ihr habt bewiesen, dass Ihr eine solche Frau seid.~
@14 = ~Es geht um meinen Bruder. Er steckt in Schwierigkeiten … Er ist der Grund, warum ich das Gold genommen habe.~
@15 = ~Es ist das Gold, das ich wollte … Ich wollte Martina nie wehtun. Die arme Frau … Ich weiß, dass sie und Lenard ein Liebespaar waren. Es tut mir leid, dass sie gestorben ist. Es war ein Unfall, ich schwöre es. Ich brauchte das Gold, um meinem Bruder zu helfen.~
@16 = ~Mein Bruder lebt in Nashkell und wird von Schmugglern bedroht. Er hatte … eine schlimme Zeit und sich eine Zeit lang an den Schwarzen Lotus verloren. Aber das ist längst vorbei! Er hat … Verpflichtungen, denen er nicht nachkommen konnte, und jetzt haben sie mein Gold genommen und bedrohen ihn immer noch. Bitte, helft uns!~
@17 = ~Euer Bruder ist also süchtig nach Schwarzem Lotus und Ihr erwartet von mir, dass ich ihn aus seinen Schulden heraushole?~
@18 = ~Schmuggler in Nashkell? Erzählt mir mehr.~
@19 = ~Schmuggler in Nashkell? Hm … Ich hätte da vielleicht eine Idee, wer das sein könnte. Erzählt mir mehr.~
@20 = ~Und was erwartet Ihr von mir?~
@21 = ~Ich habe alle seine Schulden bezahlt! Aber sie sagten, dass es zu spät ist und dass er verkauft wird, wenn ich nicht mehr bringe. Ich kam hierher zurück, um Hilfe zu holen, aber meine … Taten waren bereits bekannt, also sitze ich jetzt hier im Gefängnis fest.~
@22 = ~Jemand muss diese Bastarde zur Rede stellen. Bitte, Ihr habt bewiesen, dass Ihr in der Lage seid zu kämpfen. Ich werde dafür sorgen, dass es sich für Euch lohnt!~
@23 = ~Es sollte ein zweites Treffen geben, zu dem ich mehr Gold mitbringen sollte, im Lotus-Zelt in Nashkell. Ich bin hergekommen, um nach ein paar freien Tagen zu bitten, aber ich wurde verhaftet … Bitte, nehmt das Gold und bringt es zu den Schmugglern. Oder behaltet das Gold und stellt Euch ihnen entgegen … Sie sind Euch nicht gewachsen, das schwöre ich!~
@24 = ~Warum habt Ihr das Eurem Kommandanten nicht gesagt?~
@25 = ~Das Gold gehört den Ilmater-Mönchen! Ich kann es nicht zu Schmugglern bringen, tut mir leid.~
@26 = ~Das werde ich tun, aber nicht mit dem Gold, das Ihr gestohlen habt. Sagt mir, wo es ist, damit ich den Rest zurückgeben kann!~
@27 = ~Gut, sagt mir, wo das Gold ist.~
@28 = ~Ihr erwartet, dass ich mich mit einer Schmugglerbande anlege, NACHDEM ich das Gold bekommen habe? Ihr seid ein bisschen naiv, findet Ihr nicht?~
@29 = ~Dies ist nicht nur ein persönliches Problem! Es geht um Schmuggler, die anständige Städter bedrohen, und … es wird genug Reichtum geben, um alle zu bezahlen! Bitte helft meinem Bruder!~
@30 = ~Nein, kein Interesse.~
@31 = ~Ich brauche jemanden, der in der Lage ist, nach Nashkell zu gehen … Ich könnte den Hauptmann um Hilfe bitten, aber was können er oder die Flammende Faust tun? Gar nichts! In Amn sind sie keine Hilfe. Außerdem … würden sie das Gold an das Kloster zurückgeben und dann wäre alle Hoffnung verloren …~
@32 = ~Das werde ich nicht tun, tut mir leid.~
@33 = ~Euer Bruder ist mir völlig egal, Ihr Narr.~
@34 = ~Das heißt, Ihr werdet meinem Bruder helfen?~
@35 = ~Ja, ich werde ihm helfen. Sagt mir, was ich tun soll.~
@36 = ~Das habe ich nicht gesagt.~
@37 = ~Ich habe keine andere Wahl … Bitte, es ist mehr Gold, als sie verlangt haben. Ihr werdet für Eure Dienste bezahlt. Sie werden Euch nicht angreifen, wenn Ihr als Bote kommt, das schwöre ich! Sie sind nur eine Bande von Dieben, die Waren schmuggeln, um die Hafengebühren zu sparen. Sie sind nicht blutdürstig, wenn Ihr sie nicht angreift!~ ~Ich habe keine andere Wahl … Bitte, es ist mehr Gold, als sie verlangt haben. Ihr werdet für Eure Dienste bezahlt. Sie werden Euch nicht angreifen, wenn Ihr als Botin kommt, das schwöre ich! Sie sind nur eine Bande von Dieben, die Waren schmuggeln, um die Hafengebühren zu sparen. Sie sind nicht blutdürstig, wenn Ihr sie nicht angreift!~
@38 = ~Ihr habt gerade gesagt, dass sie Euren Bruder versklavt haben! Klingt für mich nach gefährlichen Leuten.~
@39 = ~Ihr scheint sie recht gut zu kennen, nicht wahr?~
@40 = ~Nein, es ist etwas komplizierter als das … Die Schmuggler drohen meinem Bruder Leid an, aber nur wenn ich das Gold nicht rechtzeitig liefere!~
@41 = ~(seufz) Mein Bruder hatte VIEL Ärger. Es ist nicht das erste Mal, dass ich ihn auszahlen musste, aber dieses Mal war es bei weitem die größte Summe. Bitte!~
@42 = ~Bitte! Das ist die letzte Hoffnung für meinen Bruder!~
@43 = ~Es tut mir leid, dass Euer Bruder sich in diese Situation gebracht hat. Ich habe derzeit keine Zeit, mich mit Schmugglern zu beschäftigen.~
@44 = ~Ihr … Ihr wollt doch nicht?~
@45 = ~(seufz) Gut, ich mache es. Sagt mir, was ich wissen muss.~
@46 = ~Ich verstehe schon, Ihr seid nicht der Typ, der gerne hilft. Aber wie ich schon sagte, es gibt die Chance auf mehr Gold … vor allem, wenn Ihr mit den Schmugglern zusammenarbeiten wollt. Sie sind immer auf der Suche nach Helfern … Ich weiß es, weil … sie mir tausend Mal Gold angeboten haben, wenn ich meine Verbindungen für sie nutzen würde.~
@47 = ~Hm. Das hört sich interessant an. Gut, erzählt mir mehr. Ich werde sehen, was ich auf dem Weg für Euren Bruder tun kann.~
@48 = ~(stöhn) Dann ist alle Hoffnung verloren. Sie werden einen Weg finden, ihn bezahlen zu lassen, und ich bin im Gefängnis. Lasst mich in Ruhe, „Held“ der Nashkell-Minen.~ ~(stöhn) Dann ist alle Hoffnung verloren. Sie werden einen Weg finden, ihn bezahlen zu lassen, und ich bin im Gefängnis. Lasst mich in Ruhe, „Heldin“ der Nashkell-Minen.~
@49 = ~Ich danke Euch! Ich danke Euch! Zuerst nehmt das Gold aus der Truhe. Sie befindet sich im Drachenturm, das ist der direkt beim Harnischmacher, oberstes Stockwerk. Ihr müsst sie ganz öffnen, um das versteckte Fach zu finden, sonst kann man das Gold leicht übersehen.~
@50 = ~Wartet, das Gold ist in Eurer Truhe hier im Turm? Wollt Ihr mich auf den Arm nehmen?~
@51 = ~Sehr gut, und was dann?~
@52 = ~Nicht … nicht in meiner. Sie gehört einem der Feldwebel, aber der hat gerade ein paar Tage frei.~
@53 = ~Ah, schlau. Und wo treffe ich die Schmuggler?~
@54 = ~Wisst Ihr, wo sich das Lotuszelt in Nashkell befindet? Es befindet sich ganz im Osten des Jahrmarkts. Vom Zelt aus geht Ihr einfach ein Stück nach Süden, bis die Zelte nicht mehr zu sehen sind, zwischen den Bäumen hindurch. Dort treffen sich die Schmuggler, normalerweise in der Abenddämmerung. Aber es gibt immer einen Ansprechpartner, wenn man weiß, wo man suchen muss.~
@55 = ~Gebt ihnen 1.000 Gold und sagt ihnen, es sei von mir. Dann sollten sie meinen Bruder gehen lassen. Was auch immer Ihr tun wollt – ob Ihr bezahlt, kämpft oder mit den Schmugglern zusammenarbeitet –, sorgt bitte dafür, dass mein Bruder freigelassen wird.~
@56 = ~Ich danke Euch, <CHARNAME>. Und … bitte beeilt Euch! Es ist nicht mehr viel Zeit übrig.~
@57 = ~Hattet Ihr die Möglichkeit, mit meinem Bruder zu sprechen? Ist er im Kloster?~
@58 = ~In der Tat. Er befindet sich wohlbehalten im Ilmater-Kloster und erholt sich von seiner Gefangenschaft.~
@59 = ~Bisher nichts Neues.~
@60 = ~Da seid Ihr ja wieder! Gibt es etwas Neues von meinem Bruder?~
@61 = ~Die Summe ist bezahlt. Er wird in Kürze in Sicherheit sein.~
@62 = ~Ich habe 20.000 Gold an die Sklavenhändler gezahlt. Er wird in Kürze in Sicherheit sein.~
@63 = ~Nun, anscheinend wurde er an Sklavenhändler verkauft … Ich bin aber dran.~
@64 = ~Ich weiß, wie ich ihn freikaufen kann, aber die Sklavenhändler wollen 20.000 Gold!~
@65 = ~Nun ja … Ich glaube, ich war ein bisschen zu ambitioniert. Die Schmuggler hatten keine Zeit, mir zu sagen, wo Euer Bruder jetzt ist, aber wenigstens habe ich sie alle getötet!~
@66 = ~Hm, ich habe beschlossen, dass es mich nicht interessiert. Tut mir leid.~
@67 = ~Ich habe zu lange gewartet, um das Geschäft mit den Sklavenhändlern abzuschließen … Es tut mir leid, er ist für mich unerreichbar.~
@68 = ~Nun ja … Ich habe mich den Sklavenhändlern zu früh entgegengestellt, also weiß ich nicht, wo er ist. Tut mir leid.~
@69 = ~Ich danke Euch für Eure Hilfe. Bitte beeilt Euch! Ich hoffe, es ist noch nicht zu spät …~
@70 = ~Alle Hoffnung ist verloren … Alle Hoffnung …~
@71 = ~Sk… Sklavenhändler?! Ich hätte nie erwartet, dass sie so weit gehen würden!~
@72 = ~Wir werden … wir werden später reden. Bitte geht …~
@73 = ~So … so viel? Ich habe nichts … ich habe nichts mehr … Ich kann nicht erwarten, dass Ihr eine solche Summe aufbringt. Dann ist er verloren …~
@74 = ~Aber noch nicht. Ich werde sehen, was ich tun kann.~
@75 = ~Es tut mir leid, aber ich werde auf keinen Fall eine solche Summe für jemanden ausgeben, den ich nicht einmal kenne.~
@76 = ~Ja, das ist er.~
@77 = ~(seufz) Ich danke Euch, dass Ihr so weit gegangen seid, „Held“ der Nashkell-Minen!~ ~(seufz) Ich danke Euch, dass Ihr so weit gegangen seid, „Heldin“ der Nashkell-Minen!~
@78 = ~Tut … tut er?~
@79 = ~Ihr habt 20.000 Gold bezahlt, um jemanden zu befreien, den Ihr nicht einmal kennt! Ich danke Euch! Ich danke Euch!~
@80 = ~Wir stehen in Eurer Schuld! Nathoriel ist … nicht der beste Mensch, aber es ist nicht nur seine Schuld. Vater starb, als wir noch klein waren, und Mutter fiel dem Schwarzen Lotus anheim … Ich habe ihn aufgezogen, und … ich habe es nicht geschafft, ihn zu einem guten Menschen zu machen. Aber ach, was beklage ich mich … Ich bin im Gefängnis, und was habe ich nicht alles getan!~
@81 = ~Ich danke Euch für Eure Hilfe. Ich werde jeden Tag für Euch beten.~
@82 = ~Irgendetwas sagt mir, dass es komplizierter war, als den Schmugglern einfach das Gold zu geben, das ich hatte. Ich danke Euch! Ich danke Euch!~
@83 = ~Ihr seid diejenigen, die mich vor diesen verfluchten Sklavenhändlern gerettet haben! Ich weiß nicht, wie ich mich bei Euch revanchieren kann. Nein, ich meine es ernst – ich weiß nicht, wie ich die Summe, die Ihr für meine Befreiung ausgegeben habt, jemals zurückzahlen soll. Zeigt bitte ein barmherziges Herz und lasst es gut sein.~
@84 = ~Ich schätze Eure Bemühungen, mich zu befreien, wirklich sehr.~
@85 = ~Das ist auch eine Art, danke zu sagen, denke ich.~
@86 = ~Ihr habt Glück, dass ich bereit war, eine so große Summe für jemanden auszugeben, den ich nicht einmal kenne.~
@87 = ~Eigentlich hat die Seeturm-Wache für Euch bezahlt. Der Kommandant wird Euch ein oder zwei Fragen zu den Sklavenhändlern stellen.~
@88 = ~Ich dachte mir, ich stecke Euch in meine Mine, wo Ihr den Rest Eures Lebens Eure Schulden abarbeiten könnt.~
@89 = ~Kommt jetzt wieder zu Kräften. Die Mönche sollten sich um Eure Genesung kümmern.~
@90 = ~Na dann, auf Wiedersehen.~
@91 = ~Was? Ihr macht Witze, hoffe ich? Ich sollte hier im Kloster sicher sein, und Sklaverei ist in Baldurs Tor verboten!~
@92 = ~Das war ein Scherz, ich habe keine Mine.~
@93 = ~Ihr seid nur aus einem Grund hier: damit der Kommandant die nötigen Informationen darüber erhält, WO die Sklavenhändler operieren!~
@94 = ~Ah, äh, haha… Ihr macht doch Witze, oder? Ich weiß wirklich nicht, wie ich so viel Gold auftreiben kann, selbst wenn ich es versuchen würde.~
@95 = ~Ihr habt meine aufrichtige Dankbarkeit. Aber das ist alles, was ich Euch geben kann.~
@96 = ~Oh, aber wir könnten uns doch kennenlernen. Wie wäre es, wenn Ihr mich zum Beispiel auf einen Krug feines Drachenbier im Gasthaus einladet?~
@97 = ~Langsam bereue ich die Mühe, die ich mir gemacht habe, um Euch zu retten.~
@98 = ~Einen schönen Tag noch. Und grüßt bitte meinen Bruder von mir, ja? Der glänzende Ritter, der im Gefängnis sitzt, wer hätte das gedacht?~
@99 = ~Ja, das ist es, was Shuck immer wieder sagt, aber da bringt er sich auch schon selbst ins Gefängnis, um seinen verlorenen kleinen Bruder zu retten.~
@100 = ~Ihr ekelt mich an, um ehrlich zu sein.~
@101 = ~Was für ein Glück, dass Ihr mich befreit habt, bevor Euch das aufgefallen ist.~
@102 = ~(jammer) Ihr überlasst mich der Gnade des Kommandanten? Habt Ihr nicht von seinem Vernehmer gehört? Ich bin nur ein geschwächtes Opfer des Sklavenhandels. Es ist nicht fair, mich dem Gesetz so in den Rachen zu werfen!~
@103 = ~Das hat nichts mit Eurem früheren Leben zu tun, oder doch? Es geht darum, dass Ihr ein Opfer des Sklavenhandels seid und dabei helft, den anderen Opfern Gerechtigkeit widerfahren zu lassen – und um die Sicherheit der Stadt.~
@104 = ~Alles klar, ich habs kapiert! Ich habs kapiert!~
@105 = ~Nun gut, Shuck. Wie ich sehe, wurde Ihr Wunsch erfüllt. Dann ist es Zeit, an die Arbeit zu gehen.~
@106 = ~Ich … ich habe nichts von Bedeutung zu sagen! Ich schwöre es!~
@107 = ~Wie wäre es, wenn Ihr uns das entscheiden lasst, hm?~
@108 = ~Ihr seid der Vernehmungsoffizier des Turms?~
@109 = ~Dann lasse ich Euch jetzt allein.~
@110 = ~In der Tat. Halbschleuder, zu Euren Diensten.~
@111 = ~Bitte seid nicht zu grausam zu ihm.~
@112 = ~Verschont den Verbrecher nicht, Halbschleuder.~
@113 = ~Wie es weitergeht, hängt ganz von Euch ab, Shuck, hm? Lasst uns beginnen …~
@114 = ~Bitte geht … damit ich mit der Arbeit beginnen kann. Ich werde in Kürze in meinem Geschäft für Kauf und Verkauf zur Verfügung stehen.~
@115 = ~Hallo da, Reisender! Es gibt hier viele feine Beeren zu finden, wenn Ihr wisst, wo Ihr suchen müsst … Oh, Ihr seid es. Leute, wir haben Besuch!~ ~Hallo da, Reisende! Es gibt hier viele feine Beeren zu finden, wenn Ihr wisst, wo Ihr suchen müsst … Oh, Ihr seid es. Leute, wir haben Besuch!~
@116 = ~Hallo da, Reisender! Es gibt hier viele feine Beeren zu finden, wenn Ihr wisst, wo Ihr suchen müsst. Natürlich müsst Ihr die richtige Sorte kennen, um die essbaren Beeren zu pflücken.~ ~Hallo da, Reisende! Es gibt hier viele feine Beeren zu finden, wenn Ihr wisst, wo Ihr suchen müsst. Natürlich müsst Ihr die richtige Sorte kennen, um die essbaren Beeren zu pflücken.~
@117 = ~Also gut, jetzt, da ich einen Verdacht habe, was Ihr wirklich seid, klingt das furchtbar nach einem Kennwort. Wir sind nicht auf der Suche nach Beeren, sondern nach Shucks Bruder. Sagt Euch das was?~
@118 = ~Wir sind hier im Namen von Shuck. Klingelt da was?~
@119 = ~Na dann, viel Spaß bei der Suche nach Euren Beeren.~
@120 = ~Ist das so? Hm, dann ist die Verkleidung wohl überflüssig, denke ich. Leute, wir haben Besuch!~
@121 = ~Es tut mir leid für die Begrüßung, aber Ihr habt „aus Versehen“ unseren Geschäftspartner im Seeturm getötet, also gibt es nur eine Sache, die jetzt hier passieren wird. Ich bin sicher, Ihr versteht das.~
@122 = ~Warum greift Ihr einen unschuldigen Beerenpflücker an? Ihr seid eine gemeine Person, wisst Ihr das?~
@123 = ~Wer zum Teufel seid Ihr?~
@124 = ~Banditen! Ich werde Euch alle töten!~
@125 = ~Beerenpflücker, ja genau.~
@126 = ~Ihr habt also wirklich aus heiterem Himmel angegriffen?~
@127 = ~Wir sind keine Banditen, wir sind Schmuggler. Wir stehlen nicht, wir liefern! Pünktlich und zu einem fairen Preis! Seht Ihr das Zelt da oben im Norden? Wenn wir den Schwarzen Lotus nicht jeden Tag pünktlich dort hinliefern, werden viele Leute in kürzester Zeit sehr verärgert sein. Also, bitte lasst uns in Ruhe. Wer weiß, vielleicht werdet Ihr uns in Zukunft noch einmal brauchen.~
@128 = ~Oh, seht Euch das an! Shuck hat Euch geschickt, was? Denkt er, er kann uns einen Haufen schwer bewaffneter Söldner auf den Hals hetzen, um die Schulden loszuwerden?~
@129 = ~Ja, wir sind die Schmuggler, falls Ihr Euch das gefragt habt.~
@130 = ~Ich bin wegen Shucks Bruder hier, ja. Ich habe das Gold, das Ihr wolltet.~
@131 = ~Ich bin wegen seines Bruders hier, aber Ihr werdet kein Gold dafür sehen! Sagt mir, wo er ist, sofort!~
@132 = ~Ich werde nicht gegen Euch kämpfen. Ich bin hier, weil ich mit Euch zusammenarbeiten möchte!~
@133 = ~Ich bin hier, weil ich kämpfen will. Je mehr von Euch, desto besser!~
@134 = ~Oh, aber findet Ihr nicht, dass Ihr ein wenig überstürzt handelt? Ihr wisst ja noch nicht einmal, wie viele von uns es gibt!~
@135 = ~Gut, dann warte ich, bis ich weiß, wie viele von Euch da sind.~
@136 = ~Nein, ich werde jetzt gegen Euch kämpfen!~
@137 = ~Ho! Ich mag Euch! Ihr habt Rückgrat!~
@138 = ~Schade, dass Ihr einer dieser Weltverbesserer seid, sonst hätte ich Verwendung für Euch.~ ~Schade, dass Ihr eine dieser Weltverbesserinnen seid, sonst hätte ich Verwendung für Euch.~
@139 = ~Schade, dass Ihr mit einem dieser Weltverbesserer reist, ich hätte Verwendung für Euch.~ ~Schade, dass Ihr mit einer dieser Weltverbesserinnen reist, ich hätte Verwendung für Euch.~
@140 = ~(seufz) Jetzt gehts los. Leute …~
@141 = ~Wollt Ihr mir sagen, dass Ihr das ganze Gold, das ich angefordert habe, hier habt?~
@142 = ~Schon gut, schon gut, ich habe verstanden. Ihr seid zu stark für uns. Aber uns hier zu töten, wird Euch nicht helfen, Shucks Bruder zu finden, oder? Bitte hört auf uns zu töten, wir sind Schmuggler, aber wir sind keine Mörder oder Banditen. Wir stehlen nicht, wir liefern!~
@143 = ~Dieser Bruder ist mir völlig egal. Ich bin hier, weil ich mit Euch arbeiten möchte!~
@144 = ~Hört auf zu reden! Ich bin noch nicht fertig mit Euch!~
@145 = ~Oh, kommt schon! Echt jetzt?~
@146 = ~Ich möchte mich kurz vorstellen. Ich bin Holger, und ich bin ein Schmuggler. Meine Kumpels und ich schmuggeln illegale und sehr seltene Waren von Amn zur Schwertküste und nach Baldurs Tor. Lasst mich hier mit offenen Karten spielen. Wir wissen, dass Shuck jetzt im Gefängnis sitzt. Es ist also nur eine Frage der Zeit, bis der Vernehmungsoffizier des Turms in Erfahrung bringt, dass Shuck unser Seeturm-Kontakt war. Er hat der Turmzelle gesagt, wann es sicher wäre anzulanden, und hat dafür gesorgt, dass die Waren gut in die Stadt kommen.~
@147 = ~Shuck hat was getan?~
@148 = ~Oh.~
@149 = ~Er hat mir gesagt, dass er die Kaution für seinen Bruder bei Euch hinterlegen muss.~
@150 = ~A-haha, was für ein schlauer, kleiner Soldat.~
@151 = ~Und das ist wahr!~
@152 = ~Ah, Shuck hat Euch nicht erzählt, dass er für uns arbeitet, oder? Nun, er hat angefangen, für uns zu arbeiten, um seinem Bruder aus der Patsche zu helfen, das ist wahr. Shucks Bruder schuldet uns immer noch Gold, also haben wir zumindest verlangt, dass die Schulden bezahlt werden. Nun, Shuck hat bezahlt, aber zu spät.~
@153 = ~Was meint Ihr mit „zu spät“?~
@154 = ~Nun gut. Ich habe die 1.000 Gold hier, um ihn auszulösen. Also händigt mir Shucks Bruder aus!~
@155 = ~Eure Probleme interessieren mich nicht. Sagt mir, wo Shucks Bruder ist!~
@156 = ~Klingt, als ob Ihr Hilfe gebrauchen könntet, hm?~
@157 = ~Hilfe? Ihr meint, von Euch? Ja, das ist ein faszinierender Gedanke.~
@158 = ~Zumindest wenn ich mich dazu bringe, Euch zu vertrauen. Hmm…~
@159 = ~Denn wir bekommen eine Menge Druck von allen Seiten. Es sind nicht nur wir, die zwielichtige Schmugglersachen machen, wisst Ihr? Konkurrenz und all das, und andere Leute sind viel, viel furchterregender als wir. Was Shucks Bruder angeht …~
@160 = ~Nun ja … Wir mussten die Schulden des Bruders an jemand anderen verkaufen, um unser Gold rechtzeitig zu bekommen. Wir haben dem Narren gesagt, er soll sich beeilen. Wofür hält er uns denn? Für Ilmater-Mönche? Sein Bruder hat sich hier knietief in Probleme verstrickt, wir sind nur Geschäftsleute, die ihren Lohn abholen wollen!~
@161 = ~Hat er seine Schulden verkauft? Und wo ist er jetzt?~
@162 = ~Bei den Neun Höllen, spuckt es schon aus! Wo ist der Bruder jetzt?~
@163 = ~Oh, das tut weh. Ich lebe und atme nach dem Ehrenkodex der Schmuggler! Macht Euch nicht lustig darüber. Man würde sich wünschen, dass sich alle „Kriminellen“ an einen solchen Kodex halten würden, dann wäre die Welt friedlich wie ein Kloster – zumindest für diejenigen, die es bezahlen können.~
@164 = ~Dann sagt mir, wo ich diese Sklavenhändler finden kann!~
@165 = ~Ich bin hier, um Shucks Bruder zu finden, und ich werde nicht ohne ihn zurückkehren!~
@166 = ~Schaut, es sind nicht WIR, die die Sklaverei betreiben, klar? Wir sind nur anständige Schmuggler, die zahlende Kunden mit Dingen versorgen, die sie jedenfalls sonst nicht so … preiswert bekommen könnten. Wir brauchen nur … die Händler für ihre Schiffe, da sie einige unserer Waren auf ihrem Weg von Amn hier hertransportieren, also müssen wir gute Freunde mit ihnen sein. Und wir brauchten das Gold, um einige sehr verärgerte Kunden zu bezahlen. Es war ohnehin schon schwierig mit all den Banditen in der Gegend. Es sind schwierige Zeiten für ehrliche Schmuggler, wisst Ihr?~
@167 = ~Ehrbare Schmuggler? Dass ich nicht lache.~
@168 = ~Wir haben lediglich die SCHULDEN des Bruders des Soldaten an die Sklavenhändler verkauft, weil Gold in diesen Zeiten des bevorstehenden Krieges und der Eisenkrise knapp ist. Viele unserer Kunden konnten nicht rechtzeitig zahlen. Wir haben auch Verpflichtungen!~
@169 = ~Ihr erwartet von mir, dass ich Verständnis für Eure Probleme habe?~
@170 = ~Nun gut, aber ich bin noch nicht fertig mit Euch, glaubt mir!~
@171 = ~Nun, da das geklärt ist, lasst uns über das Geschäftliche reden, ja?~
@172 = ~Dann sind wir hier fertig. Lebt wohl.~
@173 = ~Nun, von den Sklavenhändlern entführt. Wahrscheinlich werden sie gerade zu einem Schiff im Hafen der Stadt transportiert. Was soll ich sagen – es tut mir leid?~
@174 = ~Das heißt, die Schulden des Bruders sind beglichen?~
@175 = ~Sklavenhändler?!~
@176 = ~Ich respektiere Euren Wunsch, Euer Versprechen an Shuck zu halten. Na gut.~
@177 = ~Dann nehmt dies. Das ist eine Kontaktnotiz für eine ihrer Sklavenauktionen. Ihr hättet das von überall her haben können. Ich schicke nur einen potenziellen Kunden zu ihnen, richtig? Es gibt keinen Grund, dass sich meine Hilfe zu meinem Nachteil auswirkt, richtig?~ ~Dann nehmt dies. Das ist eine Kontaktnotiz für eine ihrer Sklavenauktionen. Ihr hättet das von überall her haben können. Ich schicke nur eine potenzielle Kundin zu ihnen, richtig? Es gibt keinen Grund, dass sich meine Hilfe zu meinem Nachteil auswirkt, richtig?~
@178 = ~Ich weiß das zu schätzen.~
@179 = ~Eure Hilfe wäre nicht nötig gewesen, wenn Ihr seinen Bruder nicht verkauft hättet!~
@180 = ~Wenn nicht für unsere, dann für die unserer Kunden. Was glaubt Ihr, was die armen Leute in dem Schwarzer-Lotus-Zelt ohne uns machen würden? Wartet, Ihr müsst das nicht beantworten. Ihr denkt wahrscheinlich, dass es unsere Schuld ist, dass sie überhaupt dort sind!~
@181 = ~Das ist mal eine Antwort, die ich gerne höre!~
@182 = ~Was wollt Ihr damit sagen, bitte?~
@183 = ~Nichts. Nur, dass ich ein Auge auf Euch und Euresgleichen haben werde, also benehmt Euch besser.~
@184 = ~(Wahrheit) Nun, die Zeiten sind hart, wie Ihr schon sagtet. Ich hätte nichts gegen ein paar zusätzliche Geschäfte, um etwas zusätzliches Gold zu verdienen, wenn Ihr wisst, was ich meine.~
@185 = ~(Lüge) Ihr habt angedeutet, dass Ihr eine Verwendung für mich habt. Ich möchte für Euch arbeiten.~
@186 = ~Ich sage, dass ich Euch jetzt, da ich die Informationen habe, die ich brauche, töten werde! Zieht Eure Waffen!~
@187 = ~Das stimmt. Lebt auch Ihr wohl.~
@188 = ~Ihr wollt wirklich für mich arbeiten, hm?~
@189 = ~Schaut mal, ich habe Euch schon viel Vertrauen entgegengebracht, in Ordnung? Wenn ich auch nur mit einem glänzenden Metallanzug wie Euch spreche, wird das von manchen als Verrat angesehen. Aber ich erkenne Potenzial, wenn ich es sehe, also lasst uns das versuchen.~
@190 = ~Ich habe vielleicht einen oder zwei Aufträge, aber zuerst müsst Ihr Euch unser Vertrauen verdienen. Ich muss sehen, wie Ihr mit den Händlern umgeht. Denn wenn Ihr dort hingeht, um Ärger zu machen, der dann auf UNS zurückfällt, dann werden wir keine Geschäftspartner, so viel ist klar. Dann muss ich sehen, wie Ihr Euch im Turm anstellt.~
@191 = ~Ich habe vielleicht einen oder zwei Aufträge, aber zuerst müsst Ihr Euch unser Vertrauen verdienen. Ich muss sehen, wie Ihr Euch im Turm anstellt.~
@192 = ~Wie ich schon sagte, wird der Vernehmer des Turms die Informationen über uns sowieso irgendwann durch Shuck bekommen, also habe ich nichts dagegen, wenn Ihr dem Seeturm-Kommandanten alles das erzählt. Die eigentliche Frage ist aber, wie Ihr danach weitermachen wollt. Denn wenn Ihr mit mir zusammenarbeiten wollt, dann wollt Ihr auch mit der Schmugglerzelle im Turm zusammenarbeiten, so würde ich annehmen. Und da haben wir schon das erste Problem. Seid Ihr immer noch dabei?~
@193 = ~Hmm. Ich weiß, dass Ihr Juan zur Flucht verholfen habt UND Ihr habt bereits das Rätsel gelöst, warum die Turmzelle nicht mehr mit uns kommuniziert, also könnten wir sagen, dass Ihr bereits für mich gearbeitet habt, und zwar in einer sehr wichtigen Angelegenheit. Nun gut. Ich hätte noch eine Aufgabe für Euch.~
@194 = ~Fahrt fort.~
@195 = ~Vor einigen Wochen haben wir den Kontakt mit der Turmzelle verloren – komplett. Dann hat die Turmzelle aufgehört zu liefern. Wir haben Beschwerden aus ganz Baldurs Tor über Kunden, die ihre Waren nicht erhalten! Shuck hat sich auch nicht bei uns gemeldet. Wir mussten glauben, dass die Zelle enttarnt, gefangen genommen oder getötet wurde, oder alles zusammen. Eigentlich hatten wir den Verdacht, dass Shuck uns verraten haben könnte, aber Shuck besteht darauf, dass die Turmzelle aufgehört hat, mit IHM zu sprechen, und dass er nichts gegen uns unternommen hat.~
@196 = ~Euer Kontakt zu den Seeturm-Behörden ist also von Vorteil für uns. Findet heraus, was mit der Schmugglerzelle passiert ist, die früher in Baldurans Seeturm operierte. Wurde sie ausgeschaltet? Wurde sie von einer rivalisierenden Gruppe übernommen? Wurden die Sklavenhändler zu gereizt und denken, sie kämen ohne uns aus?~
@197 = ~Ich glaube, ich kenne die Antwort darauf bereits.~
@198 = ~Das werde ich tun.~
@199 = ~Ich schätze, ich habe keine andere Wahl, als diesen Auftrag anzunehmen.~
@200 = ~Ich bin mir nicht sicher, ob ich bald Zeit haben werde, mich damit zu beschäftigen.~
@201 = ~Oh? Das ist interessant. Aber lasst mich erst zu Ende bringen, was ich sagen wollte.~
@202 = ~Wenn Ihr für uns arbeiten wollt, solltet Ihr Euch Zeit nehmen.~
@203 = ~Hier ist eine sehr wichtige Lieferung für den Koch des Helm und Umhang im Nordwesten von Baldurs Tor. Liefert diese spätestens in den nächsten drei Tagen ab.~
@204 = ~Der Helm und Umhang bekommt Schmugglerware? Habt Ihr keine Angst, dass die Flammende Faust das herausfindet?~
@205 = ~Eine versiegelte Kiste? Wie kann ich darauf vertrauen, dass mir dadurch kein Schaden entsteht?~
@206 = ~Ich möchte wissen, was in dieser Kiste ist, wenn ich sie für Euch abliefern soll.~
@207 = ~In Ordnung, ich bin auf dem Weg.~
@208 = ~Was ist, wenn ich das nicht tun möchte?~
@209 = ~Oh, und wir wollen von Euch, dass Ihr die Kiste nicht öffnet. Sie ist versiegelt, und wir erwarten, dass das Siegel bei Auslieferung unversehrt geblieben ist. Es ist ein Test – offensichtlich.~
@210 = ~Erledigt diese beiden Aufgaben – liefert die Kiste ab und erkundigt Euch, was mit der Turmzelle passiert ist – und meldet Euch bei mir mit Neuigkeiten. Ihr werdet es nicht bereuen. Beeilt Euch aber mit der Lieferung. Ihr habt drei Tage Zeit.~
@211 = ~Erledigt diese Aufgabe – liefert die Kiste ab und meldet Euch bei mir mit Neuigkeiten. Ihr werdet es nicht bereuen. Beeilt Euch aber mit der Lieferung. Ihr habt drei Tage Zeit.~
@212 = ~Dann muss ich jemand anderen mit der Kiste losschicken und zutiefst bereuen, dass ich Euch gerade all die Dinge erzählt habe, die ich getan habe. Und wenn ich etwas bereue, lasse ich die Verantwortlichen das normalerweise ebenfalls bereuen.~
@213 = ~Habt Ihr mir gedroht? Das hättet Ihr nicht tun sollen. Ich werde Euch töten! Zieht Eure Waffen!~
@214 = ~Ihr sollt es ihnen doch nicht verraten. Und urteilt nicht über unsere Kunden. Was habe ich gesagt – nicht alle unsere Waren sind illegal, manche sind nur selten, klar?~
@215 = ~Ah, aber nein, Ihr versteht nicht, worum es hier geht. Es geht nicht darum, dass Ihr mir vertraut. Die eigentliche Frage ist: Warum sollte ich EUCH vertrauen? Schmuggeln bedeutet, dass Ihr Waren liefert, über die Ihr so wenig wie möglich wisst. Und Ihr tut das, weil Ihr wisst, dass ich Euch Waren liefere, für die Ihr gutes Gold bekommt und die Euch nicht schaden werden. Es sei denn, Ihr werdet vom Gesetz erwischt, aber ich muss jetzt nicht erklären, warum das eine Ausnahme ist, oder?~
@216 = ~Also, darum geht es hier. Ihr müsst mir vertrauen, wenn Ihr für mich arbeiten wollt. Aber noch wichtiger ist, dass ich Euch tatsächlich mit meinen Waren vertraue. Ich garantiere, dass diese Kiste weder giftig ist, noch explodieren wird, noch gegen allgemeine Moralvorstellungen verstößt. Solange Ihr städtischen Behörden nicht in die Quere kommt, wird Euch kein Schaden entstehen.~
@217 = ~Mit uns arbeiten? Nun, das ist eine interessante Wendung der Ereignisse. Wie wäre es, wenn wir uns erst einmal kennenlernen?~
@218 = ~Ja, für uns sind seine Schulden abgeschlossen.~
@219 = ~(Wahrheit) Großartig, denn ich könnte mich nicht weniger für den Bruder interessieren. Ich bin hierhergekommen, um mit Euch in Kontakt zu treten. Ich könnte auch etwas zusätzliches Gold gebrauchen.~
@220 = ~Oh, was für eine Erleichterung, wenn man bedenkt, dass wir ihn bereits verkauft haben. Natürlich nicht ihn, sondern seine SCHULDEN. Aber was kann ich tun, wenn die Händler ihn als Rückzahlung nehmen? Dann können wir die ganze Angelegenheit also zu den Akten legen. Zumindest bezweifle ich, dass wir in Zukunft viele Söldner von Shuck sehen werden …~
@221 = ~Nun da, <CHARNAME>. Ihr kehrt zurück, aber was habt Ihr getan? Ihr habt den Kontaktmann des Händlers angegriffen und getötet, nachdem ich Euch die Information gegeben habe, wo er zu finden ist!~
@222 = ~Nun, Ihr habt das Paket an den Kunden ausgeliefert, aber … warum habt Ihr der Flammenden Faust einen Tipp gegeben UND zeigt hier noch einmal Euer Gesicht? Dachtet Ihr, wir würden es nicht wissen?~
@223 = ~Ihr kehrt von Eurer ersten Lieferung zurück!~
@224 = ~Und es war ein Erfolg. Unser Kunde war zufrieden, und ich bin es auch. Gut gemacht!~
@225 = ~Da konnte jemand seine Neugier nicht zügeln und musste hineinschauen, was?~
@226 = ~Und Teile der Lieferung essen, <CHARNAME>?~
@227 = ~Ich habe das Gefühl, dass Ihr nicht versteht, welche Priorität diese Lieferungen haben. Wir machen das nicht, wenn wir die Zeit dazu finden. Sie sind WICHTIG und DRINGEND. Ihr habt getrödelt.~
@228 = ~Nun gut, unser Kunde war damit einverstanden, und das Gold, das er einbehielt, war Euer Anteil, also werde ich ein Auge zudrücken – dieses eine Mal. Dieses eine Mal, <CHARNAME>. Herzlichen Glückwunsch zu Eurem ersten gut zu Ende gebrachten Auftrag!~
@229 = ~FEIGEN, Holger? Warum?~
@230 = ~Was ist also meine nächste Aufgabe?~
@231 = ~Wir sind hier fertig, ich werde nicht weiter für Euch arbeiten.~
@232 = ~Das ist ein inakzeptables Verhalten. Ich hatte große Hoffnungen in Euch, <CHARNAME>, so große Hoffnungen … Aber so geht es nicht. Unsere Geschäftsbeziehung ist beendet. Lebt wohl.~
@233 = ~Und das ist ein absolut inakzeptables Verhalten, das geahndet werden muss.~
@234 = ~Warum? Ja, <CHARNAME>, Feigen sind perfekt für einen Neuling. Sie sind ziemlich empfindlich, müssen schnell geliefert werden – und sie sind absolut gesetzestreu. Bringt das geheimnisvolle, versiegelte Paket zur Flammenden Faust, und der Einzige, der mit ihnen Ärger bekommt, seid Ihr!~ ~Warum? Ja, <CHARNAME>, Feigen sind perfekt für einen Neuling. Sie sind ziemlich empfindlich, müssen schnell geliefert werden – und sie sind absolut gesetzestreu. Bringt das geheimnisvolle, versiegelte Paket zur Flammenden Faust, und die Einzige, die mit ihnen Ärger bekommt, seid Ihr!~
@235 = ~Hm. Tja, dann ist es wohl an der Zeit, Abschied zu nehmen, <CHARNAME>.~
@236 = ~Hm, lasst mich mal sehen.~
@237 = ~Es stellt sich immer noch die Frage, was mit der Zelle des Turms passiert ist. Bleiben wir erst einmal dabei, denn das ist wirklich wichtig.~
@238 = ~Ich muss schon sagen, was habe ich da gehört? Die Turmzelle wurde von Doppelgängern übernommen! Juan war voll des Lobes über Eure Rettungsaktion.~
@239 = ~Sozusagen, denn Ihr habt trotzdem versucht, ihn zu töten. Tss, tss, <CHARNAME>, Ihr solltet es besser wissen, als einen anderen Schmuggler zu bedrohen. Oder Ihr seid schlauer, als Ihr ausseht, und strebt nach einer Position an der Spitze, hm?~
@240 = ~Meine Kontaktperson von den Sklavenhändlern taucht nicht mehr auf, <CHARNAME>. Ist etwas passiert?~
@241 = ~Das könnt Ihr laut sagen, Holger. Die Sklavenhändler wollten sich an Euch rächen, weil sie Euch die Schuld dafür geben, dass der Schmugglertunnel nicht mehr verfügbar ist. Nachdem sie mir das gesagt haben, sind sie aber nicht sehr weit gekommen.~
@242 = ~Ratet mal.~
@243 = ~Ihr kehrt zurück. Das ist ein gutes Zeichen. Ihr habt zumindest überlebt. Wie ist es gelaufen?~
@244 = ~Ihr hattet recht, sie wollten mich gleich versklaven, als ich reinkam.~
@245 = ~Sie wollten eine Botschaft übermitteln. Leider gibt es niemanden mehr, der dies tun könnte.~
@246 = ~Wie erwartet.~
@247 = ~Ah, ich habe gehört, Ihr habt auch Leonhard getötet. Nun, ich schätze, ich kann es Euch nicht verübeln, nachdem die Sklavenhändler unseren Vertrag gebrochen haben.~
@248 = ~Ah, sie wollten einen „Gruß“ schicken, oder? Es ist noch niemand hier angekommen, also habt Ihr gute Arbeit geleistet. Ich nehme an, ich bin Euch zu Dank verpflichtet, <CHARNAME>.~
@249 = ~Ich danke Euch und muss zugeben, dass ich dankbar bin, dass Ihr zwischen mir und den wütenden Sklavenhändlern standet, denn ich hätte ihren Angriff nicht überlebt. Nun gut.~
@250 = ~Sie … sie haben Euch angegriffen? Während Ihr für sie gearbeitet habt? Bitte sagt mir, dass das nichts mit mir zu tun hat.~
@251 = ~Tja, nun. Die Sklavenhändler wollten sich an Euch rächen, weil sie Euch die Schuld dafür geben, dass der Schmugglertunnel nicht mehr verfügbar ist. Nachdem sie mir das gesagt haben, sind sie allerdings nicht sehr weit gekommen.~
@252 = ~„Es hatte nichts mit Euch zu tun.“ Zufrieden?~
@253 = ~Mit dem Wegfall der Sklavenhandelsrouten wäre mir hier längst alles um die Ohren geflogen. Ich bin froh, dass wir uns bereits mit der Neupositionierung beschäftigen. Und ich MUSS mich neu positionieren, <CHARNAME>. Ich hatte mir unsere Zusammenarbeit wirklich anders vorgestellt.~
@254 = ~Heißt das, Ihr habt nichts mehr für mich zu tun?~
@255 = ~Ich fürchte, Ihr werdet das ohne mich machen, Holger. Ich muss unsere Zusammenarbeit beenden.~
@256 = ~Heh! Ich mag Euren Humor. Also WAR er an mich gerichtet?~
@257 = ~Nicht so viel, wie ich gehofft hatte. Aber ich bin wirklich sehr froh, Euch kampferprobte Rekruten zu haben. Von so etwas lassen wir uns doch nicht die Laune verderben, oder?~
@258 = ~Die Sklavenhändler haben um ein Treffen gebeten, <CHARNAME>. Ich will ehrlich sein. Ich erwarte nichts Gutes. Es ist ungewöhnlich, dass sie mich auf diese Weise sehen wollen. Ich würde Euch gerne schicken, denn ich werde nicht hingehen. Es wäre mein Todesurteil, das weiß ich schon, und meine Schurken sind nicht stark genug, um es mit ihnen aufzunehmen.~
@259 = ~In Ordnung, ich mache es.~
@260 = ~Warum sollten die Sklavenhändler Euch töten wollen?~
@261 = ~Aber Ihr wollt, dass ich mich abschlachten lasse?~
@262 = ~Ihr solltet Euch ihnen stellen wie ein Mann, Holger. Seid nicht so ein Feigling!~
@263 = ~Hmm. Ich mag Euch, aber ich das mache nicht für Euch, Holger.~
@264 = ~Nee, ich wollte unsere Zusammenarbeit sowieso beenden.~
@265 = ~Oh, ich kann den Braten riechen, <CHARNAME>. Die Schmugglertunnel nach Baldurs Tor sind verloren gegangen, und das trifft auch die Sklavenhändler hart. Ich würde nicht sagen, dass ich dafür verantwortlich bin, aber ich bin sicher, dass sie kein Problem damit hätten, mir die Schuld zu geben, und sei es nur, um ihre eigene Haut vor ihren Bossen zu retten.~
@266 = ~Aber ganz im Gegenteil. Ich möchte Euch dort hinschicken, weil ich überzeugt bin, dass IHR aus einer solchen Konfrontation lebend herauskommen würdet!~
@267 = ~Ich kann es Euch nicht verdenken. Ich werde jetzt verschwinden. Das bedeutet, unsere Zusammenarbeit ist leider vorbei. Wie schade! Ich habe noch viel zu tun, aber das wird mir langsam zu brenzlig. (seufz) Die Schmugglerzelle meldet sich nun also komplett ab. Ich hätte nie gedacht, dass ich meine Kunden so im Stich lassen würde.~
@268 = ~In Ordnung, in Ordnung, genug der Theatralik. Ich werde mich Euren Sklavenhalter gegenüberstellen.~
@269 = ~Lebt wohl, Holger.~
@270 = ~Wenn ich mich ihnen wie ein Mann stelle, würde ich wie ein Hund getötet werden, <CHARNAME>.~
@271 = ~Das Glück hat mir wirklich zugelächelt, als es Euch in meine Richtung schickte. Trefft sie am Westufer des Chionthar, südlich der Lindwurmsquerung, wenn die Nacht hereingebrochen ist. Geht vorbereitet dorthin, dies wird eine feindliche Konfrontation sein. Und … lasst Euch nicht töten, <CHARNAME>.~
@272 = ~Ihr habt der Flammenden Faust einen Tipp gegeben? UND zeigt Euer Gesicht hier noch einmal? Habt Ihr gedacht, wir würden es nicht wissen?~
@273 = ~Da seid Ihr ja. Die zweite Zahlung für die Lieferung ist bereits eingetroffen. Gut gemacht, <CHARNAME>. Das war ein sehr lukrativer Auftrag und hat das Loch, das das Turmzellenfiasko in unsere Finanzen gerissen hatte, weitgehend gefüllt.~
@274 = ~Wenn Ihr bereit seid, könnte ich Euer Fachwissen bei einer weiteren Sache gebrauchen.~
@275 = ~Da seid Ihr ja. Die zweite Zahlung für die Lieferung ist nicht angekommen. Stattdessen wurde mir gesagt, Ihr wärt nie mit der versprochenen Lieferung aufgetaucht. Ihr erinnert Euch, was ich Euch über Vertrauen gesagt habe? Ihr vertraut mir, ich vertraue Euch und so weiter?~
@276 = ~Holger, ich habe die Zusammenarbeit mit den Sklavenhändlern aus einem bestimmten Grund abgelehnt. Ihr könnt mich nicht ohne Vorwarnung einen Menschen herumtragen lassen!~
@277 = ~Holger, Ihr könnt mich nicht ohne Vorwarnung eine Person herumtragen lassen!~
@278 = ~Ich habe eine Person in einem Fass bemerkt, die auf keinerlei Kommunikationsversuche reagierte. Ich habe versucht, die Ware zu SICHERN, Holger! Versteht Ihr das nicht?~
@279 = ~Ja, <CHARNAME>, das kann ich, weil ICH kein Sklavenhändler bin!~
@280 = ~Es ist mir egal, aus welchen Euren Gründen Ihr die Sache abgeblasen habt. Ich habe das Vertrauen in Euch verloren, so traurig das auch ist.~
@281 = ~<CHARNAME>, habt Ihr eine Ahnung, wie viel Gold Ihr verprasst habt? Ich musste die Provision, die ich bekommen habe, ausgeben, um den Kontakt zu entschädigen, also habe ich überhaupt keinen Gewinn! Das heißt, ich habe noch genauso viel Gold wie vorher … (seufz) Also, ich denke, das macht nichts. Nun gut. Ich verstehe, was Ihr meint. Ihr habt bis jetzt konsequent gehandelt, also sollte ich wohl einen Teil der Schuld auf mich nehmen.~
@282 = ~Ihr seid zurück, aber ich sehe keine Phiole mit Calimshan-Parfüm. Ich habe allerdings Berichte darüber erhalten, dass die Seeturm-Wache im Hinblick auf Schmuggleraktivitäten noch wachsamer ist als ohnehin schon.~
@283 = ~Ja, es tut mir leid, Holger. Ich habe es vermasselt.~
@284 = ~Ihr wisst es also bereits.~
@285 = ~Nun, solche Dinge können passieren, oder nicht?~
@286 = ~Ich habe Euch dort hingeschickt, weil ich dachte, es sei ein Kinderspiel für Euch, <CHARNAME>. Und dann geht Ihr hin und macht die Seeturm-Wache auf die Phiole aufmerksam?~
@287 = ~Nun, es jetzt zu beschaffen, wäre eine echte Herausforderung. Ein Fläschchen ist DIESE Menge Ärger nicht wert. Ich werde es einfach vergessen … ebenso wie Euer Versagen. Ich schätze, es war Wunschdenken meinerseits, dies Euch zu überlassen. Ich hätte es besser wissen müssen … und das meine ich in vollem Ernst. Ich hätte es besser wissen müssen, welche Art von Aufgaben ich Euch anvertrauen sollte. Ich bitte um Entschuldigung.~
@288 = ~Ihr seid zurück, und ich sehe ein Fläschchen mit Calimshan-Parfüm. Ihr wart erfolgreich!~
@289 = ~Lasst mich Euch das abnehmen und Euch Euren Lohn geben. Ah … es ist voll und so gut wie neu! Meine Vermutung bezüglich der tatsächlichen Verwendung dieser Art von Geschenken war also richtig. Ihr wisst vielleicht nicht, was diese Art von Parfüm wert ist. Das ist eine gut erledigte Aufgabe, <CHARNAME>.~
@290 = ~Ich bin mir nicht ganz sicher, was Ihr getan habt, aber mir wurde gesagt, dass die Seeturm-Wache in noch höherer Alarmbereitschaft gegenüber Schmugglern zu sein scheint, als sie es ohnehin schon war. Nun, ich schätze, die Tunnel sind in nächster Zukunft noch mehr tabu.~
@291 = ~Ihr seid zurück, und den Geräuschen entnehme ich, dass die Nachtmasken besiegt sind. Ich danke Euch dafür, das tue ich wirklich und werde Euch Eure Belohnung geben. Aber, <CHARNAME> – Ihr habt die Soldaten angegriffen? Als ich sagte, Ihr sollt Euch nicht von den Soldaten mit meinen Waren erwischen lassen, meinte ich weglaufen oder so etwas in der Art! Aber nicht töten! Wisst Ihr, was das für Folgen haben wird? Haltet Ihr tote Soldaten in der Nähe unserer Basis für eine kluge Idee? Es tut mir leid, Euch sagen zu müssen, dass das keine ist, ganz und gar nicht.~
@292 = ~Ihr seid zurück, und aus den Geräuschen schließe ich, dass die Nachtmasken besiegt sind. Gut gemacht, <CHARNAME>! Sehr gut gemacht. Hier ist Eure Belohnung, und lasst mich die Kiste zurüknehmen.~
@293 = ~Ich werde sie Edgar geben. Jetzt können wir den Schwarzen Lotus reintun und ihn wirklich ausliefern.~
@294 = ~Oh, ich sehe, Ihr habt sie geöffnet.~
@295 = ~Ich habe Soldaten bestochen, Holger. Bekomme ich eine Entschädigung?~
@296 = ~Ja, das war sie, <CHARNAME>.~
@297 = ~Und warum?~
@298 = ~Wollt Ihr mich auf den Arm nehmen, Holger? Erst lasst Ihr mich streng geheime Feigen ausliefern, dann riskiere ich mein Leben für leere Kisten?~
@299 = ~Die Nachtmasken herauszulocken, ohne tatsächliche Ware zu riskieren … schlau!~
@300 = ~So funktioniert das nicht, Holger. Ihr müsst mir schon sagen, was in den Kisten drin ist, die Ihr mich liefern lasst!~
@301 = ~Tretet einen Schritt zurück und seht Euch das Gesamtbild an.~
@302 = ~Ich habe Euch gesagt, dass die Nachtmasken angreifen würden. Es war eine Falle, <CHARNAME>, eine Falle für unsere Feinde. Und wegen Euch hat sie nicht nur zugeschnappt, sondern sie auch noch richtig zerschmettert. Sagt nicht, ich hätte Euch angelogen. Ich sagte, die Nachtschatten wollten eine unserer Lieferungen mit Schwarzem Lotus überfallen. Ich habe nie gesagt, dass ich das zulassen würde!~
@303 = ~Ihr fühlt Euch wahrscheinlich betrogen. Ich respektiere diese Einschätzung. Aber ich habe Euer Vertrauen nicht dahingehend missbraucht, dass ich Euch für wichtige Aufgaben einsetzen würde, <CHARNAME>. Es war eindeutig ein Kampfauftrag, als Ihr ihn angenommen habt. Die leeren Kisten waren ihr Volumen in Gold wert. Denn durch sie konnten wir den Nachtmasken eine Lektion erteilen. Die Bedrohung durch diese Geier dürfte für einige Zeit erheblich geschwächt sein. Ihr habt gute Arbeit geleistet, <CHARNAME>, und habt Euch Eure Belohnung redlich verdient!~
@304 = ~Ich verstehe, warum … Die Nachtmasken herauszulocken, ohne tatsächlich eine Ware zu bedrohen – clever!~
@305 = ~Nein, ich mag es nicht, so benutzt zu werden. Ich fürchte, unsere Zusammenarbeit ist vorbei.~
@306 = ~Ich hoffe, das klärt die Sache ein wenig auf.~
@307 = ~Das klärt einiges auf. Ich verstehe es jetzt.~
@308 = ~Das tut es. Aber Holger … wenn ich noch einmal um leere Kisten kämpfen muss, bringe ich Euch um.~
@309 = ~Wahnsinn! Ich hoffe sehr, dass Ihr das nicht wörtlich gemeint habt. Aber seid versichert, ich werde Euch nicht noch einmal leere Kisten beschützen lassen. Ihr habt mein Wort.~
@310 = ~Genau darum ging es hier.~
@311 = ~Ich bin froh, dass wir auf der gleichen Seite sind. Ich hätte mir ein Missverständnis zwischen uns nicht gewünscht.~
@312 = ~Ich bin froh, dass ich Euch helfen konnte. Und was jetzt?~
@313 = ~Geht diesen Sieg feiern. Bis bald, <CHARNAME> – wann immer Ihr bereit seid!~
@314 = ~Das habt Ihr geschafft? Das ist genial! Aber ich fürchte, das ist Berufsrisiko – Ihr müsst ihnen beim nächsten Mal aus dem Weg gehen. Ich glaube, mein Zahlungen sind hoch genug, um Eure Ausgaben zu kompensieren.~
@315 = ~Die Kiste war leer?~
@316 = ~Gebt mir einfach meinen Lohn.~
@317 = ~Es tut mir leid, Holger, aber ich muss unsere Geschäftsbeziehungen beenden.~
@318 = ~<CHARNAME>, falls es nicht klar war – Ihr könnt sicher sein, dass Ihr nichts transportieren werdet, was Euch wirklich in Schwierigkeiten mit der Flammenden Faust bringen würde. Glaubt Ihr ernsthaft, ich würde Euch Neuling das wirklich heiße Zeug geben? Nun, eine andere Organisation würde das vielleicht tun, um ihre eigenen Leute zu schonen. Aber ich bin ein Schmuggler, <CHARNAME>! Wenn ich meine Kunden nicht beliefere, leidet mein Ruf. Natürlich gebe ich die heiklen Sachen meinen erfahreneren Schurken. Ich bin kein leichtsinniger Mann, der schnelles Gold machen will und dafür seine Leute verkauft!~
@319 = ~Ihr müsst bedenken, dass jede fehlgeschlagene Lieferung einen Kunden bedeutet, der seine Ware nicht erhält. Nun, abgesehen von der leeren Kiste, natürlich. Aber das hatte einen anderen Zweck.~
@320 = ~Das ist ein Köder, <CHARNAME>! Glaubt Ihr ernsthaft, ich würde das echte Ding benutzen, wenn ich es ohne Risiko erreichen kann? Schaut mal, ob die Nachtmasken anbeißen. Wir werden das später besprechen.~
@321 = ~Jetzt können wir … Moment mal, was ist hier los?~
@322 = ~Oh, verdammter Mist. Ihr habt das hier zu verantworten, <CHARNAME>, nicht wahr?~
@323 = ~Wir haben Euch erwischt, Ihr Schurken! Wir haben Euch auf frischer Tat ertappt mit diesem Fläschchen Calimshan-Parfüm, das Ihr illegal eingeführt und verkauft habt, ohne Zölle zu bezahlen! Ihr kommt jetzt mit uns mit! Und benehmt Euch besser!~
@324 = ~<CHARNAME>, <CHARNAME> … Ihr habt mich gekonnt ausgespielt. Wie schade, dass Ihr die ganze Zeit auf der anderen Seite wart.~
@325 = ~<CHARNAME>, kommt später zu mir und holt Euch Eure Belohnung ab!~
@326 = ~(seufz) Hallo, Offiziere. Was kann ich für Euch tun?~
@327 = ~Wir haben Euch erwischt, Ihr Schurken! Wir haben Euch auf frischer Tat ertappt mit dieser Kiste, die gefüllt ist mit … äh … nichts? Die Kiste ist leer!~
@328 = ~Das ist sie in der Tat! Diese wunderbar<PRO_MANWOMAN> hat sich freiwillig gemeldet, also dachte ich, es wäre eine gute Sache, der ehrenwerten Wache aus Nashkell dabei zu helfen, die Gegend von einigen Kriminellen zu befreien! Das ist alles, was hier passiert ist, lieber Offizier. Gibt es eine Belohnung für solche Aktionen, wenn ich fragen darf?~
@329 = ~Das … das … das geht nicht! Hier gibt es nichts … NICHTS! <CHARNAME>, das war ein Fehlschlag. Eure Informationen waren nichts wert! Wir werden jetzt aufbrechen. Ich werde die gesamte Untersuchung von nun an selbst leiten!~
@330 = ~Nun, <CHARNAME>, ich denke, es wird keine Überraschung sein, dass ich jetzt auch gehen werde.~
@331 = ~<CHARNAME>, ich bin mir nicht sicher, was passiert ist, aber solange Euer Ebenbild an jeder zweiten Ecke in Baldurs Tor hängt, ist es wohl das Beste, unsere Zusammenarbeit zu pausieren, bis sich die Dinge beruhigt haben. Nicht, weil ich mich von Euch distanzieren würde, sondern weil die Verfolgung durch die Flammende Faust und Schmuggel nicht gut zusammenpassen.~
@332 = ~Na dann, bereit für etwas mehr Abenteuer?~
@333 = ~Danke für den Schmugglergruß, Holger. Es war schön, in diesen turbulenten Zeiten ein freundliches Gesicht zu sehen.~
@334 = ~Ich hätte nicht gedacht, dass Ihr in der Lage wärt, in Menschenhandel verwickelt zu sein, Holger! Ich verstehe, warum es Euch leicht fällt, mit den Sklavenhändlern Geschäfte zu machen.~
@335 = ~Ihr wisst, dass ich dem Gedanken an Sklavenhandel nicht abgeneigt bin, aber ich muss zugeben, dass ich überrascht war, als ich erkannt habe, dass sich eine Person in dem Fass befand.~
@336 = ~Holger, ich habe mich aus gutem Grund geweigert, mit den Sklavenhändlern zusammenzuarbeiten. Habt Ihr eine Ahnung, wie sehr Ihr meine Loyalität auf die Probe gestellt habt, indem Ihr mich eine unvorbereitete Person schmuggeln ließt?~
@337 = ~Ich war sehr überrascht, als ich eine Person im Inneren des Fasses bemerkt habe, Holger. Erweitert Ihr Euer Gewerbe?~
@338 = ~Dieser Transportkontakt für das schwere Fass – es scheint, als hättet Ihr nicht alle Eure Routen per Schiff zusammen mit den Sklavenhändlern verloren?~
@339 = ~Ja. Was soll ich für Euch tun?~
@340 = ~Ja. Ich bin bereit, Euer Treffen zu bewachen.~
@341 = ~Vielleicht später.~
@342 = ~Habt Ihr irgendwelche Neuigkeiten für mich?~
@343 = ~Die Turmzelle wurde anscheinend von Doppelgängern übernommen.~
@344 = ~Die „Schwarzer Lotus“-Kiste ist leer, Holger!~
@345 = ~Wollt Ihr mich auf den Arm nehmen? Erst liefere ich streng geheime Figuren aus, und jetzt lasst Ihr mich leere Kisten mit meinem Leben bewachen?~
@346 = ~Ich bin immer noch dabei.~
@347 = ~Tut mir leid, Holger, aber ich werde mich den Nachtmasken doch nicht stellen. Bitte nehmt die Kiste zurück.~
@348 = ~Ich bin immer noch ein Schmuggler, nichts weiter. Der Kunde hat dafür bezahlt, dass seine Ware heimlich geliefert wird – die „Ware“ ist er selbst. Das war alles freiwillig und aus freien Stücken. Und, wie ich hinzufügen möchte, auch nicht, um ein Verbrechen zu vertuschen. Zumindest wenn Ihr diplomatische Turbulenzen nicht als illegal anseht.~
@349 = ~Ich verstehe, was Ihr meint. Ihr wart bisher konsequent in Eurem Handeln, also hätte ich Euch vielleicht einen Hinweis geben sollen.~
@350 = ~Gerne. Ja, ich habe mir Sorgen gemacht, als Euer Ebenbild für ein Kopfgeld überall aufgetaucht ist. Aber Ihr habt Euren Weg zurück in die Stadt gefunden. Und das ziemlich eindrucksvoll, wenn ich das sagen darf!~
@351 = ~Wa… <CHARNAME>, ich habe mich zurückgehalten, weil ich den Nachtmasken nicht gewachsen bin. Wenn Ihr mir jetzt diese Kiste übergebt, werde ich so schnell wie möglich von hier verschwinden.~
@352 = ~Ja, Entschuldigung.~
@353 = ~Gut, ich werde mich ihnen stellen.~
@354 = ~Oh, nein, ganz und gar nicht. Die Sklavenhändler waren einer unserer Kontakte. Ich habe nur mit ihnen zusammengearbeitet, weil ihre Angebote immer so unglaublich kostengünstig waren. Und weil sie auf einigen Routen fuhren, für die ich keine anderen Mittel hatte, zumindest nicht ohne erhebliche Umwege zu nehmen.~
@355 = ~Doppelgänger!~
@356 = ~Nun, kein Wunder, dass sie nicht mehr mit uns kommuniziert haben.~
@357 = ~Hm, anscheinend habe ich Shuck Unrecht getan, dem armen Mann! Ich bin untröstlich – oder vielleicht auch nicht.~
@358 = ~Nun, Ihr habt Euch als nützlich erwiesen, <CHARNAME>. Sehr sogar.~
@359 = ~Ich mag Euch und sehe, dass Ihr mit Euren Waffen umzugehen wisst. Unsere … Partner sind immer auf der Suche nach Söldnern, um ihre Lieferungen zu schützen.~
@360 = ~Ich spreche von den hilfreichen Leuten in Amn, die genug Gold haben, um die Schulden unserer Kunden abzukaufen, und genug Schiffe, um einige unserer Waren zu transportieren.~
@361 = ~Mit anderen Worten: die Sklavenhändler. Ihr habt bereits ihren Kontakt für den Bruder Eures Freundes getroffen.~
@362 = ~Mit anderen Worten: Sie sind Sklavenhändler. Es gibt keinen Grund, um die Wahrheit herumzureden, wenn ich möchte, dass Ihr für sie arbeitet.~
@363 = ~Wir müssen uns mit ihnen gut stellen, und sie sind oft an Unterstützung gegen die Flammende Faust für ihre Lieferungen in der Nähe von Baldurs Tor interessiert. Ich werde Euch an sie weiterempfehlen. Es ist leicht verdientes Gold. Die Flammende Faust taucht nur selten auf und die Bezahlung ist meist recht gut. Ich würde es ja selbst machen, aber wir werden eine Weile mit eigenen Sachen beschäftigt sein.~
@364 = ~Endlich! Ich habe auf Eure Empfehlung gewartet.~
@365 = ~Gut, ich werde mir ihr Angebot anhören.~
@366 = ~Auf keinen Fall. Für Euch zu arbeiten, ist in Ordnung, aber ich werde mich nicht mit einer zwielichtigen Organisation einlassen.~
@367 = ~Macht Euch keine Mühe. Ich bin auch fertig damit, für Euch zu arbeiten.~
@368 = ~Lasst mich nicht zu lange auf weitere Neuigkeiten warten, <CHARNAME>.~
@369 = ~Ich habe ein ernsthaftes Problem. Als ob der Verlust von Männern in Baldurs Tor nicht schon genug wäre, habe ich auch noch Schurken zwischen Baldurs Tor und Nashkell verloren. Jemand tötet sie, und zwar in einem Ausmaß, dass ich bestimmte Lieferungen auf Eis gelegt habe. Das ist einer der Gründe, warum es so lange gedauert hat, bis der Verlust der Turmzelle bemerkt wurde.~
@370 = ~Sagt mir nicht, dass sie auch durch Doppelgänger ersetzt wurden.~
@371 = ~Jemand? Wisst Ihr, wer es ist?~
@372 = ~Ich nehme an, dass ich ihre Leichen dann nicht hätte finden können.~
@373 = ~Ich weiß, dass es sich um die Nachtmasken handelt, und sie scheuen sich nicht, dies deutlich zu machen. Sie scheinen meine Scharzer-Lotus-Route zerstören zu wollen. Ich brauche Euch als meine nächsten Schmuggler auf dieser Route. Ich gebe Euch große, große Kisten, die die Nachtmasken nicht übersehen können. Das wäre ein Kampfauftrag, <CHARNAME>, denn sie WERDEN Euch angreifen.~
@374 = ~Ich wäre also ein Köder?~
@375 = ~Hmm, Nachtmasken. Gut, ich machs.~
@376 = ~Nachtmasken – was ist das?~
@377 = ~Und wenn ich nein sage?~
@378 = ~Die Boxen werden Köder sein. Ihr werdet die Verteidigung sein, und zwar eine fähige, würde ich sagen.~
@379 = ~Dann werde ich meinen Schwarzer-Lotus-Schmuggel nach Baldurs Tor begraben. Ich habe schon zu viele Männer verloren.~
@380 = ~Es tut mir leid, aber da muss ich passen.~
@381 = ~Großartig. Trefft Euch bei Einbruch der Nacht mit Edgar hinter dem Schwarzer-Lotus-Zelt. Er wird Euch die wertvolle Beute geben und Euch sagen, wohin Ihr damit gehen müsst, um die Plünderer anzulocken. Ihr kehrt zu mir zurück, <CHARNAME>, sobald Ihr denjenigen besiegt habt, der die Lieferung angreifen wird. Mach ihnen klar, dass wir nicht wehrlos sind.~
@382 = ~Es handelt sich im Grunde um eine Organisation von Elite-Meuchelmördern. Sie führen Auftragsmorde aus und haben begonnen, sich ein wenig zu sehr in der Gegend zu engagieren.~
@383 = ~Aha, ich verstehe. Nun, dann muss das warten, denn ich habe niemanden, der so fähig ist wie Ihr, den ich dorthin schicken könnte. Aber gut, ich habe genug andere Dinge, die mich beschäftigen.~
@384 = ~Ich habe für mehrere meiner Lieferungen keine Bezahlung erhalten. In Anbetracht Eurer Verbindungen würde ich Euch gerne einer hinterherschicken.~
@385 = ~Soll ich jetzt Euer Gold einsammeln? Ich wollte als Schmuggler arbeiten, nicht als Kopfgeldjäger.~ ~Soll ich jetzt Euer Gold einsammeln? Ich wollte als Schmugglerin arbeiten, nicht als Kopfgeldjägerin.~
@386 = ~Klar, wen soll ich denn verprügeln?~
@387 = ~Was soll ich Eurer Meinung nach tun?~
@388 = ~Nein, nein, keine Sorge, <CHARNAME>. Ihr werdet nichts mit dem Kunden zu tun haben. Zumindest nicht, wenn Ihr es verhindern könnt.~
@389 = ~Ich möchte, dass Ihr einen besonderen Gegenstand für mich besorgt: ein Parfüm aus Calimshan. Er sollte sich beim Hauptmann der Wache im Seeturm befinden.~
@390 = ~Holger, wollt Ihr mir weismachen, dass der Hauptmann Schmuggelware gekauft hat?!~
@391 = ~Die Seeturm-Wache? Seid Ihr sicher?~
@392 = ~Uff. Ich glaube, das ist zu heikel für mich. Es tut mir leid, Holger.~
@393 = ~Nein, natürlich nicht der Hauptmann.~
@394 = ~Seine Leute haben den Gegenstand durch Shuck bekommen – ein Geschenk für ihren Boss, versteht Ihr? Ich denke, es gibt hier viele Unschuldige, und Shuck hat wirklich schon genug Probleme. Vor allem, weil es vielleicht nicht Shucks Schuld ist, dass ich kein Gold erhalten habe.~
@395 = ~Das wäre bedauerlich.~
@396 = ~Ich habe immer noch genug Schurken, um die meisten meiner unbezahlten Waren zurückzubekommen. Aber ausgerechnet aus der Seeturm-Kaserne … Na ja, sagen wir mal so, da würde ich lieber Euch hinschicken. Ihr scheint den Ort recht ungehindert zu besuchen.~
@397 = ~Es tut mir leid, Holger, aber ich werde das nicht tun.~
@398 = ~Das ist wirklich schade. Aber gut, ich kann Euch nicht zwingen. Sagt mir Bescheid, wenn Ihr bereit für eine neue Aufgabe seid.~
@399 = ~Großartig! Ich bin sicher, er hat es aus Respekt vor seinen Männern, die es ihm geschenkt haben, in der Kaserne aufbewahrt. Ich bin sicher, Ihr werdet einen unbeobachteten Moment finden, um es zu holen.~
@400 = ~Ich habe eine sehr heikle Lieferung durch die ehemaligen Schmugglertunnel unter dem Seeturm. Da Ihr ungehinderten Zugang zu diesem Tunnel habt, wärt Ihr perfekt dafür geeignet.~
@401 = ~Ihr möchtet Euch allerdings vielleicht mit Vorräten eindecken.~
@402 = ~Das Fass ist ein bisschen schwer. Dieses Mal ist etwas Kostbares drin, das könnt Ihr mir glauben. Etwas, das mit großer Sorgfalt behandelt werden muss, damit es nicht zerbricht. Ihr müsst es schnell abliefern und dürft den Inhalt unter keinen Umständen preisgeben, so lautet der ausdrückliche Auftrag des Auftraggebers. Kann ich auf Euch zählen?~
@403 = ~Ja, das kann ich machen.~
@404 = ~Es tut mir leid, Holger, aber ich glaube nicht, dass ich das tun kann.~
@405 = ~Wunderbar. Das Fass wird vor der Schneiderei stehen – Ihr erinnert Euch, wo Ihr im Keller die traurigen Überreste der ehemaligen Turmzelle getroffen habt? Tragt es durch die Tunnel nach draußen an die Küste unter den Seeturm. Meine Kontaktleute werden es Euch dort abnehmen. Und <CHARNAME> – dies ist ein zeitkritischer Auftrag. Es stehen Leben auf dem Spiel, buchstäblich. Ganz zu schweigen davon, dass mein Transportkontakt nicht ewig warten wird.~
@406 = ~Ich bräuchte mal wieder Eure Kampffähigkeiten, <CHARNAME>. Ihr müsst ein Treffen bewachen, das ich veranstalten werde. Es ist sehr wichtig. Ich habe Euch gesagt, dass wir uns neu organisieren müssen. Ich bin mir nicht sicher, was oder wer versuchen wird, uns zu stören – Nashkeller Garde, Nachtmasken, Bären … Ich brauche Euch, um Erstere zu bestechen und die beiden Letzteren zu töten. Es könnte sogar sein, dass ich Eure Hilfe gegen meine Besucher benötige! Sagt mir Bescheid, wenn Ihr bereit seid.~
@407 = ~Genial. Bleibt einfach hier stehen und seid bereit – für alles. Stört uns nicht, aber ich nehme an, das versteht sich von selbst.~
@408 = ~Wir machen eine kurze Pause. Ist hier noch alles in Ordnung?~
@409 = ~Ja, bis jetzt ist noch nichts passiert.~
@410 = ~Wie sind die Verhandlungen bisher verlaufen?~
@411 = ~Wird es noch lange dauern?~
@412 = ~Es dauert so lange, wie es dauert, fürchte ich.~
@413 = ~Macht weiter so!~
@414 = ~Nicht schlecht, ganz und gar nicht schlecht.~
@415 = ~Und … wir sind fertig. Ist hier alles ruhig geblieben?~
@416 = ~Was meint Ihr mit „fertig“? Es ist nichts passiert!~
@417 = ~Moment mal, das wars? Kein Kampf, kein Streit, kein Gemetzel, keine plötzlich auftauchenden Feinde?~
@418 = ~Ja, hier ist alles ruhig geblieben.~
@419 = ~Hätte ich gewusst, dass dieses Treffen so ereignislos sein würde, hätte ich meine Zeit anders genutzt.~
@420 = ~Nein, nichts dergleichen.~
@421 = ~Hätte ich gewusst, dass dieses Treffen so ereignislos sein würde, hätte ich Euch nicht belästigt, <CHARNAME>. Hmm, aber man weiß ja nie, Ihr wisst schon.~
@422 = ~Ich bin mir sicher, dass Eure bloße Anwesenheit jegliche Versuche unserer Geschäftspartner uns abzuzocken stark reduziert hat. Und die Tatsache, dass keine Nachtmasken aufgetaucht sind – na ja, es muss ja nicht immer alles schiefgehen, oder? Ausnahmsweise ist ein geheimes Treffen tatsächlich ein geheimes Treffen geblieben. Ich denke, das ist ein gutes Zeichen für diese neue Zusammenarbeit, die ich gerade aufbaue. Ihr habt sehr gute Arbeit geleistet, <CHARNAME>.~
@423 = ~Es ist geradezu bedauerlich, dass ich unsere Schmuggelkooperation an dieser Stelle pausieren muss, da mich meine Pflichten nun zurück zur Muttergilde der Königstränen rufen. Die wechselnden Eventualitäten und neuen Möglichkeiten müssen weise abgewogen werden, diese Diskussion funktioniert nicht gut über Brieftauben.~
@424 = ~Ich würde Euch gerne als meinen Leibwächter anheuern und mitnehmen, aber ich weiß, dass Ihr anderweitige Verpflichtungen habt. Wenn es irgendeine Chance gibt, dann werden wir uns wiedersehen.~ ~Ich würde Euch gerne als meine Leibwächterin anheuern und mitnehmen, aber ich weiß, dass Ihr anderweitige Verpflichtungen habt. Wenn es irgendeine Chance gibt, dann werden wir uns wiedersehen.~
@425 = ~Ich würde so etwas Wertvolles wie Euch nicht verschwenden, das könnt Ihr mir glauben. Seid versichert, dass Ihr hier einen sehr profitablen Geschäftskontakt geknüpft habt. Ich würde sagen „Freund“, aber wir beide wissen, dass das nicht der Wahrheit entsprechen würde.~
@426 = ~Lebt wohl, <CHARNAME>.~
@427 = ~Ihr werdet von mir hören, wenn sie uns mehr Details verraten.~
@428 = ~Oh, wie schade. Dann muss ich wohl wieder Edgar schicken.~
@429 = ~Die Verluste sind ein harter Schlag für uns. Ich habe noch einige Aufträge, die ich ausliefern muss, aber ich werde auch anfangen, meine Operationen neu zu organisieren.~
@430 = ~Wenn Ihr bereit seid, hätte ich noch mehr Aufgaben für Euch. Sagt einfach Bescheid.~
@431 = ~Ich bin nur fürs Grobe hier. Sprecht mit Holger.~
@432 = ~Oh, ich habe Eure Kiste gar nicht bemerkt. Die ist für mich, richtig? Also, mal sehen …~
@433 = ~Ihr seid spät dran, das wisst Ihr doch, oder?~
@434 = ~Was ist das? Sie ist bereits geöffnet?! Versucht Ihr mich auszutricksen? Ich habe die Calimshan-Feigen teuer bezahlt, und jetzt kann ich nicht sicher sein, dass Ihr sie nicht mit billigen Früchten aus Tethyr ausgetauscht habt!~
@435 = ~Und es sind nicht mehr sechs! Einige fehlen!~
@436 = ~Und … Igitt, die sind vergammelt. Also bringt Ihr mir ein paar verfaulte Feigen statt der versprochenen frischen Calimshan-Feigen.~
@437 = ~Ich bin sehr enttäuscht. Sehr enttäuscht. Ich werde Euch nicht bezahlen, da Ihr nicht geliefert habt, was ich bestellt habe. Verschwindet aus meiner Küche! Frische Lieferung, pah!~
@438 = ~Hm, nun, ich denke, ich werde das gebrochene Siegel akzeptieren, sie sehen richtig aus. Ich werde das aber bei meiner nächsten Bestellung melden.~
@439 = ~Ah, ja, hier sind sie – sechs wunderbare Calimshan-Feigen.~
@440 = ~Hier ist noch etwas für Euch extra, und jetzt raus aus meiner Küche, ich habe zu tun.~
@441 = ~Festhalten! Ihr seid auf frischer Tat ertappt worden, als Ihr Schmuggelware gestohlen habt! Vielleicht sind es nur Feigen … aber sie wurden geschmuggelt! Zahlt eine Strafgebühr von 1.000 Goldmünzen. Wenn wir Euch noch einmal bei illegalen Aktivitäten erwischen, werden wir nicht so nachsichtig sein!~
@442 = ~Was … Uff, da geht es dahin, das „gesparte“ Gold, weil es so viel billiger war. Und noch einiges mehr! Ich hätte mir das nicht aufschwatzen lassen sollen. Und IHR – glaubt nicht, dass ich so blöd bin, nicht zu wissen, dass Ihr es wart, der der Flammenden Faust den Tipp gegeben hat!~ ~Was … Uff, da geht es dahin, das „gesparte“ Gold, weil es so viel billiger war. Und noch einiges mehr! Ich hätte mir das nicht aufschwatzen lassen sollen. Und IHR – glaubt nicht, dass ich so blöd bin, nicht zu wissen, dass Ihr es wart, die der Flammenden Faust den Tipp gegeben hat!~
@443 = ~Und jetzt alle raus aus meiner Küche! Raus, raus, raus!~
@444 = ~Da seid Ihr ja, unser neuer Muskelprotz. Seid Ihr bereit?~
@445 = ~Ja. Was soll ich tun?~
@446 = ~Nicht ganz. Ich bin in einer Minute zurück.~
@447 = ~Sicher, ich werde hier sein.~
@448 = ~Hier ist zunächst die Kiste. Nehmt sie und geht von hier aus nach Norden in Richtung Baldurs Tor. Aber tut das ohne Eile und vor allem nicht im Schatten oder gar unsichtbar. Es geht nicht darum anzukommen, sondern darum, die Teufel herauszulocken. Wenn Ihr mit den Nachtmasken fertig seid, kehrt einfach zu Holger zurück.~
@449 = ~Was soll ich sagen, haltet Ihr uns für dumm und blind? Die Kiste ist also leer. Gut gespielt! Na ja, bis auf den Teil, wo Ihr mit einer leeren Kiste durch die Gegend gestolpert seid. Wir haben beschlossen, Euch trotzdem zu töten, und ich habe noch ein paar Freunde mitgebracht, weil Ihr auch noch schmutzig spielen wolltet.~
@450 = ~Vielen Dank für die Schwarze-Lotus-Lieferung. Wir übernehmen ab hier.~
@451 = ~Wer seid Ihr? Bringt Ihr die Schmuggler um?~
@452 = ~Das glaube ich nicht.~
@453 = ~Bitte, nehmt die Kiste und lasst mich gehen. Das ist nicht mein Kampf!~
@454 = ~Das ist genau das, was wir tun. Wie wäre es, wenn wir es Euch zeigen?~
@455 = ~Oh, aber jetzt schon!~
@456 = ~Uh, ein „Held“.~ ~Uh, eine „Heldin“.~
@457 = ~Na dann, lasst uns tanzen!~
@458 = ~Da seid Ihr ja!~
@459 = ~[BG:EE #8907]Einen Schritt näher und Ihr kriegt eins hinter die Ohren!~
@460 = ~Moment, Moment, Moment. Ich erkenne ihn jetzt. Das ist Telmovs Schmugglerspion! Warum eskaliert Ihr die Situation auf diese Weise? Sagt uns doch einfach, dass Ihr auf einer von Telmovs Missionen seid!~ ~Moment, Moment, Moment. Ich erkenne sie jetzt. Das ist Telmovs Schmugglerspionin! Warum eskaliert Ihr die Situation auf diese Weise? Sagt uns doch einfach, dass Ihr auf einer von Telmovs Missionen seid!~
@461 = ~Halt! Was ist hier passiert? Erklärt Euch!~
@462 = ~Nun, was soll ich sagen … Das hier waren Nachtmasken, und wir wurden von ihnen angegriffen!~
@463 = ~Ich bin <CHARNAME>, ich arbeite mit Feldwebel Telmov, um die Schmuggler zu enttarnen. Dies ist eine der Missionen.~
@464 = ~Ich bin ein Abenteurer auf dem Weg nach Baldurs Tor.~ ~Ich bin eine Abenteurerin auf dem Weg nach Baldurs Tor.~
@465 = ~Es ist mir völlig egal, was Ihr Soldaten-Drecksäcke von mir denkt!~
@466 = ~Oh, das solltet Ihr aber, Bürger!~ ~Oh, das solltet Ihr aber, Bürgerin!~
@467 = ~Wir waren auf der Suche nach Nachtmasken, die sich in der Gegend herumgetrieben haben sollen. Es ist schon spät, und Eure Anwesenheit hier ist bestenfalls zweifelhaft. Was ist das für eine Kiste?~
@468 = ~Öffnet sie sofort!~
@469 = ~Nein, bitte … Äh, ich glaube, Ihr habt mich erwischt. Ich will wirklich nicht gegen Soldaten kämpfen.~
@470 = ~Schaut, das ist nur mein Reisegepäck. Ihr wollt doch nicht in meiner schmutzigen Wäsche wühlen, oder?~
@471 = ~Natürlich, bitte tut das. Ich bin sicher, es gibt nichts Verdächtiges zu sehen. (Zumindest gehe ich davon aus, dass Holger das sichergestellt hat …)~
@472 = ~Nun, wie wäre es, wenn ich Euch, sagen wir, 500 Goldstücke gebe und wir tun einfach so, als wäre das keine verdächtige Kiste, die ich nachts herumtrage?~
@473 = ~Nun, wie wäre es, wenn ich Euch, sagen wir, 300 Goldstücke gebe und wir tun einfach so, als wäre das keine verdächtige Kiste, die ich nachts herumtrage?~
@474 = ~Nun, wie wäre es, wenn ich Euch, sagen wir, 100 Goldstücke gebe und wir tun einfach so, als wäre das keine verdächtige Kiste, die ich nachts herumtrage?~
@475 = ~Wenn es so sein soll, dann zieht Eure Waffen! Ich werde Euch diese Kiste nicht überlassen!~
@476 = ~Öffnet sie oder wir werden es mit Gewalt tun!~
@477 = ~Eine Mission? Er hat uns nichts davon erzählt. Ist er sich dessen überhaupt bewusst?~
@478 = ~Er hat allerdings seinen Schmugglerspion erwähnt.~ ~Er hat allerdings seine Schmugglerspionin erwähnt.~
@479 = ~Richtig, er hat etwas erwähnt. Gut, dann tun wir eben nichts, um die Operation nicht zu gefährden!~
@480 = ~Ja, am besten lassen wir die Kiste unangetastet. Ich könnte nicht erklären, warum Ihr eine Kiste Schwarzen Lotus’ nicht beschlagnahmen wolltet, denke ich.~
@481 = ~Im Gegenteil, ich möchte die Situation nutzen und die Kiste öffnen. Wir müssen wissen, was sich darin befindet, wenn wir damit die Schmuggler hochgehen lassen wollen.~
@482 = ~Wahre Worte. Nun, mal sehen …~
@483 = ~Die Kiste ist leer! Tja, sieht so aus, als hätte Feldwebel Telmov nicht viel Glück bei der Verhaftung von Schmugglern, was?~
@484 = ~Versucht Ihr, uns zu bestechen?~
@485 = ~Nun, sie waren auf dem Weg nach Norden … Ist es wirklich wichtig, was in der Kiste ist, sobald sie aus Amn heraus sind?~
@486 = ~Ihr meint, wir sollten DANKBAR sein, dass jemand das, was wir für Schwarzen Lotus halten, WEG von hier bringt – und zu den Idioten in Baldurs Tor, damit sie sich einen Hirnschaden einhandeln können?~
@487 = ~Na logo.~
@488 = ~Hm, gut.~
@489 = ~Aber lasst es mindestens 300 Goldmünzen sein!~
@490 = ~300 Goldmünzen, bitte sehr.~
@491 = ~500 Goldmünzen, bitte sehr.~
@492 = ~Ich habe nicht so viel Gold bei mir, wie es scheint.~
@493 = ~Dann öffnet die Kiste jetzt!~
@494 = ~Ich hatte befürchtet, dass Ihr das sagen würdet.~
@495 = ~Die Kiste ist leer! Ist das ein Scherz? Warum tragt Ihr spät in der Nacht eine leere Kiste?~
@496 = ~Das … ist eine sehr gute Frage.~
@497 = ~Sie ist LEER? Holger, Ihr verdammter …~
@498 = ~Tja, da hat uns auch jemand belogen. Ich hätte erwartet, dass es zumindest eine große Ladung leckerer Feigen ist. Oder Steine! Steine sind auch sehr beliebt.~
@499 = ~Seht Ihr? Da ist keine Schmuggelware drin. Lasst Ihr uns jetzt in Ruhe?~
@500 = ~Nun, seht Ihr, die Kiste IST der Schatz. Habt Ihr noch nie von den, äh, sehr stabilen Kisten aus Chult gehört? Die sind der letzte Schrei in Baldurs Tor!~
@501 = ~Ihr seid enttäuscht, dass Ihr keinen Grund gefunden habt uns anzugreifen, was?~
@502 = ~Ihr haltet das für einen Scherz?~
@503 = ~Passt auf, was Ihr sagt!~
@504 = ~Hmpf.~
@505 = ~Ich denke, Ihr könnt dann gehen. Keine Sorge.~
@506 = ~Ihr habt einen Fehler gemacht!~
@507 = ~Seid gegrüßt. Die Aktivitäten der Banditen sind deutlich zurückgegangen, aber wir haben immer noch Probleme mit Schurken aller Art, die die Situation ausnutzen. Lasst es mich wissen, wenn Ihr etwas Verdächtiges bemerkt oder von irgendwelchen Banditen- oder Schmuggelaktivitäten hört. Es sind allzeit Schurken unterwegs!~
@508 = ~Ihr! Ich kann es nicht beweisen, aber ich WEISS, dass Ihr es wart, die meine Soldaten auf der Jagd nach Nachtmasken getötet haben. Geht mir aus den Augen! Seid froh, dass ich zu beschäftigt bin, um Euch einfach ins Gefängnis zu stecken, bis Ihr von selbst gesteht!~
@509 = ~<CHARNAME>! Hier ist Eure wohlverdiente Belohnung. Diese Stadt ist dank Euch ein wenig sicherer geworden. Ich werde wieder auf Patrouille gehen. Habt einen schönen Tag!~
@510 = ~Meine Kameraden haben mir erzählt, dass sie Euch bei einer Mission getroffen haben! Warum habe ich davon nichts gewusst?~
@511 = ~Ich sage es Euch gerade. Ich bringe die Schmugglerkiste jetzt zum Kopf der Bande. Das wird eine gute Gelegenheit sein, die Schmuggler auffliegen zu lassen.~
@512 = ~Bemüht Euch nicht, Feldwebel. Die Kiste ist leer, sie war wirklich nur ein Köder für die Nachtmasken.~
@513 = ~Es war eine fingierte Operation, um die Nachtmasken herauszulocken. Die Gegend ist jetzt wieder viel sicherer, aber um die Schmuggler hochgehen zu lassen, hätte es nicht funktioniert.~
@514 = ~Ihr müsst mir hier vertrauen, sonst funktioniert die Zusammenarbeit nicht.~
@515 = ~Ich verstehe. Haltet mich auf dem Laufenden.~
@516 = ~Ihr macht es einem schwer, Euch zu vertrauen, <CHARNAME>.~
@517 = ~Lauft nicht wieder mit Schmuggelware herum oder ich werde unsere Vereinbarung ernsthaft überdenken!~
@518 = ~Ihr macht es einem schwer, Euch zu vertrauen, <CHARNAME>. Zu schwer, um genau zu sein.~
@519 = ~Ihr sagt das immer wieder, aber ich bin mit meiner Geduld am Ende, <CHARNAME>.~
@520 = ~<CHARNAME>! Was ist aus unserer geplanten Schmugglerverhaftung in Bezug auf die Schmuggelware geworden, die Ihr aus Baldurs Tor holen wolltet?~
@521 = ~Ich habe Euch sogar ein offizielles Dokument dazu gegeben!~
@522 = ~Anscheinend habe ich vergessen, Euch zu sagen, wie es gelaufen ist. Jetzt ist der Schmugglerüberfall beendet.~
@523 = ~Ähm, hoppla. Entschuldigung …~
@524 = ~<CHARNAME>! So viel Zeit ist vergangen, aber Ihr habt keine hilfreichen Hinweise gegeben.~
@525 = ~Ich kann nicht länger auf Euch warten. Unsere Zusammenarbeit in Bezug auf die Schmuggler ist nun zu Ende.~
@526 = ~Habt Ihr irgendwelche Banditen- oder Schmuggleraktivitäten beobachtet, von denen Ihr berichten möchtet?~
@527 = ~Ich möchte eine Schmugglerorganisation melden, die ihren Treffpunkt hier in der Nähe hat. Leutnant Bardolan sagte, ich sollte mit Euch darüber sprechen.~
@528 = ~Ich möchte eine Schmugglerorganisation melden, die hier in der Nähe ihren Treffpunkt hat.~
@529 = ~(Lüge) Ihr wisst, dass Ihr nicht viel finden werdet, wenn Ihr Schmugglern unvorbereitet gegenübertretet, und Beobachtung braucht Zeit und Arbeitskraft. Ich könnte Euer Spion bei ihnen sein. Ich habe so getan, als wollte ich mit ihnen zusammenarbeiten. Auf diese Weise könnte ich Euch informieren, wenn sie echte Raubüberfälle planen, sodass Ihr sie auf frischer Tat ertappen könntet.~ ~(Lüge) Ihr wisst, dass Ihr nicht viel finden werdet, wenn Ihr Schmugglern unvorbereitet gegenübertretet, und Beobachtung braucht Zeit und Arbeitskraft. Ich könnte Eure Spionin bei ihnen sein. Ich habe so getan, als wollte ich mit ihnen zusammenarbeiten. Auf diese Weise könnte ich Euch informieren, wenn sie echte Raubüberfälle planen, sodass Ihr sie auf frischer Tat ertappen könntet.~
@530 = ~Ich werde meine Spionage mit den Schmugglern beenden. Wenn Ihr sie ausschalten wollt, müsst Ihr zu ihrem Treffpunkt gehen, südwestlich des Schwarzer-Lotus-Zeltes auf dem Jahrmarkt.~
@531 = ~Es gab eine Schmuggler-Organisation, die von Amn aus arbeitete, aber die gibt es jetzt nicht mehr.~
@532 = ~Die Schmuggler-Organisation, die von Amn aus arbeitet, ist jetzt verschwunden.~
@533 = ~In der Nähe gab es einen Schmugglertreffpunkt, südwestlich des Schwarzer-Lotus-Zeltes beim Jahrmarkt. Die gibt es jetzt aber nicht mehr. Ich habe diese Kiste bei ihnen gefunden. Ich glaube, es ist eine Lieferung für ein Gasthaus in Baldurs Tor.~
@534 = ~In der Nähe gab es einen Schmugglertreffpunkt, südwestlich des Schwarzer-Lotus-Zeltes auf dem Jahrmarkt. Die gibt es allerdings nicht mehr.~
@535 = ~Die Schmuggler haben mir diese verdächtige Kiste gegeben, die ich nach Baldurs Tor bringen soll. Es ist ein erster Testauftrag, also denke ich, es wäre das Beste, wenn ich das mache, um mich bei ihnen beliebt zu machen. Ich wollte es Euch nur sagen.~
@536 = ~Ich soll eine Lieferung überbringen, um Nachtmasken anzulocken, die es auf die Schwarzer-Lotus-Schmuggelaktivitäten abgesehen haben, aber ich werde sie anschließend zum Schmugglerkopf zurückbringen. Das könnte eine gute Gelegenheit sein, sie auf frischer Tat zu ertappen.~
@537 = ~Gut, dass Ihr noch hier seid. Kommt nicht zu den Schmugglern! Die Kiste ist leer … da ist nichts drin. Es war wirklich nur ein Köder für die Nachtmasken.~
@538 = ~Wäre es möglich, etwas Offizielles zu bekommen, das besagt, dass ich tatsächlich für Euch arbeite? Das würde das Auffinden des Schmugglergegenstands auf jeden Fall sehr erleichtern.~
@539 = ~(Wahrheit) Der nächste Schmugglerüberfall steht an. Ich soll Waren aus Baldurs Tor zurückholen. Ich wollte Euch nur Bescheid geben, damit Ihr Euch darauf vorbereiten könnt, die Schmuggler zu verhaften, sobald ich sie zurückbringe.~
@540 = ~(Lüge) Der nächste Schmugglerüberfall steht an. Ich soll Waren aus Baldurs Tor zurückholen und sie den Schmugglern zurückgeben. Ich wollte Euch nur Bescheid sagen und fragen, ob Ihr mich in irgendeiner Weise unterstützen könnt.~
@541 = ~Ich bin zurück aus Baldurs Tor mit der Schmugglerware. Ich gehe jetzt und stelle mich den Schmugglern. Werdet Ihr dabei sein?~
@542 = ~Ich bin zurück aus Baldurs Tor mit Schmugglerware. Ich werde mich jetzt den Schmugglern stellen. Das ist Eure Chance, sie auf frischer Tat zu ertappen!~
@543 = ~Es wird keine Schmugglerverhaftung geben. Es tut mir leid, in Baldurs Tor lief es nicht wie geplant, also habe ich nichts, was ich den Schmugglern übergeben könnte.~
@544 = ~Welchen Status habt Ihr hier?~
@545 = ~Ich habe Euch hier noch nicht gesehen. Seid Ihr neu in Nashkell stationiert?~
@546 = ~Einen schönen Tag Euch.~
@547 = ~Na gut, das ist schade.~
@548 = ~Die lokale Schmugglerbedrohung ist also erledigt, nehme ich an. Vielen Dank für Euren Bericht, Bürger.~ ~Die lokale Schmugglerbedrohung ist also erledigt, nehme ich an. Vielen Dank für Euren Bericht, Bürgerin.~
@549 = ~Sehr gut. Sagt uns Bescheid, wenn Ihr zurück seid, bevor Ihr den Schmugglern irgendetwas Kompromittierendes gebt, damit wir sie zur Rede stellen können.~
@550 = ~Wäre es möglich, etwas Offizielles zu bekommen, das besagt, dass ich tatsächlich für Euch arbeite? Das würde das Auffinden des Schmugglergegenstandes auf jeden Fall sehr viel einfacher machen. Er befindet sich ausgerechnet in der Seeturm-Kaserne.~
@551 = ~Ich werde mich auf den Weg machen.~
@552 = ~Nachtmasken! So machen sich die Schurken gegenseitig das Leben schwer. Was wird die Lieferung sein?~
@553 = ~Ich weiß es nicht.~
@554 = ~Schwarzer Lotus, was wohl sonst?~
@555 = ~Wollt Ihr einen Blick darauf werfen?~
@556 = ~Ich würde ja gerne, aber ich fürchte, es ist besser, wenn wir nicht an der Schachtel herumhantieren, um keinen Verdacht zu erregen.~
@557 = ~Hmm, es könnte tatsächlich Schwarzer Lotus sein, wenn es ein Köder sein soll.~
@558 = ~Wir können Euch nicht gegen die Nachtmasken helfen, da dies verdächtig aussehen würde.~
@559 = ~Wir werden da sein, wenn Ihr mit der Ware zu den Schmugglern zurückkehrt. Lasst uns das zu Ende bringen.~
@560 = ~Gut, dass Ihr mich warnt. Dann werde ich mit der Konfrontation von Schmugglern noch warten.~
@561 = ~Wisst Ihr, was da drin ist?~
@562 = ~Nein, es ist ein Test. Das hat er mir nicht absichtlich gesagt.~
@563 = ~Nicht die geringste Idee.~
@564 = ~Es sind Feigen.~
@565 = ~Wenn ich das wüsste, hätte ich nicht gesagt: „Ich habe hier eine Kiste“, nicht wahr?~
@566 = ~Ist das von Bedeutung?~
@567 = ~In diesem Fall informiert Ihr am besten unser Pendant in Baldurs Tor, damit sie die Beteiligten bei der Übergabe fangen können!~
@568 = ~Wäre es möglich, etwas Offizielles zu bekommen, das besagt, dass ich tatsächlich für Euch arbeite? Es widerstrebt mir, mit Schmuggelware in meinem Rucksack herumzulaufen. Es wäre auch etwas einfacher, die Flammende Faust anzusprechen, wenn sie sehen könnten, dass dies Teil einer offiziellen Untersuchung ist.~
@569 = ~Ich denke, das kann ich arrangieren.~
@570 = ~Feigen?~
@571 = ~Diese Kiste zu öffnen, würde in der Tat zu nichts führen, da wir nicht beweisen können, dass sie Euch von den Schmugglern ausgehändigt wurde.~
@572 = ~Ich bin Feldwebel Telmov. Ich sorge dafür, dass die Befehle unseres Leutnants ausgeführt werden, und ich sorge für die Ausbildung und Disziplin der Männer unter unserem Kommando.~
@573 = ~Nein, ganz im Gegenteil. Die Beruhigung der Banditensituation hat es mir ermöglicht hierher zurückzukehren. Ich war vorher im Auftrag unterwegs. Jetzt werde ich mehr Zeit haben, mich neben den Banditen auch mit gewöhnlichen Verbrechern zu beschäftigen.~
@574 = ~Schmuggler, sagt Ihr? Wir haben zwar einige Aktivitäten bemerkt, aber wir waren uns nicht sicher, von wo aus sie operierten. Trotz der Anzahl der Soldaten haben wir nicht die nötige Mannstärke, um jeden verdächtigen Vorfall zu untersuchen.~
@575 = ~Ihr Treffpunkt ist südwestlich des Schwarzer-Lotus-Zeltes auf dem Jahrmarkt. Dort ist normalerweise jemand, der als Beerenpflücker verkleidet ist. Er ist der Kontaktmann des Schmugglers.~
@576 = ~(Wahrheit) Ich habe mich von ihnen anheuern lassen, aber nur, um mehr Einblick in ihre Tätigkeit zu bekommen. Ich werde Euch auf dem Laufenden halten.~
@577 = ~Wenn ich es mir recht überlege, bin ich mir nicht sicher. Ich werde jetzt gehen.~
@578 = ~Ja, das passt zu anderen Berichten über verdächtige Aktivitäten, die wir erhalten haben.~
@579 = ~Wenn wir sie schon nicht fangen können, so können wir ihnen zumindest die Arbeit erschweren. Vielen Dank für Euren Bericht, Bürger.~ ~Wenn wir sie schon nicht fangen können, so können wir ihnen zumindest die Arbeit erschweren. Vielen Dank für Euren Bericht, Bürgerin.~
@580 = ~Oh? Nachrichten wie diese sind Musik in meinen Ohren.~
@581 = ~Normalerweise sind Nachrichten wie diese Musik in meinen Ohren, aber in diesem Fall hatte ich gehofft, dass wir in der Lage sein würden, mehr Aktivitäten zu beobachten, um sie auf frischer Tat zu ertappen.~
@582 = ~Vielen Dank, dass Ihr uns das mitgeteilt habt.~
@583 = ~Ihr habt Euch bei der Befreiung der Minen bewährt. Ich werde Euch in diesem Fall vertrauen. Wir werden vorerst keine eigenen Maßnahmen gegen die Schmuggler ergreifen, sondern warten auf Eure Berichte, wann wir sie hart treffen können. Ihr werdet mich wissen lassen, wenn es irgendwelche Schmuggelaktivitäten gibt, die wir nutzen könnten, um sie auf frischer Tat zu ertappen.~
@584 = ~Hmm, ein offizielles Dokument, meint Ihr? Hört, ich verstehe, was Eure Beweggründe sind, aber Ihr habt mich im Grunde genommen gebeten, eine Schmuggeloperation zu zertifizieren …~
@585 = ~Bei allem Respekt, aber das wird nicht passieren. Seid froh, dass ich Euch überhaupt mit dieser Kiste laufen lasse!~
@586 = ~Hmm, aber Ihr habt da ein gutes Argument. Wenn wir ihre Mittelsmänner ausschalten können, wird uns das am Ende auch helfen.~
@587 = ~Gut. Hier, nehmt das. Aber wenn ich höre, dass Ihr das in irgendeiner Art missbraucht habt, werde ich Euch genauso zur Strecke bringen wie die Schmuggler!~
@588 = ~Hmm, ich gebe zu, dass Ihr in gewisser Weise ein Agent auf einer Mission zu unseren Gunsten seid.~ ~Hmm, ich gebe zu, dass Ihr in gewisser Weise eine Agentin auf einer Mission zu unseren Gunsten seid.~
@589 = ~Das ist immer noch ein bisschen viel verlangt. Ich kenne Euch immer noch nicht wirklich, ich habe nur Euer Wort. Ich hoffe, Ihr versteht, dass ich Euch ein solches Dokument noch nicht aushändigen werde.~
@590 = ~Guten Tag, Bürger.~ ~Guten Tag, Bürgerin.~
@591 = ~Ich werde auch das Kollaborationsdokument zurücknehmen.~
@592 = ~Ich bin mir nicht sicher, warum ich es Euch überhaupt gegeben habe!~
@593 = ~Das ist eine gute Information. Geht in die Kaserne und sagt Feldwebel Telmov Bescheid, er wird die Details besprechen.~
@594 = ~Seid gegrüßt. Seit die Brücke zerstört ist, haben wir wieder mehr Gesindel in der Stadt. Gut, dass die reduzierten Banditenaktivitäten es möglich gemacht haben, dass mehr Söldner ins Hauptquartier zurückkehren konnten. Wir werden sie brauchen, um mit den Kriminellen fertig zu werden, die wieder ihr Glück innerhalb der Stadttore versuchen. Zögert nicht, verdächtige oder illegale Aktivitäten zu melden, die Ihr beobachtet. Wir werden alle Hände voll zu tun haben, aber die Sicherheit der Stadt steht an erster Stelle.~
@595 = ~Ah, Ihr wart diejenigen, die die Schmugglertunnel unter dem Seeturm aufgedeckt haben, nicht wahr? In diesem Fall – wenn Ihr von weiteren Schmuggleraktivitäten wisst, kommt sofort zu mir!~
@596 = ~Ah, <CHARNAME>. Hier ist Eure Belohnung für die Meldung der Schmuggleraktivitäten des Kochs. Das ist ziemlich gut gelaufen. Haltet uns auf dem Laufenden!~
@597 = ~Ich füge auch eine Bestätigung über Eure Hilfe bei dieser Verhaftung hinzu. Ich denke, es könnte helfen, die Unterstützung der Nashkeller Garde zu sichern. Und wenn die organisierten Schmuggler dort verschwunden sind, werden auch die Aktivitäten hier aufhören.~
@598 = ~Habt Ihr etwas zu berichten?~
@599 = ~(Wahrheit) Ich habe mich von Schmugglern, die in Baldurs Tor operieren, anheuern lassen, aber nur, um mehr Einblick in ihre Geschäfte zu bekommen. Ich werde Euch auf dem Laufenden halten.~
@600 = ~Ich habe diese versiegelte Kiste mit Schmuggelware, die ich einem Koch im Gasthaus Helm und Umhang bringen soll.~
@601 = ~Ich habe diese versiegelte Kiste mit Schmuggelware von Schmugglern, die ich hochgenommen habe. Ich glaube, sie sollte an den Koch im Gasthaus Helm und Umhang gehen.~
@602 = ~Ich habe Wissen über Schmuggelaktivitäten im Seeturm.~
@603 = ~Ich habe Kenntnis von Sklavenhändlern, die ihre Geschäfte direkt im Seeturm abwickeln!~
@604 = ~Im Moment nichts.~
@605 = ~Hmm, das ist Seeturm-Territorium. In diesem Fall meldet Euch bitte direkt beim Hauptmann der Seeturm-Wache, damit er die Einzelheiten mit Euch besprechen kann.~
@606 = ~Ich bin Manip Limmon. Falls Ihr mit der Terminologie nicht vertraut seid: Ein Manip ist das, was man in anderen militärischen Organisationen einen Feldwebel nennen würde. Ich unterstehe direkt unserer Flamme – unserem Leutnant – und helfe, die Fäuste – unsere Soldaten – zu befehligen. Ich wurde beauftragt, gegen Bandenkriminalität und organisierte illegale Aktivitäten innerhalb Baldurs Tors vorzugehen.~
@607 = ~Eine Schmugglerlieferung! Was ist da drin?~
@608 = ~Es sind nur Figuren … Aber sie wurden trotzdem geschmuggelt.~
@609 = ~Eigentlich ist dies ein Test, bei dem die Schmuggler entscheiden werden, ob sie mir vertrauen oder nicht. Ich weiß, dass es schwer zu fragen ist, aber würdet Ihr bei diesem Test ein Auge zudrücken und mich zuerst ein Vollmitglied werden lassen?~
@610 = ~Gibt es eine Möglichkeit für Euch, sich nicht so einzumischen, dass meine „Mission“ gefährdet wird? Zum Beispiel, indem Ihr es so aussehen lasst, als hättet Ihr einen Tipp von irgendwo anders bekommen, und den Helm und Umhang durchsucht, lange nachdem ich weg bin? Auf diese Weise kann ich auf lange Sicht bessere Informationen liefern.~
@611 = ~Die Kenntnis des Inhalts würde helfen, die Ernsthaftigkeit dieses Rechtsverstoßes zu beurteilen.~
@612 = ~Was wollt Ihr damit sagen?~
@613 = ~Schmuggelware ist Schmuggelware, nicht wahr?~
@614 = ~Es gibt keine Möglichkeit, jetzt zu schauen, ohne das Siegel dieser Kiste zu brechen. Es könnte die Operation gefährden, den Koch im Helm und Umhang auf frischer Tat zu ertappen.~
@615 = ~Schauen wir es uns doch einmal an, nicht wahr?~
@616 = ~Ich habe einen offiziellen Kooperationspass der Nashkeller Garde, falls das etwas bedeutet.~
@617 = ~Aber natürlich!~
@618 = ~Sie zu öffnen, würde riskieren, Verdacht zu erregen, bevor wir loslegen, das ist sicher. Hmm.~
@619 = ~Es gibt einen Unterschied zwischen einer seltenen und geschützten magischen Zutat und etwas, das jemand nur geschmuggelt hat, um ein paar Goldmünzen zu sparen.~
@620 = ~Aber ich will damit NICHT andeuten, dass es Fälle gibt, in denen sich die Verfolgung illegaler Aktivitäten nicht lohnen würde! Ich habe versucht, das Ausmaß dieser Transaktion abzuschätzen, um zu ermitteln, wie viel Personal man einsetzen müsste, um sie zu stören.~
@621 = ~Werdet Ihr dabei sein, wenn ich die Schachtel überreiche?~
@622 = ~Da ich diese Testmission wahrscheinlich schon gefährdet habe, ist das Beste, was wir tun können, den Koch im Helm und Umhang zu kriegen.~
@623 = ~Gibt es eine Möglichkeit, mich da rauszulassen? Zum Beispiel, den Helm und den Umhang zu durchsuchen, lange nachdem ich weg bin?~
@624 = ~Wir werden da sein, wenn Ihr die Schachtel übergebt.~
@625 = ~Hmm. Einen Bericht über eine illegale Aktion für das „größere Wohl“ liegen lassen?~
@626 = ~Und warum sollte ich das tun?~
@627 = ~Wie Ihr gerade gesagt habt – weil Ihr auf lange Sicht mehr davon habt, wenn Ihr mich jetzt nicht „kompromittiert“.~
@628 = ~Sorgt nur dafür, dass die Schmuggler nicht wissen, dass ich sie gemeldet habe, damit sie nicht das Vertrauen in mich verlieren. Ich bin natürlich dafür, dass die Verantwortlichen im Helm und Umhang ihre angemessene Strafe bekommen.~
@629 = ~Sorgt nur dafür, dass die Schmuggler nicht wissen, dass ich sie gemeldet habe. Ich bin natürlich dafür, dass die Verantwortlichen im Helm und Umhang ihre gerechte Strafe bekommen.~
@630 = ~Ich habe Euch bereits den Hinweis gegeben. Ich habe kein Interesse daran, in der Bestrafung involviert zu sein, wisst Ihr?~
@631 = ~Ihr habt recht, das ist ein bisschen viel verlangt, und auch ziemlich verdächtig, denke ich.~
@632 = ~Lass mich mal sehen. Hmm. Ja, das bedeutet eine Menge.~
@633 = ~Das werdet Ihr nicht sein.~
@634 = ~Gut, wir werden uns zurückhalten, bis Ihr längst außer Sichtweite seid. Der Koch im Helm und Umhang wird nicht wissen, dass Ihr es wart, der uns die Informationen gegeben hat. Kommt nach einer Woche oder so und holt Euch Eure Belohnung ab!~ ~Gut, wir werden uns zurückhalten, bis Ihr längst außer Sichtweite seid. Der Koch im Helm und Umhang wird nicht wissen, dass Ihr es wart, die uns die Informationen gegeben hat. Kommt nach einer Woche oder so und holt Euch Eure Belohnung ab!~
@635 = ~Ihr habt die Kiste bereits geöffnet. Glaubt Ihr wirklich, dass sie Euch noch vertrauen?~
@636 = ~Na gut, das höre ich gerne.~
@637 = ~Und jetzt sind sie weg? Es ist eine Schande, dass wir keinen Weg gefunden haben, sie zu erwischen, als sie noch aktiv waren, aber es ist trotzdem gut zu hören.~
@638 = ~Jetzt sind sie also weg? Gut, das ist etwas, das ich gerne höre. Vielen Dank für Eure Mitarbeit in dieser Sache. Wir waren zwar nicht in der Lage, die gesamte Organisation hier in der Stadt zu zerschlagen, aber Ihr habt uns geholfen, einige der Strukturen zu identifizieren. Lebt wohl.~
@639 = ~Hmm, ich glaube, ich weiß, auf wen Ihr Euch bezieht. Das wäre Seeturm-Kommandant Airards Kontrollbereich. Lasst es ihn wissen, wenn Ihr mehr Details dazu habt. Ich weiß, dass er die Bastarde überführen will.~
@640 = ~Dann geht weiter.~
@641 = ~Hmm, gut. Ihr habt Euch bereits einen Namen gemacht, und ich weiß, dass Scar nach Euch gesucht hat. Halte mich über alle Schmuggleraktivitäten auf dem Laufenden, von denen Ihr wisst. Es wäre ideal, sie auffliegen zu lassen, aber ich nehme auch Hinweise auf ihre Kunden entgegen.~
@642 = ~Ich möchte eine Schmugglerorganisation aus Amn melden, die in Baldurs Tor operiert.~
@643 = ~Ah. Unser Manip wäre die richtige Adresse für diese Art von Berichten – Manip Limmon. Sie sollte im Hauptquartier sein.~
@644 = ~Sie ist gleich da drüben.~
@645 = ~Bitte meldet dieses Detail an Manip Limmon. Ihr solltet sie im Hauptquartier finden. Ich bin gespannt darauf, von Euren Erfolgen zu hören.~
@646 = ~Bitte meldet dieses Detail an Manip Limmon. Ihr solltet sie im Hauptquartier finden. Bitte kommt jetzt mit mir.~
@647 = ~Bitte meldet dieses Detail an Manip Limmon. Ihr solltet sie im Hauptquartier finden. Kommt Ihr jetzt mit mir mit?~
@648 = ~Bitte meldet dieses Detail an Manip Limmon. Ihr solltet sie im Hauptquartier finden.~
@649 = ~He! Wie ich sehe, mischt Ihr Euch in die persönlichen Dinge des Hauptmanns ein. Das ist definitiv nichts für Euch! Ich nehme das hier und Ihr verschwindet SEHR schnell von hier! Seid froh, dass ich Euch am Leben lasse!~
@650 = ~Oh, was für ein schlimmes Missverständnis! Ihr seht, ich bin mitten in einer Untersuchung über Schmuggelaktivitäten in der Region. Wir haben einen Hinweis erhalten, dass Euer Hauptmann einem dubiosen Händler zum Opfer gefallen ist. Ich war hier, um die belastenden Beweise unauffällig zu beseitigen. Seht hier, ich habe einen offiziellen Ausweis und so.~
@651 = ~Oh, was für ein schlimmes Missverständnis! Schaut, ich bin mitten in einer Untersuchung über Schmuggelaktivitäten in der Region. Wir haben einen Hinweis erhalten, dass Euer Hauptmann einem dubiosen Händler zum Opfer gefallen ist. Ich war hier, um die belastenden Beweise unauffällig zu beseitigen.~
@652 = ~Hört zu, ich brauche dieses Parfümfläschchen dringend. Besteht die Möglichkeit, dass wir das mit einer schönen Summe Gold regeln können?~
@653 = ~Na gut, na gut, ich bin weg.~
@654 = ~Verschwindet schnell, bevor ich feststelle, dass Ihr einer der Schurken seid, vor denen ich den Turm beschützen soll!~ ~Verschwindet schnell, bevor ich feststelle, dass Ihr einer der Schurkinnen seid, vor denen ich den Turm beschützen soll!~
@655 = ~Schmuggler?~
@656 = ~Hört mal, ich weiß, was Ihr für diesen Turm und diese Stadt getan habt.~
@657 = ~Ihr könnt nicht einfach herkommen und Sachen mitnehmen! Aber Ihr klingt ehrlich genug. Wenn Ihr die Wahrheit sprecht, ist das eine ernste Angelegenheit.~
@658 = ~Ich werde diese Phiole an einem sicheren Ort aufbewahren, und Ihr sprecht mit unserem Hauptmann darüber, in Ordnung? Ich kann sie Euch nicht einfach geben, ich bin sicher, Ihr werdet das verstehen.~
@659 = ~Das ist aus Amn! Hmm. Wenn Ihr die Wahrheit sprecht, ist das eine ernste Angelegenheit.~
@660 = ~Dies ist kein Ort für Euch zu dieser Stunde. Verlasst ihn sofort!~
@661 = ~Was ist das denn? Ich … ich habe SO SEHR versucht, mich nicht zu erkennen zu geben, aber das ist einfach zu viel! Euer Kollege hat mir gesagt, ich solle ganz, ganz leise sein, damit alles reibungslos abläuft, und jetzt bin ich hier!~
@662 = ~Ähh…~
@663 = ~Wer seid Ihr?~
@664 = ~Ihr wart aus freien Stücken dort drin?~
@665 = ~Ihr wart in dem Fass?~
@666 = ~Fürchtet Euch nicht! Ich habe Euch aus dem Inneren des Fasses gerettet, mein Herr!~
@667 = ~Wollt Ihr mich für dumm verkaufen?~
@668 = ~Großartig, einfach großartig. Ich habe eine ganze Menge Gold ausgegeben, um unentdeckt aus der Stadt zu kommen, und jetzt ist alles umsonst! Hier bin ich nun, außerhalb dieses Fasses in Gott weiß wo. Ihr werdet nicht den zweiten Teil des Honorars bekommen, das sage ich Euch!~
@669 = ~Entschuldigung, ich dachte, da drin sei jemand in Gefahr!~
@670 = ~Warum habt Ihr Euch aus der Stadt schmuggeln lassen?~
@671 = ~Ihr seid also ein Verbrecher?!~
@672 = ~Wartet, wartet, ich gehöre zu den Schmugglern. Geht einfach wieder rein und ich bringe Euch zu dem versprochenen Kontakt. Ihr habt mein Wort.~
@673 = ~Ihr wollt jetzt einfach gehen? Nach der Anstrengung, die Ihr auf Euch genommen habt, um in diesem Fass zu sein?~
@674 = ~Ah, so einfach ist das nicht. Das ist es nie.~
@675 = ~Was? Passt auf, was Ihr sagt! Im Moment seid IHR hier der Kriminelle!~ ~Was? Passt auf, was Ihr sagt! Im Moment seid IHR hier die Kriminelle!~
@676 = ~Ah-aHAHAhaha!~
@677 = ~Ich denke, es ist egal, ob ich Euch mein Motiv nenne. Ich bin Botschafter, Botschafter von Crimmor. Das ist in Amn, falls Ihr das nicht wisst. Ich … halte mich nicht mehr gerne in dieser Stadt auf. Die Gründe dafür sollten wir für uns behalten, aber ich versichere Euch, dass sie nicht illegal oder moralisch anstößig sind. Aber um offiziell meinen Posten aufzugeben, müsste ich meine Entlassung bei meiner Heimatbehörde beantragen, es gäbe Abschiedszeremonien, ich müsste auf meinen offiziellen Nachfolger warten und ihn angemessen vorstellen … (seufz) Also bin ich abgehauen. Oder zumindest habe ich es versucht. (spöttel)~
@678 = ~Hinzu kommen die aktuellen Spannungen zwischen Baldurs Tor und Amn, die der Gesamtsituation nicht gerade zuträglich sind. Die Stadt war bis vor Kurzem sogar abgeriegelt. Das ist der Grund, warum ich überhaupt mit Euch in Kontakt getreten bin.~
@679 = ~Bitte habt Verständnis dafür, dass ich Euch meine Weiterreise nicht mehr anvertrauen werde, nachdem Ihr das Fass entgegen den ausdrücklichen Vereinbarungen geöffnet habt.~
@680 = ~Nun, ich schätze, das ist ein Zeichen der Götter, dass es keinen einfachen Weg aus einigen Verpflichtungen gibt. (seufz) Danke, ab hier werde ich meinen eigenen Weg finden.~
@681 = ~Hallo da! Wo ist die Lieferung? Beeilt Euch und holt sie! Die Flut ist gut zum Verschwinden.~
@682 = ~Ah, da seid Ihr ja. Und ich sehe das Fass.~
@683 = ~Lasst mich Euch das abnehmen.~
@684 = ~Eure Arbeit hier ist getan. Folgt uns nicht!~
@685 = ~Lasst mich das von Eurer … Wartet! Soldaten!~
@686 = ~Ah, es tut gut, mir mal wieder die Beine zu vertreten. Ich war mir nicht sicher, ob es wirklich funktionieren würde, so von meinen Pflichten wegzukommen … Wer sind all diese Leute?~
@687 = ~Keine Sorge, das sind nur unsere Leute fürs Grobe. Sie wollten gerade gehen.~
@688 = ~Äh, ja, ich gehe jetzt. Gute Reise, Herr.~
@689 = ~Ist Holger jetzt in den Menschenschmuggel eingestiegen?~
@690 = ~Warum … stellen sie Fragen? Ihr habt garantiert, dass ich die Stadt völlig inkognito verlassen würde.~
@691 = ~Das tun sie nicht. Sie wollten gerade GEHEN.~
@692 = ~<CHARNAME>! Was ist aus der geplanten Schmugglerverhaftung geworden? Wir haben gewartet, aber es ist niemand aufgetaucht! Ihr habt unsere Zeit verschwendet, wie es scheint!~
@693 = ~Nein, ich dachte, ich würde jemanden aus dem Fass retten, ich schwöre! Aber dann ist die ganze Operation geplatzt.~
@694 = ~Ich bitte um Entschuldigung. Eine wichtige Mission führte mich in die Irre und ich hatte nicht genug Zeit.~
@695 = ~Ich hätte es dem Hauptmann gesagt, aber Ihr seid mir zuvorgekommen.~
@696 = ~Ups, ja, ich bin mir auch nicht sicher, was da passiert ist.~
@697 = ~Hmpf, dann ist es eine gescheiterte Mission. Ihr solltet das ernster nehmen!~
@698 = ~Hmpf, eine gescheiterte Mission also. Nun, so etwas kann passieren. Lasst es uns wissen, wenn Ihr noch etwas anderes hört.~
@699 = ~Ihr seid wegen Schmuggels und Drogenhandels verhaftet! Die Beweise befinden sich in diesem Fass!~
@700 = ~Ah, es tut gut, sich die Beine zu vertreten … Wartet … Soldaten? Das läuft … nicht wie geplant, wie ich sehe.~
@701 = ~Oh, Herr Botschafter! Ich wurde über Euer plötzliches Verschwinden informiert, und Eure Nachricht hat im Palast große Aufregung ausgelöst. Wart Ihr in irgendeiner Form in Gefahr, mein Herr?~
@702 = ~Was? Nein, nein-nein-nein, keine Gefahr. Ich wollte nur … nach Hause zurückkehren. Ich entschuldige mich für die Verwirrung, die ich verursacht habe. Ich schätze, das ist ein Zeichen der Götter, dass es keinen einfachen Weg aus einigen Verantwortlichkeiten gibt. (seufz)~
@703 = ~Wir werden Euch zurück zum Palast begleiten, wenn Ihr uns das erlaubt, Herr.~
@704 = ~Nun, das ist nicht gerade die Art von Schmuggelware, die ich mir erhofft hatte, aber wir haben diesen Mann und seine Kollegen auf frischer Tat ertappt. <CHARNAME>, kommt später im Büro des Hauptmanns vorbei, um Eure Belohnung zu erhalten.~
@705 = ~Ich diene der Flammenden Faust!~
@706 = ~<CHARNAME>! Es ist schön Euch wiederzusehen – und dazu noch in so guter Verfassung.~
@707 = ~Holger! Seid Ihr jetzt wieder in Baldurs Tor?~
@708 = ~Habt Ihr noch mehr Schmuggleraufgaben für mich?~
@709 = ~Tut mir leid, aber ich habe keine Zeit für Euch.~
@710 = ~Das bin ich in der Tat.~
@711 = ~Das habe ich in der Tat.~
@712 = ~Ich hätte da eine Sache, bei der ich Eure Hilfe gebrauchen könnte. Da Ihr heutzutage im Palast ein- und ausgeht, könnte ich Eure Hilfe gebrauchen, um eine Zusammenarbeit … abzusichern, die ich gerade schmiede.~
@713 = ~Oh nein, ich bin kein Mann der ineffizienten Kleinigkeiten, <CHARNAME>. Nun, ja, natürlich bin ich auch an dem privaten Schatzverstecken des Herzogs interessiert, aber es ist keineswegs mein Hauptinteresse. Und mit Eurer Hilfe werde ich mir – unter anderem – unbegrenzten Zugang dazu verschaffen.~
@714 = ~Das weiß ich zu schätzen. Ja, ich habe mir Sorgen gemacht, dass Euer Abbild auf Steckbriefen überall auftauchen könnte. Aber Ihr habt Euren Weg zurück in die Stadt gefunden, und das ziemlich eindrucksvoll, wenn ich das sagen darf!~
@715 = ~Nun, dann sehen wir uns, denke ich.~
@716 = ~Gebt dies einer Wache der Flammenden Faust im Palast. Sein Name ist Bruce. Soweit ich weiß, sollte er im ersten Stock Dienst haben. Gebt es ihm einfach und richtet ihm Grüße von mir aus. Er wird Bescheid wissen.~
@717 = ~Kann ich auf Euch zählen?~
@718 = ~Wollt Ihr auch, dass ich Rubinwein aus dem Keller des Palastes hole?~
@719 = ~Natürlich. Was soll ich für Euch tun?~
@720 = ~Es tut mir leid, das kann ich nicht tun.~
@721 = ~Es ist immer schön, Euch zu sehen.~
@722 = ~Ich habe eine Antwort von Bruce erhalten. Gut gemacht, <CHARNAME>. Shucks „Ersatz“ ist installiert, jetzt bin ich wieder voll im Geschäft!~
@723 = ~Es ist wirklich eine Schande, <CHARNAME>, aber Ihr seid zu berühmt geworden, um ein guter Schmuggler zu sein. Zumindest für die Art von Geschäften, die ich mache. Ihr solltet Euch um größere und politischere Taten bemühen, wenn Ihr in der Branche bleiben wollt. Nochmals, es war ein Vergnügen, mit Euch zu arbeiten, aber dies ist der Abschied. Ihr werdet mich nicht wiedersehen, nicht wenn ich so gut darin bin, im Verborgenen zu bleiben, wie ich immer behaupte. Lebt wohl.~ ~Es ist wirklich eine Schande, <CHARNAME>, aber Ihr seid zu berühmt geworden, um eine gute Schmugglerin zu sein. Zumindest für die Art von Geschäften, die ich mache. Ihr solltet Euch um größere und politischere Taten bemühen, wenn Ihr in der Branche bleiben wollt. Nochmals, es war ein Vergnügen, mit Euch zu arbeiten, aber dies ist der Abschied. Ihr werdet mich nicht wiedersehen, nicht wenn ich so gut darin bin, im Verborgenen zu bleiben, wie ich immer behaupte. Lebt wohl.~
@724 = ~[BG:EE #7550]Geht weiter, Freunde! Aber wehe, Ihr macht Ärger!~
@725 = ~[BG:EE #7549]Ihr da! Macht bloß keinen Ärger!~
@726 = ~Ich habe dies für Euch, mit Grüßen von Holger.~
@727 = ~Ich gehe schon.~
@728 = ~Holger? Was zum … A-ahahaha! Das ist BRILLANT. Ich habe ihm gesagt, er soll mich beeindrucken, und … nun … Dass Ihr mir das ausgerechnet HIER liefert … Ja, ich bin beeindruckt. Sagt ihm, ich bin dabei. Eigentlich kann ich es ihm selbst sagen. Ich habe jetzt Pause. Man sieht sich!~
@729 = ~He, ich habe eine Nachricht für <CHARNAME>. Grüße von Holger. Wenn Ihr Zeit habt, kommt bitte zu ihm in das „Zu den Drei Alten Fässern“.~
@730 = ~Nun, eigentlich bin ich hier, weil wir bemerkt haben, dass Ihr in Schwierigkeiten steckt. Wir lassen keinen von uns im Regen stehen, also will Holger, dass ich hallo sage.~
@731 = ~Nun, ich bin hier, weil wir Eure Probleme bemerkt haben. Wir lassen doch keinen von uns im Regen stehen, oder? Ich bin ein Schmuggler, zu Euren Diensten, und Holger will, dass ich hallo sage.~
@732 = ~Oh, wartet einen Moment. Ich glaube, ich kenne Euch von unserem Mitarbeiter Holger. Klingelt da was? Er hat Euch in den Himmel gelobt für Eure große Hilfe bei der Wiedereinführung des Schmuggelgeschäfts in Baldurs Tor. Nun, in diesem Fall bin ich sogar noch mehr geneigt, Euch ein gutes Angebot zu machen.~
@733 = ~Wie läuft die Ermittlung wegen des Schmuggels in der Taverne „Helm und Umhang“?~
@734 = ~Wir werden sie bald zur Strecke bringen. Kommt später wieder, um Eure Belohnung zu holen.~
