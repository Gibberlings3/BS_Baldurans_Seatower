// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Willkommen im Gasthaus des Seeturm. Es gibt Essen und Zimmer für diejenigen, die es sich leisten können. Ich bin der Gastwirt, Roryn mein Name.~
@1 = ~Es tut mir sehr leid für den Ärger und all die kleinen Kaninchen da oben.~
@2 = ~Wie kann ich Euch helfen?~
@3 = ~Zeigt mir, was Ihr habt.~
@4 = ~Ihr seid ein Zwerg! Ich hatte gerade ein … Gespräch mit der Köchin darüber, was sie von Zwergen hält …~ ~Ihr seid eine Zwergin! Ich hatte gerade ein … Gespräch mit der Köchin darüber, was sie von Zwergen hält …~
@5 = ~Wegen der Kaninchen …~
@6 = ~Ich werde nun doch nicht nach Euren Ratten suchen.~
@7 = ~Ich habe einen Verdacht, was die Ratten im ersten Stock angeht. Gibt es ein Kind, das sich derzeit hier aufhält?~
@8 = ~Eure Tochter Azala – hat sie zufälligerweise ein Haustier?~
@9 = ~Ich habe eine Ratte im ersten Stock gefunden …~
@10 = ~Wie geht es Azala?~
@11 = ~Nichts, guten Tag.~
@12 = ~Na ja, sie ist eine gute Seele, wisst Ihr? Wir verstehen uns sehr gut, solange ich nicht in die Küche gehe.~
@13 = ~Aber warum musstet Ihr ein Kaninchen auf dem schönen Boden töten? Ach, ich muss die Stelle sofort aufwischen, sonst gibt es einen Fleck. Diesmal berechne ich Euch nichts, aber bitte verschmutzt nichts mehr im Turm!~
@14 = ~Ich werde Barney schicken, damit er sich sofort darum kümmert, und dann erinnert uns nichts mehr an diesen Vorfall. Nun, vielleicht nachdem er auch die Böden gewischt hat.~
@15 = ~Was war mit diesem Magier los? Er sah ziemlich verzweifelt aus.~
@16 = ~Ich hoffe sehr, dass eine solche Tierplage in den Räumen nicht mehr vorkommt!~
@17 = ~Tut das, guter Mann.~
@18 = ~Guten Tag und einen angenehmen Aufenthalt im Seeturm-Gasthaus!~
@19 = ~Och, ich auch, das könnt Ihr mir glauben!~
@20 = ~Wie wäre es, wenn ich Euch beim Einsammeln der Kaninchen helfe?~
@21 = ~Nun, ich überlasse Euch das Sammeln dieser Kaninchen.~
@22 = ~Ach, das ist Meister Klaus. Kam vor ein paar Monaten hierher und saß irgendwie in der Falle, als die Brücken hochgezogen wurden. Machte immer einen sehr ängstlichen Eindruck, wenn Ihr mich fragt. Redet dauernd von einem „Ulf“ und dass er ihn retten muss.~
@23 = ~Ulf? Ist das ein Freund von ihm?~
@24 = ~Warum Kaninchen?~
@25 = ~Ich glaube schon, ja, aber mehr hat er nie erzählt. Er hat nicht immer klar gedacht, wenn Ihr versteht, was ich meine.~
@26 = ~Ich bin mir ziemlich sicher, dass er versucht hat, etwas anderes zu beschwören, aber er konnte sich nicht genug konzentrieren. Aber solange es nur ein oder zwei Hasen waren, gab es keinen wirklichen Grund, ihn vorher aus dem Gasthaus zu werfen.~
@27 = ~Och! Das wäre eine große Hilfe. Barney ist immer noch draußen beschäftigt. Hier ist ein Käfig, in dem Ihr sie einsperr’n könnt. Ich geb Euch 50 Gold für jeden dieser kleinen Hüpfer, ja?~
@28 = ~Was ist damit?~
@29 = ~Ich bin mit dem Einsammeln fertig, glaube ich.~
@30 = ~Ich werde keine Kaninchen mehr sammeln. Hier ist Euer Käfig zurück.~
@31 = ~Ich werde sie doch nicht sammeln.~
@32 = ~Was glaubt Ihr, wie viele es sind?~
@33 = ~Ich werde sie wieder einsammeln.~
@34 = ~Macht das. Barney freut sich schon darauf, die Exkremente einzusammeln.~
@35 = ~Aha, ich verstehe. Nun, trotzdem danke.~
@36 = ~Also, wie viele habt Ihr?~
@37 = ~Ich sehe nur das eine. Das sind dann 50 Gold!~
@38 = ~Ich sehe nur die beiden. Das sind dann 100 Gold!~
@39 = ~Eins, zwei …~
@40 = ~… drei. Das macht dann 150 Gold.~
@41 = ~… vier. Das macht dann 200 Gold.~
@42 = ~… fünf. Das macht dann 250 Gold.~
@43 = ~… sechs. Das macht dann 300 Gold.~
@44 = ~… sieben. Das macht dann 350 Gold.~
@45 = ~… acht. Das macht dann 400 Gold.~
@46 = ~… neun. Das macht dann 450 Gold.~
@47 = ~… zehn. Das macht dann 500 Gold.~
@48 = ~… elf. Das macht dann 550 Gold.~
@49 = ~Hier ist Euer Gold, dank Euch für Eure Bemühungen!~
@50 = ~Oooh, wie süß! Darf ich das mal streicheln?~
@51 = ~Oder? Sie sind WIRKLICH süß!~
@52 = ~(Ich habs dir gesagt, <CHARNAME>!)~
@53 = ~Nun, das sind sie, aber …~
@54 = ~Lass, nicht jetzt … Ich muss sie aus dem Gasthaus schaffen, und zwar schnell.~
@55 = ~Nun, ich würde sagen, es gibt mindestens zehn davon.~
@56 = ~Grüßt Euch.~
@57 = ~Das ist meine kleine Azala.~
@58 = ~Sie ist meine Tochter. Meine beiden anderen sind krank und meine Frau Dorna hat alle Hände voll zu tun, sie zu pflegen, also habe ich sie mit zur Arbeit genommen. Ich hoffe, sie hat nichts angestellt. Sie ist normalerweise ruhig und macht keine Probleme.~
@59 = ~(Das Kaninchen ist leicht zu fangen. Ihr könntet es mitnehmen, aber was wollt Ihr mit einem zappelnden Kaninchen in Eurem Rucksack machen?)~
@60 = ~(Das Kaninchen ist leicht zu fangen.)~
@61 = ~(Das Kaninchen einsammeln.)~
@62 = ~(Das Kaninchen laufen lassen.)~
@63 = ~(Das Kaninchen hoppelt davon.)~
@64 = ~(Das Kaninchen in den Käfig legen.)~
@65 = ~Oooh, sie sind SO süß! Seht Euch diese flauschigen, warmen, kleinen Nasen an! Ich meine … Würde es überhaupt jemandem auffallen, wenn eins von ihnen verschwände? Hmmm?~
@66 = ~Der Welpenblick funktioniert bei mir nicht. Die Kaninchen bleiben, Imoen.~
@67 = ~Du willst dich auf unserer Reise um ein normales Kaninchen kümmern?~
@68 = ~Klar, ich denke, das wäre ein gutes Abendessen.~
@69 = ~Aber …~
@70 = ~Kaninchen sind gesellige Tiere, Imoen. Eines von den anderen zu trennen, ist grausam.~
@71 = ~Wie, Imoen? Wie würdet Ihr es aufbewahren? Es in Euren Rucksack stopfen? Es an eine Leine legen, sodass es sich selbst verletzt? Ich werde nicht zusehen, wie eine Kreatur gequält wird!~
@72 = ~Minsk hat einen Hamster!~
@73 = ~… Und ihn verloren, zumindest für jetzt. Ahem.~
@74 = ~Boo ist kein normaler Hamster. Er ist ein Miniatur-Riesenweltraumhamster, stimmts, Boo?~
@75 = ~Ich bin ganz der Meinung von Imoen. Lasst uns drei oder vier fangen, das wird ein großes Fest heute Abend! (Sorgt nur dafür, dass ich eins für mich allein erwische! Es sind genügend da.)~
@76 = ~Ooooh, Ihr seid wirklich ein Spielverderber. Schöööön.~
@77 = ~Eine Ratte! Ich habe oben eine Ratte gesehen!~
@78 = ~Meine Dame, es tut uns sehr leid für die Unannehmlichkeiten. Sicherlich habt Ihr eines der Kaninchen gesehen, die im Haus freigelassen wurden, aber die Situation …~
@79 = ~VERZEIHUNG? Denkt Ihr, ich kann eine Ratte nicht von einem KANINCHEN unterscheiden? Ich sage Euch, ich habe eine RATTE im ersten Stock dieses Etablissements gesehen.~
@80 = ~Der erste Stock? Hm, vielen Dank, werte Dame. Heute Morgen gab es keine Ratten im Keller, aber wenn ein Gast eine Sichtung meldet, muss ich Barney sofort hochschicken.~
@81 = ~Das erinnert mich an alte Zeiten … Ich könnte diese Ratten für Euch töten.~
@82 = ~Nun, ich werde damit nichts zu tun haben. Viel Glück Euch.~
@83 = ~Ich verstehe Euch gut. He-ho, Barney, schnappt Euch Keule und die Ersatzfallen, und kämpft gegen diese Biester!~
@84 = ~Azala, Mama hat eine Nachricht für dich geschickt. Du siehst gar nicht gut aus, geh nach Hause.~
@85 = ~Ich bin sicher, dass es ein Kaninchen ist. Ihr müsst ein KANINCHEN suchen, und … und es mir bringen!~
@86 = ~Vielleicht, Mädel, aber wenn es wirklich Ratten sind und nicht eines dieser Hoppelhäschen, die die Treppenhäuser gefunden haben, muss das schnell erledigt werden. Ich sag Euch was, Barney ist oben immer noch damit beschäftigt, den Boden von den Kaninchenausscheidungen zu säubern. Wenn Ihr hinaufgeht und nachschaut, gebe ich Euch 50 Gold für jede Ratte, die Ihr findet, bevor Barney es tut. Wenn es ein Kaninchen ist, lasst es einfach hoppeln, Barney wird sich später darum kümmern. Ratten sind viel wichtiger. Und, bitte, seid so diskret wie möglich …~
@87 = ~Nein, Azala, nicht du. Bleib bei Papa, bitte.~
@88 = ~Ha, ja, ich glaube, ich erinnere mich an die Rattenplage des alten Reevor. Er hat so laut über deine „schlechte“ Leistung geschimpft, dass halb Kerzenburg es hören konnte.~
@89 = ~Manche Dinge müssen einfach g-getan werden.~
@90 = ~Ratten gehören nicht in ein Haus, denn sie gefährden die Gesundheit der Bewohner. Wir tun Gutes, wenn wir sie vertreiben.~
@91 = ~Jammern über Ratten, dass sie nicht in Häuser gehören … Wir sollten die Küste vom ganzen Turm säubern und sie der Natur zurückgeben!~
@92 = ~Auch der kleinste Auftrag ist ehrenvoll.~
@93 = ~Ja, ich denke, man kann es als eine ehrenvolle Aufgabe betrachten.~
@94 = ~Ich glaube allerdings, dass wir unsere Zeit besser anderswo verbringen sollten.~
@95 = ~ICH werde keine RATTE anfassen!~
@96 = ~Minsc ist sich da nicht so sicher. Sie sind kleine, pelzige Tiere, genau wie Boo …~
@97 = ~(quiek)~ [GAM_48]
@98 = ~Oh, Boo hat recht. Boo ist nicht die Nummer zwei im Suppentopf von <CHARNAME>. Und er hat keinen Schwanz!~
@99 = ~Das MUSS ein Scherz sein.~
@100 = ~Ah, ja, Ratten. Sie sind immer ein Ärgernis, sowohl in einem Laden als auch in einem Gasthaus.~
@101 = ~Unsere Kraft an Ungeziefer verschwenden? Warum säubern wir nicht das ganze Gasthaus, angefangen mit dieser Halle?!~
@102 = ~(Die Ratte sieht … glänzend aus, als wäre sie gewaschen und gekämmt worden. Außerdem ist sie ungewöhnlich dick. Als Ihr genauer hinseht, entdeckt Ihr eine winzige rosa Schleife an ihrem Schwanz.)~
@103 = ~(Die Ratte ist ziemlich langsam. Ihr könntet sie packen und mitnehmen.)~
@104 = ~(Die Ratte greifen.)~
@105 = ~(Die Ratte ziehen lassen.)~
@106 = ~(Die Ratte töten.)~
@107 = ~(Mit einem leisen Quieken wendet sich die Ratte ab.)~
@108 = ~(Ihr steckt die Ratte in eine Eurer Taschen.)~
@109 = ~Oh, sieh dir diese kleinen Schnurrhaare an! Und die Schleife! Sie ist so süß!~
@110 = ~Oh, ich glaube, diese Ratte g-gehört einem Kind – wenn ich mir die Schleife an ihrem Schwanz ansehe.~
@111 = ~Eine HAUSTIER-Ratte. Das ist eine Abscheulichkeit. Die arme Kreatur hat schon lange keine Natur mehr gesehen.~
@112 = ~Mir gefällt die Idee einer kleinen, pelzigen Hausratte. Allerdings scheint diese Ratte jemand anderem zu gehören.~
@113 = ~WER würde eine RATTE als Haustier nehmen?! Igitt-igitt!~
@114 = ~Hier gibt es alle möglichen Damen mit ihren Sprösslingen, wer weiß, womit sich diese verwöhnten Gören die Zeit vertreiben wollen.~
@115 = ~Oh, Ihr wollt das Kindermädchen verärgern? Hm… Aber eine RATTE? Igitt-igitt!~
@116 = ~Wie wärs, wenn Minsk sie nimmt und ich Boo bekomme?~
@117 = ~Es muss ein kalter Tag in der Hölle sein, an dem ich Boo hergebe!~
@118 = ~<CHARNAME> muss sich um den quiekenden Begleiter kümmern, wem auch immer er jetzt gehört.~
@119 = ~Seid Ihr sicher, dass Ihr genug Getreide dabeihabt? Diese kleinen Kerle fressen gerne.~
@120 = ~Garrick, dieses Tier sieht nicht wirklich ausgehungert aus. Ich bin sicher, dass es eine Weile ohne etwas zu essen auskommt. Zumindest so lange, wie <CHARNAME> braucht, um es zu seinem … „Besitzer“ zurückzubringen.~
@121 = ~Wir sollten schnell denjenigen finden, der diese Kreatur für sich beansprucht. Es wurde schon genug Zeit verschwendet.~
@122 = ~Wie wäre es, wenn wir es rösten und dem „Besitzer“ in den Hals stecken? Was für eine Zeitverschwendung …~
@123 = ~Wie wäre es, wenn wir sie braten und die guten Teile selbst essen, bevor wir sie dem „Besitzer“ zurückgeben? Kein Grund, das Vieh zu vergeuden.~
@124 = ~Eine Hausratte in einem Gasthaus … Das hat das Potenzial, wirklich unterhaltsam zu werden. Zumindest wenn ich ein Wörtchen mitzureden habe.~
@125 = ~Rosa Schleife? Gekämmtes Fell? Ich wette alles Gold von <CHARNAME>, dass sie einem Mädchen gehört.~
@126 = ~(Ihr tötet die Ratte mit einem Hieb Eurer Waffe und nehmt den Kadaver mit.)~
@127 = ~Oh, sieh dir die Schleife an! Sieht aus wie das, was ich immer mit meiner Puppe gemacht habe. <CHARNAME>, ich glaube, du hast gerade jemanden sehr traurig gemacht.~
@128 = ~Ich glaube, diese Ratte g-gehörte einem Kind – wenn ich mir die Schleife an ihrem Schwanz ansehe.~
@129 = ~Eine HAUSTIER-Ratte. Das war eine Abscheulichkeit. Möge die arme Seele in Frieden ruhen.~
@130 = ~Oh? Nun, es gibt einige Kinder in der Haupthalle, aber keines von ihnen wohnt derzeit in den Zimmern, also … Oh, und dann ist da noch meine kleine Azala, zumindest heute.~
@131 = ~Das werden wir ja sehen. Ich bringe Euch jede Ratte, die ich finden kann.~
@132 = ~Nein, aber witzig, dass Ihr fragt – sie verlangt schon seit Wochen nach einem.~
@133 = ~Und ich freue mich darauf. Nun, nicht wirklich, aber Ihr wisst, was ich meine.~
@134 = ~Gut! Nur die eine? Oh … sie hat eine rosa Schleife am Schwanz?!~
@135 = ~(kreisch) Was?!~
@136 = ~Was ist los, Azala?~
@137 = ~Ist sie … ist sie wirklich tot?~
@138 = ~Wovon redest du, Mädchen?~
@139 = ~(schluchz) Die Ratte war meine Betsy. (schluchz) Ich habe sie letzten Freitag auf der Straße gefunden und ich habe sie aufgepäppelt und ich wollte sie nicht allein zu Hause lassen, also habe ich sie mitgenommen und ich habe sie laufen lassen, aber nur, wenn sie nicht hungrig war, und ich habe die Kacke weggenommen und es tut mir leid, dass die Dame sie gesehen hat, und ich hätte sie nicht laufen lassen sollen, aber sie ist mir entkommen und ich hatte gehofft, dass sie niemand sehen würde, und dann hast du mir gesagt, ich soll in der Nähe bleiben und ich könnte nicht nach ihr suchen und dann wurde ich von all den Kaninchen abgelenkt und … (Luft hol)~
@140 = ~Du hast eine RATTE in die Gästezimmer gebracht? In mein Gasthaus? Azala, hast du eine Ahnung, was du getan hast?~
@141 = ~Betsy ist tot, ich gebe es zu. Azala, das tut mir sehr leid.~
@142 = ~Hier ist deine Ratte. Kann mir jemand diesen Kadaver abnehmen?~
@143 = ~Sie ist nicht tot, Azala.~
@144 = ~Ruhig, Azala. Ich habe sie hier, siehst du?~
@145 = ~Echt jetzt? Nachdem ich oben gerade durch mehr als zehn Kaninchen gelaufen bin, will ein Kind unbedingt ein Haustier haben und weiß nicht, was es sonst tun soll, als eine RATTE zu zähmen?~
@146 = ~Wie auch immer, kann jemand dieses Kind zum Schweigen bringen?~
@147 = ~Och. Die ganze Sache tut mir leid!~
@148 = ~(wimmer)~
@149 = ~Betsy! Sie ist noch am Leben! Ich hatte solche Angst, Ihr hättet sie getötet! Ich danke Euch! Ich danke Euch!~
@150 = ~Azala, Mama hat eine Nachricht für dich geschickt. Geh nach Hause! Nimm die Ratte mit, und wir reden später darüber.~
@151 = ~Nun, das war sicher nicht das, was ich erwartet hatte, aber Ihr habt eine Ratte besiegt. Hier sind Eure 50 Gold.~
@152 = ~Vielen Dank für Eure Hilfe, auch wenn keiner von uns erwartet hat, dass die Dinge so laufen würden. Bitte genießt Euren Aufenthalt im Seeturm-Gasthaus. Und wenn Ihr wieder ein Nagetier durch die Gästezimmer jagen müsst, bekommt Ihr eine Runde aufs Haus, das schwöre ich Euch!~
@153 = ~Danke der Nachfrage. Macht Euch darüber keine Sorgen. Sie wird ein Kaninchen als Haustier haben. Nein, kein weißes, von denen habe ich schon zu viele gesehen. Die Ratte hat uns sowieso nicht gefallen. Es gibt Grenzen des guten Geschmacks, wie Ihr ja wisst. Es tat mir leid für sie, dass sie sie so sehr mochte, aber es ist besser so.~
