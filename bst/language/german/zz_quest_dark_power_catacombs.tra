// creator: Shai Hulud
// game: Balduran's Seatower
// date: 2026-03-30, 21:16
// Caution: This file is in UTF-8 format because it uses several special characters of non-english languages

@0 = ~Oh, ich hoffe wirklich, dass alles gutgehen wird!~
@1 = ~Meine armen Brüder …~
@2 = ~Es tut mir leid, Gerrit, aber sowohl Muck als auch Fuller sind tot.~
@3 = ~Wir haben mit Fuller gesprochen, und er hat uns von dem Ritual erzählt. Ihr hättet ETWAS ausführlicher darüber berichten können, was Ihr und Eure Brüder da drinnen versucht habt. Der Abt hatte auch keine Ahnung.~
@4 = ~Wir haben zugestimmt, einen Blick in die Katakomben zu werfen. Der Abt erwähnte, dass Ihr der Einzige seid, der es hinausgeschafft hat. Was genau ist passiert?~
@5 = ~Das hört sich nicht gut an. Was ist mit deinen Brüdern passiert?~
@6 = ~Ich überlasse Euch Euren Gebeten.~
@7 = ~Wir … standen einem großen Übel gegenüber und konnten es nicht bändigen. Oh, meine armen Brüder, wenn ich nur wüsste, was mit ihnen geschehen ist!~
@8 = ~Kann ich irgendwie helfen?~
@9 = ~Geht mit Ilmaters Segen.~
@10 = ~Ilmater segne Euch dafür, dass Ihr das überhaupt vorschlagt, mein Freund. Wir hatten schon früher Abenteurer, die uns bei der Räumung der Katakomben geholfen haben, aber dieses Mal sollte nur jemand mit großer Kampfkraft auf die Suche unserer Brüder gehen … Sprecht mit dem Abt, er ist derjenige, der das entscheidet.~ ~Ilmater segne Euch dafür, dass Ihr das überhaupt vorschlagt, meine Freundin. Wir hatten schon früher Abenteurer, die uns bei der Räumung der Katakomben geholfen haben, aber dieses Mal sollte nur jemand mit großer Kampfkraft auf die Suche unserer Brüder gehen … Sprecht mit dem Abt, er ist derjenige, der das entscheidet.~
@11 = ~Wir … wir gingen in das Allerheiligste, um unsere Beschwörungen zu verrichten und einen Segen zu singen, um die ruhelosen Geister zu besänftigen, die normalerweise in den Katakomben umherwandern, als etwas schrecklich schief ging und sich ein großes Übel manifestierte … Wir wurden von Skeletten überschwemmt. Wir versuchten, sie zu bekämpfen, bis wir merkten, dass wir gegen die Masse keine Chance hatten. Also versuchten wir zu fliehen. Erst draußen merkte ich, dass meine beiden Brüder es nicht rausgeschafft hatten …~
@12 = ~Muck hatte den Schlüssel zum inneren Heiligtum bei sich, und er und Fuller sind immer noch drinnen, ihr Schicksal ist uns unbekannt … (stöhn)~
@13 = ~Der arme Muck hatte den Schlüssel zum inneren Heiligtum bei sich … Fuller ist noch drin, sein Schicksal ist uns unbekannt … (stöhn)~
@14 = ~Und Ihr wisst wirklich nicht, welches Böse sich manifestiert hat oder woher es kommt?~
@15 = ~Ich weiß genug.~
@16 = ~Nein, aber ich war derjenige, der gehört hat, was es sagte. Es … es nannte sich selbst den Beschützer der ruhelosen Toten, sogar ihren „König“, der sie befehligt … Abgesehen davon weiß ich es wirklich nicht.~
@17 = ~Danke, dass Ihr reingeschaut habt. Ich danke Euch vielmals. Ilmater soll Euch segnen, und bitte findet Muck und Fuller …~
@18 = ~Es … es tut mir SO leid! Ich hatte solche Angst … Es gibt keine Entschuldigung dafür, dass wir Euch nicht früher gesagt haben, was wir getan haben, aber ich habe nicht gelogen, als ich sagte, dass ich nicht WUSSTE, was genau passiert ist. Wir dachten, wir würden einen Schutzsegen singen.~
@19 = ~Danke, dass Ihr Fuller gerettet und den armen Muck gefunden habt.~
@20 = ~Danke, dass Ihr … Ihr den armen Fuller und Muck gefunden habt.~
@21 = ~Ihr … Ihr habt das große Böse gebannt, das wir so leichtsinnig erweckt haben.~
@22 = ~Oh nein … meine armen Brüder. Danke, dass Ihr … Ihr sie gefunden habt.~
@23 = ~Ilmater sei mit Euch für Eure Hilfe.~
@24 = ~Vielen Dank, dass Ihr Fuller gerettet habt. Und … und für die Hilfe beim Aufräumen unseres Chaos …~
@25 = ~Ich muss bereuen, was ich getan habe …~
@26 = ~Ilmater sei gesegnet! Ich habe versucht, sie zurückzuschlagen und die Schriftrolle zu holen, aber es sind einfach zu viele … Verzeiht, ich sollte ganz von vorne anfangen. Meine Brüder und ich haben eine Schriftrolle mit Myrkuls Symbol drauf in die Hände bekommen. Myrkul ist einer der vergangenen Götter der Toten. Mit all unserem Wissen waren wir in der Lage, die Worte „Untote abwehren“ zu entziffern, und waren davon überzeugt, dass es ein Segen sei, um Schutz vor Untoten zu gewähren, weil wir dachten, es würde den ruhelosen Toten Frieden geben. Stattdessen erweckten wir ein Wesen, das unsere Anwesenheit nun als Eindringen deklariert und Untote beschwört, um die Katakomben zu „verteidigen“. Ich habe alles in meiner Macht Stehende versucht, um es aufzuhalten, aber ich bin zu schwach, um seine Verteidigung zu überwinden. Die einzige Möglichkeit besteht darin, die Schriftrolle der Beschwörung zu holen und es damit zu bannen. Die Schriftrolle liegt immer noch im inneren Heiligtum.~
@27 = ~Ist … ist das Muck, der da drüben auf dem Boden liegt? Oh, mein armer Bruder …~
@28 = ~Ihr konntet Euch dem inneren Heiligtum nähern, ohne weitere Skelette zu erregen!? Was ist passiert?~
@29 = ~Wir hatten ein … Gespräch mit den ruhelosen Toten in den Katakomben.~
@30 = ~Ja, ein Kinderspiel. Das Wesen hat sich mir übrigens selbst gezeigt.~
@31 = ~Wie auch immer. Was nun?~
@32 = ~Ich werde hier am Eingang zu den inneren Katakomben warten und dafür sorgen, dass kein Skelett den Weg ins Mausoleum findet.~
@33 = ~Bitte holt die Schriftrolle zurück, damit wir das große Böse, das sich hier manifestiert hat, bannen können.~
@34 = ~Damit ich das richtig verstehe, Ihr habt eine Schriftrolle benutzt, die Ihr nicht richtig verstanden habt, aber Ihr seid sicher, dass dieselbe Schriftrolle das Problem, das sie verursacht hat, beseitigen wird?~
@35 = ~Hier ist die Schriftrolle. Was nun?~
@36 = ~Ich werde später wiederkommen.~
@37 = ~Oh, wir konnten sie schon LESEN. Wir haben nur nicht VERSTANDEN, was „Myrkuls Schutz“ eigentlich bedeutet. Nämlich dass es die Untoten nicht besänftigt, sondern ein Wesen beschwört, das aktiv Untote benutzt, um die Katakomben vor „Eindringlingen“ zu schützen.~
@38 = ~Sie muss benutzt werden, um den Bann zu wirken. Jeder kann das mit der Schriftrolle tun. Ich werde es tun, wenn Ihr sie mir gebt, ich muss nur meine Brüder um Unterstützung bitten.~
@39 = ~Ihr sagtet, Ihr wurdet von Skeletten überschwemmt, als Ihr versucht habt, Euch dem Allerheiligsten zu nähern – was bei mir nicht der Fall war. Ich habe das Gefühl, dass ich das mal machen sollte.~
@40 = ~Ich behalte sie vorerst bei mir. Ich werde darüber nachdenken.~
@41 = ~Nehmt sie. Ich überlasse es Euch, die Verbannung vorzunehmen.~
@42 = ~Bitte gebt die Schriftrolle Abt Guoremor, wenn nicht mir. Oder Ihr könnt sie selbst benutzen, wenn Ihr wollt.~
@43 = ~Ihr sagtet, Ihr seid von Skeletten überrannt worden, als Ihr versucht habt, Euch dem inneren Heiligtum zu nähern. Ich habe das Gefühl, das sollte ich ebenso versuchen.~
@44 = ~Es überrascht mich nicht, dass es dazu in der Lage ist, wenn man bedenkt, wie es seine Angriffe koordiniert hat. Nur dass es sich vor Euch zu erkennen gegeben hat, nach allem, was ich versucht habe.~
@45 = ~Nehmts nicht persönlich. Ich denke, es ist nur ein Zufall.~
@46 = ~Vielleicht mag es nicht, dass es hierher gezogen wurde. Es war irgendwie verärgert darüber, gestört zu werden.~
@47 = ~Nun, ich weiß warum, aber das ist jetzt nicht wichtig.~
@48 = ~Ihr habt recht. Wir müssen uns auf das konzentrieren, was jetzt wichtig ist.~
@49 = ~Ich wäre Euch sehr dankbar, wenn Ihr das tun würdet.~
@50 = ~Ich werde das untote Wesen jetzt verbannen. Ihr geht in Deckung, Ihr habt genug getan.~
@51 = ~Ich werde es tun. Bleibt hier! Ich bin sicher, es wird böse Überraschungen geben, und ich könnte die Hilfe gebrauchen.~
@52 = ~Ich bin wirklich dankbar, dass der Abt Euch geschickt hat.~
@53 = ~Vielen Dank für alles, was Ihr getan habt. Ich werde jetzt zum Abt gehen, um zu gestehen, was wir getan haben. Ich werde auch den armen Muck mitnehmen. Eure Arbeit hier ist getan, hilfreicher Abenteurer. Bitte stört die restlichen Gräber nicht. Ich denke, wir hatten genug ruhelose Untote für den Tag.~ ~Vielen Dank für alles, was Ihr getan habt. Ich werde jetzt zum Abt gehen, um zu gestehen, was wir getan haben. Ich werde auch den armen Muck mitnehmen. Eure Arbeit hier ist getan, hilfreiche Abenteurerin. Bitte stört die restlichen Gräber nicht. Ich denke, wir hatten genug ruhelose Untote für den Tag.~
@54 = ~Ich danke Euch. Ich danke Euch so sehr. Ich werde jetzt zum Abt gehen, um zu gestehen, was wir getan haben. Ich werde auch den armen Muck mitnehmen. Bitte kommt ins Kloster, wenn Ihr hier fertig seid.~
@55 = ~Also gut. Ich werde hier sein und Euch den Rücken freihalten.~
@56 = ~Ihr habt es geschafft! Ich konnte spüren, wie der Stromstoß durch die Katakomben ging. Na ja, und die vielen erschienenen Skelette waren auch ein deutliches Zeichen. Ich entschuldige mich für meinen schlechten Humor.~
@57 = ~Ist das so? Was genau habt Ihr gefunden?~
@58 = ~Ein Skelett, das von sich behauptete, der Herrscher der Toten zu sein, erschien im inneren Heiligtum und sagte seltsame Dinge über meinen Vater.~
@59 = ~Es gab ein sprechendes Skelett im inneren Heiligtum. Es kann jedoch nicht direkt bekämpft werden, sondern schickt nur seine Untergebenen.~
@60 = ~Vielen Dank für Eure Hilfe.~
@61 = ~Ihr schaut Euch die Symbole auf der Seite der Schriftrolle an. Die Symbole ordnen sich zu etwas an, das Ihr lesen könnt.~ [bsblank]
@62 = ~Ihr konzentriert Euch auf die Magie der Schriftrolle, um den Zauber umzukehren, der den Beschützer der ruhelosen Toten herbeirief.~
@63 = ~Ihr lasst die Schriftrolle liegen.~
@64 = ~Ihr sprecht den Bannzauber. Dabei zerbröselt die Schriftrolle in Euren Händen zu Staub.~
@65 = ~Ihr schaut Euch die Symbole auf der Seite der Schriftrolle an. Die Symbole fangen an, sich zu bewegen, aber sie halten nicht an und sie bilden nichts, was Ihr lesen könntet. Es scheint, dass Ihr zu weit von den beschworenen Untoten entfernt seid, die Ihr bannen wollt.~ [bsblank]
@66 = ~Und wen haben wir hier?~
@67 = ~Ihr habt meine Mutter gehört.~
@68 = ~Ich … ich kann nicht glauben, dass Vater tot ist! Woher wird das benötigte Gold jetzt kommen?~
@69 = ~Hallo Ihr! Seid Ihr auf dem Weg ins Mausoleum?~
@70 = ~Mutter, sieh sie dir an. Das sind keine Mönche aus dem Kloster, und sie besitzen auch sicherlich keine Familiengruft im Seeturm!~
@71 = ~Mutter, sieh sie dir an. Sie mögen zwar Mönche sein, aber ich habe sie noch nie im Kloster gesehen, und sie besitzen auch sicherlich keine Familiengruft im Seeturm!~
@72 = ~Du hast recht, mein Sohn. Mein Fehler.~
@73 = ~In der Tat, das bin ich. Ich habe den Schlüssel vom Abt bekommen und werde einen Blick in die Katakomben werfen.~
@74 = ~Ins was?~
@75 = ~Dies ist also der Eingang zu einem Mausoleum?~
@76 = ~Achtet auf Ihren Tonfall!~
@77 = ~Ich muss jetzt weiter.~
@78 = ~Oh, keine Sorge, <SIRMAAM>.~
@79 = ~Einen guten Tag Euch.~
@80 = ~Ich bin jetzt auf dem Weg in das Mausoleum. Ich habe den Schlüssel vom Abt bekommen und werde einen Blick in die Katakomben werfen.~
@81 = ~Ist das so? In diesem Fall, <SIRMAAM>, haltet bitte Ausschau nach meinem Mann, Fürst Dlusker. Er ist hineingegangen, um unserem Familiengrab die letzte Ehre zu erweisen, aber es dauert schon furchtbar lange, und ich fürchte, ihm ist etwas passiert.~
@82 = ~Wie ist Euer Mann dort hineingekommen? Der Abt sagte, es sei für die Öffentlichkeit gesperrt.~
@83 = ~Es scheint, als hätte sich Euer Mann in Schwierigkeiten gebracht. Ich werde nach ihm Ausschau halten.~
@84 = ~Ich kann nichts versprechen.~
@85 = ~Ich entschuldige mich, falls wir Euch beleidigt haben, <SIRMAAM>.~
@86 = ~Das ist es in der Tat, und es enthält auch unser Familiengrab.~
@87 = ~Nun ja, wir sind nicht „die Öffentlichkeit“, wir besitzen eines der Gräber, Ihr Schwachköpfe.~
@88 = ~Hester, bitte! Verzeiht uns, <SIRMAAM>, wir sind beide ziemlich besorgt über Fürst Dluskers Verbleib. Der Abt hat uns zwar auf Probleme in den Katakomben aufmerksam gemacht, aber mein Mann hat nur das Mausoleum betreten.~
@89 = ~Ihr würdet uns einen großen Gefallen tun, <SIRMAAM>.~
@90 = ~Hester, bitte!~
@91 = ~Wir hörten schreckliche Geräusche aus dem Inneren des Mausoleums, <SIRMAAM>. Seid Ihr zufällig meinem Mann, Fürst Dlusker, begegnet und könnt uns sagen, wo er sich aufhält?~
@92 = ~Ich habe ihn tatsächlich gefunden. Ich fürchte, er ist tot.~
@93 = ~Wir sprechen uns später.~
@94 = ~Mein Mann ist t… tot?~
@95 = ~Seht Ihr? Euer Mann wollte einen Vorfahren anrufen, aber der Zauber ging irgendwie nach hinten los und verwandelte ihn in einen Zombie. Wir mussten ihn töten.~
@96 = ~Er und Euer Vorfahre, den er mit einem Zauberspruch wiederbeleben wollte. Nun, der Vorfahre war bereits tot, denke ich, aber jetzt ist auch seine Geistererscheinung, die Euer Mann beschworen hat, tot.~
@97 = ~Er … er hat einen Zauber auf unser Familiengrab gelegt? Oh nein, der Narr, warum sollte er das tun?~
@98 = ~Was … was ist das? Hester, wusstest du davon?~
@99 = ~Nun … Vater hoffte, wir würden etwas über den Schatz erfahren, den unser Vorfahre in seinem Tagebuch angedeutet hatte, wenn wir nur die Chance hätten, mit ihm zu sprechen …~
@100 = ~Es scheint, dass der einzige Schatz, den Ihr von Euren Vorfahren bekommt, das ist, was er mit in sein Grab genommen hat.~
@101 = ~Nun, in diesem Grab wartete eine böse Überraschung, kann ich Euch sagen.~
@102 = ~Nun, den Geräuschen nach zu urteilen, die aus der Gruft kommen, ist IRGENDETWAS dort drinnen bereit herumzuwandern, denke ich.~
@103 = ~Das hört sich aber nicht gut an! Habt Ihr das Grab unserer Familie geplündert?!~
@104 = ~Natürlich nicht!~
@105 = ~Nun, vielleicht hätte ich das tun sollen, wenn man Euer unverschämtes Verhalten bedenkt.~
@106 = ~(Lüge) Natürlich nicht!~
@107 = ~Ich habe eine Halskette herausgenommen, aber sie gehört natürlich Euch.~
@108 = ~Ich habe eine Halskette herausgenommen, aber jetzt ist sie weg. Das tut mir leid.~
@109 = ~Nun, ich bin froh, dass ich das getan habe, wenn man Euer unverschämtes Verhalten bedenkt.~
@110 = ~Junger Mann, Ihr müsst auf Euren Tonfall achten – und zwar sofort.~
@111 = ~Bitte, <SIRMAAM>, würdet Ihr in die Gruft unserer Familie schauen und sicherstellen, dass alles in Ordnung ist?~
@112 = ~Wir sind so dankbar für Eure Hilfe. Bitte, ich flehe Euch an, uns zu geben, was immer Ihr im Grab unserer Vorfahren gefunden haben. Wir brauchen dringend finanzielle Unterstützung, und da mein Mann tot ist, muss ich … ich … (stöhn)~
@113 = ~Ich sehe das Tagebuch meines Mannes bei Euch – ich werde es Euch direkt aus den Händen nehmen, und bitte verzeiht mir, dass ich so dreist bin.~
@114 = ~Wenn mein Mann etwas Magisches bei sich hatte, könnt Ihr es gerne behalten, als eine Art Belohnung. Da mein Mann tot ist, habe ich keine Verwendung dafür. Wir können es nicht verkaufen, ohne dass jeder von unserer misslichen Lage erfährt. Und ich möchte wirklich nichts besitzen, was zu diesem Desaster geführt hat.~
@115 = ~Ja, natürlich. Ich habe den Inhalt der Gruft nicht angerührt, es ist alles noch da.~
@116 = ~Ja, natürlich. Hier ist die Familienhalskette aus der Gruft.~
@117 = ~Ich werde bald mit allem, was ich finden konnte, zurückkommen.~
@118 = ~Gute Frau, ich habe in Eurem Namen gegen einen Zombie UND ein Gespenst gekämpft. Ich denke, eine kleine Entschädigung ist mehr als gerechtfertigt. Ich behalte jeden Schatz, der da war.~
@119 = ~Ich danke Euch. Ich danke Euch SO sehr. Ich hoffe, dass das, was auch immer mein Mann bei sich hatte, genug sein wird, um Euch für Eure Bemühungen zu entschädigen – und um Euer Schweigen über das, was hier passiert ist, zu erkaufen.~
@120 = ~Oh nein … Ich … ich verstehe Euren Standpunkt, aber das ist sehr bedauerlich. Trotzdem vielen Dank, <SIRMAAM>. Ihr hattet genug Entschädigung für Eure Bemühungen, würde ich wetten. Oh, was ist aus dieser Welt geworden?~
@121 = ~Komm, Hester. Lass uns dieses Kapitel so schnell wie möglich abschließen.~
@122 = ~Das Bett ist frisch gemacht und einsatzbereit.~
@123 = ~Ihr klappt das Bett herunter und legt Euch hin, um eine ganze Nacht zu schlafen (8 Stunden).~
@124 = ~Ihr verbringt die Zeit bis Mitternacht.~
@125 = ~Ihr verbringt die Zeit bis zur 23. Stunde.~
@126 = ~Ihr verbringt die Zeit bis zur Mittagszeit.~
@127 = ~Ihr verbringt die Zeit bis zur 11. Stunde.~
@128 = ~Ihr verbringt die Zeit bis zur 10. Stunde.~
@129 = ~Ihr verbringt die Zeit bis zum Beginn der Morgendämmerung (6. Stunde).~
@130 = ~Ihr verbringt die Zeit bis zum Ende der Morgendämmerung (7. Stunde).~
@131 = ~Ihr verbringt die Zeit bis zum Beginn der Dämmerung (21. Stunde.).~
@132 = ~Ihr verbringt die Zeit bis zum Ende der Dämmerung (22. Stunde.).~
@133 = ~Ihr lasst das Bett stehen.~
