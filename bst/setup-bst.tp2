  SAY NAME1 @403 /* Moggy's Favor */

COPY ~bst/items/bstqrat2.itm~ ~override/bsdedrat.itm~
  SAY NAME1 @594 /* ~Dead Rat~ */
  SAY NAME2 @594 /* ~Dead Rat~ */
  SAY IDENTIFIED_DESC @595 /* ~This is a dead rat. It looks surprisingly intakt and was placed so you *had* to find it.~ */

COMPILE ~bst/moggythecat/moggythecat.d~

COMPILE ~bst/moggythecat/bsmoggy.baf~
COMPILE ~bst/moggythecat/bsmogbtr.baf~

COPY_EXISTING ~cat.cre~ ~override/bsmoggy.cre~
	SAY NAME1 @178 /* Moggy */
	SAY NAME2 @178 /* Moggy */
	WRITE_ASCII 0x248 ~bsmoggy~ #8
	WRITE_ASCII 0x268 ~WTRUNSGT~ #8
	WRITE_ASCII 0x280 ~bsmoggy~ #32
	WRITE_ASCII 0x2cc ~bsmoggy~ #8

/* give monastery range detection trigger */
COPY_EXISTING ~ys0123.are~ ~override~
  LPF ~fj_are_structure~
    INT_VAR
    fj_type         = 0    //trap
    fj_box_left    = 171  //kleinstes x
    fj_box_top     = 735   //kleinstes y
    fj_box_right   = 264  //gr��tes x 
    fj_box_bottom  = 811 //gr��tes y
    fj_vertex_0    = 197 + (811 << 16) 
    fj_vertex_1    = 264 + (766 << 16)
    fj_vertex_2    = 226 + (735 << 16)
    fj_vertex_3    = 171 + (773 << 16)
    STR_VAR
    fj_structure_type   = region
    fj_trap_detect      = 100
    fj_trap_active      = 1
    fj_trap_status      = 0
    fj_name             = MoggyBedTrigger
    fj_reg_script   	= bsmogbtr
  END
  LPF fj_are_structure
  INT_VAR
    fj_loc_x          = 244
    fj_loc_y          = 799
    fj_type           = 4 //pile
    fj_lock_diff      = 0
    fj_trap_remove_diff = 0    
    fj_flags       = 0b00000000000000000001000000
  STR_VAR
    fj_structure_type = container
    fj_name           = "RatPile"
  END
BUT_ONLY_IF_IT_CHANGES

