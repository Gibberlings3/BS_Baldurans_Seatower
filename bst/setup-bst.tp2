////////////////////////////////////////////////////////////////////
/* High level encounter under the Tailor's Shop, by Acifer */

  INCLUDE ~bst/bst_Highlevel/bst_highlevel.tpa~



////////////////////////////////////////////////////////////////////
/* EET: add areas to BG1 area type */
ACTION_IF (GAME_IS ~eet~) BEGIN
  // reading list of area filenames to array
  COPY ~bst/lib/area_list.txt~ ~bst/lib/area_list.txt~
    READ_2DA_ENTRIES_NOW area_list 1
  BUT_ONLY

  // patching ARE files
  OUTER_SET bg1area = IDS_OF_SYMBOL(~areatype~ ~BG1AREA~)
  OUTER_FOR (row = 0; row < area_list; ++row) BEGIN
    OUTER_SPRINT are_filename $area_list(~%row%~ ~0~)
    COPY_EXISTING ~%are_filename%.are~ ~override~
      WRITE_SHORT 0x48 (THIS | bg1area)
    BUT_ONLY IF_EXISTS
  END
END


