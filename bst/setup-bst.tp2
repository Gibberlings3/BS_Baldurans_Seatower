/* helper cre and script for PC's "bed" in Ilmater Monastery*/

<<<<<<<< .../inlined/bsrsd08.baf
/* script for bed helper cre */
IF
	See([PC])
	Global("bs_TalkToPC","LOCALS",0)
THEN
	RESPONSE #100
		StartDialogNoSet([PC])
END

IF
	OR(2)
		!See([PC])
		Global("bs_TalkToPC","LOCALS",1)
THEN
	RESPONSE #100
		DestroySelf()
END
