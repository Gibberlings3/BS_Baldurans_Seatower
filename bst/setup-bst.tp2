/* Fix Dock District Search Map - this might become an own component later */

/* using Weigo's search map modding tool */

INCLUDE ~%MOD_FOLDER%/lib/alter_searchmap.tpa~
    LAF ALTER_SEARCHMAP
        STR_VAR
        path_to_2da_file = EVAL ~%MOD_FOLDER%/tpa/AR1200SR_changes.2da~ // full path to the *changes.2da file, e.g. ~mymod/bam/AR3700SR_changes_ee.2da~
        areaname = EVAL ~%BaldursGateDocks%~                             // area name, e.g. ~AR3700~
    END
	


//////////////////////////////////////////////////////////////////////////////////
/* Reveal Seatower Map When Entering Area */
//////////////////////////////////////////////////////////////////////////////////

BEGIN @1000026 /* ~Reveal Seatower Map When Entering Area~ */ 
DESIGNATED 10 
LABEL BS_BalduransSeatower-reveal_map
REQUIRE_COMPONENT ~bst.tp2~ ~0~ @1000007

EXTEND_TOP ~bs1000.bcs~ ~bst/area scripts/patch/explor.baf~ EVALUATE_BUFFER



//////////////////////////////////////////////////////////////////////////////////
/* Adapt Palace Fight with Regard to Doppelganger Invasion */
//////////////////////////////////////////////////////////////////////////////////

BEGIN @1000028 /* ~Place More FF soldiers into the Palace if Revealed~ */ 
DESIGNATED 20 
LABEL BS_BalduransSeatower-palace_fight_more_soldiers
	SUBCOMPONENT @1000027 /* ~Adapt Palace Fight with Regard to Doppelganger Invasion~ */
REQUIRE_COMPONENT ~bst.tp2~ ~0~ @1000007

LAF extend_area_script STR_VAR area="%NBaldursGate_DucalPalace_L1%" bottom="bst/area scripts/gamebcs/ar0108_more_ff.baf"   END


BEGIN @1000029 /* ~Reduce Number of Doppelgangers in Palace if Revealed~ */
DESIGNATED 21 
LABEL BS_BalduransSeatower-palace_fight_less_doppelg
	SUBCOMPONENT @1000027 /* ~Adapt Palace Fight with Regard to Doppelganger Invasion~ */
REQUIRE_COMPONENT ~bst.tp2~ ~0~ @1000007

EXTEND_TOP ~noblpa.bcs~ ~bst/cre scripts/patch/ar0108_less_dpl.baf~ EVALUATE_BUFFER

BEGIN @1000030 /* ~Place More Doppelgangers into Palace if Invasion was not Revealed~ */ 
DESIGNATED 22 
LABEL BS_BalduransSeatower-palace_fight_more_doppelg
	SUBCOMPONENT @1000027 /* ~Adapt Palace Fight with Regard to Doppelganger Invasion~ */
REQUIRE_COMPONENT ~bst.tp2~ ~0~ @1000007

LAF extend_area_script STR_VAR area="%NBaldursGate_DucalPalace_L1%" bottom="bst/area scripts/gamebcs/ar0108_more_dpl.baf"   END




/////////////////////////////////////////////////////////////////////////////////
/* correct music entries for BGT - not needed for BGT Muic choice "Hybrid BG1 and BGII Music", this is the default case considered */
/////////////////////////////////////////////////////////////////////////////////

BEGIN @1000009 /* ~Correct music entries for BGT~ */ 
DESIGNATED 30 
LABEL BS_BalduransSeatower-music_bgt
REQUIRE_COMPONENT ~bst.tp2~ ~0~ @1000007
REQUIRE_PREDICATE (GAME_IS ~bgt~) @1000006
REQUIRE_PREDICATE !(MOD_IS_INSTALLED ~bgt.tp2~ (ID_OF_LABEL ~bgt.tp2~ ~A6-BGT-MusicHybrid~)) @1000006
REQUIRE_PREDICATE ((MOD_IS_INSTALLED ~bgt.tp2~ (ID_OF_LABEL ~bgt.tp2~ ~A6-BGT-MusicBG1~)) OR (MOD_IS_INSTALLED ~bgt.tp2~ (ID_OF_LABEL ~bgt.tp2~ ~A6-BGT-MusicFull~))) @1000008

INCLUDE ~%MOD_FOLDER%/lib/get_song_value.tpa~

COPY_EXISTING ~bs1000.are~ ~override~
LPF get_song_value STR_VAR label = ~CDay1~ RET songCDay1 = value END
LPF get_song_value STR_VAR label = ~CNite~ RET songCNite = value END
LPF get_song_value STR_VAR label = ~BC4~ RET songBC4 = value END
READ_LONG 0xBC ofsSong
WRITE_LONG (ofsSong + 0x00) songCDay1
WRITE_LONG (ofsSong + 0x04) songCNite
WRITE_LONG (ofsSong + 0x0c) songBC4




