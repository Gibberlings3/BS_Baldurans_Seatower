ACTION_IF GAME_IS ~eet bgt~ THEN BEGIN 
<<<<<<<< ...inlined/spawn_messenger_in_bg2.baf
/* easter egg messenger for heirloom reward (doppelganger quest) if PC handed in all gold rings in BG1 */
IF
	InMyArea(Player1)
	Global("bsPCTookGoldrings","GLOBAL",4)
	CombatCounter(0)
	GlobalTimerExpired("bs_SpawnRewardHeirloomTimer","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("bsPCTookGoldrings","GLOBAL",5)
		CreateCreatureObjectOffset("bsgenmes",Player1,[5.5])
		Continue()
END
IF
	InMyArea(Player1)
	GlobalGT("MakeStatue","GLOBAL",0) //after becoming hero of Trademeet
	Global("bsPCTookGoldrings","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobalTimer("bs_SpawnRewardHeirloomTimer","GLOBAL",FOUR_DAYS)
		SetGlobal("bsPCTookGoldrings","GLOBAL",4)
		Continue()
END
>>>>>>>>
EXTEND_TOP ~ar2000.bcs~ ~...inlined/spawn_messenger_in_bg2.baf~ EVALUATE_BUFFER //Trademeet
END

