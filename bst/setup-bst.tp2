// Silver Dart of Selune
  COPY ~bst/items/bsdart01.itm~ ~override~
	SAY NAME2 @618
	SAY IDENTIFIED_DESC @619

	// Weapon's enchantment level +4 against lycanthropes and undead
	// and +2 to everything else, but this doesn't quite work in the 
	// old engine which lacks opcode 344, so we just make it a +4 there.
	//
	// This is in line with how similar vanilla items work between
	// BGT and BGEE.  Note that it still has only +2 to hit and damage,
	// the enchantment level only determines what it can hit.

	PATCH_IF NOT enhanced_edition
	BEGIN
	  WRITE_LONG 0x0060 4	// Enchantment level
	  LAUNCH_PATCH_FUNCTION DELETE_EFFECT
	    INT_VAR
	    match_opcode	= 344	// Does not exist in old engine.
	  END
	END

  CREATE EFF ~bsdart01~
 	WRITE_LONG 0x0010 12	// HP: Damage
	WRITE_LONG 0x0014 2	// Target: Preset target
	WRITE_LONG 0x001c 2	// Parameter1: Damage amount
	WRITE_LONG 0x0020 BIT23	// Parameter2: Damage type (missile)
	WRITE_LONG 0x0024 1	// Timing Mode: Instant/Permanent
	WRITE_BYTE 0x002c 100	// Probability: always

// Silver Sphere Ioun Stone
  COPY ~bst/items/bsioun01.itm~ ~override~
	SAY NAME2 @620
	SAY IDENTIFIED_DESC @621

// Longbow of Speed +2
  COPY ~bst/items/bslbow01.itm~ ~override~
	SAY NAME2 @622
	SAY IDENTIFIED_DESC @623

// Paladin's Plate
  COPY ~bst/items/bsplat01.itm~ ~override~
	SAY NAME2 @624
	SAY IDENTIFIED_DESC @625

// Ring of Illusions
  COPY ~bst/items/bsring01.itm~ ~override~
	SAY NAME2 @626
	SAY IDENTIFIED_DESC @627

// Moon Pendant
  COPY ~bst/items/bsamul01.itm~ ~override~
		SAY NAME2 @50000
		SAY IDENTIFIED_DESC @50001

// Silver Flail of Selune
  COPY ~bst/items/bsblun01.itm~ ~override~
	SAY NAME2 @50002
	SAY IDENTIFIED_DESC @50003

	// Weapon's enchantment level +3 against lycanthropes and undead
	// and +1 to everything else, but this doesn't quite work in the 
	// old engine which lacks opcode 344, so we just make it a +3 there.
	//
	// This is in line with how similar vanilla items work between
	// BGT and BGEE.  Note that it still has only +1 to hit and damage,
	// the enchantment level only determines what it can hit.

	PATCH_IF NOT enhanced_edition
	BEGIN
	  WRITE_LONG 0x0060 3	// Enchantment level
	  LAUNCH_PATCH_FUNCTION DELETE_EFFECT
	    INT_VAR
	    match_opcode	= 344	// Does not exist in old engine.
	  END
	END

  CREATE EFF ~bsblun01~
 	WRITE_LONG 0x0010 12	// HP: Damage
	WRITE_LONG 0x0014 2	// Target: Preset target
	WRITE_LONG 0x001c 2	// Parameter1: Damage amount
	WRITE_LONG 0x0020 0	// Parameter2: Damage type (crushing)
	WRITE_LONG 0x0024 1	// Timing Mode: Instant/Permanent
	WRITE_BYTE 0x002c 100	// Probability: always

