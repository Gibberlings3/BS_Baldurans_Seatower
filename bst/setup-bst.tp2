/////////////////////////////////////////////////////////////
/* preparation for compilation of dialogue: read in other mods */
/* BST needs to be installed after these mods for the reply options to show */

/* EndlessBG1 */
ACTION_IF FILE_EXISTS_IN_GAME ~C#STELTA.cre~ THEN BEGIN
// Get state for DELTAN2 %deltan2_70%
/* ~You saved us. You have the gratitude of the city.~ */
OUTER_SET deltan2_70 = STATE_WHICH_SAYS 70 IN ~c#endlessbg1/translations/%s/DIALOGUES.TRA~ FROM ~DELTAN2~
OUTER_SPRINT ~EBG1_ONLY_SLASH~ ~~
OUTER_SPRINT ~EBG1_ONLY_ASTERIKS~ ~~
END ELSE BEGIN
/* no endlessbg1 detected */
OUTER_SPRINT ~EBG1_ONLY_SLASH~ ~/~
OUTER_SPRINT ~EBG1_ONLY_ASTERIKS~ ~*~
END //EndlessBG1

/* needed if both mods are not present. Will be overwritten if bg1re is presnet */
OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_SLASH~ ~/~
OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_ASTERIKS~ ~*~

/* bg1re ("Eltan's Spare Minute") */
ACTION_IF MOD_IS_INSTALLED ~bg1re.tp2~ 6 THEN BEGIN
/* @12   = ~Don't lose any more time!~ */
  OUTER_SET deltan2_12 = STATE_WHICH_SAYS 12 IN ~bg1re/tra/autotra/%s/c#eltan.tra~ FROM ~DELTAN2~
  OUTER_SPRINT ~BG1RE_ONLY_SLASH~ ~~
  OUTER_SPRINT ~BG1RE_ONLY_ASTERIKS~ ~~
 /* only important if EBG1 is *not* installed */
 ACTION_IF !FILE_EXISTS_IN_GAME ~C#STELTA.cre~ THEN BEGIN
// Get state for DELTAN2 %deltan2_322%
/* ~You saved us. You have the gratitude of the city.~ */
  OUTER_SET deltan2_322 = STATE_WHICH_SAYS 322 IN ~bg1re/tra/autotra/%s/c#eltan.tra~ FROM ~DELTAN2~
  OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_SLASH~ ~~
  OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_ASTERIKS~ ~~
 END ELSE BEGIN
  OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_SLASH~ ~/~
  OUTER_SPRINT ~BG1RE_NO_EBG1_ONLY_ASTERIKS~ ~*~
 END
END ELSE BEGIN
/* no bg1re ("Eltan's Spare Minute") detected */
OUTER_SPRINT ~BG1RE_ONLY_SLASH~ ~/~
OUTER_SPRINT ~BG1RE_ONLY_ASTERIKS~ ~*~
END

/* bg1re ("Necromancer's Trouble") */
ACTION_IF MOD_IS_INSTALLED ~bg1re.tp2~ 30 THEN BEGIN
/* @12   = ~Don't lose any more time!~ */
  OUTER_SET c#q11wat_270 = STATE_WHICH_SAYS 270 IN ~bg1re/tra/autotra/%s/necromancer.tra~ FROM ~c#q11wat~
OUTER_SPRINT ~BG1RE_NT_ONLY_SLASH~ ~~
OUTER_SPRINT ~BG1RE_NT_ONLY_ASTERIKS~ ~~
END ELSE BEGIN
/* no bg1re ("Necromancer's Trouble") */
OUTER_SPRINT ~BG1RE_NT_ONLY_SLASH~ ~/~
OUTER_SPRINT ~BG1RE_NT_ONLY_ASTERIKS~ ~*~
END

/* Transitions - uses different dlg for Eltan altogether */
ACTION_IF ((MOD_IS_INSTALLED ~transitions/setup-transitions.TP2~ "70")
OR (MOD_IS_INSTALLED ~transitions/setup-transitions.TP2~ "71")
OR (MOD_IS_INSTALLED ~transitions/setup-transitions.TP2~ "72")
OR (MOD_IS_INSTALLED ~transitions/setup-transitions.TP2~ "73")) THEN BEGIN
// Get state for DELTAN %deltan_2057%
/* ~Greetings, <GABBER>.  It's a pleasure to see you again.~ */
OUTER_SET deltan_2057 = STATE_WHICH_SAYS 2057 IN ~transitions/languages/%s/DIALOGUES.TRA~ FROM ~DELTAN~
OUTER_SPRINT ~TRANSITIONS_ONLY_SLASH~ ~~
OUTER_SPRINT ~TRANSITIONS_ONLY_ASTERIKS~ ~~
END ELSE BEGIN
/* no Transitions detected */
OUTER_SPRINT ~TRANSITIONS_ONLY_SLASH~ ~/~
OUTER_SPRINT ~TRANSITIONS_ONLY_ASTERIKS~ ~*~
END

/* JAP component "~Nashkel~" - Bardolan in Nashkel */
ACTION_IF MOD_IS_INSTALLED ~Setup-JA#BGT_AdvPack.tp2~ 40 THEN BEGIN
// Get state for BARDOL %bardol_jap_6%
/* @6    = ~But yes, what do you want to know?~ */
OUTER_SET bardol_jap_6 = STATE_WHICH_SAYS 6 IN ~JA#BGT_AdvPack/languages/%s/ja#bardol.tra~ FROM ~BARDOL~
OUTER_SPRINT ~JAP_BARDOL_ONLY_SLASH~ ~~
OUTER_SPRINT ~JAP_BARDOL_ONLY_ASTERIKS~ ~~
END ELSE BEGIN
/* no JAP detected */
OUTER_SPRINT ~JAP_BARDOL_ONLY_SLASH~ ~/~
OUTER_SPRINT ~JAP_BARDOL_ONLY_ASTERIKS~ ~*~
END





