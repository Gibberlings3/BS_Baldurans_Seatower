/////////////////////////////////////////////////////////////
// Crossmod
////////////////////////////////////////////////////////////
/* will only be installed if install order is correct */

/* EE with EndlessBG1: add option to move contents of chest in Ilmater monastery to chest in PC's room in palace */
/* transfer content of PC's container into Palace in SoD */
ACTION_IF !(GAME_IS ~bgt~) AND (MOD_IS_INSTALLED ~c#endlessbg1.tp2~ ~1~) THEN BEGIN

// Get state for c#stsrv1.dlg %butler% (in pc_palaceresidence.d)
/* @30 ~Welcome, Hero of Baldur's Gate! This room will serve as your residence as long as you will stay in the city. I prepared everything and hope you will find it to your pleasing! The Dukes want me to tell you that the chest on the far left of the room will be your personal one, and everything you will put inside shall stay there as long as you take residence here. We cleared out the chests and moved everything downstairs, but if we left things in feel free to stock up your supplies with them. Have a good stay and thank you for saving the city!~ */
OUTER_SET butler = STATE_WHICH_SAYS 30 IN ~c#endlessbg1/translations/%s/DIALOGUES.TRA~ FROM ~c#stsrv1~

<<<<<<<< ...inlined/butler_asks_about_items.d
INTERJECT c#stsrv1 %butler% bs_c#stsrv1_int
== c#stsrv1 IF ~Global("bs_IlmaterMonasteryStronghold","GLOBAL",1)~ THEN @2915 /* ~Is there anything else you'd like me to do for you?~ */ 
END
++ @2916 /* ~Would you please make sure that all my personal belongings from the Ilmater Monastery are also brought here?~ */ DO ~SetGlobal("bs_BSTPlayerChest","MYAREA",1)~ + goodbye
++ @2917 /* ~No, nothing.~ */ + goodbye

APPEND c#stsrv1
IF ~~ THEN goodbye
SAY @2918 /* ~As you wish, my <PRO_LADYLORD>.~ */
COPY_TRANS c#stsrv1 %butler%
END
END //APPEND
>>>>>>>>
COMPILE EVALUATE_BUFFER ~...inlined/butler_asks_about_items.d~ 
USING ~weidu_external/bst/language/%LANGUAGE%/bst_setup.tra~


<<<<<<<< .../move_items_to_palace.baf
  // Transferring items to BG1 area palace container
IF
	Global("bs_IlmaterMonasteryStronghold","GLOBAL",1)
	Global("bs_BSTPlayerChest","MYAREA",1)
THEN
	RESPONSE #100
		MoveContainerContents("ys0123*Chest01","%NBaldursGate_DucalPalace_L3%*Container1")
		SetGlobal("bs_BSTPlayerChest","MYAREA",2)
END
>>>>>>>>
EXTEND_BOTTOM ~%NBaldursGate_DucalPalace_L3%.bcs~ ~.../move_items_to_palace.baf~ EVALUATE_BUFFER 
END //EndlessBG1



