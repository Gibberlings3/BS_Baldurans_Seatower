////////////////////////////////////////////////////////////////////
//Spells
	COPY ~bst/spells/bsdark01.spl~ ~override/bsdark01.spl~
  		SAY NAME1 @400

	COPY ~bst/spells/bsdoppdr.spl~ ~override/bsdoppdr.spl~
  		SAY NAME1 @401
		SAY NAME2 @401

	COPY ~bst/spells/copy/.~ ~override/.~

	ACTION_IF GAME_IS ~bgee~ THEN BEGIN 
	 INCLUDE ~bst/lib/cd_clone_spell_bulk_first.tpa~
	 ACTION_CLEAR_ARRAY cd_clone_spell_array // do this once
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr416 destination = bspin203 RET_ARRAY cd_clone_spell_array END // Cloak of Fear - only needed for BG:EE
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr414 destination = bsppr414 RET_ARRAY cd_clone_spell_array END // Cause Serious Wounds
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi409 destination = bspwi409 RET_ARRAY cd_clone_spell_array END // Contagion
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr401 destination = bsppr401 RET_ARRAY cd_clone_spell_array END // Cure Serious Wounds
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi411 destination = bspwi411 RET_ARRAY cd_clone_spell_array END // Emotion, Hopelessness
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr403 destination = bsppr403 RET_ARRAY cd_clone_spell_array END // Free Action
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr412 destination = bsppr412 RET_ARRAY cd_clone_spell_array END // Holy Power
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi405 destination = bspwi405 RET_ARRAY cd_clone_spell_array END // Improved Invisibility
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr417 destination = bsppr417 RET_ARRAY cd_clone_spell_array END // Lesser Restoration
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr405 destination = bsppr405 RET_ARRAY cd_clone_spell_array END // Mental Domination
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi406 destination = bspwi406 RET_ARRAY cd_clone_spell_array END // Minor Globe of Invulnerability
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr404 destination = bsppr404 RET_ARRAY cd_clone_spell_array END // Neutralize Poison
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi413 destination = bspwi413 RET_ARRAY cd_clone_spell_array END // Otiluke's Resilient Sphere
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi415 destination = bspwi415 RET_ARRAY cd_clone_spell_array END // Polymorph Other
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi410 destination = bspwi410 RET_ARRAY cd_clone_spell_array END // Remove Curse
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi419 destination = bspwi419 RET_ARRAY cd_clone_spell_array END // Secret Word
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi414 destination = bspwi414 RET_ARRAY cd_clone_spell_array END // Spirit Armor
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi408 destination = bspwi408 RET_ARRAY cd_clone_spell_array END // Stoneskin
	 INCLUDE ~bst/lib/cd_clone_spell_bulk_last.tpa~
	END ELSE BEGIN
	 INCLUDE ~bst/lib/cd_clone_spell_bulk_first.tpa~
	 ACTION_CLEAR_ARRAY cd_clone_spell_array // do this once
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr414 destination = bsppr414 RET_ARRAY cd_clone_spell_array END // Cause Serious Wounds
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi409 destination = bspwi409 RET_ARRAY cd_clone_spell_array END // Contagion
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr401 destination = bsppr401 RET_ARRAY cd_clone_spell_array END // Cure Serious Wounds
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi411 destination = bspwi411 RET_ARRAY cd_clone_spell_array END // Emotion, Hopelessness
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr403 destination = bsppr403 RET_ARRAY cd_clone_spell_array END // Free Action
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr412 destination = bsppr412 RET_ARRAY cd_clone_spell_array END // Holy Power
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi405 destination = bspwi405 RET_ARRAY cd_clone_spell_array END // Improved Invisibility
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr417 destination = bsppr417 RET_ARRAY cd_clone_spell_array END // Lesser Restoration
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr405 destination = bsppr405 RET_ARRAY cd_clone_spell_array END // Mental Domination
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi406 destination = bspwi406 RET_ARRAY cd_clone_spell_array END // Minor Globe of Invulnerability
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = sppr404 destination = bsppr404 RET_ARRAY cd_clone_spell_array END // Neutralize Poison
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi413 destination = bspwi413 RET_ARRAY cd_clone_spell_array END // Otiluke's Resilient Sphere
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi415 destination = bspwi415 RET_ARRAY cd_clone_spell_array END // Polymorph Other
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi410 destination = bspwi410 RET_ARRAY cd_clone_spell_array END // Remove Curse
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi419 destination = bspwi419 RET_ARRAY cd_clone_spell_array END // Secret Word
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi414 destination = bspwi414 RET_ARRAY cd_clone_spell_array END // Spirit Armor
	 LAF cd_clone_spell_bulk INT_VAR make_innate = 1 STR_VAR source = spwi408 destination = bspwi408 RET_ARRAY cd_clone_spell_array END // Stoneskin
	 INCLUDE ~bst/lib/cd_clone_spell_bulk_last.tpa~
	END

