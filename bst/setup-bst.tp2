        Race(LastTrigger,GOBLIN)~
  OUTER_SPRINT ~NO_RACE_GOBLIN~ ~!Race(LastTrigger,GOBLIN)~
  OUTER_SPRINT ~BGEE_ONLY_SLASH~ ~/~
  OUTER_SPRINT ~BGEE_ONLY_ASTERIKS~ ~*~
 END

