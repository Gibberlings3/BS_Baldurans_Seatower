	COPY_EXISTING ~bs0102.are~ ~override/bs0102.are~
		SET songCDay1 = IDS_OF_SYMBOL (~songlist~ ~Dung3~) //Get the song's number
		SET songCNite = IDS_OF_SYMBOL (~songlist~ ~Dung3~)
		SET songBC4 = IDS_OF_SYMBOL (~songlist~ ~BD1~)
