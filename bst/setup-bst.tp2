  ACTION_IF GAME_IS ~eet~ THEN BEGIN
	COPY_EXISTING ~bs1000.are~ ~override/bs1000.are~
		SET songCDay1 = IDS_OF_SYMBOL (~songlist~ ~CDay1~) //Get the song's number
		SET songCNite = IDS_OF_SYMBOL (~songlist~ ~CNite~) 
		SET songBC4 = IDS_OF_SYMBOL (~songlist~ ~BC4~) 
		READ_LONG 0xBC ofsSong
		SET ofsDay = ofsSong
		SET ofsNight = ofsSong + 4
		SET ofsBC = ofsSong + 12
		WRITE_LONG ofsDay %songCDay1% // Make the change
		WRITE_LONG ofsNight %songCNite% // Make the change
		WRITE_LONG ofsBC %songBC4% // Make the change
  END
  ACTION_IF GAME_IS ~bgee~ THEN BEGIN
	COPY_EXISTING ~bs1000.are~ ~override/bs1000.are~
		SET songCDay1 = IDS_OF_SYMBOL (~songlist~ ~CDay1~) //Get the song's number
		SET songCNite = IDS_OF_SYMBOL (~songlist~ ~CNite~) 
		READ_LONG 0xBC ofsSong
		SET ofsDay = ofsSong
		SET ofsNight = ofsSong + 4
		SET ofsBC = ofsSong + 12
		WRITE_LONG ofsDay %songCDay1% // Make the change
		WRITE_LONG ofsNight %songCNite% // Make the change
  END
