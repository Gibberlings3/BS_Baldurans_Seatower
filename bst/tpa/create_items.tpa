//##################################################
// Items


// Catacombs secret door key
  CREATE ~ITM~ VERSION ~V1  ~ ~bscckey~
  COPY ~override/bscckey.itm~ ~override/bscckey.itm~
    // Item Header: //
      WRITE_LONG   0x0008 1697      // Unidentified Name (strref)
      SAY          NAME2  @514      // Identified Name (strref)
      WRITE_LONG   0x0018 109       // Flags
      WRITE_SHORT  0x001c 8         // Item type
      WRITE_ASCIIE 0x0022 ~  ~ #2   // Item animation
      WRITE_LONG   0x0034 7500      // Price
      WRITE_SHORT  0x0038 1         // Stack amount
      WRITE_ASCIIE 0x003a ~bscdkey2~ // Inventory icon (BAM)
      WRITE_ASCIIE 0x0044 ~GMISC83~ // Ground icon (BAM)
      WRITE_LONG   0x004c 0         // Weight
      SAY          IDENTIFIED_DESC @515 // Identified Description (strref)
      WRITE_ASCIIE 0x0058 ~BSCCKYC~ // Description icon (BAM)

