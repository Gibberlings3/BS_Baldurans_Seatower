      WRITE_LONG   0x0034 10000     // Price
      WRITE_SHORT  0x0038 1         // Stack amount
      WRITE_ASCIIE 0x003a ~bsclawdi~ // Inventory icon (BAM)
      WRITE_ASCIIE 0x0044 ~GMISC72~ // Ground icon (BAM)
      WRITE_LONG   0x004c 1         // Weight
      WRITE_LONG   0x0050 11847     // Unidentified Description (strref)
      //SAY        UNIDENTIFIED_DESC ~~ // Unidentified Description (strref)
      SAY          IDENTIFIED_DESC @525 // Identified Description (strref)
      WRITE_ASCIIE 0x0058 ~CMISC72~ // Description icon (BAM)
    // Equipping Effect (Feature Block) 0 //
      LPF ADD_ITEM_EQEFFECT
        INT_VAR
             insert_point  = "-1" // The position of the feature block
             opcode        = 142  // Opcode number
             target        = 1    // Target type
             parameter2    = 35   // Parameter 2
